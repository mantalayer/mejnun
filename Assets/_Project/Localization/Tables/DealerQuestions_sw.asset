  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DealerQuestions_sw
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: sw
  m_SharedData: {fileID: 11400000, guid: 87a4643bee3d747fb9ab730fc39509cd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6547924049920
    m_Localized: Nani angesahau zaidi kwa nini waliingia chumbani?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244224
    m_Localized: Nani anasema utani mbaya zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244225
    m_Localized: Nani angekuwa wa kwanza kucheza kwenye harusi?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244226
    m_Localized: Nani ana ghala la simu lenye machafuko zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244227
    m_Localized: Ni nani angeishi kwa muda mrefu zaidi kwenye kisiwa cha jangwa?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244228
    m_Localized: Ni nani anaye uwezekano mkubwa wa kuanzisha mtindo kwa bahati mbaya?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244229
    m_Localized: Ni siku ya kuzaliwa ya nani iliyo karibu zaidi leo?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244230
    m_Localized: Nani alioga hivi karibuni?
    m_Metadata:
      m_Items: []
  - m_Id: 74276106395648
    m_Localized: Ni nani anaye uwezekano mkubwa wa kuonyesha mvuto?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561472
    m_Localized: Nywele za nani zilizopinda zaidi (na kwa hivyo ni nzuri zaidi)?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561473
    m_Localized: Ni nani mlaji anayechagua zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561474
    m_Localized: Ni nani anayeweza kumpiga mtu kofi kwa kumpiga?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561475
    m_Localized: Nani anaweza hata kuinua, kaka?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561476
    m_Localized: Nani anaweza kudumisha ubora wake?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561477
    m_Localized: Nani anaweza kuhesabu tarakimu nyingi zaidi za pi? Mmmm, pai...
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561478
    m_Localized: Kama ungekwama kwenye kisiwa cha jangwa ukiwa na kindi mmoja tu
      na vijiti viwili vya meno... Nani angemkamata kindi huyo, au kitu kama hicho?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561479
    m_Localized: Ni nani mwenye uzoefu zaidi katika kuhesabu maharagwe?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561480
    m_Localized: Nani husengenya zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561481
    m_Localized: Nani ana michubuko yenye harufu mbaya zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561482
    m_Localized: Ni nani bora zaidi katika kukisia uzito wa watu?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561483
    m_Localized: Nani anaweza kujenga trebuchet bora zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561484
    m_Localized: Nani mpishi bora?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561485
    m_Localized: Ni nani anayechoma chakula zaidi wakati wa kupika?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561486
    m_Localized: Mzunguko wa kichwa cha nani ni mkubwa zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561487
    m_Localized: Ni nani anaye uwezekano mkubwa wa kusahau simu yake kwenye friji?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561488
    m_Localized: Ni nani anaye uwezekano mkubwa wa kuacha rimoti kwenye friji?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561489
    m_Localized: Nani hupiga ala nyingi zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561490
    m_Localized: Nani ni mbaya zaidi katika kifaa cha muziki?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561491
    m_Localized: Nani angechukua muda mrefu zaidi kujenga samani?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561492
    m_Localized: Ni nani anayependa sana paka?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561493
    m_Localized: Ni nani anayependa sana mbwa?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561494
    m_Localized: Nani ananusa zaidi matunda ya elderberry?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561495
    m_Localized: Rangi ya bluu ni ya nani anayeipenda zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561496
    m_Localized: Ni nani mwenye uwezekano mkubwa wa kupigana na dubu (na kushinda)?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561497
    m_Localized: Nani anapoteza zaidi huko Vegas?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561498
    m_Localized: Nani anajua kila kitu ni nini?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561499
    m_Localized: Ni nani anayetumia mtandao kwa muda mrefu zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561500
    m_Localized: Haraka, nafikiria nambari kati ya 81 na 976! Nani alikisia 222?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561501
    m_Localized: Ni nani anayekabiliwa zaidi na hasira wakati wa kucheza michezo?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561502
    m_Localized: Ni nani anayeshindana zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561503
    m_Localized: Nani anataka kuwa wa kwanza zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561504
    m_Localized: Nani anataka kuwa wa kwanza hata kidogo?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561505
    m_Localized: Pambana! Nani alishinda?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561506
    m_Localized: Nani hataki kwenda kabisa?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561507
    m_Localized: Nani asiyependa rangi ya zambarau?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561508
    m_Localized: Nani ana nywele za kijivu zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561509
    m_Localized: Nani mwenye nywele chache zaidi? Ninahesabu nywele za mwili.
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561510
    m_Localized: Nani alimaliza kupika sahani?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561511
    m_Localized: Nani ana mkusanyiko mkubwa zaidi wa michezo?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561512
    m_Localized: Nani anaweza kuelezea vyema nadharia ya quantum?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561513
    m_Localized: Nani ana maono bora zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561514
    m_Localized: Nani huzungumza lugha nyingi zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561515
    m_Localized: Nani ana paka wengi zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561516
    m_Localized: Nani anaweza kurekebisha kabureta?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561517
    m_Localized: Ni nani amewahi kutembelea nchi nyingi zaidi?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561518
    m_Localized: Nani anaweza kukimbia umbali mrefu zaidi? Jaribu kabla ya mchezo!
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561519
    m_Localized: Nani angeelekeza troli kwa watu watano?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561520
    m_Localized: Ungeuliza swali, lakini usiseme kwamba nilikuambia...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
