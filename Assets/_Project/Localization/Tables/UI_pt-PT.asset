  m_TableData:
  - m_Id: 1656690302978
    m_Localized: Fechar
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208842
    m_Localized: Adicionar a um conjunto
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208844
    m_Localized: Ases
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208845
    m_Localized: "Um \xE1s pode ser baixo (A-2-3) ou alto (Q-K-A), mas uma sequ\xEAncia
      nunca se completa (K-A-2)."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208849
    m_Localized: Duplas
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208860
    m_Localized: Use seu duplo
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208884
    m_Localized: "Voc\xEA desenhou o 2\u2665"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208887
    m_Localized: "Agora o A\u2665 se encaixa na extremidade inferior: A-2-3-4-5\u2665.
      Jogue sua \xFAltima carta!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208892
    m_Localized: ternos mistos
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208894
    m_Localized: Alto
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403137
    m_Localized: Um duplo
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403142
    m_Localized: "Em jogos cronometrados, um rel\xF3gio faz a contagem regressiva
      de cada turno. Quando o tempo acaba \u2014 Halas! \u2014 o turno v\xE1lido
      termina; caso contr\xE1rio, suas cartas voltam para a base e voc\xEA compra
      mais."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403159
    m_Localized: Game Over
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403190
    m_Localized: "Maom\xE9"
    m_Metadata:
      m_Items: []
