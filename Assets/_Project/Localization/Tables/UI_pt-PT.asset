      - rid: 4825848250703282614
  - m_Id: 6549035540540
    m_Localized: "{0} est\xE1 pensando\u2026"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549035540541
    m_Localized: Sua vez
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540542
    m_Localized: "\xC9 a vez de {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549035540543
    m_Localized: Sua vez
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540544
    m_Localized: A vez de {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549035540545
    m_Localized: Assento {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549035540546
    m_Localized: 'Pilha de compra: {0}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549035540548
    m_Localized: "N\xE3o \xE9 a sua vez."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540549
    m_Localized: "Essa op\xE7\xE3o n\xE3o est\xE1 dispon\xEDvel no momento."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540550
    m_Localized: "Des\xE7a at\xE9 a mesa antes de usar as cartas do tabuleiro."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540551
    m_Localized: "As cartas na mesa n\xE3o podem ser devolvidas para a sua m\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540552
    m_Localized: "Voc\xEA deve fazer uma jogada v\xE1lida antes de encerrar seu turno."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540553
    m_Localized: "Esse conjunto n\xE3o atende aos requisitos para descer."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540554
    m_Localized: "Um conjunto n\xE3o pode conter a mesma carta duas vezes."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540555
    m_Localized: "Esse conjunto cont\xE9m cartas demais."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540556
    m_Localized: "Essa carta n\xE3o pode ser adicionada a este conjunto."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540557
    m_Localized: "Escolha um local v\xE1lido para esse cart\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540560
    m_Localized: "Esse cart\xE3o ou conjunto n\xE3o est\xE1 mais dispon\xEDvel."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540561
    m_Localized: "Este jogo j\xE1 terminou."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540562
    m_Localized: "Experimente os cart\xF5es destacados."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540563
    m_Localized: "Essa jogada n\xE3o \xE9 permitida pelas regras do jogo."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540564
    m_Localized: "N\xE3o pergunte novamente."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540567
    m_Localized: "Algumas cartas inv\xE1lidas retornar\xE3o para sua m\xE3o. Corrija
      o tabuleiro?"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540568
    m_Localized: "Pular o tutorial? Voc\xEA pode reproduzi-lo a qualquer momento
      em Como jogar."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540569
    m_Localized: "Voltar ao menu principal? Este jogo ser\xE1 salvo para que voc\xEA
      possa retom\xE1-lo mais tarde."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540570
    m_Localized: "Reiniciar este jogo? A rodada atual ser\xE1 perdida."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540571
    m_Localized: Em pausa
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540572
    m_Localized: Retomar
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540573
    m_Localized: Reinicie o jogo
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540574
    m_Localized: "Configura\xE7\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540575
    m_Localized: Pular tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540576
    m_Localized: '? Ajuda'
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540577
    m_Localized: Menu principal
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540578
    m_Localized: "C\xF3digo do quarto: {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549035540579
    m_Localized: Atalhos de PC
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540580
    m_Localized: "Ctrl/Cmd+Z Desfazer\nCtrl/Cmd+Shift+Z ou Ctrl+Y Refazer\nEspa\xE7o
      Finalizar turno\nD Comprar/Passar\nR Reverter\nF Corrigir tabuleiro\nH Dica\nF1
      Esta folha\nEsc ou P Pausar"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540581
    m_Localized: "Experimente os cart\xF5es destacados."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540582
    m_Localized: Pular tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540583
    m_Localized: "Pr\xF3ximo"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540584
    m_Localized: Entendi
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540585
    m_Localized: "Pr\xF3ximo"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540586
    m_Localized: Feito
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540588
    m_Localized: "\u2713 {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549035540589
    m_Localized: "\u2717 {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549035540590
    m_Localized: Quem vai primeiro?
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540591
    m_Localized: "Primeiro jogador aleat\xF3rio"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540592
    m_Localized: Toque para revelar
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540593
    m_Localized: MEJNUN!
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540594
    m_Localized: Conquistas
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734784
    m_Localized: Novidades na Galeria
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734785
    m_Localized: "Ainda n\xE3o desbloqueado"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734786
    m_Localized: Menu
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734787
    m_Localized: Revanche
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734788
    m_Localized: Jogue para valer
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734789
    m_Localized: Iniciar uma nova rodada?
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734790
    m_Localized: "N\xE3o pergunte novamente."
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734791
    m_Localized: Revanche
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734792
    m_Localized: Cartas restantes
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734793
    m_Localized: '{0}: {1}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549039734794
    m_Localized: "Voc\xEA concluiu o tutorial. Agora voc\xEA est\xE1 pronto para
      uma partida de verdade!"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734795
    m_Localized: +{0} XP
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549039734798
    m_Localized: 'Novo: {0}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549039734799
    m_Localized: "Ainda n\xE3o desbloqueado: {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549039734800
    m_Localized: Novo baralho desbloqueado
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734801
    m_Localized: Toque para continuar
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734802
    m_Localized: por {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
