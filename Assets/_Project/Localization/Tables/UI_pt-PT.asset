    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549031346186
    m_Localized: "Cosm\xE9ticos de mesa"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346187
    m_Localized: "Escolha dois baralhos e um feltro para a mesa. As escolhas de um
      jogador ser\xE3o selecionadas para a partida."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346188
    m_Localized: "Criar sess\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346189
    m_Localized: "C\xF3digo da sess\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346190
    m_Localized: "Junte-se por c\xF3digo"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346191
    m_Localized: "Partida r\xE1pida"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346192
    m_Localized: "Conectando\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346193
    m_Localized: "Primeiro, participe de uma sess\xE3o ou crie a sua pr\xF3pria."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346194
    m_Localized: "O anfitri\xE3o cancelou o jogo."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346195
    m_Localized: "Voc\xEA saiu do sagu\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346196
    m_Localized: "C\xF3digo de sess\xE3o indispon\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346197
    m_Localized: "Aguardando jogadores ({0}/{1})\u2026"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282614
  - m_Id: 6549031346198
