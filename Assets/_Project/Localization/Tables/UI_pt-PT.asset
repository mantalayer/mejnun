      m_Items: []
  - m_Id: 6549018763285
    m_Localized: Coletor
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763287
    m_Localized: "MEJNUN \xD710"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763288
    m_Localized: "Ganhe 10 partidas esvaziando sua m\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763289
    m_Localized: Limpeza completa
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763290
    m_Localized: "Des\xE7a e esvazie a m\xE3o na mesma rodada, com dicas e o tabuleiro
      fixo desativados."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763291
    m_Localized: Raio
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763292
    m_Localized: "Ven\xE7a nas suas primeiras cinco rodadas."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763293
    m_Localized: "\xDAltimo Suspiro"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763294
    m_Localized: "Ganhe esvaziando sua m\xE3o quando o monte de compra estiver vazio."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763295
    m_Localized: Voltar
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763297
    m_Localized: "At\xE9 o \xFAltimo minuto"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763299
    m_Localized: Estrada Real
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763300
    m_Localized: "Fa\xE7a uma sequ\xEAncia completa de 13 cartas, do \xE1s ao rei."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763302
    m_Localized: "Complete uma sequ\xEAncia de dama-rei-\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763303
    m_Localized: Entrada principal
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763304
    m_Localized: "Fa\xE7a pelo menos tr\xEAs s\xE9ries seguidas."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763305
    m_Localized: Arquiteto
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763306
    m_Localized: "Coloque pelo menos oito cartas da m\xE3o em uma \xFAnica jogada."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763307
    m_Localized: "Cirurgi\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763309
    m_Localized: Tempo Emprestado
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763311
    m_Localized: Vendo em Dobro
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763312
    m_Localized: "Encerre seu turno com ambas as c\xF3pias de uma carta em conjuntos
      separados."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763313
    m_Localized: Paciente
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763315
    m_Localized: Sem rodinhas de apoio
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763316
    m_Localized: Ganhe com as dicas desativadas.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763317
    m_Localized: Halas!
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763318
    m_Localized: Chegou a sua vez.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763319
    m_Localized: "Mantenha a calma sob press\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763320
    m_Localized: "Encerre uma jogada v\xE1lida com menos de tr\xEAs segundos restantes."
    m_Metadata:
      m_Items: []
