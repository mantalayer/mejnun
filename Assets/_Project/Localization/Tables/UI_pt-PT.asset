  - m_Id: 6549027151885
    m_Localized: "\xC9 novo em Mejnun?"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346176
    m_Localized: "Um breve jogo guiado ensina todas as regras atrav\xE9s da brincadeira."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346177
    m_Localized: Reproduza o tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346178
    m_Localized: "Eu conhe\xE7o as regras."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346179
    m_Localized: Jogue online
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346180
    m_Localized: "Fa\xE7a login anonimamente e participe com um c\xF3digo de sess\xE3o
      ou encontre uma partida rapidamente."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346181
    m_Localized: Apelido
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346183
    m_Localized: Temporizador de turno
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346184
    m_Localized: Desligado
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346185
