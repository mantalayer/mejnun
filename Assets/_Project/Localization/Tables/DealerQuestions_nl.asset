  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DealerQuestions_nl
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: nl
  m_SharedData: {fileID: 11400000, guid: 87a4643bee3d747fb9ab730fc39509cd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6547924049920
    m_Localized: Wie zou het snelst vergeten waarom hij of zij een kamer binnenliep?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244224
    m_Localized: Wie vertelt de slechtste grappen?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244225
    m_Localized: Wie zou als eerste dansen op een bruiloft?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244226
    m_Localized: Wie heeft de meest chaotische telefoongalerij?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244227
    m_Localized: Wie zou het langst overleven op een onbewoond eiland?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244228
    m_Localized: Wie heeft de grootste kans om per ongeluk een trend te starten?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244229
    m_Localized: Wiens verjaardag is het dichtst bij vandaag?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244230
    m_Localized: Wie heeft er het laatst gedoucht?
    m_Metadata:
      m_Items: []
  - m_Id: 74276106395648
    m_Localized: "Wie is het meest geneigd om een \u200B\u200Bdragshow op te voeren?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561472
    m_Localized: Wiens haar is het meest krullend (en dus het mooist)?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561473
    m_Localized: Wie is de meest kieskeurige eter?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561474
    m_Localized: Wie is het meest geneigd om iemand terug te slaan omdat diegene
      iemand anders heeft geslagen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561475
    m_Localized: Wie kan er nou echt gewichten tillen, man?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561476
    m_Localized: Wie kan het beste de maat houden?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561477
    m_Localized: Wie kan de meeste cijfers van pi tellen? Mmmm, pi...
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561478
    m_Localized: Stel je voor dat je vastzit op een onbewoond eiland met alleen een
      eekhoorn en twee tandenstokjes... Wie zou de eekhoorn vangen, of zoiets?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561479
    m_Localized: Wie is het meest ervaren in het tellen van bonen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561480
    m_Localized: Wie roddelt het meest?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561481
    m_Localized: Wie heeft de meest stinkende boeren?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561482
    m_Localized: Wie kan het gewicht van mensen het beste inschatten?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561483
    m_Localized: Wie kan de beste katapult bouwen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561484
    m_Localized: Wie is de beste kok?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561485
    m_Localized: Wie verbrandt er het meeste eten tijdens het koken?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561486
    m_Localized: Wiens hoofdomtrek is het grootst?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561487
    m_Localized: Wie vergeet het vaakst zijn of haar telefoon in de koelkast?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561488
    m_Localized: Wie laat het meest waarschijnlijk de afstandsbediening in de vriezer
      liggen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561489
    m_Localized: Wie bespeelt de meeste instrumenten?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561490
    m_Localized: Wie is het slechtst op een instrument?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561491
    m_Localized: "Wie zou er het langst over doen om een \u200B\u200Bmeubelstuk in
      elkaar te zetten?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561492
    m_Localized: Wie is het meest geobsedeerd door katten?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561493
    m_Localized: Wie is het meest geobsedeerd door honden?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561494
    m_Localized: Wie ruikt het sterkst naar vlierbessen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561495
    m_Localized: Wiens favoriete kleur is blauw?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561496
    m_Localized: "Wie heeft de grootste kans om een \u200B\u200Bbeer aan te vallen
      (en te winnen)?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561497
    m_Localized: Wie verliest het meest in Las Vegas?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561498
    m_Localized: "Wie weet wat een 'alles-in-\xE9\xE9n'-douche is?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561499
    m_Localized: Wie is het meest chronisch online?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561500
    m_Localized: Snel, ik denk aan een getal tussen 81 en 976! Wie had 222 geraden?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561501
    m_Localized: Wie heeft de grootste kans om woedend te worden tijdens het gamen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561502
    m_Localized: Wie is het meest competitief?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561503
    m_Localized: Wie wil er het liefst als eerste aan de beurt zijn?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561504
    m_Localized: Wie heeft er het minste zin om als eerste te gaan?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561505
    m_Localized: Vechtpartij! Wie heeft gewonnen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561506
    m_Localized: Wie wil er nou helemaal niet heen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561507
    m_Localized: Wie houdt er nu niet van de kleur paars?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561508
    m_Localized: Wie heeft de meeste grijze haren?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561509
    m_Localized: Wie heeft het minste haar? Ik tel lichaamshaar mee.
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561510
    m_Localized: Wie heeft als laatste de afwas gedaan?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561511
    m_Localized: Wie heeft de grootste gamecollectie?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561512
    m_Localized: Wie kan de kwantumtheorie het beste uitleggen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561513
    m_Localized: Wie heeft het beste gezichtsvermogen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561514
    m_Localized: Wie spreekt de meeste talen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561515
    m_Localized: Wie heeft de meeste katten?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561516
    m_Localized: Wie kan een carburateur afstellen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561517
    m_Localized: Wie heeft de meeste landen bezocht?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561518
    m_Localized: Wie kan het verst rennen? Probeer het eens uit voor de wedstrijd!
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561519
    m_Localized: Wie zou de winkelwagen naar vijf personen omleiden?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561520
    m_Localized: Verzin een vraag, maar zeg niet dat ik je dat heb opgedragen...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
