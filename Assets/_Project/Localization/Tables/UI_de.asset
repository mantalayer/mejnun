  - m_Id: 6549006180389
    m_Localized: Adaeze
    m_Metadata:
      m_Items: []
  - m_Id: 6549006180399
    m_Localized: Yutong
    m_Metadata:
      m_Items: []
  - m_Id: 6549006180402
    m_Localized: Xinyan
    m_Metadata:
      m_Items: []
  - m_Id: 6549006180407
    m_Localized: Ema
    m_Metadata:
      m_Items: []
  - m_Id: 6549006180417
    m_Localized: Seo-ah
    m_Metadata:
      m_Items: []
  - m_Id: 6549006180420
    m_Localized: Linh
    m_Metadata:
      m_Items: []
  - m_Id: 6549006180442
    m_Localized: Indah
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763272
    m_Localized: Spiele 50 Spiele.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763276
    m_Localized: Gewinne 50 Spiele.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763285
    m_Localized: Kollektor
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763299
    m_Localized: Royal Road
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763308
    m_Localized: "Eine Stra\xDFe teilen und den Turn mit einem g\xFCltigen Board
      beenden."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763311
    m_Localized: Doppeltes Sehen
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763313
    m_Localized: Geduldig
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763322
    m_Localized: Gewinne ein Spiel, das mit einem 30-Sekunden-Timer gespielt wird.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957571
    m_Localized: Gewinne drei Bot-Spiele in Folge.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957578
    m_Localized: Partyveranstalter
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957584
    m_Localized: "Hei\xDFer Stuhl"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957591
    m_Localized: Verdiene {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6549022957605
    m_Localized: Blueeyedrat Classic Light 2color 0
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957606
    m_Localized: Blueeyedrat Classic Light 2color 1
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957620
    m_Localized: Schwarz
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151881
    m_Localized: Einstellungen
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346192
    m_Localized: "Verbindung wird hergestellt\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346194
    m_Localized: Der Veranstalter hat das Spiel abgesagt.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346219
    m_Localized: Blocker
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346225
    m_Localized: "Zuf\xE4lliges Deck"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346235
    m_Localized: '{0} / {1} Decks im Besitz'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6549031346244
    m_Localized: Neu in der Galerie
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346247
    m_Localized: Einstellungen
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346250
    m_Localized: Hinweise
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346252
    m_Localized: Audio
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346255
    m_Localized: Credits
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346262
    m_Localized: "Fragen Sie, bevor Sie ung\xFCltige Karten wieder auf die Hand nehmen."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346266
    m_Localized: "Steuert, wie schnell die CPU-Spieler ihre Z\xFCge ausf\xFChren."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346268
    m_Localized: Sehr langsam
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346271
    m_Localized: Schnell
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346275
    m_Localized: Schnellvorlauftaste anzeigen
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346284
    m_Localized: "Kartengr\xF6\xDFe"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346292
    m_Localized: "Zeichne K\xE4stchen um die Mengen"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346300
    m_Localized: Hinweise
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346302
    m_Localized: "Hebt Spielkarten hervor, die bei einem rechtlichen Vorgehen hilfreich
      sein k\xF6nnten."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346312
    m_Localized: Audio
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540493
    m_Localized: "Kontofunktionen folgen sp\xE4ter"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540498
    m_Localized: "Mejnun wird mit zwei gemischten Standard-Kartenspielen \xE0 52
      Karten gespielt: insgesamt 104 Karten, ohne Joker. Gleiche Karten aus beiden
      Kartenspielen ergeben ein Paar. Gespielt wird mit 2\u20136 Spielern im Uhrzeigersinn
      (nach links)."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540509
    m_Localized: "Ziehen (oder Passen, wenn der Stapel leer ist) ist immer verf\xFCgbar.
      Dadurch wird das Spielbrett auf den Anfang deines Zuges zur\xFCckgesetzt, deine
      gespielten Karten werden auf die Hand zur\xFCckgenommen, du ziehst gegebenenfalls
      eine Karte und dein Zug endet. Zug beenden ist verf\xFCgbar, wenn das Spielbrett
      g\xFCltig ist und du eine Handkarte gespielt oder Karten abgelegt hast."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540510
    m_Localized: "\u201ER\xFCckg\xE4ngig\u201C f\xFChrt deine Z\xFCge r\xFCckg\xE4ngig;
      \u201EWiederherstellen\u201C wiederholt einen r\xFCckg\xE4ngig gemachten Zug
      im selben Zug. Neue Z\xFCge und Aktionen am Zugende setzen \u201EWiederherstellen\u201C
      zur\xFCck. \u201EBrett reparieren\u201C versucht, g\xFCltige Spielz\xFCge von
      deiner Hand fernzuhalten, w\xE4hrend das Brett repariert wird; Karten, die
      nicht verwendet werden k\xF6nnen, kehren auf deine Hand zur\xFCck. \u201EZur\xFCcksetzen\u201C
      stellt den Zustand des Bretts zu Beginn des Zuges wieder her und gibt deine
      gespielten Karten auf deine Hand zur\xFCck. Destruktive Aktionen fordern m\xF6glicherweise
      eine Best\xE4tigung an."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540515
    m_Localized: Credits
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540516
    m_Localized: Spieldesign & -entwicklung
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540517
    m_Localized: Hergestellt mit
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540521
    m_Localized: "R\xFCckg\xE4ngig machen"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540522
    m_Localized: Wiederholen
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540531
    m_Localized: Ziehen
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540541
    m_Localized: Du bist dran
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540547
    m_Localized: 'Zeit: {0}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6549035540549
    m_Localized: "Diese Option ist momentan nicht verf\xFCgbar."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540553
    m_Localized: "Diese Gruppe erf\xFCllt nicht die Voraussetzungen f\xFCr einen
      Abstieg."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540555
    m_Localized: "Dieses Set enth\xE4lt zu viele Karten."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540556
    m_Localized: "Diese Karte kann diesem Set nicht hinzugef\xFCgt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540573
    m_Localized: Spiel neu starten
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540574
    m_Localized: Einstellungen
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540591
    m_Localized: "Zuf\xE4lliger erster Spieler"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734784
    m_Localized: Neu in der Galerie
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734799
    m_Localized: 'Noch nicht entsperrt: {0}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6549039734801
    m_Localized: Zum Fortfahren tippen
    m_Metadata:
      m_Items: []
  - m_Id: 1341120512
    m_Localized: Mejnun
    m_Metadata:
      m_Items: []
  - m_Id: 695204831232
    m_Localized: "Automatisch (Ger\xE4tesprache)"
    m_Metadata:
      m_Items: []
  - m_Id: 1656669331456
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302976
    m_Localized: Stornieren
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302977
    m_Localized: "Zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302978
    m_Localized: "Schlie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302980
    m_Localized: Aus
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302981
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302983
    m_Localized: Weitermachen
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302984
    m_Localized: Erledigt
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302985
    m_Localized: Gesperrt
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302986
    m_Localized: "Laden\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6548909711360
    m_Localized: Willkommen bei Mejnun
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014528
    m_Localized: "Mejnun wird mit zwei vollst\xE4ndigen Kartenspielen gespielt: 104
      Karten. Jeder Spieler erh\xE4lt 11 Karten. Wer als Erster alle seine Karten
      auf den Tisch legt, gewinnt."
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014530
    m_Localized: "Die Karten werden in S\xE4tzen auf den Tisch gelegt. Ein Satz besteht
      aus drei oder vier Karten desselben Wertes, aber unterschiedlichen Farben.
      Eine Stra\xDFe besteht aus drei oder mehr Karten derselben Farbe in der richtigen
      Reihenfolge."
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014531
    m_Localized: '{0} ist an der Reihe'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548985208832
    m_Localized: '{0} geht zuerst. Beobachte, was sie tut.'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548985208833
    m_Localized: '{0} ist unten'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548985208834
    m_Localized: "{0} legte einen Satz ab, der nur aus ihren H\xE4nden bestand. Das
      nennt man Abw\xE4rtsgehen, und ein Satz gen\xFCgt."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548985208835
    m_Localized: Du bist noch nicht unten
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208836
    m_Localized: Du kannst den Tisch erst benutzen, wenn du unten bist. Lege zuerst
      einen Satz aus deiner Hand ab.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208839
    m_Localized: "Spiel weiter \u2013 lege alle drei Karten aus deiner Hand ab, um
      nach unten zu ziehen."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208840
    m_Localized: Du bist raus!
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208841
    m_Localized: "Jetzt steht Ihnen der gesamte Tisch zur Verf\xFCgung: Sie k\xF6nnen
      beliebige Sets erg\xE4nzen, neu anordnen oder teilen. Und Sie k\xF6nnen diesen
      Zug immer wieder spielen."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208842
    m_Localized: "Zu einem Set hinzuf\xFCgen"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208843
    m_Localized: "Setze nun dein A\u2660 auf {0}s J\u2660 Q\u2660 K\u2660."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548985208844
    m_Localized: Asse
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208845
    m_Localized: "Ein Ass kann niedrig (A-2-3) oder hoch (Q-K-A) sein, aber eine
      Stra\xDFe schlie\xDFt sich nie um (K-A-2)."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208846
    m_Localized: Gleiche Art
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208847
    m_Localized: "Lege 5\u2663 5\u2666 5\u2660 auf den leeren Tisch."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208848
    m_Localized: "Mach weiter \u2013 platziere alle drei Karten."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208849
    m_Localized: Doppel
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208850
    m_Localized: "Bei zwei Kartenspielen hat jede Karte ein Duplikat: dieselbe Farbe
      und denselben Wert, aber aus dem anderen Kartenspiel (die R\xFCckseite der
      Karte sieht anders aus). Ein Duplikat darf niemals in dasselbe Set geh\xF6ren."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208851
    m_Localized: Beende deinen Zug
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208852
    m_Localized: "Du kannst deinen Zug beenden, wenn alle auf dem Tisch liegenden
      Kartenpaare g\xFCltig sind und du mindestens eine Karte aus deiner Hand gespielt
      hast."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208853
    m_Localized: Beobachte {0}.
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548985208854
    m_Localized: Jedes Set ist erlaubt.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208855
    m_Localized: "{0} hat 10\u2665 J\u2665 zu deinen Herzen und 5\u2665 zu deinen
      F\xFCnfen hinzugef\xFCgt. Sobald du unten bist, kannst du zu jeder beliebigen
      Kombination auf dem Tisch etwas hinzuf\xFCgen."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548985208856
    m_Localized: Teile eine Gerade
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208857
    m_Localized: "Halten Sie die 10\u2665 gedr\xFCckt und ziehen Sie sie auf den
      leeren Tisch. Die 10\u2665 J\u2665 werden mitgeliefert."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208858
    m_Localized: Noch kein Set
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208859
    m_Localized: "10\u2665 J\u2665 hat einen roten Rand: Es ist kein g\xFCltiges
      Set. Das ist mitten im Zug kein Problem, aber du kannst deinen Zug erst beenden,
      wenn alle Sets g\xFCltig sind."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208860
    m_Localized: Benutze deinen Doppel
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208861
    m_Localized: "Lege deine 9\u2665 auf 10\u2665 J\u2665. Es ist das Doppelte der
      9\u2665 im anderen Set, also ist es hier erlaubt."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208863
    m_Localized: "Einen Fehler gemacht? Mach einen Schritt zur\xFCck. Probier's aus."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208865
    m_Localized: "\u201EWiederholen\u201C setzt den Zug zur\xFCck. \u201EZur\xFCcksetzen\u201C
      setzt den gesamten Zug zur\xFCck, und \u201EBrett reparieren\u201C versucht,
      das Spielbrett f\xFCr dich zu reparieren."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208866
    m_Localized: "Jeder Satz ist wieder g\xFCltig. Beende deinen Zug."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208867
    m_Localized: '{0} zeichnete'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548985208868
    m_Localized: '{0} konnte nicht spielen, also zog sie eine Karte. Durch das Ziehen
      einer Karte wird eine Karte vom Stapel genommen und der Zug endet.'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548985208869
    m_Localized: "Gr\xFCnde eine Gruppe"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208871
    m_Localized: "Mach weiter \u2013 platziere beide Karten vollst\xE4ndig."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208872
    m_Localized: Aus einem Set ausleihen
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208873
    m_Localized: "Ein Vierling funktioniert auch mit drei Karten. Ziehe die 5\u2665
      aus den F\xFCnfen auf 3\u2665 4\u2665."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208874
    m_Localized: "Alle S\xE4tze sind g\xFCltig. Beende deinen Zug."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208875
    m_Localized: "Nur noch eine Karte \xFCbrig!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208876
    m_Localized: "Wenn ein Spieler nur noch eine Karte hat, wackelt sein Stuhl und
      ein Ausrufezeichen erscheint \u2013 jeder kann sehen, dass er kurz vor dem
      Sieg steht."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208877
    m_Localized: Neue Sets
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208878
    m_Localized: "Spieler, die unten sind, k\xF6nnen auch brandneue Sets aus ihrer
      Hand beginnen."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208879
    m_Localized: Gesteckt
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208880
    m_Localized: "Dein A\u2665 passt nirgendwo auf den Tisch."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208883
    m_Localized: "{0} h\xE4ngt auch fest."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548985208884
    m_Localized: "Du hast die 2\u2665 gezogen."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208885
    m_Localized: "Setze die 2\u2665 auf 3\u2665 4\u2665 5\u2665."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208886
    m_Localized: Ace low
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208887
    m_Localized: "Jetzt passt das A\u2665 ganz nach unten: A-2-3-4-5\u2665. Spiele
      deine letzte Karte!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208888
    m_Localized: MEJNUN!
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208889
    m_Localized: Du hast deine Karten ausgespielt und gewonnen. Ein paar weitere
      Dinge sind gut zu wissen.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208890
    m_Localized: Gleiche Art
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208891
    m_Localized: Gerade
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208892
    m_Localized: "Gemischte Anz\xFCge"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208893
    m_Localized: Niedrig
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403136
    m_Localized: Keine Verpackung
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403137
    m_Localized: Ein Doppel
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403138
    m_Localized: Gleiches Set
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403139
    m_Localized: Leerer Ziehstapel
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403140
    m_Localized: "Wenn der Nachziehstapel leer ist, wird aus \u201EZiehen\u201C ein
      Pass. Passen alle Spieler nacheinander, gewinnt der Spieler mit den wenigsten
      Karten. Bei Gleichstand endet das Spiel unentschieden."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403141
    m_Localized: Zeitgesteuerte Runden
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403142
    m_Localized: "Bei Spielen mit Zeitbegrenzung z\xE4hlt eine Uhr in jeder Runde
      herunter. Wenn die Zeit abgelaufen ist \u2013 Hala! \u2013 endet der g\xFCltige
      Zug; andernfalls werden die Karten zur\xFCckgelegt und man zieht neue."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403143
    m_Localized: "Platine reparieren und zur\xFCcksetzen"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403144
    m_Localized: "\u201EFix board\u201C versucht, alle Spielz\xFCge g\xFCltig zu
      machen und deine Z\xFCge beizubehalten. \u201ERevert\u201C versetzt das gesamte
      Spielfeld in den Zustand zu Beginn deines Zuges zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403145
    m_Localized: Hinweise und die Tabelle
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403147
    m_Localized: "N\xE4chstes Spiel"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403149
    m_Localized: Layla
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403150
    m_Localized: Du
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403151
    m_Localized: Spieler {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403152
    m_Localized: Bot {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403153
    m_Localized: '{0} (Einfacher Bot)'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403154
    m_Localized: '{0} (Mittlerer Bot)'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403155
    m_Localized: '{0} (Schwieriger Bot)'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403156
    m_Localized: "Weiter zu {0} \u2014 tippen zum Anzeigen"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403157
    m_Localized: Patt
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403158
    m_Localized: '{0} gewinnt!'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403159
    m_Localized: Spiel vorbei
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403160
    m_Localized: "{0} leerten ihre H\xE4nde."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403161
    m_Localized: '{0} hatte die wenigsten Karten, als der Nachziehstapel aufgebraucht
      war.'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403162
    m_Localized: "Die Punktzahl mit den wenigsten Karten war gleich. W\xE4hle aus,
      wer beginnt."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403163
    m_Localized: Wer sollte zuerst gehen?
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403164
    m_Localized: Spiel pausiert
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403165
    m_Localized: Das Spiel wurde fortgesetzt.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403166
    m_Localized: Host hat die Verbindung getrennt
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403167
    m_Localized: '{0} verbunden'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403168
    m_Localized: '{0} getrennt'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403169
    m_Localized: Alle Spieler sind beigetreten
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403170
    m_Localized: '{0} ist nun der Host'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403172
    m_Localized: "Warten auf Spieler ({0}/{1})\u2026"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403174
    m_Localized: Ein Spieler hat die Verbindung getrennt
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403175
    m_Localized: "Warten Sie, bis sie es tun, lassen Sie einen Medium-Bot \xFCbernehmen
      oder speichern und pausieren Sie."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403176
    m_Localized: Warten / automatisch weiterleiten
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403177
    m_Localized: "Lasst die KI \xFCbernehmen"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403178
    m_Localized: Speichern und pausieren
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403179
    m_Localized: Spiel gespeichert und pausiert
    m_Metadata:
      m_Items: []
