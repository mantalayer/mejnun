    m_Localized: Tischkosmetik
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346187
    m_Localized: "W\xE4hlt zwei Kartenspiele und einen Tischfilz aus. Die Kartenauswahl
      eines Spielers wird f\xFCr das Spiel bestimmt."
    m_Metadata:
      m_Items: []
