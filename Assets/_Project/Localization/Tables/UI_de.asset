  - m_Id: 6549014568960
    m_Localized: Erstes Spiel
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568961
    m_Localized: "Schlie\xDFe dein erstes Spiel ab."
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568962
    m_Localized: Erster Sieg
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568963
    m_Localized: Gewinne dein erstes Spiel.
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568964
    m_Localized: Erste MEJNUN
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763264
    m_Localized: Gewinne, indem du deine Hand leerst.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763265
    m_Localized: Zehn Siege
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763266
    m_Localized: Gewinne 10 Spiele.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763267
    m_Localized: Besiege einen schwierigen Bot
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763268
    m_Localized: Besiege einen schwierigen Bot.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763269
    m_Localized: "Vollst\xE4ndige Tabelle"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763270
    m_Localized: Spielt ein Spiel mit sechs Sitzen.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763271
    m_Localized: "Regul\xE4r"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763273
    m_Localized: Veteran
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763274
    m_Localized: Spiele 250 Spiele.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763275
    m_Localized: "Gew\xFCrzt"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763277
    m_Localized: Meister von MEJNUN
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763278
    m_Localized: Gewinne 200 Spiele.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763279
    m_Localized: Level 10
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763280
    m_Localized: Erreiche Level 10.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763281
    m_Localized: Level 25
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763282
    m_Localized: Erreiche Level 25.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763283
    m_Localized: Level 50
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763284
    m_Localized: Erreiche Level 50.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763286
    m_Localized: "Schalte alle kostenlosen oder verdienbaren Deckfl\xE4chen und Filze
      frei."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763287
    m_Localized: "MEJNUN \xD710"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763288
    m_Localized: Gewinne 10 Spiele, indem du deine Handkarten leerst.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763289
    m_Localized: Saubere Reinigung
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763290
    m_Localized: Gehe in derselben Runde nach unten und leere deine Handkarten, wobei
      Hinweise und Fix Board deaktiviert sind.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763291
    m_Localized: Blitz
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763292
    m_Localized: "Gewinne innerhalb deiner ersten f\xFCnf Z\xFCge."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763293
    m_Localized: Letzter Atemzug
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763294
    m_Localized: "Gewinne, indem du deine Hand leerst, w\xE4hrend der Nachziehstapel
      leer ist."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763295
    m_Localized: "Komm zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763296
    m_Localized: Gewinne, sobald du 20 oder mehr Karten hast.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763297
    m_Localized: Bis zum Schluss
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763298
    m_Localized: Gewinne die Endwertung des Stapels mit genau einer Karte Vorsprung.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763300
    m_Localized: "Bilde eine vollst\xE4ndige Stra\xDFe mit 13 Karten vom Ass bis
      zum K\xF6nig."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763301
    m_Localized: Ace High
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763302
    m_Localized: "Vervollst\xE4ndige eine Stra\xDFe Dame-K\xF6nig-Ass."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763303
    m_Localized: "Gro\xDFer Eingang"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763304
    m_Localized: "Nimm mindestens drei S\xE4tze auf einmal."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763305
    m_Localized: Architekt
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763306
    m_Localized: Lege in einem Zug mindestens acht Handkarten ab.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763307
    m_Localized: Chirurg
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763309
    m_Localized: Geborgte Zeit
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763310
    m_Localized: Nimm eine Karte aus einem Set mit vier gleichartigen Karten und
      benutze sie.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763312
    m_Localized: Beende deinen Zug, indem du beide Exemplare einer Karte in getrennten
      Sets platzierst.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763314
    m_Localized: "Gewinnen, ohne die Funktionen \u201ER\xFCckg\xE4ngig\u201C, \u201EZur\xFCcksetzen\u201C
      oder \u201EBoard reparieren\u201C zu verwenden."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763315
    m_Localized: "Keine St\xFCtzr\xE4der"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763316
    m_Localized: Gewinne auch ohne Hinweise.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763317
    m_Localized: Halas!
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763318
    m_Localized: Lassen Sie Ihre Abschlagszeit ablaufen.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763319
    m_Localized: Cool unter Druck
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763320
    m_Localized: "Beende einen g\xFCltigen Abbiegevorgang mit weniger als drei verbleibenden
      Sekunden."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763321
    m_Localized: "Geschwindigkeitsd\xE4mon"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957568
    m_Localized: "Riesent\xF6ter"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957569
    m_Localized: "Gewinne gegen f\xFCnf starke Bots an einem vollen Tisch."
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957570
    m_Localized: Hattrick, Hat-Trick
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957572
    m_Localized: Unaufhaltsam
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957573
    m_Localized: "Gewinne f\xFCnf Spiele in Folge."
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957574
    m_Localized: Online gehen
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957575
    m_Localized: Beende ein Online-Spiel.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957576
    m_Localized: Publikumsliebling
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957577
    m_Localized: Gewinne ein Online-Spiel mit mindestens vier menschlichen Spielern.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957579
    m_Localized: Veranstalte 10 Online-Spiele.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957580
    m_Localized: Weitergeben
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957581
    m_Localized: "Schlie\xDFe ein Pass-and-Play-Spiel mit mindestens vier Personen
      ab."
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957582
    m_Localized: Sogar Steven
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957583
    m_Localized: Ein Spiel unentschieden beenden.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957585
    m_Localized: "Werde 10 Mal von der Frage als Erster ausgew\xE4hlt."
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957586
    m_Localized: eine Leistung
    m_Metadata:
      m_Items: []
