    m_Localized: Konto
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540494
    m_Localized: "Die Kontofunktionen sind noch nicht verf\xFCgbar."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540495
    m_Localized: '{0}%'
    m_Metadata:
      m_Items:
