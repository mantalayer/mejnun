  - m_Id: 6549031346218
    m_Localized: "Zur\xFCckhalten"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346220
    m_Localized: Mindestens ein Platz muss von einem menschlichen Spieler besetzt
      sein.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346221
    m_Localized: Tischkosmetik
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346222
    m_Localized: "W\xE4hlen Sie zwei Kartenspiele und einen Tischfilz. Klicken Sie
      auf eine Vorschau, um sie anzusehen."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346223
    m_Localized: Spiel starten
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346224
    m_Localized: Deck {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6549031346226
    m_Localized: Tischfilz
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346227
    m_Localized: "Zuf\xE4lliges Gef\xFChl"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346228
    m_Localized: "W\xE4hle Deck {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6549031346229
    m_Localized: "W\xE4hlen Sie Tischfilz"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346230
    m_Localized: Noch nicht freigeschaltet.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346231
    m_Localized: "Noch nicht entsperrt \u2014 {0}"
    m_Metadata:
