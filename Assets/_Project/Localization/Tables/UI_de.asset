  m_Metadata:
    m_Items:
    - rid: 4825848250703282616
  m_TableData:
  - m_Id: 1656690302979
    m_Localized: An
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302982
    m_Localized: NEIN
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014529
    m_Localized: Sets
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208837
    m_Localized: Geh zuerst runter
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208838
    m_Localized: "Solange du nicht unten bist, kannst du nur Sets aus deiner eigenen
      Hand spielen. Lege 7\u2665 8\u2665 9\u2665 auf den leeren Tisch."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208862
    m_Localized: "R\xFCckg\xE4ngig machen"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208864
    m_Localized: Wiederholen
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208870
    m_Localized: "Lege 3\u2665 4\u2665 auf den leeren Tisch. Es sind nur zwei Karten,
      also wird vorerst Rot angezeigt."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208881
    m_Localized: Ziehen
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208882
    m_Localized: "Tippe auf \u201EZiehen\u201C, um eine Karte zu nehmen und deinen
      Zug zu beenden. Durch das Ziehen erh\xE4ltst du auch alle Karten zur\xFCck,
      die du in diesem Zug gelegt hast."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208894
    m_Localized: Hoch
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403146
    m_Localized: Hinweise zeigen die ausspielbaren Karten an. Zum Zoomen mit zwei
      Fingern, zum Verschieben mit der Ziehgeste und zum Anpassen an die gesamte
      Tabelle verwenden.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403148
    m_Localized: "Der Gewinner beginnt das n\xE4chste Spiel."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403171
    m_Localized: Ein Spieler ist nun der Gastgeber
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403173
    m_Localized: "Warte auf Spieler ({0}/{1})\u2026\nRaumcode: {2}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282616
  - m_Id: 6548989403180
    m_Localized: Der Gastgeber kann diese Sitzung fortsetzen, sobald alle bereit
      sind.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403181
    m_Localized: "Lebenslauf-\xDCbereinstimmung"
    m_Metadata:
      m_Items: []
