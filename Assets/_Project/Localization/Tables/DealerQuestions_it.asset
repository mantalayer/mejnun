%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DealerQuestions_it
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 87a4643bee3d747fb9ab730fc39509cd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6547924049920
    m_Localized: "Chi \xE8 pi\xF9 propenso a dimenticare il motivo per cui \xE8 entrato
      in una stanza?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244224
    m_Localized: Chi racconta le barzellette peggiori?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244225
    m_Localized: Chi sarebbe il primo a ballare a un matrimonio?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244226
    m_Localized: "Chi ha la galleria fotografica pi\xF9 caotica sul telefono?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244227
    m_Localized: "Chi sopravvivrebbe pi\xF9 a lungo su un'isola deserta?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244228
    m_Localized: "Chi \xE8 pi\xF9 propenso a lanciare accidentalmente una nuova tendenza?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244229
    m_Localized: "Chi compie gli anni pi\xF9 vicino a oggi?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244230
    m_Localized: "Chi ha fatto la doccia pi\xF9 di recente?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276106395648
    m_Localized: "Chi \xE8 pi\xF9 propenso a mettere in scena uno spettacolo di drag
      queen?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561472
    m_Localized: "Chi ha i capelli pi\xF9 ricci (e quindi pi\xF9 belli)?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561473
    m_Localized: "Chi \xE8 il pi\xF9 schizzinoso a tavola?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561474
    m_Localized: "Chi \xE8 pi\xF9 propenso a dare uno schiaffo a qualcuno per aver
      dato uno schiaffo?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561475
    m_Localized: "Chi \xE8 capace di sollevare pesi, amico?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561476
    m_Localized: Chi riesce a tenere meglio il ritmo?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561477
    m_Localized: Chi riesce a contare il maggior numero di cifre del pi greco? Mmm,
      torta...
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561478
    m_Localized: Se foste bloccati su un'isola deserta con solo uno scoiattolo e
      due stuzzicadenti... Chi catturerebbe lo scoiattolo, o qualcos'altro?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561479
    m_Localized: "Chi \xE8 il pi\xF9 esperto nel contare i fagioli?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561480
    m_Localized: "Chi \xE8 il pi\xF9 pettegolo?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561481
    m_Localized: "Chi ha i rutti pi\xF9 maleodoranti?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561482
    m_Localized: "Chi \xE8 il pi\xF9 bravo a indovinare il peso delle persone?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561483
    m_Localized: "Chi sapr\xE0 costruire il miglior trabucco?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561484
    m_Localized: "Chi \xE8 il miglior cuoco?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561485
    m_Localized: "Chi brucia pi\xF9 cibo mentre cucina?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561486
    m_Localized: Chi ha la circonferenza cranica maggiore?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561487
    m_Localized: "Chi \xE8 pi\xF9 propenso a dimenticare il telefono in frigorifero?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561488
    m_Localized: "Chi \xE8 pi\xF9 propenso a dimenticare il telecomando nel congelatore?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561489
    m_Localized: "Chi suona pi\xF9 strumenti?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561490
    m_Localized: "Chi \xE8 il peggiore a suonare uno strumento?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561491
    m_Localized: "Chi impiegherebbe pi\xF9 tempo a costruire un mobile?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561492
    m_Localized: "Chi \xE8 il pi\xF9 ossessionato dai gatti?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561493
    m_Localized: "Chi \xE8 il pi\xF9 ossessionato dai cani?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561494
    m_Localized: "Chi sente di pi\xF9 l'odore delle bacche di sambuco?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561495
    m_Localized: A chi piace il blu come colore preferito?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561496
    m_Localized: "Chi ha pi\xF9 probabilit\xE0 di combattere contro un orso (e vincere)?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561497
    m_Localized: "Chi perde di pi\xF9 a Las Vegas?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561498
    m_Localized: "Chi sa cos'\xE8 una doccia \"tutto\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561499
    m_Localized: "Chi \xE8 la persona che passa pi\xF9 tempo online in modo cronico?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561500
    m_Localized: Presto, sto pensando a un numero tra 81 e 976! Chi ha indovinato
      222?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561501
    m_Localized: "Chi \xE8 pi\xF9 propenso ad arrabbiarsi durante una partita?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561502
    m_Localized: "Chi \xE8 il pi\xF9 competitivo?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561503
    m_Localized: "Chi ha pi\xF9 voglia di andare per primo?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561504
    m_Localized: Chi ha meno voglia di andare per primo?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561505
    m_Localized: Combattimento! Chi ha vinto?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561506
    m_Localized: Chi non vorrebbe andarci affatto?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561507
    m_Localized: Chi non ama il colore viola?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561508
    m_Localized: "Chi ha pi\xF9 capelli grigi?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561509
    m_Localized: Chi ha meno peli? Intendo i peli del corpo.
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561510
    m_Localized: Chi ha lavato i piatti per ultimo?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561511
    m_Localized: "Chi possiede la pi\xF9 grande collezione di videogiochi?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561512
    m_Localized: "Chi \xE8 in grado di spiegare al meglio la teoria quantistica?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561513
    m_Localized: Chi ha la vista migliore?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561514
    m_Localized: "Chi parla pi\xF9 lingue?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561515
    m_Localized: "Chi ha pi\xF9 gatti?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561516
    m_Localized: Chi sa mettere a punto un carburatore?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561517
    m_Localized: "Chi ha visitato pi\xF9 paesi?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561518
    m_Localized: "Chi riesce a correre pi\xF9 lontano? Mettetevi alla prova prima
      della partita!"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561519
    m_Localized: Chi mai dirotterebbe il carrello per cinque persone?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561520
    m_Localized: Inventa una domanda, ma non dire che te l'ho chiesto io...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
