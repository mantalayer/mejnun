  m_TableData:
  - m_Id: 6547924049920
    m_Localized: "\u041A\u0442\u043E \u0441 \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0435\u0439
      \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E \u0437\u0430\u0431\u0443\u0434\u0435\u0442,
      \u0437\u0430\u0447\u0435\u043C \u043E\u043D \u0432\u043E\u0448\u0435\u043B
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244224
    m_Localized: "\u041A\u0442\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0441\u0430\u043C\u044B\u0435 \u0443\u0436\u0430\u0441\u043D\u044B\u0435 \u0430\u043D\u0435\u043A\u0434\u043E\u0442\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244225
    m_Localized: "\u041A\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u043C \u0441\u0442\u0430\u043D\u0446\u0443\u0435\u0442
      \u043D\u0430 \u0441\u0432\u0430\u0434\u044C\u0431\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244226
    m_Localized: "\u0423 \u043A\u043E\u0433\u043E \u0441\u0430\u043C\u0430\u044F
      \u0445\u0430\u043E\u0442\u0438\u0447\u043D\u0430\u044F \u0433\u0430\u043B\u0435\u0440\u0435\u044F
      \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0439 \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244227
    m_Localized: "\u041A\u0442\u043E \u0434\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0445
      \u0432\u044B\u0436\u0438\u0432\u0435\u0442 \u043D\u0430 \u043D\u0435\u043E\u0431\u0438\u0442\u0430\u0435\u043C\u043E\u043C
      \u043E\u0441\u0442\u0440\u043E\u0432\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244228
    m_Localized: "\u041A\u0442\u043E \u0441 \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0435\u0439
      \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E \u043C\u043E\u0436\u0435\u0442
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0442\u0440\u0435\u043D\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244229
    m_Localized: "\u0423 \u043A\u043E\u0433\u043E \u0438\u0437 \u0432\u0430\u0441
      \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u0431\u043B\u0438\u0436\u0435
      \u0432\u0441\u0435\u0433\u043E \u043A \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u043C\u0443
      \u0434\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244230
    m_Localized: "\u041A\u0442\u043E \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u043B
      \u0434\u0443\u0448 \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u0434\u0430\u0432\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276106395648
    m_Localized: "\u041A\u0442\u043E \u0441 \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0435\u0439
      \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E \u0443\u0441\u0442\u0440\u043E\u0438\u0442
      \u0442\u0440\u0430\u0432\u0435\u0441\u0442\u0438-\u0448\u043E\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561472
    m_Localized: "\u0423 \u043A\u043E\u0433\u043E \u0441\u0430\u043C\u044B\u0435
      \u043A\u0443\u0434\u0440\u044F\u0432\u044B\u0435 \u0432\u043E\u043B\u043E\u0441\u044B
      (\u0438, \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0441\u0430\u043C\u044B\u0435 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0435)?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561473
    m_Localized: "\u041A\u0442\u043E \u0441\u0430\u043C\u044B\u0439 \u043F\u0440\u0438\u0432\u0435\u0440\u0435\u0434\u043B\u0438\u0432\u044B\u0439
      \u0432 \u0435\u0434\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561474
    m_Localized: "\u041A\u0442\u043E \u0441 \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0435\u0439
      \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E \u0443\u0434\u0430\u0440\u0438\u0442
      \u043A\u043E\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0437\u0430
      \u0442\u043E, \u0447\u0442\u043E \u0442\u043E\u0442 \u0443\u0434\u0430\u0440\u0438\u043B
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561475
    m_Localized: "\u0410 \u043A\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435
      \u0443\u043C\u0435\u0435\u0442 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C
      \u0442\u044F\u0436\u0435\u0441\u0442\u0438, \u0447\u0443\u0432\u0430\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561476
    m_Localized: "\u041A\u0442\u043E \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0445
      \u0443\u043C\u0435\u0435\u0442 \u043E\u0442\u0431\u0438\u0432\u0430\u0442\u044C
      \u0440\u0438\u0442\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561477
    m_Localized: "\u041A\u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u0441\u0447\u0438\u0442\u0430\u0442\u044C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0433\u043E \u0446\u0438\u0444\u0440
      \u0447\u0438\u0441\u043B\u0430 \u043F\u0438? \u041C\u043C\u043C, \u043F\u0438\u0440\u043E\u0433..."
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561478
    m_Localized: "\u0415\u0441\u043B\u0438 \u0431\u044B \u0432\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u043D\u0435\u043E\u0431\u0438\u0442\u0430\u0435\u043C\u043E\u043C
      \u043E\u0441\u0442\u0440\u043E\u0432\u0435, \u0438\u043C\u0435\u044F \u043F\u0440\u0438
      \u0441\u0435\u0431\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u0435\u043B\u043A\u0443
      \u0438 \u0434\u0432\u0435 \u0437\u0443\u0431\u043E\u0447\u0438\u0441\u0442\u043A\u0438...
      \u041A\u0442\u043E \u0431\u044B \u043F\u043E\u0439\u043C\u0430\u043B \u0431\u0435\u043B\u043A\u0443
      \u0438\u043B\u0438 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0435\u0449\u0451?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561479
    m_Localized: "\u041A\u0442\u043E \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
      \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043E\u043F\u044B\u0442\u043E\u043C
      \u0432 \u043F\u043E\u0434\u0441\u0447\u0435\u0442\u0435 \u0446\u0438\u0444\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561480
    m_Localized: "\u041A\u0442\u043E \u0441\u043F\u043B\u0435\u0442\u043D\u0438\u0447\u0430\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561481
    m_Localized: "\u0423 \u043A\u043E\u0433\u043E \u0441\u0430\u043C\u0430\u044F
      \u0432\u043E\u043D\u044E\u0447\u0430\u044F \u043E\u0442\u0440\u044B\u0436\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561482
    m_Localized: "\u041A\u0442\u043E \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0445
      \u0443\u043C\u0435\u0435\u0442 \u0443\u0433\u0430\u0434\u044B\u0432\u0430\u0442\u044C
      \u0432\u0435\u0441 \u043B\u044E\u0434\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561483
    m_Localized: "\u041A\u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u043B\u0443\u0447\u0448\u0443\u044E \u0442\u0440\u0435\u0431\u0443\u0448\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561484
    m_Localized: "\u041A\u0442\u043E \u043B\u0443\u0447\u0448\u0438\u0439 \u043F\u043E\u0432\u0430\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561485
    m_Localized: "\u041A\u0442\u043E \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E
      \u0441\u0436\u0438\u0433\u0430\u0435\u0442 \u0435\u0434\u0443 \u0432\u043E
      \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0442\u043E\u0432\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561486
    m_Localized: "\u0423 \u043A\u043E\u0433\u043E \u0441\u0430\u043C\u044B\u0439
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043E\u0431\u0445\u0432\u0430\u0442
      \u0433\u043E\u043B\u043E\u0432\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561487
    m_Localized: "\u041A\u0442\u043E \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E
      \u0437\u0430\u0431\u044B\u0432\u0430\u0435\u0442 \u0441\u0432\u043E\u0439 \u0442\u0435\u043B\u0435\u0444\u043E\u043D
      \u0432 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561488
    m_Localized: "\u041A\u0442\u043E \u0441 \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0435\u0439
      \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u0441\u0442\u0430\u0432\u0438\u0442
      \u043F\u0443\u043B\u044C\u0442 \u0432 \u043C\u043E\u0440\u043E\u0437\u0438\u043B\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561489
    m_Localized: "\u041A\u0442\u043E \u0438\u0433\u0440\u0430\u0435\u0442 \u043D\u0430
      \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0435\u043C \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561490
    m_Localized: "\u041A\u0442\u043E \u0445\u0443\u0436\u0435 \u0432\u0441\u0435\u0445
      \u0438\u0433\u0440\u0430\u0435\u0442 \u043D\u0430 \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u043E\u043C
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561491
    m_Localized: "\u041A\u043E\u043C\u0443 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043C\u0435\u0431\u0435\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561492
    m_Localized: "\u041A\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0445
      \u043F\u043E\u043C\u0435\u0448\u0430\u043D \u043D\u0430 \u043A\u043E\u0448\u043A\u0430\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561493
    m_Localized: "\u041A\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0445
      \u043F\u043E\u043C\u0435\u0448\u0430\u043D \u043D\u0430 \u0441\u043E\u0431\u0430\u043A\u0430\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561494
    m_Localized: "\u0423 \u043A\u043E\u0433\u043E \u0441\u0438\u043B\u044C\u043D\u0435\u0435
      \u0432\u0441\u0435\u0433\u043E \u043F\u0430\u0445\u043D\u0435\u0442 \u0431\u0443\u0437\u0438\u043D\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561495
    m_Localized: "\u0427\u0435\u0439 \u043B\u044E\u0431\u0438\u043C\u044B\u0439 \u0446\u0432\u0435\u0442
      \u2014 \u0441\u0438\u043D\u0438\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561496
    m_Localized: "\u041A\u0442\u043E \u0441 \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0435\u0439
      \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u043C\u043E\u0436\u0435\u0442
      \u0441\u0440\u0430\u0437\u0438\u0442\u044C\u0441\u044F \u0441 \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u043C
      (\u0438 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C)?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561497
    m_Localized: "\u041A\u0442\u043E \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E
      \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442 \u0432 \u0412\u0435\u0433\u0430\u0441\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561498
    m_Localized: "\u041A\u0442\u043E \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E
      \u0442\u0430\u043A\u043E\u0435 \u0434\u0443\u0448, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0435\u0441\u0442\u044C \u0432\u0441\u0451?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561499
    m_Localized: "\u041A\u0442\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0441\u0430\u043C\u044B\u043C \u0437\u0430\u044F\u0434\u043B\u044B\u043C \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C
      \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561500
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u043E, \u044F \u0437\u0430\u0433\u0430\u0434\u0430\u043B
      \u0447\u0438\u0441\u043B\u043E \u043E\u0442 81 \u0434\u043E 976! \u0410 \u043A\u0442\u043E
      \u0443\u0433\u0430\u0434\u0430\u043B 222?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561501
    m_Localized: "\u041A\u0442\u043E \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437 \u0441\u0435\u0431\u044F
      \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0438\u0433\u0440\u044B?"
    m_Metadata:
