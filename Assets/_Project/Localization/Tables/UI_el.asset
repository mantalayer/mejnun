  - m_Id: 1656690302983
    m_Localized: "\u03A3\u03C5\u03BD\u03B5\u03C7\u03AF\u03B6\u03C9"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302984
    m_Localized: "\u0393\u03B9\u03BD\u03CE\u03BC\u03B5\u03BD\u03BF\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302985
    m_Localized: "\u039A\u03BB\u03B5\u03B9\u03B4\u03C9\u03BC\u03AD\u03BD\u03BF"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302986
    m_Localized: "\u03A6\u03CC\u03C1\u03C4\u03C9\u03C3\u03B7\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6548909711360
    m_Localized: "\u039A\u03B1\u03BB\u03CE\u03C2 \u03BF\u03C1\u03AF\u03C3\u03B1\u03C4\u03B5
      \u03C3\u03C4\u03BF \u039C\u03B5\u03C4\u03B6\u03BD\u03BF\u03CD\u03BD"
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014528
    m_Localized: "\u03A4\u03BF Mejnun \u03C0\u03B1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B4\u03CD\u03BF \u03C0\u03BB\u03AE\u03C1\u03B5\u03B9\u03C2
      \u03C4\u03C1\u03AC\u03C0\u03BF\u03C5\u03BB\u03B5\u03C2: 104 \u03C6\u03CD\u03BB\u03BB\u03B1.
      \u03A3\u03B5 \u03CC\u03BB\u03BF\u03C5\u03C2 \u03BC\u03BF\u03B9\u03C1\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      11. \u0393\u03AF\u03BD\u03B5\u03C4\u03B5 \u03BF \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03B8\u03B1 \u03B1\u03B4\u03B5\u03B9\u03AC\u03C3\u03B5\u03B9
      \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9 \u03C3\u03B1\u03C2 \u03C3\u03C4\u03BF
      \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9 \u03B3\u03B9\u03B1 \u03BD\u03B1
      \u03BA\u03B5\u03C1\u03B4\u03AF\u03C3\u03B5\u03C4\u03B5."
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014529
    m_Localized: "\u03A3\u03BA\u03B7\u03BD\u03B9\u03BA\u03AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014530
    m_Localized: "\u03A4\u03B1 \u03C6\u03CD\u03BB\u03BB\u03B1 \u03BC\u03C0\u03B1\u03AF\u03BD\u03BF\u03C5\u03BD
      \u03C3\u03C4\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9 \u03C3\u03B5
      \u03C3\u03B5\u03C4. \u038A\u03B4\u03B9\u03BF \u03B5\u03AF\u03B4\u03BF\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 3 \u03AE 4 \u03C6\u03CD\u03BB\u03BB\u03B1 \u03C4\u03B7\u03C2
      \u03AF\u03B4\u03B9\u03B1\u03C2 \u03B1\u03BE\u03AF\u03B1\u03C2, \u03CC\u03BB\u03B1
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03BF\u03CD \u03C7\u03C1\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2.
      \u039A\u03AD\u03BD\u03C4\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 3 \u03AE \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1
      \u03C6\u03CD\u03BB\u03BB\u03B1 \u03C4\u03B7\u03C2 \u03AF\u03B4\u03B9\u03B1\u03C2
      \u03C0\u03BF\u03B9\u03BA\u03B9\u03BB\u03AF\u03B1\u03C2, \u03BC\u03B5 \u03C4\u03B7
      \u03C3\u03B5\u03B9\u03C1\u03AC."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208835
    m_Localized: "\u0394\u03B5\u03BD \u03B5\u03AF\u03C3\u03B1\u03B9 \u03B1\u03BA\u03CC\u03BC\u03B1
      \u03BA\u03AC\u03C4\u03C9"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208836
    m_Localized: "\u0394\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2 \u03BD\u03B1
      \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9 \u03BC\u03AD\u03C7\u03C1\u03B9
      \u03BD\u03B1 \u03C7\u03AC\u03C3\u03B5\u03B9\u03C2 \u03C4\u03BF\u03BD \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF.
      \u03A0\u03C1\u03CE\u03C4\u03B1, \u03AC\u03C6\u03B7\u03C3\u03B5 \u03BA\u03AC\u03C4\u03C9
      \u03AD\u03BD\u03B1 \u03C3\u03B5\u03C4 \u03B1\u03C0\u03CC \u03C4\u03BF \u03AF\u03B4\u03B9\u03BF
      \u03C3\u03BF\u03C5 \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208837
    m_Localized: "\u03A0\u03AE\u03B3\u03B1\u03B9\u03BD\u03B5 \u03C0\u03C1\u03CE\u03C4\u03B1
      \u03BA\u03AC\u03C4\u03C9"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208838
    m_Localized: "\u039C\u03AD\u03C7\u03C1\u03B9 \u03BD\u03B1 \u03B5\u03AF\u03C3\u03B1\u03B9
      Down, \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2 \u03BD\u03B1 \u03C0\u03B1\u03AF\u03BE\u03B5\u03B9\u03C2
      \u03BC\u03CC\u03BD\u03BF \u03C3\u03B5\u03C4 \u03B1\u03C0\u03CC \u03C4\u03BF
      \u03B4\u03B9\u03BA\u03CC \u03C3\u03BF\u03C5 \u03C7\u03AD\u03C1\u03B9. \u0392\u03AC\u03BB\u03B5
      7\u2665 8\u2665 9\u2665 \u03C3\u03C4\u03BF \u03AC\u03B4\u03B5\u03B9\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208839
    m_Localized: "\u03A3\u03C5\u03BD\u03AD\u03C7\u03B9\u03C3\u03B5\u2014\u03BF\u03BB\u03BF\u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B5
      \u03C4\u03B7\u03BD \u03C4\u03BF\u03C0\u03BF\u03B8\u03AD\u03C4\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03C9\u03BD \u03C4\u03C1\u03B9\u03CE\u03BD \u03BA\u03B1\u03C1\u03C4\u03CE\u03BD
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9 \u03C3\u03BF\u03C5
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C0\u03B1\u03C2 \u039A\u03AC\u03C4\u03C9."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208840
    m_Localized: "\u0395\u03AF\u03C3\u03B1\u03B9 \u03BA\u03AC\u03C4\u03C9!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208841
    m_Localized: "\u03A4\u03CE\u03C1\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03BF
      \u03C4\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B4\u03B9\u03BA\u03CC \u03C3\u03B1\u03C2 \u03B3\u03B9\u03B1 \u03BD\u03B1
      \u03C4\u03BF \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C4\u03B5:
      \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03C4\u03B5 \u03C4\u03BF \u03C3\u03B5
      \u03BF\u03C0\u03BF\u03B9\u03BF\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5 \u03C3\u03B5\u03C4,
      \u03B1\u03BD\u03B1\u03B4\u03B9\u03B1\u03C4\u03AC\u03BE\u03C4\u03B5 \u03C4\u03BF,
      \u03C7\u03C9\u03C1\u03AF\u03C3\u03C4\u03B5 \u03C4\u03BF. \u039A\u03B1\u03B9
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B5\u03C7\u03AF\u03C3\u03B5\u03C4\u03B5
      \u03BD\u03B1 \u03C0\u03B1\u03AF\u03B6\u03B5\u03C4\u03B5 \u03C3\u03C4\u03BF\u03BD
      \u03AF\u03B4\u03B9\u03BF \u03B3\u03CD\u03C1\u03BF."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208842
    m_Localized: "\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u03C3\u03B5 \u03AD\u03BD\u03B1
      \u03C3\u03CD\u03BD\u03BF\u03BB\u03BF"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208844
    m_Localized: "\u0386\u03C3\u03C3\u03BF\u03B9"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208845
    m_Localized: "\u0388\u03BD\u03B1\u03C2 \u03AC\u03C3\u03C3\u03BF\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C7\u03B1\u03BC\u03B7\u03BB\u03CC\u03C2
      (A-2-3) \u03AE \u03C5\u03C8\u03B7\u03BB\u03CC\u03C2 (Q-K-A), \u03B1\u03BB\u03BB\u03AC
      \u03BC\u03B9\u03B1 \u03BA\u03AD\u03BD\u03C4\u03B1 \u03B4\u03B5\u03BD \u03C4\u03C5\u03BB\u03AF\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03C0\u03BF\u03C4\u03AD \u03B3\u03CD\u03C1\u03C9 \u03B1\u03C0\u03CC (K-A-2)."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208846
    m_Localized: "\u038A\u03B4\u03B9\u03BF \u03B5\u03AF\u03B4\u03BF\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208847
    m_Localized: "\u0392\u03AC\u03BB\u03B5 5\u2663 5\u2666 5\u2660 \u03C3\u03C4\u03BF
      \u03AC\u03B4\u03B5\u03B9\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208848
    m_Localized: "\u03A3\u03C5\u03BD\u03B5\u03C7\u03AF\u03C3\u03C4\u03B5\u2014\u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03CE\u03C3\u03C4\u03B5
      \u03C4\u03B7\u03BD \u03C4\u03BF\u03C0\u03BF\u03B8\u03AD\u03C4\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03C9\u03BD \u03C4\u03C1\u03B9\u03CE\u03BD \u03BA\u03B1\u03C1\u03C4\u03CE\u03BD."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208849
    m_Localized: "\u0394\u03B9\u03C0\u03BB\u03AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208850
    m_Localized: "\u039C\u03B5 \u03B4\u03CD\u03BF \u03C4\u03C1\u03AC\u03C0\u03BF\u03C5\u03BB\u03B5\u03C2,
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03CD\u03BB\u03BB\u03BF \u03AD\u03C7\u03B5\u03B9
      \u03AD\u03BD\u03B1 \u03B4\u03B9\u03C0\u03BB\u03CC: \u03AF\u03B4\u03B9\u03BF
      \u03C7\u03C1\u03CE\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BA\u03B1\u03C4\u03AC\u03C4\u03B1\u03BE\u03B7,
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03AC\u03BB\u03BB\u03B7 \u03C4\u03C1\u03AC\u03C0\u03BF\u03C5\u03BB\u03B1
      (\u03C4\u03BF \u03C0\u03AF\u03C3\u03C9 \u03BC\u03AD\u03C1\u03BF\u03C2 \u03C4\u03BF\u03C5
      \u03C6\u03CD\u03BB\u03BB\u03BF\u03C5 \u03C4\u03B7\u03C2 \u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03CC). \u0388\u03BD\u03B1
      \u03B4\u03B9\u03C0\u03BB\u03CC \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03C0\u03BF\u03C4\u03AD \u03BD\u03B1 \u03BC\u03C0\u03B5\u03B9 \u03C3\u03C4\u03BF
      \u03AF\u03B4\u03B9\u03BF \u03C3\u03B5\u03C4."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208851
    m_Localized: "\u03A4\u03B5\u03C1\u03BC\u03B1\u03C4\u03AF\u03C3\u03C4\u03B5 \u03C4\u03B7
      \u03C3\u03B5\u03B9\u03C1\u03AC \u03C3\u03B1\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208852
    m_Localized: "\u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C4\u03B5\u03C1\u03BC\u03B1\u03C4\u03AF\u03C3\u03B5\u03C4\u03B5
      \u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC \u03C3\u03B1\u03C2 \u03CC\u03C4\u03B1\u03BD
      \u03CC\u03BB\u03B1 \u03C4\u03B1 \u03C3\u03B5\u03C4 \u03C3\u03C4\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03B3\u03BA\u03C5\u03C1\u03B1 \u03BA\u03B1\u03B9
      \u03AD\u03C7\u03B5\u03C4\u03B5 \u03C0\u03B1\u03AF\u03BE\u03B5\u03B9 \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD
      \u03BC\u03AF\u03B1 \u03BA\u03AC\u03C1\u03C4\u03B1 \u03B1\u03C0\u03CC \u03C4\u03BF
      \u03C7\u03AD\u03C1\u03B9 \u03C3\u03B1\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208854
    m_Localized: "\u039F\u03C0\u03BF\u03B9\u03BF\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5
      \u03C3\u03B5\u03C4 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03AF\u03BA\u03B1\u03B9\u03BF
      \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208856
    m_Localized: "\u03A7\u03C9\u03C1\u03AF\u03C3\u03C4\u03B5 \u03BC\u03B9\u03B1 \u03B5\u03C5\u03B8\u03B5\u03AF\u03B1"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208857
    m_Localized: "\u03A0\u03B1\u03C4\u03AE\u03C3\u03C4\u03B5 \u03C0\u03B1\u03C1\u03B1\u03C4\u03B5\u03C4\u03B1\u03BC\u03AD\u03BD\u03B1
      \u03C4\u03BF 10\u2665 \u03BA\u03B1\u03B9 \u03C3\u03CD\u03C1\u03B5\u03C4\u03AD
      \u03C4\u03BF \u03C3\u03C4\u03BF \u03AC\u03B4\u03B5\u03B9\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9.
      \u03A4\u03BF 10\u2665 J\u2665 \u03C4\u03BF \u03C3\u03C5\u03BD\u03BF\u03B4\u03B5\u03CD\u03B5\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208858
    m_Localized: "\u0394\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03BF\u03C1\u03B9\u03C3\u03C4\u03B5\u03AF
      \u03B1\u03BA\u03CC\u03BC\u03B1"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208859
    m_Localized: "10\u2665 \u03A4\u03BF J\u2665 \u03AD\u03C7\u03B5\u03B9 \u03BA\u03CC\u03BA\u03BA\u03B9\u03BD\u03BF
      \u03C0\u03B5\u03C1\u03AF\u03B3\u03C1\u03B1\u03BC\u03BC\u03B1: \u03B4\u03B5\u03BD
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03B3\u03BA\u03C5\u03C1\u03BF \u03C3\u03B5\u03C4.
      \u0391\u03C5\u03C4\u03CC \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03C4\u03AC\u03BE\u03B5\u03B9
      \u03C3\u03C4\u03B7 \u03BC\u03AD\u03C3\u03B7 \u03B5\u03BD\u03CC\u03C2 \u03B3\u03CD\u03C1\u03BF\u03C5,
      \u03B1\u03BB\u03BB\u03AC \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5
      \u03BD\u03B1 \u03C4\u03B5\u03C1\u03BC\u03B1\u03C4\u03AF\u03C3\u03B5\u03C4\u03B5
      \u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC \u03C3\u03B1\u03C2 \u03BC\u03AD\u03C7\u03C1\u03B9
      \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03B3\u03BA\u03C5\u03C1\u03B1
      \u03CC\u03BB\u03B1 \u03C4\u03B1 \u03C3\u03B5\u03C4."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208860
    m_Localized: "\u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03C4\u03B5
      \u03C4\u03BF \u03B4\u03B9\u03C0\u03BB\u03CC \u03C3\u03B1\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208861
    m_Localized: "\u0392\u03AC\u03BB\u03B5 \u03C4\u03BF 9\u2665 \u03C3\u03BF\u03C5
      \u03C3\u03C4\u03BF 10\u2665 J\u2665. \u0395\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF
      \u03B4\u03B9\u03C0\u03BB\u03AC\u03C3\u03B9\u03BF \u03C4\u03BF\u03C5 9\u2665
      \u03C3\u03C4\u03BF \u03AC\u03BB\u03BB\u03BF \u03C3\u03B5\u03C4, \u03AC\u03C1\u03B1
      \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03C4\u03B1\u03B9 \u03B5\u03B4\u03CE."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208862
    m_Localized: "\u039E\u03B5\u03BA\u03AC\u03BD\u03C9"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208863
    m_Localized: "\u039A\u03AC\u03BD\u03B1\u03C4\u03B5 \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF
      \u03BB\u03AC\u03B8\u03BF\u03C2; \u0391\u03BD\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7
      \u03B2\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B1
      \u03C0\u03AF\u03C3\u03C9 \u03BA\u03B1\u03C4\u03AC \u03BC\u03AF\u03B1 \u03BA\u03AF\u03BD\u03B7\u03C3\u03B7.
      \u0394\u03BF\u03BA\u03B9\u03BC\u03AC\u03C3\u03C4\u03B5 \u03C4\u03BF."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208864
    m_Localized: "\u039E\u03B1\u03BD\u03B1\u03BA\u03AC\u03BD\u03C9"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208865
    m_Localized: "\u0397 \u0395\u03C0\u03B1\u03BD\u03AC\u03BB\u03B7\u03C8\u03B7 \u03B5\u03C0\u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03BA\u03AF\u03BD\u03B7\u03C3\u03B7. \u0397 \u0395\u03C0\u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC
      \u03BC\u03B7\u03B4\u03B5\u03BD\u03AF\u03B6\u03B5\u03B9 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03BF
      \u03C4\u03BF\u03BD \u03B3\u03CD\u03C1\u03BF \u03BA\u03B1\u03B9 \u03C4\u03BF
      \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC \u0394\u03B9\u03CC\u03C1\u03B8\u03C9\u03C3\u03B7\u03C2
      \u03C0\u03C1\u03BF\u03C3\u03C0\u03B1\u03B8\u03B5\u03AF \u03BD\u03B1 \u03B5\u03C0\u03B9\u03C3\u03BA\u03B5\u03C5\u03AC\u03C3\u03B5\u03B9
      \u03C4\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9 \u03B3\u03B9\u03B1
      \u03B5\u03C3\u03AC\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208866
    m_Localized: "\u039A\u03AC\u03B8\u03B5 \u03C3\u03B5\u03C4 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BE\u03B1\u03BD\u03AC \u03AD\u03B3\u03BA\u03C5\u03C1\u03BF. \u03A4\u03B5\u03C1\u03BC\u03B1\u03C4\u03AF\u03C3\u03C4\u03B5
      \u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC \u03C3\u03B1\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208869
    m_Localized: "\u0388\u03BD\u03B1\u03C1\u03BE\u03B7 \u03BF\u03BC\u03AC\u03B4\u03B1\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208870
    m_Localized: "\u0392\u03AC\u03BB\u03B5 3\u26654\u2665 \u03C3\u03C4\u03BF \u03AC\u03B4\u03B5\u03B9\u03BF
      \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9. \u0395\u03AF\u03BD\u03B1\u03B9
      \u03BC\u03CC\u03BD\u03BF \u03B4\u03CD\u03BF \u03C6\u03CD\u03BB\u03BB\u03B1,
      \u03BF\u03C0\u03CC\u03C4\u03B5 \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03C0\u03B1\u03C1\u03CC\u03BD
      \u03B4\u03B5\u03AF\u03C7\u03BD\u03B5\u03B9 \u03BA\u03CC\u03BA\u03BA\u03B9\u03BD\u03BF."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208871
    m_Localized: "\u03A3\u03C5\u03BD\u03B5\u03C7\u03AF\u03C3\u03C4\u03B5\u2014\u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03CE\u03C3\u03C4\u03B5
      \u03C4\u03B7\u03BD \u03C4\u03BF\u03C0\u03BF\u03B8\u03AD\u03C4\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03C9\u03BD \u03B4\u03CD\u03BF \u03BA\u03B1\u03C1\u03C4\u03CE\u03BD."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208872
    m_Localized: "\u0394\u03B1\u03BD\u03B5\u03B9\u03C3\u03BC\u03CC\u03C2 \u03B1\u03C0\u03CC
      \u03AD\u03BD\u03B1 \u03C3\u03CD\u03BD\u03BF\u03BB\u03BF"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208873
    m_Localized: "\u0388\u03BD\u03B1 \u03BA\u03B1\u03C1\u03AD \u03CC\u03BC\u03BF\u03B9\u03BF
      \u03B5\u03BE\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03B5\u03AF \u03BD\u03B1
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03B5\u03AF \u03BC\u03B5 \u03C4\u03C1\u03AF\u03B1.
      \u03A3\u03CD\u03C1\u03B5\u03C4\u03B5 \u03C4\u03BF 5\u2665 \u03B1\u03C0\u03CC
      \u03C4\u03B1 \u03C0\u03B5\u03BD\u03C4\u03AC\u03C1\u03B9\u03B1 \u03C3\u03C4\u03BF
      3\u2665 4\u2665."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208874
    m_Localized: "\u038C\u03BB\u03B1 \u03C4\u03B1 \u03C3\u03B5\u03C4 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03AD\u03B3\u03BA\u03C5\u03C1\u03B1. \u03A4\u03B5\u03C1\u03BC\u03B1\u03C4\u03AF\u03C3\u03C4\u03B5
      \u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC \u03C3\u03B1\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208875
    m_Localized: "\u039C\u03AF\u03B1 \u03BA\u03AC\u03C1\u03C4\u03B1 \u03AD\u03BC\u03B5\u03B9\u03BD\u03B5!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208876
    m_Localized: "\u038C\u03C4\u03B1\u03BD \u03AD\u03BD\u03B1\u03C2 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u03C2
      \u03AD\u03C7\u03B5\u03B9 \u03BC\u03B5\u03AF\u03BD\u03B5\u03B9 \u03BC\u03B5
      \u03C4\u03BF \u03C4\u03B5\u03BB\u03B5\u03C5\u03C4\u03B1\u03AF\u03BF \u03C4\u03BF\u03C5
      \u03C6\u03CD\u03BB\u03BB\u03BF, \u03B7 \u03B8\u03AD\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03C4\u03C1\u03AD\u03BC\u03B5\u03B9 \u03BA\u03B1\u03B9 \u03B4\u03B5\u03AF\u03C7\u03BD\u03B5\u03B9
      \u03AD\u03BD\u03B1 ! \u2014 \u03CC\u03BB\u03BF\u03B9 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD
      \u03BD\u03B1 \u03B4\u03BF\u03C5\u03BD \u03CC\u03C4\u03B9 \u03C0\u03C1\u03CC\u03BA\u03B5\u03B9\u03C4\u03B1\u03B9
      \u03BD\u03B1 \u03BA\u03B5\u03C1\u03B4\u03AF\u03C3\u03B5\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208877
    m_Localized: "\u039D\u03AD\u03B1 \u03C3\u03B5\u03C4"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208878
    m_Localized: "\u039F\u03B9 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5
      \u03B5\u03AF\u03BD\u03B1\u03B9 Down \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03BD\u03B1 \u03BE\u03B5\u03BA\u03B9\u03BD\u03AE\u03C3\u03BF\u03C5\u03BD
      \u03BF\u03BB\u03BF\u03BA\u03B1\u03AF\u03BD\u03BF\u03C5\u03C1\u03B3\u03B9\u03B1
      \u03C3\u03B5\u03C4 \u03B1\u03C0\u03CC \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9
      \u03C4\u03BF\u03C5\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208879
    m_Localized: "\u039A\u03BF\u03BB\u03BB\u03B7\u03BC\u03AD\u03BD\u03BF\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208880
    m_Localized: "\u03A4\u03BF A\u2665 \u03C3\u03BF\u03C5 \u03B4\u03B5\u03BD \u03C7\u03C9\u03C1\u03AC\u03B5\u03B9
      \u03C0\u03BF\u03C5\u03B8\u03B5\u03BD\u03AC \u03C3\u03C4\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208881
    m_Localized: "\u0399\u03C3\u03BF\u03C0\u03B1\u03BB\u03AF\u03B1"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208882
    m_Localized: "\u03A0\u03B1\u03C4\u03AE\u03C3\u03C4\u03B5 \u03A3\u03C7\u03B5\u03B4\u03AF\u03B1\u03C3\u03B7
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C0\u03AC\u03C1\u03B5\u03C4\u03B5 \u03BC\u03B9\u03B1
      \u03BA\u03AC\u03C1\u03C4\u03B1 \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03C4\u03B5\u03C1\u03BC\u03B1\u03C4\u03AF\u03C3\u03B5\u03C4\u03B5
      \u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC \u03C3\u03B1\u03C2. \u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
      \u03A3\u03C7\u03B5\u03B4\u03AF\u03B1\u03C3\u03B7 \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03B5\u03B9
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03C4\u03C5\u03C7\u03CC\u03BD \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03C4\u03BF\u03C0\u03BF\u03B8\u03B5\u03C4\u03AE\u03C3\u03B1\u03C4\u03B5
      \u03C3\u03B5 \u03B1\u03C5\u03C4\u03AE\u03BD \u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208884
    m_Localized: "\u0396\u03AE\u03C4\u03B7\u03C3\u03B5\u03C2 \u03C4\u03B1 2\u2665"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208885
    m_Localized: "\u0392\u03AC\u03BB\u03B5 \u03C4\u03BF 2\u2665 \u03C3\u03C4\u03BF
      3\u2665, 4\u2665, 5\u2665."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208886
    m_Localized: "\u0386\u03C3\u03C3\u03BF\u03C2 \u03C7\u03B1\u03BC\u03B7\u03BB\u03CC\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208887
    m_Localized: "\u03A4\u03CE\u03C1\u03B1 \u03C4\u03BF A\u2665 \u03C4\u03B1\u03B9\u03C1\u03B9\u03AC\u03B6\u03B5\u03B9
      \u03C3\u03C4\u03BF \u03C7\u03B1\u03BC\u03B7\u03BB\u03CC \u03AC\u03BA\u03C1\u03BF:
      A-2-3-4-5\u2665. \u03A0\u03B1\u03AF\u03BE\u03B5 \u03C4\u03BF \u03C4\u03B5\u03BB\u03B5\u03C5\u03C4\u03B1\u03AF\u03BF
      \u03C3\u03BF\u03C5 \u03C7\u03B1\u03C1\u03C4\u03AF!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208888
    m_Localized: "\u039C\u0395\u03A4\u0396\u039D\u039F\u03A5\u039D!"
