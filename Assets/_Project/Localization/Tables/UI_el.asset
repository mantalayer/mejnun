  - m_Id: 6548985208832
    m_Localized: "\u0397 {0} \u03C0\u03C1\u03BF\u03C7\u03C9\u03C1\u03AC\u03B5\u03B9
      \u03C0\u03C1\u03CE\u03C4\u03B7. \u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03AE\u03C3\u03C4\u03B5
      \u03C4\u03B9 \u03BA\u03AC\u03BD\u03B5\u03B9."
    m_Metadata:
      m_Items:
      - rid: 4825848269831405569
  - m_Id: 6548985208833
    m_Localized: "{0} \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BA\u03C4\u03CC\u03C2
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1\u03C2"
    m_Metadata:
      m_Items:
      - rid: 4825848269831405569
  - m_Id: 6548985208834
    m_Localized: "\u0397 {0} \u03AD\u03B2\u03B1\u03BB\u03B5 \u03BA\u03AC\u03C4\u03C9
      \u03AD\u03BD\u03B1 \u03C3\u03B5\u03C4 \u03C6\u03C4\u03B9\u03B1\u03B3\u03BC\u03AD\u03BD\u03BF
      \u03BC\u03CC\u03BD\u03BF \u03B1\u03C0\u03CC \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9
      \u03C4\u03B7\u03C2. \u0391\u03C5\u03C4\u03CC \u03BF\u03BD\u03BF\u03BC\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03C4\u03AD\u03B2\u03B1\u03C3\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03AD\u03BD\u03B1
      \u03C3\u03B5\u03C4 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C1\u03BA\u03B5\u03C4\u03CC."
    m_Metadata:
      m_Items:
      - rid: 4825848269831405569
  - m_Id: 6548985208843
    m_Localized: "\u03A4\u03CE\u03C1\u03B1 \u03B2\u03AC\u03BB\u03B5 \u03C4\u03BF
      A\u2660 \u03C3\u03BF\u03C5 \u03C3\u03C4\u03BF J\u2660 Q\u2660 K\u2660 \u03C4\u03BF\u03C5
      {0}."
    m_Metadata:
      m_Items:
      - rid: 4825848269831405569
  - m_Id: 6548985208853
    m_Localized: "\u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03AE\u03C3\u03C4\u03B5
      {0}."
    m_Metadata:
      m_Items:
      - rid: 4825848269831405569
  - m_Id: 6548985208855
    m_Localized: "\u039F \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7\u03C2 {0} \u03C0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C3\u03B5
      10\u2665 J\u2665 \u03C3\u03C4\u03B9\u03C2 \u03BA\u03B1\u03C1\u03B4\u03B9\u03AD\u03C2
      \u03C3\u03B1\u03C2 \u03BA\u03B1\u03B9 5\u2665 \u03C3\u03C4\u03B9\u03C2 \u03C0\u03B5\u03BD\u03C4\u03AC\u03B4\u03B5\u03C2
      \u03C3\u03B1\u03C2. \u039C\u03CC\u03BB\u03B9\u03C2 \u03C7\u03AC\u03C3\u03B5\u03C4\u03B5,
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03B5\u03C4\u03B5
      \u03C3\u03B5 \u03BF\u03C0\u03BF\u03B9\u03BF\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5
      \u03C3\u03B5\u03C4 \u03C3\u03C4\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9."
    m_Metadata:
      m_Items:
      - rid: 4825848269831405569
  - m_Id: 6548985208867
    m_Localized: "{0} \u03B6\u03C9\u03B3\u03C1\u03AC\u03C6\u03B9\u03C3\u03B5"
    m_Metadata:
      m_Items:
      - rid: 4825848269831405569
  - m_Id: 6548985208868
    m_Localized: "\u0397 {0} \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5
      \u03BD\u03B1 \u03C0\u03B1\u03AF\u03BE\u03B5\u03B9, \u03BF\u03C0\u03CC\u03C4\u03B5
      \u03C4\u03C1\u03AC\u03B2\u03B7\u03BE\u03B5. \u03A4\u03BF \u03C4\u03C1\u03AC\u03B2\u03B7\u03B3\u03BC\u03B1
      \u03C0\u03B1\u03AF\u03C1\u03BD\u03B5\u03B9 \u03BC\u03B9\u03B1 \u03BA\u03AC\u03C1\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03C3\u03C4\u03BF\u03AF\u03B2\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03BD\u03B5\u03B9 \u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC
      \u03C3\u03BF\u03C5."
    m_Metadata:
      m_Items:
      - rid: 4825848269831405569
  - m_Id: 6548985208883
    m_Localized: "\u03A4\u03BF {0} \u03AD\u03C7\u03B5\u03B9 \u03BA\u03BF\u03BB\u03BB\u03AE\u03C3\u03B5\u03B9
