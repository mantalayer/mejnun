  - m_Id: 6549031346272
    m_Localized: "\u03A0\u03BF\u03BB\u03CD \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03BF"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346273
    m_Localized: "\u038C\u03BB\u03BF\u03B9 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD
      \u03BD\u03B1 \u03BA\u03B1\u03C4\u03AD\u03B2\u03BF\u03C5\u03BD \u03C3\u03C4\u03B7\u03BD
      \u03C0\u03C1\u03CE\u03C4\u03B7 \u03C3\u03C4\u03C1\u03BF\u03C6\u03AE"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346274
    m_Localized: "\u0395\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9 \u03C3\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7 \u03BD\u03B1
      \u03C0\u03AD\u03C3\u03B5\u03B9 \u03BA\u03AC\u03C4\u03C9 \u03BA\u03B1\u03C4\u03AC
      \u03C4\u03B7 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1 \u03C4\u03BF\u03C5
      \u03C0\u03C1\u03CE\u03C4\u03BF\u03C5 \u03B3\u03CD\u03C1\u03BF\u03C5 \u03C4\u03BF\u03C5."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346275
    m_Localized: "\u0395\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7 \u03BA\u03BF\u03C5\u03BC\u03C0\u03B9\u03BF\u03CD
      \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B7\u03C2 \u03C0\u03C1\u03BF\u03CE\u03B8\u03B7\u03C3\u03B7\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346276
    m_Localized: "\u0395\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7 \u03B5\u03BD\u03CC\u03C2
      \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03BF\u03C5 \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03C4\u03AC\u03C7\u03C5\u03BD\u03C3\u03B7
      \u03C4\u03C9\u03BD \u03C3\u03C4\u03C1\u03BF\u03C6\u03CE\u03BD \u03C4\u03B7\u03C2
      CPU."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346277
    m_Localized: "\u03A4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9 & \u03C7\u03AD\u03C1\u03B9"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346278
    m_Localized: "\u0395\u03C0\u03B9\u03C3\u03AE\u03BC\u03B1\u03BD\u03C3\u03B7 \u03BA\u03AC\u03C1\u03C4\u03B1\u03C2
      \u03BC\u03B5 \u03B4\u03B5\u03AF\u03BA\u03C4\u03B7 \u03C0\u03BF\u03C5 \u03AD\u03C7\u03B5\u03B9
      \u03C4\u03BF\u03C0\u03BF\u03B8\u03B5\u03C4\u03B7\u03B8\u03B5\u03AF \u03BC\u03B5
      \u03C4\u03BF \u03C0\u03BF\u03BD\u03C4\u03AF\u03BA\u03B9"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346279
    m_Localized: "\u03A3\u03C7\u03B5\u03B4\u03B9\u03AC\u03B6\u03B5\u03B9 \u03BA\u03B1\u03B9
      \u03B1\u03BD\u03C5\u03C8\u03CE\u03BD\u03B5\u03B9 \u03B5\u03BB\u03B1\u03C6\u03C1\u03CE\u03C2
      \u03C4\u03B7\u03BD \u03BA\u03AC\u03C1\u03C4\u03B1 \u03BA\u03AC\u03C4\u03C9
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03B4\u03B5\u03AF\u03BA\u03C4\u03B7
      \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BD\u03C4\u03B9\u03BA\u03B9\u03BF\u03CD."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346280
    m_Localized: "\u03A0\u03BF\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03CC\u03BE\u03BF\u03C5"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346281
    m_Localized: "\u03A1\u03C5\u03B8\u03BC\u03AF\u03B6\u03B5\u03B9 \u03C4\u03B7\u03BD
      \u03BA\u03B1\u03BC\u03C0\u03CD\u03BB\u03B7 \u03C4\u03BF\u03C5 \u03C7\u03B5\u03C1\u03B9\u03BF\u03CD
      \u03C3\u03B1\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346282
    m_Localized: "\u0394\u03B9\u03AC\u03B4\u03BF\u03C3\u03B7 \u03BA\u03B1\u03C1\u03C4\u03CE\u03BD"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346283
    m_Localized: "\u0391\u03BB\u03BB\u03AC\u03B6\u03B5\u03B9 \u03C4\u03B7\u03BD \u03B1\u03C0\u03CC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03C4\u03C9\u03BD \u03BA\u03B1\u03C1\u03C4\u03CE\u03BD
      \u03C3\u03C4\u03BF \u03C7\u03AD\u03C1\u03B9 \u03C3\u03B1\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346284
    m_Localized: "\u039C\u03AD\u03B3\u03B5\u03B8\u03BF\u03C2 \u03BA\u03AC\u03C1\u03C4\u03B1\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346285
    m_Localized: "\u0391\u03BB\u03BB\u03AC\u03B6\u03B5\u03B9 \u03C4\u03BF \u03BC\u03AD\u03B3\u03B5\u03B8\u03BF\u03C2
