    m_Localized: "\u03A3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03C3\u03C5\u03C3\u03BA\u03B5\u03C5\u03AD\u03C2 \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540498
    m_Localized: "\u03A4\u03BF Mejnun \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF
      \u03B4\u03CD\u03BF \u03B1\u03BD\u03B1\u03BA\u03B1\u03C4\u03B5\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C4\u03C5\u03C0\u03B9\u03BA\u03AD\u03C2 \u03C4\u03C1\u03AC\u03C0\u03BF\u03C5\u03BB\u03B5\u03C2
      \u03C4\u03C9\u03BD 52 \u03C6\u03CD\u03BB\u03BB\u03C9\u03BD: \u03C3\u03C5\u03BD\u03BF\u03BB\u03B9\u03BA\u03AC
      104 \u03C6\u03CD\u03BB\u03BB\u03B1, \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C4\u03B6\u03CC\u03BA\u03B5\u03C1.
      \u039F\u03B9 \u03AF\u03B4\u03B9\u03B5\u03C2 \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2
      \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03B4\u03CD\u03BF \u03C4\u03C1\u03AC\u03C0\u03BF\u03C5\u03BB\u03B5\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03C0\u03BB\u03AD\u03C2. \u03A0\u03B1\u03AF\u03BE\u03C4\u03B5
      \u03BC\u03B5 2\u20136 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B5\u03C2, \u03BA\u03B9\u03BD\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03B4\u03B5\u03BE\u03B9\u03CC\u03C3\u03C4\u03C1\u03BF\u03C6\u03B1 (\u03C0\u03C1\u03BF\u03C2
      \u03C4\u03B1 \u03B1\u03C1\u03B9\u03C3\u03C4\u03B5\u03C1\u03AC)."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540499
    m_Localized: "\u03A0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03AC\u03B5\u03B9 \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03BC\u03BF\u03B9\u03C1\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540500
    m_Localized: "\u039F \u03C5\u03C0\u03BF\u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AE\u03C2
      \u03BC\u03BF\u03B9\u03C1\u03AC\u03B6\u03B5\u03B9. \u039F \u03BD\u03B9\u03BA\u03B7\u03C4\u03AE\u03C2
      \u03C4\u03BF\u03C5 \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C5
      \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD \u03C0\u03B1\u03AF\u03B6\u03B5\u03B9
      \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2, \u03B1\u03BD \u03B5\u03BE\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03B5\u03AF
      \u03BD\u03B1 \u03C0\u03B1\u03AF\u03B6\u03B5\u03B9. \u0394\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AC,
      \u03BF\u03B9 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B5\u03C2 \u03B5\u03C0\u03B9\u03BB\u03AD\u03B3\u03BF\u03C5\u03BD
      \u03C0\u03BF\u03B9\u03BF\u03C2 \u03B8\u03B1 \u03C0\u03B1\u03AF\u03BE\u03B5\u03B9
      \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2 \u03BC\u03B5 \u03BC\u03B9\u03B1 \u03B5\u03C1\u03CE\u03C4\u03B7\u03C3\u03B7:
      \u03C0\u03B1\u03C4\u03AE\u03C3\u03C4\u03B5 \u03BC\u03B9\u03B1 \u03B8\u03AD\u03C3\u03B7
      \u03C4\u03BF\u03C0\u03B9\u03BA\u03AC \u03AE \u03B5\u03BD\u03B1\u03BD\u03C4\u03AF\u03BF\u03BD
      \u03C4\u03B7\u03C2 \u03A4\u03B5\u03C7\u03BD\u03B7\u03C4\u03AE\u03C2 \u039D\u03BF\u03B7\u03BC\u03BF\u03C3\u03CD\u03BD\u03B7\u03C2
      \u03AE \u03C8\u03B7\u03C6\u03AF\u03C3\u03C4\u03B5 online. \u039F\u03B9 online
      \u03C8\u03AE\u03C6\u03BF\u03B9 \u03B4\u03B9\u03B1\u03C1\u03BA\u03BF\u03CD\u03BD
      20 \u03B4\u03B5\u03C5\u03C4\u03B5\u03C1\u03CC\u03BB\u03B5\u03C0\u03C4\u03B1.
      \u039F\u03B9 \u03B9\u03C3\u03BF\u03C0\u03B1\u03BB\u03AF\u03B5\u03C2 \u03BB\u03CD\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C4\u03C5\u03C7\u03B1\u03AF\u03B1."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540501
    m_Localized: "\u039F \u03BD\u03C4\u03AF\u03BB\u03B5\u03C1 \u03B4\u03AF\u03BD\u03B5\u03B9
      11 \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2 \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7, \u03BC\u03AF\u03B1 \u03BA\u03AC\u03B8\u03B5
      \u03C6\u03BF\u03C1\u03AC, \u03B4\u03B5\u03BE\u03B9\u03CC\u03C3\u03C4\u03C1\u03BF\u03C6\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7.
      \u039F\u03B9 \u03C5\u03C0\u03CC\u03BB\u03BF\u03B9\u03C0\u03B5\u03C2 \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2
      \u03C3\u03C7\u03B7\u03BC\u03B1\u03C4\u03AF\u03B6\u03BF\u03C5\u03BD \u03C4\u03B7
      \u03C3\u03C4\u03BF\u03AF\u03B2\u03B1 \u03BC\u03B5 \u03C4\u03B7\u03BD \u03CC\u03C8\u03B7
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B1 \u03BA\u03AC\u03C4\u03C9 \u03BA\u03B1\u03B9
      \u03BF \u03B5\u03C0\u03B9\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03C2 \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2
      \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u03C2 \u03C0\u03B1\u03AF\u03B6\u03B5\u03B9
      \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540502
    m_Localized: "\u03A3\u03C4\u03CC\u03C7\u03BF\u03C2 & \u03AD\u03B3\u03BA\u03C5\u03C1\u03B1
      \u03C3\u03B5\u03C4"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540503
    m_Localized: "\u0393\u03AF\u03BD\u03B5 \u03BF \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03B8\u03B1 \u03B1\u03B4\u03B5\u03B9\u03AC\u03C3\u03B5\u03B9
      \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9 \u03C3\u03BF\u03C5 \u03B3\u03B9\u03B1
      \u03BD\u03B1 \u03BA\u03B5\u03C1\u03B4\u03AF\u03C3\u03B5\u03B9\u03C2. \u0388\u03BD\u03B1
      \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03AD\u03BD\u03B1\u03C2 \u03B3\u03CD\u03C1\u03BF\u03C2. \u039F \u03BD\u03B9\u03BA\u03B7\u03C4\u03AE\u03C2
      \u03C0\u03C1\u03BF\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2
      \u03C3\u03C4\u03BF \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540504
    m_Localized: "\u03A4\u03B1 \u03C3\u03B5\u03C4 \u03AF\u03B4\u03B9\u03BF\u03C5
      \u03B5\u03AF\u03B4\u03BF\u03C5\u03C2 \u03C0\u03B5\u03C1\u03B9\u03AD\u03C7\u03BF\u03C5\u03BD
      3\u20134 \u03C6\u03CD\u03BB\u03BB\u03B1 \u03C4\u03B7\u03C2 \u03AF\u03B4\u03B9\u03B1\u03C2
      \u03B1\u03BE\u03AF\u03B1\u03C2, \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03C7\u03C1\u03CE\u03BC\u03B1
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03CC. \u03A4\u03B1
      straight \u03C0\u03B5\u03C1\u03B9\u03AD\u03C7\u03BF\u03C5\u03BD 3\u201313 \u03C3\u03C5\u03BD\u03B5\u03C7\u03CC\u03BC\u03B5\u03BD\u03B1
      \u03C6\u03CD\u03BB\u03BB\u03B1 \u03C4\u03B7\u03C2 \u03AF\u03B4\u03B9\u03B1\u03C2
      \u03B1\u03BE\u03AF\u03B1\u03C2, \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B5\u03C0\u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03B1\u03BD\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03B1\u03BE\u03AF\u03B1. \u0388\u03BD\u03B1\u03C2 \u03AC\u03C3\u03C3\u03BF\u03C2
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C7\u03B1\u03BC\u03B7\u03BB\u03CC\u03C2 (A-2-3) \u03AE \u03C5\u03C8\u03B7\u03BB\u03CC\u03C2
      (Q-K-A), \u03B1\u03BB\u03BB\u03AC \u03C0\u03BF\u03C4\u03AD \u03BA\u03B1\u03B9
      \u03C4\u03B1 \u03B4\u03CD\u03BF. \u03A4\u03BF K-A-2 \u03B4\u03B5\u03BD \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03C4\u03B1\u03B9.
      \u039A\u03AC\u03B8\u03B5 \u03C3\u03B5\u03C4 \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03AD\u03B3\u03BA\u03C5\u03C1\u03BF. \u03A3\u03B5\u03C4 \u03B5\u03BD\u03CC\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03CD\u03BF \u03C6\u03CD\u03BB\u03BB\u03C9\u03BD
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03B3\u03BA\u03C5\u03C1\u03B1."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540505
    m_Localized: "\u039A\u03B1\u03C4\u03B5\u03B2\u03B1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540506
    m_Localized: "\u03A0\u03C1\u03B9\u03BD \u03BE\u03B5\u03BA\u03B9\u03BD\u03AE\u03C3\u03B5\u03C4\u03B5,
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AE\u03C3\u03B5\u03C4\u03B5
      \u03BD\u03AD\u03B1 \u03C3\u03B5\u03C4 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03CE\u03BD\u03C4\u03B1\u03C2
      \u03BC\u03CC\u03BD\u03BF \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9 \u03C3\u03B1\u03C2. \u0394\u03B5\u03BD
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C4\u03B5
      \u03AE \u03BD\u03B1 \u03B1\u03BB\u03BB\u03AC\u03BE\u03B5\u03C4\u03B5 \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1
      \u03C3\u03B5\u03C4 \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC. \u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5
      \u03BD\u03B1 \u03C0\u03B1\u03AF\u03BE\u03B5\u03C4\u03B5 \u03AD\u03BD\u03B1
      \u03AE \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1 \u03C3\u03B5\u03C4,
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03C5\u03C2
      \u03C0\u03CC\u03BD\u03C4\u03BF\u03C5\u03C2. \u039C\u03CC\u03BB\u03B9\u03C2
      \u03B5\u03C0\u03B9\u03B2\u03B5\u03B2\u03B1\u03B9\u03CE\u03C3\u03B5\u03C4\u03B5
      \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD \u03AD\u03BD\u03B1
      \u03AD\u03B3\u03BA\u03C5\u03C1\u03BF \u03C3\u03B5\u03C4 \u03BC\u03CC\u03BD\u03BF
      \u03B3\u03B9\u03B1 \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9, \u03B5\u03AF\u03C3\u03C4\u03B5
      \u03BA\u03AC\u03C4\u03C9 \u03BA\u03B1\u03B9 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5
      \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C4\u03B5
      \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03BF \u03C4\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC
      \u03B3\u03B9\u03B1 \u03C4\u03BF \u03C5\u03C0\u03CC\u03BB\u03BF\u03B9\u03C0\u03BF
      \u03C4\u03B7\u03C2 \u03C3\u03B5\u03B9\u03C1\u03AC\u03C2. \u039F\u03B9 \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03B8\u03B7\u03BA\u03B1\u03BD
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03BE\u03B5\u03BA\u03B9\u03BD\u03AE\u03C3\u03B5\u03C4\u03B5
      \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03BF\u03C5\u03BD \u03C3\u03C4\u03BF
      \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03C3\u03B5\u03B9\u03C1\u03AC. \u0397 \u0391\u03BD\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7
      \u03AE \u03B7 \u0395\u03C0\u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD
      \u03BD\u03B1 \u03B1\u03BD\u03B1\u03B9\u03C1\u03AD\u03C3\u03BF\u03C5\u03BD \u03C4\u03B7\u03BD
      \u03AD\u03BD\u03B1\u03C1\u03BE\u03B7."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540507
    m_Localized: "\u038C\u03C4\u03B1\u03BD \u03B5\u03AF\u03C3\u03C4\u03B5 \u03BA\u03AC\u03C4\u03C9,
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03B1\u03BD\u03B1\u03B4\u03B9\u03B1\u03C4\u03AC\u03BE\u03B5\u03C4\u03B5
      \u03C4\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC, \u03C3\u03C5\u03BC\u03C0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03B1\u03BD\u03BF\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03C4\u03B7\u03C2 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C1\u03B9\u03BD\u03AE\u03C2
      \u03B1\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7\u03C2 \u03C4\u03BF\u03C5. \u0393\u03B9\u03B1
      \u03BD\u03B1 \u03C4\u03B5\u03C1\u03BC\u03B1\u03C4\u03AF\u03C3\u03B5\u03C4\u03B5
      \u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC \u03C3\u03B1\u03C2, \u03C4\u03BF
      \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03B3\u03BA\u03C5\u03C1\u03BF \u03BA\u03B1\u03B9
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03AD\u03C7\u03B5\u03C4\u03B5
      \u03C0\u03B1\u03AF\u03BE\u03B5\u03B9 \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD
      \u03BC\u03AF\u03B1 \u03BA\u03AC\u03C1\u03C4\u03B1 \u03B1\u03C0\u03CC \u03C4\u03BF
      \u03C7\u03AD\u03C1\u03B9 \u03C3\u03B1\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540508
    m_Localized: "\u0395\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B5\u03C2 \u03C3\u03C4\u03C1\u03BF\u03C6\u03AE\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540509
    m_Localized: "\u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03A4\u03C1\u03B1\u03B2\u03AE\u03BE\u03C4\u03B5
      (\u03AE \u03A0\u03B5\u03C1\u03AC\u03C3\u03C4\u03B5 \u03CC\u03C4\u03B1\u03BD
      \u03B7 \u03C3\u03C4\u03BF\u03AF\u03B2\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03AC\u03B4\u03B5\u03B9\u03B1) \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03AC\u03BD\u03C4\u03B1
      \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03B7. \u0395\u03C0\u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9
      \u03C4\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC \u03C3\u03C4\u03B7\u03BD
      \u03B1\u03C1\u03C7\u03AE \u03C4\u03B7\u03C2 \u03C3\u03B5\u03B9\u03C1\u03AC\u03C2
      \u03C3\u03B1\u03C2, \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03B5\u03B9
      \u03C4\u03B9\u03C2 \u03C0\u03B1\u03B9\u03B3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2
      \u03C3\u03B1\u03C2 \u03C3\u03C4\u03BF \u03C7\u03AD\u03C1\u03B9 \u03C3\u03B1\u03C2,
      \u03C4\u03C1\u03B1\u03B2\u03AC\u03B5\u03B9 \u03BC\u03AF\u03B1 \u03BA\u03AC\u03C1\u03C4\u03B1
      \u03B1\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03BD
      \u03BA\u03B1\u03B9 \u03C4\u03B5\u03C1\u03BC\u03B1\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC \u03C3\u03B1\u03C2. \u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
      \u03A4\u03AD\u03BB\u03BF\u03C2 \u0393\u03CD\u03C1\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03B7 \u03CC\u03C4\u03B1\u03BD
      \u03C4\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03AD\u03B3\u03BA\u03C5\u03C1\u03BF \u03BA\u03B1\u03B9 \u03AD\u03C7\u03B5\u03C4\u03B5
      \u03C0\u03B1\u03AF\u03BE\u03B5\u03B9 \u03BC\u03B9\u03B1 \u03BA\u03AC\u03C1\u03C4\u03B1
      \u03C7\u03B5\u03C1\u03B9\u03BF\u03CD \u03AE \u03AD\u03C7\u03B5\u03C4\u03B5
      \u03C7\u03AC\u03C3\u03B5\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540510
    m_Localized: "\u0397 \u0391\u03BD\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 \u03BA\u03AC\u03BD\u03B5\u03B9
      \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1 \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B1
      \u03C0\u03AF\u03C3\u03C9 \u03C3\u03C4\u03B9\u03C2 \u03BA\u03B9\u03BD\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03C3\u03B1\u03C2. \u0397 \u0395\u03C0\u03B1\u03BD\u03AC\u03BB\u03B7\u03C8\u03B7
      \u03B5\u03C6\u03B1\u03C1\u03BC\u03CC\u03B6\u03B5\u03B9 \u03BE\u03B1\u03BD\u03AC
      \u03BC\u03B9\u03B1 \u03BA\u03AF\u03BD\u03B7\u03C3\u03B7 \u03C0\u03BF\u03C5
      \u03B4\u03B5\u03BD \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03CE\u03B8\u03B7\u03BA\u03B5
      \u03C3\u03C4\u03BF\u03BD \u03AF\u03B4\u03B9\u03BF \u03B3\u03CD\u03C1\u03BF.
      \u039F\u03B9 \u03BD\u03AD\u03B5\u03C2 \u03BA\u03B9\u03BD\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B5\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B5\u03C2
      \u03BB\u03AE\u03BE\u03B7\u03C2 \u03B3\u03CD\u03C1\u03BF\u03C5 \u03B1\u03BA\u03C5\u03C1\u03CE\u03BD\u03BF\u03C5\u03BD
      \u03C4\u03B7\u03BD \u0395\u03C0\u03B1\u03BD\u03AC\u03BB\u03B7\u03C8\u03B7.
      \u03A4\u03BF Fix Board \u03C0\u03C1\u03BF\u03C3\u03C0\u03B1\u03B8\u03B5\u03AF
      \u03BD\u03B1 \u03BA\u03C1\u03B1\u03C4\u03AE\u03C3\u03B5\u03B9 \u03AD\u03B3\u03BA\u03C5\u03C1\u03B5\u03C2
      \u03C6\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B1\u03C0\u03CC \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9
      \u03C3\u03B1\u03C2 \u03B5\u03BD\u03CE \u03B5\u03C0\u03B9\u03C3\u03BA\u03B5\u03C5\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC. \u039F\u03B9 \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03B9
      \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03BF\u03C5\u03BD \u03C3\u03C4\u03BF
      \u03C7\u03AD\u03C1\u03B9 \u03C3\u03B1\u03C2. \u0397 \u0395\u03C0\u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC
      \u03B5\u03C0\u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9 \u03C4\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03AD\u03BD\u03B1\u03C1\u03BE\u03B7\u03C2 \u03C4\u03BF\u03C5 \u03B3\u03CD\u03C1\u03BF\u03C5
      \u03C4\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03B5\u03B9
      \u03C4\u03B9\u03C2 \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5
      \u03C0\u03B1\u03AF\u03BE\u03B1\u03C4\u03B5 \u03C3\u03C4\u03BF \u03C7\u03AD\u03C1\u03B9
      \u03C3\u03B1\u03C2. \u039F\u03B9 \u03BA\u03B1\u03C4\u03B1\u03C3\u03C4\u03C1\u03BF\u03C6\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B5\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03C3\u03B1\u03C2 \u03B6\u03B7\u03C4\u03AE\u03C3\u03BF\u03C5\u03BD
      \u03BD\u03B1 \u03B5\u03C0\u03B9\u03B2\u03B5\u03B2\u03B1\u03B9\u03CE\u03C3\u03B5\u03C4\u03B5."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540511
    m_Localized: "\u03A7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B5\u03C4\u03C1\u03B7\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C3\u03C4\u03C1\u03BF\u03C6\u03AD\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540512
    m_Localized: "\u039F \u03BF\u03B9\u03BA\u03BF\u03B4\u03B5\u03C3\u03C0\u03CC\u03C4\u03B7\u03C2
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03B5\u03B9
      30, 60, 90 \u03AE 120 \u03B4\u03B5\u03C5\u03C4\u03B5\u03C1\u03CC\u03BB\u03B5\u03C0\u03C4\u03B1
      \u03B1\u03BD\u03AC \u03B3\u03CD\u03C1\u03BF \u03AE \u03BD\u03B1 \u03B1\u03C0\u03B5\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03B9
      \u03C4\u03BF \u03C7\u03C1\u03BF\u03BD\u03CC\u03BC\u03B5\u03C4\u03C1\u03BF \u03C3\u03B5
      \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u03B1 \u03B5\u03BA\u03C4\u03CC\u03C2
      \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7\u03C2. \u03A4\u03B1 online \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u03B1
      \u03AD\u03C7\u03BF\u03C5\u03BD \u03C0\u03AC\u03BD\u03C4\u03B1 \u03C7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B5\u03C4\u03C1\u03B7\u03BC\u03AD\u03BD\u03BF
      \u03C7\u03C1\u03CC\u03BD\u03BF. \u038C\u03C4\u03B1\u03BD \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03C3\u03B5\u03B9
      \u03BF \u03C7\u03C1\u03CC\u03BD\u03BF\u03C2, \u03AD\u03BD\u03B1 \u03AD\u03B3\u03BA\u03C5\u03C1\u03BF
      \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u03B1
      \u03C7\u03B5\u03C1\u03B9\u03CE\u03BD \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03B9 \u03C4\u03C1\u03B1\u03B2\u03AC\u03C4\u03B5. \u0388\u03BD\u03B1
      \u03AC\u03BA\u03C5\u03C1\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u03B1 \u03C7\u03B5\u03C1\u03B9\u03CE\u03BD
      \u03B1\u03C0\u03BF\u03BA\u03B1\u03B8\u03AF\u03C3\u03C4\u03B1\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03B9 \u03C4\u03C1\u03B1\u03B2\u03AC\u03C4\u03B5. \u0395\u03AC\u03BD
      \u03C0\u03B1\u03AF\u03BE\u03B1\u03C4\u03B5 \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2
      \u03C7\u03B5\u03C1\u03B9\u03CE\u03BD \u03BA\u03B1\u03B9 \u03C4\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03B3\u03BA\u03C5\u03C1\u03BF, \u03B7
      \u03C3\u03B5\u03B9\u03C1\u03AC \u03C3\u03B1\u03C2 \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03BD\u03B5\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C4\u03C1\u03B1\u03B2\u03AE\u03B3\u03BC\u03B1.
      \u0395\u03AC\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AC\u03BA\u03C5\u03C1\u03B7,
      \u03BF\u03B9 \u03BA\u03B9\u03BD\u03AE\u03C3\u03B5\u03B9\u03C2 \u03C3\u03B1\u03C2
      \u03B1\u03BA\u03C5\u03C1\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BC\u03AD\u03C7\u03C1\u03B9
      \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03B3\u03BA\u03C5\u03C1\u03B7.
      \u03A4\u03C1\u03B1\u03B2\u03AC\u03C4\u03B5 \u03BC\u03CC\u03BD\u03BF \u03B5\u03AC\u03BD
      \u03B4\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03B1\u03C0\u03BF\u03BC\u03B5\u03AF\u03BD\u03B5\u03B9
      \u03BA\u03B1\u03BC\u03AF\u03B1 \u03BA\u03AC\u03C1\u03C4\u03B1 \u03C7\u03B5\u03C1\u03B9\u03BF\u03CD
      \u03C3\u03C4\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540513
    m_Localized: "\u0386\u03B4\u03B5\u03B9\u03B1 \u03C3\u03C4\u03BF\u03AF\u03B2\u03B1
      \u03C4\u03C1\u03B1\u03B2\u03AE\u03B3\u03BC\u03B1\u03C4\u03BF\u03C2 \u03BA\u03B1\u03B9
      \u03B1\u03B4\u03B9\u03AD\u03BE\u03BF\u03B4\u03B1"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540514
    m_Localized: "\u038C\u03C4\u03B1\u03BD \u03B7 \u03C3\u03C4\u03BF\u03AF\u03B2\u03B1
      \u03C4\u03C1\u03B1\u03B2\u03AE\u03B3\u03BC\u03B1\u03C4\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03AC\u03B4\u03B5\u03B9\u03B1, \u03C4\u03BF \u03A4\u03C1\u03B1\u03B2\u03AE\u03B3\u03BC\u03B1
      \u03B3\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03A0\u03AC\u03C3\u03BF: \u03B4\u03B5\u03BD
      \u03C4\u03C1\u03B1\u03B2\u03B9\u03AD\u03C4\u03B1\u03B9 \u03BA\u03B1\u03BC\u03AF\u03B1
      \u03BA\u03AC\u03C1\u03C4\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC
      \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03B5\u03C4\u03B1\u03B9.
      \u0395\u03AC\u03BD \u03BA\u03AC\u03B8\u03B5 \u03B5\u03BD\u03B5\u03C1\u03B3\u03CC\u03C2
      \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u03C2 \u03BA\u03AC\u03BD\u03B5\u03B9 \u03C0\u03AC\u03C3\u03BF
      \u03C3\u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03BD\u03B1 \u03C0\u03B1\u03AF\u03BE\u03B5\u03B9 \u03BA\u03AC\u03C1\u03C4\u03B1,
      \u03BF \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u03C2 \u03BC\u03B5 \u03C4\u03B9\u03C2
      \u03BB\u03B9\u03B3\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2 \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2
      \u03BA\u03B5\u03C1\u03B4\u03AF\u03B6\u03B5\u03B9 \u03B5\u03AC\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BF \u03BC\u03CC\u03BD\u03BF\u03C2 \u03BC\u03B5 \u03B1\u03C5\u03C4\u03CC\u03BD
      \u03C4\u03BF\u03BD \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC. \u0395\u03AC\u03BD
