  - m_Id: 500000000000000
    m_Localized: "\u0393\u03C1\u03AE\u03B3\u03BF\u03C1\u03B7 \u03BA\u03B1\u03B8\u03C5\u03C3\u03C4\u03AD\u03C1\u03B7\u03C3\u03B7
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03B1\u03B2\u03AE\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 500000000000001
    m_Localized: "\u039A\u03C1\u03B1\u03C4\u03AE\u03C3\u03C4\u03B5 \u03B3\u03B9\u03B1
      \u03BB\u03AF\u03B3\u03BF \u03C0\u03C1\u03B9\u03BD \u03BC\u03B1\u03B6\u03B5\u03C5\u03C4\u03B5\u03AF
      \u03BC\u03B9\u03B1 \u03BA\u03AC\u03C1\u03C4\u03B1 \u03C3\u03C4\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC.
      \u0393\u03C1\u03AE\u03B3\u03BF\u03C1\u03B1 \u03C3\u03CD\u03C1\u03BC\u03B1\u03C4\u03B1
      \u03BA\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03B1\u03BD\u03BF\u03C1\u03B1\u03BC\u03B9\u03BA\u03AE
      \u03BA\u03AF\u03BD\u03B7\u03C3\u03B7 \u03C3\u03C4\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC."
    m_Metadata:
      m_Items: []
  - m_Id: 500000000000002
    m_Localized: "{0:0,00} \u03B4\u03B5\u03C5\u03C4."
    m_Metadata:
      m_Items:
      - rid: 4825848269831405569
  - m_Id: 500000000000003
    m_Localized: "\u0395\u03C0\u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03C9\u03BD"
    m_Metadata:
      m_Items: []
  - m_Id: 500000000000004
    m_Localized: "\u0395\u03C0\u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03C3\u03C4\u03B9\u03C2
      \u03C0\u03C1\u03BF\u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 500000000000005
    m_Localized: "\u0395\u03C0\u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03C9\u03BD
      \u03C3\u03C4\u03B9\u03C2 \u03C0\u03C1\u03BF\u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2
      \u03C0\u03BF\u03C5 \u03AD\u03C7\u03BF\u03C5\u03BD \u03B4\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03C9\u03B8\u03B5\u03AF
      \u03B3\u03B9\u03B1 \u03BC\u03B9\u03B1 \u03BD\u03AD\u03B1 \u03C3\u03C5\u03C3\u03BA\u03B5\u03C5\u03AE.
      \u0397 \u03B3\u03BB\u03CE\u03C3\u03C3\u03B1, \u03C4\u03BF \u03C8\u03B5\u03C5\u03B4\u03CE\u03BD\u03C5\u03BC\u03CC
      \u03C3\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03B7 \u03C0\u03C1\u03CC\u03BF\u03B4\u03BF\u03C2
      \u03C4\u03BF\u03C5 \u03B5\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03C0\u03C1\u03BF\u03B3\u03C1\u03AC\u03BC\u03BC\u03B1\u03C4\u03BF\u03C2 \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 638500138377216
    m_Localized: "\u0394\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1 \u03B1\u03BD\u03B1\u03BC\u03BF\u03BD\u03AE\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03B1\u03B2\u03AE\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 638500549419008
    m_Localized: "\u038F\u03C1\u03B1 \u03BD\u03B1 \u03BA\u03C1\u03B1\u03C4\u03AE\u03C3\u03B5\u03C4\u03B5
      \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9 \u03C3\u03B1\u03C2 \u03C0\u03C1\u03B9\u03BD
      \u03BC\u03B1\u03B6\u03B5\u03C5\u03C4\u03B5\u03AF \u03BC\u03B9\u03B1 \u03BA\u03AC\u03C1\u03C4\u03B1
      \u03C4\u03BF\u03C5 \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC. \u03A3\u03C5\u03BD\u03B5\u03C7\u03AF\u03C3\u03C4\u03B5
      \u03BD\u03B1 \u03BA\u03C1\u03B1\u03C4\u03AC\u03C4\u03B5 \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9
      \u03C3\u03B1\u03C2 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03BC\u03B1\u03B6\u03AD\u03C8\u03B5\u03C4\u03B5
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03C5\u03C0\u03CC\u03BB\u03BF\u03B9\u03C0\u03B7
      \u03BF\u03C5\u03C1\u03AC."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010777
    m_Localized: "\u03A4\u03B1\u03C7\u03CD\u03C4\u03B7\u03C4\u03B1 \u03BA\u03CD\u03BB\u03B9\u03C3\u03B7\u03C2
      \u03B1\u03C0\u03CC \u03AC\u03BA\u03C1\u03B7 \u03C3\u03B5 \u03AC\u03BA\u03C1\u03B7"
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010778
    m_Localized: "\u03A1\u03C5\u03B8\u03BC\u03AF\u03C3\u03C4\u03B5 \u03C4\u03B7\u03BD
      \u03C4\u03B1\u03C7\u03CD\u03C4\u03B7\u03C4\u03B1 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03BF\u03C0\u03BF\u03AF\u03B1 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03B5\u03C4\u03B1\u03B9
      \u03C4\u03BF \u03C4\u03B1\u03BC\u03C0\u03BB\u03CC \u03B5\u03BD\u03CE \u03C3\u03CD\u03C1\u03B5\u03C4\u03B5
      \u03BC\u03B9\u03B1 \u03BA\u03AC\u03C1\u03C4\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03AC\u03BA\u03C1\u03B7 \u03C4\u03B7\u03C2 \u03BF\u03B8\u03CC\u03BD\u03B7\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 686715395104768
    m_Localized: "\u039A\u03AC\u03BD\u03B5 \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B1!"
    m_Metadata:
      m_Items: []
  - m_Id: 686715407687680
    m_Localized: "\u0392\u03B9\u03B1\u03C3\u03C4\u03B5\u03AF\u03C4\u03B5 ({0})"
    m_Metadata:
