  - m_Id: 6548989403138
    m_Localized: "\u038A\u03B4\u03B9\u03BF \u03C3\u03B5\u03C4"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403139
    m_Localized: "\u0386\u03B4\u03B5\u03B9\u03B1 \u03C3\u03C4\u03BF\u03AF\u03B2\u03B1
      \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403140
    m_Localized: "\u038C\u03C4\u03B1\u03BD \u03B7 \u03C3\u03C4\u03BF\u03AF\u03B2\u03B1
      \u03C4\u03C1\u03B1\u03B2\u03AE\u03B3\u03BC\u03B1\u03C4\u03BF\u03C2 \u03B5\u03BE\u03B1\u03BD\u03C4\u03BB\u03B7\u03B8\u03B5\u03AF,
      \u03C4\u03BF \u03A4\u03C1\u03B1\u03B2\u03AE\u03B3\u03BC\u03B1 \u03B3\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03A0\u03AC\u03C3\u03BF. \u0391\u03BD \u03CC\u03BB\u03BF\u03B9 \u03BF\u03B9
      \u03C0\u03B1\u03AF\u03BA\u03C4\u03B5\u03C2 \u03BA\u03AC\u03BD\u03BF\u03C5\u03BD
      \u03C0\u03AC\u03C3\u03BF \u03C3\u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC,
      \u03BA\u03B5\u03C1\u03B4\u03AF\u03B6\u03B5\u03B9 \u03BF \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u03C2
      \u03BC\u03B5 \u03C4\u03B9\u03C2 \u03BB\u03B9\u03B3\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2. \u0397 \u03B9\u03C3\u03BF\u03C0\u03B1\u03BB\u03AF\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03BD\u03B1 \u03B1\u03B4\u03B9\u03AD\u03BE\u03BF\u03B4\u03BF."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403141
    m_Localized: "\u03A7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B5\u03C4\u03C1\u03B7\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C3\u03C4\u03C1\u03BF\u03C6\u03AD\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403142
    m_Localized: "\u03A3\u03C4\u03B1 \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u03B1
      \u03BC\u03B5 \u03C7\u03C1\u03BF\u03BD\u03BF\u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7,
      \u03AD\u03BD\u03B1 \u03C1\u03BF\u03BB\u03CC\u03B9 \u03BC\u03B5\u03C4\u03C1\u03AC\u03B5\u03B9
      \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03C1\u03BF\u03C6\u03B1 \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03B3\u03CD\u03C1\u03BF. \u038C\u03C4\u03B1\u03BD \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03C3\u03B5\u03B9
      \u2014 \u03A7\u03B1\u03BB\u03AC\u03C2! \u2014 \u03AD\u03BD\u03B1\u03C2 \u03AD\u03B3\u03BA\u03C5\u03C1\u03BF\u03C2
      \u03B3\u03CD\u03C1\u03BF\u03C2 \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03BD\u03B5\u03B9,
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AC \u03BF\u03B9
      \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2 \u03C3\u03B1\u03C2 \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03BF\u03C5\u03BD
      \u03BA\u03B1\u03B9 \u03C4\u03C1\u03B1\u03B2\u03AC\u03C4\u03B5."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403143
    m_Localized: "\u0395\u03C0\u03B9\u03B4\u03B9\u03CC\u03C1\u03B8\u03C9\u03C3\u03B7
      \u03C0\u03BB\u03B1\u03BA\u03AD\u03C4\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403144
    m_Localized: "\u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE Fix board \u03C0\u03C1\u03BF\u03C3\u03C0\u03B1\u03B8\u03B5\u03AF
      \u03BD\u03B1 \u03BA\u03AC\u03BD\u03B5\u03B9 \u03BA\u03AC\u03B8\u03B5 \u03C3\u03B5\u03C4
      \u03AD\u03B3\u03BA\u03C5\u03C1\u03BF \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03CE\u03BD\u03C4\u03B1\u03C2
      \u03C0\u03B1\u03C1\u03AC\u03BB\u03BB\u03B7\u03BB\u03B1 \u03C4\u03B9\u03C2 \u03BA\u03B9\u03BD\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03C3\u03B1\u03C2. \u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE Revert
      \u03B5\u03C0\u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03BF
      \u03C4\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9 \u03C3\u03C4\u03B7\u03BD
      \u03B1\u03C1\u03C7\u03B9\u03BA\u03AE \u03C4\u03BF\u03C5 \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403145
    m_Localized: "\u03A3\u03C5\u03BC\u03B2\u03BF\u03C5\u03BB\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03BF \u03C0\u03AF\u03BD\u03B1\u03BA\u03B1\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403146
    m_Localized: "\u039F\u03B9 \u03C3\u03C5\u03BC\u03B2\u03BF\u03C5\u03BB\u03AD\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03BF\u03C5\u03BD \u03C4\u03B9\u03C2
      \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5
      \u03BD\u03B1 \u03C0\u03B1\u03AF\u03BE\u03B5\u03C4\u03B5. \u03A4\u03C3\u03B9\u03BC\u03C0\u03AE\u03C3\u03C4\u03B5
      \u03C4\u03B1 \u03B4\u03AC\u03C7\u03C4\u03C5\u03BB\u03AC \u03C3\u03B1\u03C2
      \u03B3\u03B9\u03B1 \u03BC\u03B5\u03B3\u03AD\u03B8\u03C5\u03BD\u03C3\u03B7,
      \u03C3\u03CD\u03C1\u03B5\u03C4\u03B5 \u03B3\u03B9\u03B1 \u03BC\u03B5\u03C4\u03B1\u03C4\u03CC\u03C0\u03B9\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03C4\u03B5
      \u03C4\u03B7\u03BD \u03A0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B4\u03B5\u03AF\u03C4\u03B5 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03BF
      \u03C4\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403147
    m_Localized: "\u0395\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403148
