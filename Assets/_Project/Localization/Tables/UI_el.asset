    m_Metadata:
      m_Items: []
  - m_Id: 6549031346266
    m_Localized: "\u0395\u03BB\u03AD\u03B3\u03C7\u03B5\u03B9 \u03C4\u03B7\u03BD \u03C4\u03B1\u03C7\u03CD\u03C4\u03B7\u03C4\u03B1
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03BF\u03C0\u03BF\u03AF\u03B1 \u03BF\u03B9
      \u03C0\u03B1\u03AF\u03BA\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2 CPU \u03BA\u03AC\u03BD\u03BF\u03C5\u03BD
