  - m_Id: 686715407687681
    m_Localized: "\u039A\u0391\u039D\u0395 \u0393\u03A1\u0397\u0393\u039F\u03A1\u0391!"
    m_Metadata:
      m_Items: []
  - m_Id: 686715407687682
    m_Localized: "\u03A4\u03B1\u03C7\u03CD\u03C4\u03B7\u03C4\u03B1 \u03AD\u03BD\u03B1\u03C1\u03BE\u03B7\u03C2
      \u03C0\u03B1\u03BD\u03BF\u03C1\u03B1\u03BC\u03B9\u03BA\u03AE\u03C2 \u03BB\u03AE\u03C8\u03B7\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 686715407687683
    m_Localized: "\u03A4\u03B1 \u03C0\u03B9\u03BF \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B1
      drags \u03BC\u03B5\u03C4\u03B1\u03BA\u03B9\u03BD\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF \u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9. \u03A4\u03B1
      \u03C0\u03B9\u03BF \u03B1\u03C1\u03B3\u03AC drags \u03BC\u03B1\u03B6\u03B5\u03CD\u03BF\u03C5\u03BD
      \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2. \u03A0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03CC\u03C3\u03C4\u03B5
      \u03C4\u03BF cutoff \u03CE\u03C3\u03C4\u03B5 \u03BD\u03B1 \u03C4\u03B1\u03B9\u03C1\u03B9\u03AC\u03B6\u03B5\u03B9
      \u03BC\u03B5 \u03C4\u03BF \u03C3\u03C4\u03C5\u03BB \u03B1\u03C6\u03AE\u03C2
      \u03C3\u03B1\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 686715407687684
    m_Localized: "{0:0} \u03C7\u03B9\u03BB./\u03B4\u03B5\u03C5\u03C4."
    m_Metadata:
      m_Items:
      - rid: 4825848269831405569
  - m_Id: 749811656548352
    m_Localized: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03BA\u03CD\u03BB\u03B9\u03C3\u03B7\u03C2
      \u03AC\u03BA\u03C1\u03C9\u03BD"
    m_Metadata:
      m_Items: []
  - m_Id: 749811673325568
    m_Localized: "\u03A0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03CC\u03C3\u03C4\u03B5
      \u03C4\u03BF \u03C0\u03BB\u03AC\u03C4\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03B6\u03CE\u03BD\u03B7\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03AC\u03BA\u03C1\u03B7 \u03C4\u03B7\u03C2 \u03BF\u03B8\u03CC\u03BD\u03B7\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03CD\u03BB\u03B9\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03C0\u03AF\u03BD\u03B1\u03BA\u03B1 \u03B5\u03BD\u03CE \u03BA\u03C1\u03B1\u03C4\u03AC\u03C4\u03B5
      \u03BC\u03B9\u03B1 \u03BA\u03AC\u03C1\u03C4\u03B1 \u03B5\u03BA\u03B5\u03AF."
    m_Metadata:
      m_Items: []
