  - m_Id: 6549035540590
    m_Localized: Nani anatangulia?
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540591
    m_Localized: Mchezaji wa kwanza bila mpangilio
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540592
    m_Localized: Gusa ili kufichua
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540593
    m_Localized: MEJNUN!
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540594
    m_Localized: Mafanikio
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734784
    m_Localized: Mpya katika Ghala
    m_Metadata:
