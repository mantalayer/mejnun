    m_Metadata:
      m_Items: []
  - m_Id: 6549031346179
    m_Localized: Cheza mtandaoni
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346180
    m_Localized: Ingia bila kujulikana na ujiunge na msimbo wa kipindi, au pata ulinganisho
      wa haraka.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346181
    m_Localized: Jina la utani
    m_Metadata:
