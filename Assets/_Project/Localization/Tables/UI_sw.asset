    m_Metadata:
      m_Items: []
  - m_Id: 6549031346183
    m_Localized: Kipima muda cha kugeuka
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346184
    m_Localized: Imezimwa
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346186
