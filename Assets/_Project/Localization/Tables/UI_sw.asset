    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549031346239
    m_Localized: Chagua kipodozi
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346240
    m_Localized: Vinjari mandharinyuma ya deki na ubao.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346241
    m_Localized: Bidhaa hii haipo tena kwenye orodha.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346244
    m_Localized: Mpya katika Ghala
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346245
    m_Localized: Hakikisho halipatikani
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346246
    m_Localized: Upakiaji wa awali
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346247
    m_Localized: Mipangilio
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346248
    m_Localized: Mchezo wa kuigiza
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346250
