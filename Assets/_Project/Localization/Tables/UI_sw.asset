    m_Localized: Kizuizi
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346220
    m_Localized: Angalau kiti kimoja lazima kiwe cha mwanadamu.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346221
    m_Localized: Vipodozi vya mezani
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346222
    m_Localized: Chagua deki mbili na fulana ya meza. Bofya hakikisho ili kuvinjari.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346223
    m_Localized: Anza mchezo
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346225
    m_Localized: Staha isiyo ya kawaida
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346227
    m_Localized: Hisia isiyo ya kawaida
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346228
    m_Localized: Chagua staha {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549031346229
    m_Localized: Chagua fanicha ya meza
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346230
    m_Localized: Haijafunguliwa bado.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346231
    m_Localized: "Bado haijafunguliwa \u2014 {0}"
    m_Metadata:
