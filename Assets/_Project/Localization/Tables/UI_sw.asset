  m_TableData:
  - m_Id: 6548981014530
    m_Localized: Kadi huwekwa mezani kwa seti. Aina hiyo hiyo ni kadi 3 au 4 za cheo
      kimoja, zote ni suti tofauti. Kadi moja kwa moja ni kadi 3 au zaidi za suti
      moja, kwa mpangilio.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208840
    m_Localized: Uko Chini!
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208849
    m_Localized: Maradufu
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208865
    m_Localized: Rudia kurudisha nyuma. Revert huweka upya zamu nzima, na bodi ya
      Fix inajaribu kukutengenezea meza.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208872
    m_Localized: Kukopa kutoka kwa seti
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208878
    m_Localized: Wachezaji walio chini wanaweza pia kuanza seti mpya kabisa kutoka
      mikononi mwao.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208879
    m_Localized: Imekwama
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208885
    m_Localized: "Weka 2\u2665 kwenye 3\u2665 4\u2665 5\u2665."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208893
    m_Localized: Chini
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403141
    m_Localized: Zamu zilizopangwa kwa wakati
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403152
    m_Localized: Kijitabu {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
