  - m_Id: 6549018763269
    m_Localized: Meza Kamili
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763284
    m_Localized: Fikia kiwango cha 50.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763286
    m_Localized: Fungua kila uso na fani ya staha ya bure au inayoweza kulipwa.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763295
    m_Localized: Kurudi
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763297
    m_Localized: Chini ya Waya
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763299
    m_Localized: Barabara ya Kifalme
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763316
    m_Localized: Shinda kwa vidokezo vilivyozimwa.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763321
    m_Localized: Pepo wa Kasi
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957585
    m_Localized: Chagua kwanza kuuliza swali mara 10.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957590
    m_Localized: Shinda {0:plural:{} mchezo|{} michezo}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549022957592
    m_Localized: Ununuzi unahitajika
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957604
    m_Localized: Blueeyedrat Classic Light 1rangi 0
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957605
    m_Localized: Blueeyedrat Classic Light 2rangi 0
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957612
    m_Localized: Sepia 2 ya rangi ya Blueeyedrat Classic 1
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957620
    m_Localized: Nyeusi
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151878
    m_Localized: Wasifu
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151880
    m_Localized: Matunzio
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346185
    m_Localized: '{0:plural:{} sekunde|{} sekunde}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549031346187
    m_Localized: Chagua deki mbili na kisu cha meza. Chaguo za mchezaji zitachaguliwa
      kwa mechi.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346188
    m_Localized: Unda kipindi
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346191
    m_Localized: Ulinganisho wa haraka
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346195
    m_Localized: Ulitoka kwenye ukumbi wa kushawishi.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346200
    m_Localized: Hakuna wachezaji waliounganishwa bado.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346205
    m_Localized: Solo dhidi ya AI
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346210
    m_Localized: '{0:plural:{} sekunde|{} sekunde}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549031346217
    m_Localized: Usawa
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346224
    m_Localized: Sitaha {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549031346226
    m_Localized: Felt ya meza
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346232
    m_Localized: Matunzio
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346234
    m_Localized: Mandharinyuma ya ubao
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346238
    m_Localized: Mpya
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346242
    m_Localized: Inamilikiwa
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346243
    m_Localized: '{0} / {1}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549031346249
    m_Localized: Meza
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346262
    m_Localized: Uliza kabla ya kurudisha kadi batili mkononi mwako.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346267
    m_Localized: Barafu
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346268
    m_Localized: Polepole sana
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346280
    m_Localized: Kiasi cha tao
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346290
    m_Localized: Inua mkono
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346291
    m_Localized: Hurekebisha umbali ambao kadi huinuka zinapochaguliwa au kuelea.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346299
    m_Localized: Huongeza tofauti ndogo ya asili katika uwekaji wa kadi.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346309
    m_Localized: Huwasha maoni ya mtetemo kwenye vifaa vinavyotumika.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346310
    m_Localized: Ukubwa wa kiolesura
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540483
    m_Localized: Huweka sauti ya sauti.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540491
    m_Localized: '{0:plural:{} sekunde|{} sekunde}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549035540496
    m_Localized: "{0}\xD7"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549035540501
    m_Localized: Muuzaji humpa kila mchezaji kadi 11, moja baada ya nyingine, kutoka
      kwa mchezaji wa kwanza kwa mwelekeo wa saa. Kadi zilizobaki hutengeneza rundo
      la droo linaloelekea chini, na mchezaji wa kwanza aliyechaguliwa huchukua zamu
      ya kwanza.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540503
    m_Localized: Kuwa wa kwanza kutoa mkono wako wote ili kushinda. Mchezo ni raundi
      moja; mshindi hutangulia katika mchezo unaofuata.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540504
    m_Localized: Seti za aina moja zina kadi 3-4 za kiwango sawa, huku kila suti
      ikiwa tofauti. Safu zilizonyooka zina kadi 3-13 mfululizo za kiwango sawa,
      bila kiwango kinachorudiwa. Ace inaweza kuwa ya chini (A-2-3) au ya juu (Q-K-A),
      lakini si zote mbili; K-A-2 hairuhusiwi. Kila seti ya ubao lazima iwe halali;
      seti za kadi moja na mbili si halali.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540511
    m_Localized: Zamu zilizopangwa kwa wakati
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540520
    m_Localized: Mwisho wa zamu
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540526
    m_Localized: 'Panga: suti'
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540529
    m_Localized: Marko
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540533
    m_Localized: 'Kidokezo: imewashwa'
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540538
    m_Localized: Imeshuka
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540565
    m_Localized: Thibitisha
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540572
    m_Localized: Wasifu
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540587
    m_Localized: '{0} / {1}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549039734793
    m_Localized: '{0}: {1}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549039734794
    m_Localized: Umemaliza mafunzo. Uko tayari kwa mchezo halisi!
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734800
    m_Localized: Deki mpya imefunguliwa
    m_Metadata:
      m_Items: []
  - m_Id: 1341120512
    m_Localized: Mejnun
    m_Metadata:
      m_Items: []
  - m_Id: 695204831232
    m_Localized: Kiotomatiki (lugha ya kifaa)
    m_Metadata:
      m_Items: []
  - m_Id: 1656669331456
    m_Localized: Sawa
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302976
    m_Localized: Ghairi
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302977
    m_Localized: Rudi
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302978
    m_Localized: Funga
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302979
    m_Localized: Imewashwa
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302980
    m_Localized: Imezimwa
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302981
    m_Localized: Ndiyo
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302982
    m_Localized: Hapana
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302983
    m_Localized: Endelea
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302984
    m_Localized: Imekamilika
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302985
    m_Localized: Imefungwa
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302986
    m_Localized: "Inapakia\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6548909711360
    m_Localized: Karibu Mejnun
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014528
    m_Localized: 'Mejnun anachezwa na deki mbili kamili: kadi 104. Kila mtu anapewa
      11. Kuwa wa kwanza kumimina mkono wako mezani ili kushinda.'
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014529
    m_Localized: Seti
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014531
    m_Localized: Zamu ya {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548985208832
    m_Localized: '{0} anatangulia. Angalia anachofanya.'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548985208833
    m_Localized: '{0} iko chini'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548985208834
    m_Localized: '{0} weka chini seti iliyotengenezwa kwa mkono wake pekee. Hiyo
      inaitwa kwenda chini, na seti moja inatosha.'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548985208835
    m_Localized: Bado hujashuka
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208836
    m_Localized: Huwezi kutumia meza hadi utakapokuwa umechoka. Kwanza, weka seti
      kutoka kwa mkono wako mwenyewe.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208837
    m_Localized: Nenda chini kwanza
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208838
    m_Localized: "Hadi utakapokuwa chini unaweza kucheza seti kwa mkono wako mwenyewe.
      Weka 7\u2665 8\u2665 9\u2665 kwenye meza tupu."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208839
    m_Localized: "Endelea\u2014malizia kuweka kadi zote tatu kutoka mkononi mwako
      ili ushuke."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208841
    m_Localized: 'Sasa meza nzima ni yako kutumia: ongeza kwenye seti yoyote, panga
      upya, gawanya. Na unaweza kuendelea kucheza zamu hii hiyo.'
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208842
    m_Localized: Ongeza kwenye seti
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208843
    m_Localized: "Sasa weka A\u2660 yako kwenye J\u2660 Q\u2660 K\u2660 ya {0}."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548985208844
    m_Localized: Ace
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208845
    m_Localized: Ace inaweza kuwa ya chini (A-2-3) au ya juu (Q-K-A), lakini mnyoofu
      hauzunguki kamwe (K-A-2).
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208846
    m_Localized: Aina hiyo hiyo
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208847
    m_Localized: "Weka 5\u2663 5\u2666 5\u2660 kwenye meza tupu."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208848
    m_Localized: "Endelea\u2014malizia kuweka kadi zote tatu."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208850
    m_Localized: 'Kwa deki mbili, kila kadi ina kadi mbili: suti na cheo kimoja,
      kutoka deki nyingine (nyuma yake inaonekana tofauti). Kadi mbili haziwezi kamwe
      kuwekwa katika seti moja.'
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208851
    m_Localized: Maliza zamu yako
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208852
    m_Localized: Unaweza kumaliza zamu yako wakati kila seti kwenye meza ni halali
      na umecheza angalau kadi moja kutoka mkononi mwako.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208853
    m_Localized: Tazama {0}.
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548985208854
    m_Localized: Seti yoyote ni ya haki
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208855
    m_Localized: "{0} aliongeza 10\u2665 J\u2665 kwenye mioyo yenu na 5\u2665 kwenye
      tano zenu. Ukishakuwa chini unaweza kuongeza kwenye seti yoyote mezani."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548985208856
    m_Localized: Gawanya moja kwa moja
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208857
    m_Localized: "Bonyeza kwa muda mrefu 10\u2665 na uiburute hadi kwenye meza tupu.
      10\u2665 J\u2665 huja nayo."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208858
    m_Localized: Bado sijaweka seti
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208859
    m_Localized: "10\u2665 J\u2665 ina muhtasari mwekundu: si seti halali. Hiyo ni
      sawa katikati ya zamu, lakini huwezi kumaliza zamu yako hadi kila seti iwe
      halali."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208860
    m_Localized: Tumia maradufu yako
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208861
    m_Localized: "Weka 9\u2665 yako kwenye 10\u2665 J\u2665. Ni maradufu ya 9\u2665
      katika seti nyingine, kwa hivyo inaruhusiwa hapa."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208862
    m_Localized: Tendua
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208863
    m_Localized: Umefanya kosa? Tendua hatua moja nyuma. Jaribu.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208864
    m_Localized: Rudia
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208866
    m_Localized: Kila seti ni halali tena. Maliza zamu yako.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208867
    m_Localized: '{0} droo'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548985208868
    m_Localized: '{0} hakuweza kucheza, kwa hivyo alichora. Kuchora kunachukua kadi
      moja kutoka kwenye rundo na kumaliza zamu yako.'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548985208869
    m_Localized: Anzisha kikundi
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208870
    m_Localized: "Weka 3\u2665 4\u2665 kwenye meza tupu. Ni kadi mbili tu, kwa hivyo
      zinaonyesha nyekundu kwa sasa."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208871
    m_Localized: "Endelea\u2014malizia kuweka kadi zote mbili."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208873
    m_Localized: "Aina nne bado inafanya kazi na tatu. Buruta 5\u2665 kati ya tano
      kwenye 3\u2665 4\u2665."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208874
    m_Localized: Seti zote ni halali. Maliza zamu yako.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208875
    m_Localized: Kadi moja imesalia!
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208876
    m_Localized: "Mchezaji anapokosa kadi yake ya mwisho, kiti chake hutetemeka na
      kuonyesha ! \u2014 kila mtu anaweza kuona kwamba anakaribia kushinda."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208877
    m_Localized: Seti mpya
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208880
    m_Localized: "A\u2665 yako haitoshi popote mezani."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208881
    m_Localized: Chora
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208882
    m_Localized: Gusa Chora ili kuchukua kadi na kumaliza zamu yako. Kuchora pia
      hurejesha kadi zozote ulizoweka zamu hii.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208883
    m_Localized: '{0} pia imekwama.'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548985208884
    m_Localized: "Ulichora 2\u2665"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208886
    m_Localized: Asidi ya chini
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208887
    m_Localized: "Sasa A\u2665 inafaa katika sehemu ya chini: A-2-3-4-5\u2665. Cheza
      kadi yako ya mwisho!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208888
    m_Localized: MEJNUN!
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208889
    m_Localized: Umeondoa mkono wako na ukashinda. Mambo machache zaidi ni vizuri
      kujua.
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208890
    m_Localized: Aina hiyo hiyo
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208891
    m_Localized: Sawa
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208892
    m_Localized: Suti mchanganyiko
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208894
    m_Localized: Juu
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403136
    m_Localized: Hakuna kufunga
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403137
    m_Localized: Mara mbili
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403138
    m_Localized: Seti sawa
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403139
    m_Localized: Rundo la kuchomoa tupu
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403140
    m_Localized: Wakati rundo la droo likiisha, droo inakuwa Pasi. Ikiwa kila mtu
      atapiga pasi mfululizo, mchezaji mwenye kadi chache zaidi atashinda. Sare ni
      Sare.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403142
    m_Localized: "Katika michezo iliyopangwa kwa wakati, saa huhesabu kila zamu.
      Inapoisha \u2014 Halas! \u2014 zamu halali huisha, vinginevyo karata zako hurudi
      nyuma na unavuta."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403143
    m_Localized: Rekebisha ubao na urudi nyuma
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403144
    m_Localized: Bodi ya kurekebisha inajaribu kufanya kila seti iwe halali huku
      ikiendelea na mienendo yako. Revert hurudisha meza nzima jinsi ilivyokuwa mwanzoni
      mwa zamu yako.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403145
    m_Localized: Vidokezo na meza
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403146
    m_Localized: Vidokezo huonyesha kadi unazoweza kucheza. Bana ili kukuza, buruta
      hadi kwenye sehemu ya kugeuza, na utumie Fit ili kuona jedwali zima.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403147
    m_Localized: Mchezo unaofuata
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403148
    m_Localized: Mshindi anaongoza katika mchezo unaofuata.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403149
    m_Localized: Layla
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403150
    m_Localized: Wewe
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403151
    m_Localized: Mchezaji {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548989403153
    m_Localized: '{0} (Boti rahisi)'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548989403155
    m_Localized: '{0} (Boti ngumu)'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548989403156
    m_Localized: "Pitisha hadi {0} \u2014 gusa ili kufichua"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548989403157
    m_Localized: Msuguano
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403158
    m_Localized: '{0} ushindi!'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548989403160
    m_Localized: '{0} walimwaga mikono yao.'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548989403161
    m_Localized: '{0} alikuwa na kadi chache zaidi wakati rundo la droo lilipoisha.'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548989403162
    m_Localized: Alama ya kadi chache zaidi ililingana. Chagua ni nani atakayetangulia.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403163
    m_Localized: Nani anapaswa kwenda kwanza?
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403164
    m_Localized: Mechi imesitishwa
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403165
    m_Localized: Mechi inaendelea tena
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403166
    m_Localized: Seva mwenyeji imetenganishwa
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403167
    m_Localized: '{0} alijiunga'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548989403168
    m_Localized: '{0} imeunganishwa'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548989403169
    m_Localized: Wachezaji wote walijiunga
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403170
    m_Localized: '{0} sasa ndiye mwenyeji'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548989403171
    m_Localized: Mchezaji sasa ndiye mwenyeji
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403172
    m_Localized: "Inasubiri wachezaji ({0}/{1})\u2026"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548989403173
    m_Localized: 'Inasubiri wachezaji ({0}/{1})...

      Nambari ya chumba: {2}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6548989403174
    m_Localized: Mchezaji amekataliwa
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403175
    m_Localized: Wasubiri, acha roboti ya Kati ichukue nafasi, au hifadhi na usitishe.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403176
    m_Localized: Subiri / pasi otomatiki
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403177
    m_Localized: Acha AI ichukue nafasi
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403178
    m_Localized: Hifadhi na usitishe
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403179
    m_Localized: Mechi imehifadhiwa na kusimamishwa
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403180
    m_Localized: Mwenyeji anaweza kuendelea na kipindi hiki wakati kila mtu yuko
      tayari.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403181
    m_Localized: Endelea na mechi
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403182
