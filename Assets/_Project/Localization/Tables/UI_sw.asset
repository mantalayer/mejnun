    m_Metadata:
      m_Items: []
  - m_Id: 6549031346251
    m_Localized: Ufikivu
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346252
    m_Localized: Sauti
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346253
    m_Localized: Jumla
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346254
    m_Localized: Sheria
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346255
    m_Localized: Mikopo
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346256
    m_Localized: Mchezo na uthibitisho
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346257
    m_Localized: Thibitisha kurejeshwa kwa ubao
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346258
    m_Localized: Uliza kabla ya kurudisha kadi zote mkononi mwako.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346259
    m_Localized: Thibitisha kuchora kadi
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346260
    m_Localized: Uliza kabla ya kuchora au kupitisha inapopatikana.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346261
    m_Localized: Thibitisha kurekebisha ubao
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346263
    m_Localized: Thibitisha kuondoka au kuanzisha upya
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346264
    m_Localized: Uliza kabla ya kuondoka au kuanzisha tena mchezo.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346265
    m_Localized: Kasi ya kusogeza CPU
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346266
    m_Localized: Hudhibiti jinsi wachezaji wa CPU wanavyofanya shughuli zao haraka.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346269
    m_Localized: Polepole
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346270
    m_Localized: Kawaida
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346271
    m_Localized: Haraka
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346272
    m_Localized: Haraka sana
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346273
    m_Localized: Kila mtu anaweza kushuka zamu ya kwanza
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346274
    m_Localized: Huruhusu kila mchezaji kushuka wakati wa zamu yake ya kwanza.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346275
    m_Localized: Onyesha kitufe cha kusogeza mbele kwa haraka
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346276
    m_Localized: Onyesha kidhibiti cha kasi kupitia zamu za CPU.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346277
    m_Localized: Meza na mkono
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346278
    m_Localized: Kadi iliyoangaziwa
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346279
    m_Localized: Huchora na kuinua kadi kidogo chini ya kielekezi cha kipanya.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346281
    m_Localized: Hurekebisha kiasi cha mkono wako kinachopinda.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346282
    m_Localized: Kadi iliyosambazwa
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346283
    m_Localized: Hubadilisha nafasi kati ya kadi mkononi mwako.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346284
    m_Localized: Ukubwa wa kadi
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346285
    m_Localized: Hubadilisha ukubwa wa kadi zako za mkononi.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346286
    m_Localized: Ukubwa wa kadi ya mpinzani
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346287
    m_Localized: Hubadilisha ukubwa wa kadi zinazoonyeshwa mikononi mwa wachezaji
      wengine.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346288
    m_Localized: Unyeti wa kukuza
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346289
    m_Localized: Hudhibiti jinsi jedwali linavyokuza haraka wakati wa kusogeza.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346292
    m_Localized: Chora visanduku kuzunguka seti
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346293
    m_Localized: Anaelezea kila seti kwenye meza.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346294
    m_Localized: Panga seti kwenye gridi
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346295
    m_Localized: Sehemu huwekwa kwenye gridi nadhifu badala ya kikaboni kote mezani.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346296
    m_Localized: Kadi ya ubao iliyopangwa
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346297
    m_Localized: Hubadilisha nafasi kati ya kadi katika seti za bodi.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346298
    m_Localized: Uchafu wa kadi
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346300
    m_Localized: Vidokezo
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346301
    m_Localized: Kadi muhimu za ubao zenye vidokezo
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346302
    m_Localized: Angazia kadi za ubao zinazoweza kusaidia katika hatua ya kisheria.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346303
    m_Localized: Kadi zenye vidokezo vya kutikisa
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346304
    m_Localized: Hutumia uhuishaji mfupi ili kuvutia umakini kwenye kadi zilizodokezwa.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346305
    m_Localized: Ufikivu
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346306
    m_Localized: Punguza mwendo
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346307
    m_Localized: Hupunguza mwendo na uhuishaji usio wa lazima.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346308
    m_Localized: Haptiki
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346311
    m_Localized: Maandishi na vidhibiti vya kiolesura cha mizani kwenye vifaa vya
      mkononi.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346312
    m_Localized: Sauti
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346313
    m_Localized: Kiasi cha Mwalimu
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346314
    m_Localized: Huweka kiwango cha jumla cha mchezo.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346315
    m_Localized: Kiasi cha muziki
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346316
    m_Localized: Huweka sauti ya muziki wa usuli.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540480
    m_Localized: Kiasi cha athari
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540481
    m_Localized: Huweka kiwango cha athari za kadi na kiolesura.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540482
    m_Localized: Kiasi cha sauti
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540484
    m_Localized: Lugha
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540485
    m_Localized: Lugha
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540486
    m_Localized: Huchagua lugha ya kiolesura.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540487
    m_Localized: Mtandaoni
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540488
    m_Localized: Jaza mechi za haraka na roboti
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540489
    m_Localized: Huweka muda wa mechi kusubiri kabla ya kuongeza wachezaji wa CPU.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540490
    m_Localized: Imezimwa
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540492
    m_Localized: Akaunti
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540493
    m_Localized: Vipengele vya akaunti vinakuja baadaye
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540494
    m_Localized: Vipengele vya akaunti bado havipatikani.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540495
    m_Localized: '{0}%'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549035540497
    m_Localized: Vipengele na wachezaji
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540498
    m_Localized: "Mejnun hutumia deki mbili za kawaida zenye kadi 52 zilizochanganywa:
      jumla ya kadi 104, bila vichekesho. Kadi zinazolingana kutoka deki hizo mbili
      ni za watu wawili. Cheza na wachezaji 2\u20136, ukisonga kwa mwendo wa saa
      (kushoto)."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540499
    m_Localized: Nani anatangulia na kushughulika
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540500
    m_Localized: 'Kompyuta inakubali. Mshindi wa mchezo uliopita anaongoza ikiwa
      bado wanacheza. Vinginevyo, wachezaji huchagua nani anaongoza kwa swali: gusa
      kiti ndani au dhidi ya akili bandia, au piga kura mtandaoni. Kura za mtandaoni
      huchukua sekunde 20; sare huvunjika bila mpangilio.'
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540502
    m_Localized: Lengo na seti halali
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540505
    m_Localized: Kushuka chini
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540506
    m_Localized: Kabla ya kushuka, unaweza kutengeneza seti mpya kwa kutumia kadi
      pekee kutoka kwa mkono wako; huwezi kutumia au kubadilisha seti zilizopo za
      ubao. Unaweza kucheza seti moja au zaidi, bila pointi za chini kabisa. Ukishathibitisha
      angalau seti moja halali ya mkono pekee, umeshuka na unaweza kutumia ubao mzima
      kwa zamu iliyobaki. Kadi zinazotumika kushuka hubaki kwenye ubao kwa zamu hiyo.
      Tendua au Rudisha nyuma zinaweza kutendua kushuka.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540507
    m_Localized: Unaposhuka, unaweza kupanga upya ubao, ikiwa ni pamoja na kuufanya
      usiwe halali kwa muda. Ili kumaliza zamu yako, ubao lazima uwe halali na lazima
      uwe umecheza angalau kadi moja kutoka mkononi mwako.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540508
    m_Localized: Vitendo vya kugeuza
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540509
    m_Localized: Chora (au Pitisha wakati rundo halina kitu) inapatikana kila wakati.
      Hurejesha ubao mwanzoni mwa zamu yako, hurudisha kadi zako ulizocheza mkononi
      mwako, huchota kadi moja ikiwezekana, na kumaliza zamu yako. Mwisho wa Zamu
      unapatikana wakati ubao unafaa na umecheza kadi ya mkono au umeshuka.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540510
    m_Localized: Tendua hatua nyuma kupitia hatua zako; Rudia tena hatua isiyotekelezwa
      katika zamu ile ile. Hatua mpya na vitendo vya kugeuza huondoa Rudia. Bodi
      ya Kurekebisha hujaribu kuweka michezo halali kutoka kwa mkono wako wakati
      wa kurekebisha ubao; kadi ambazo haziwezi kutumia hurudi kwenye mkono wako.
      Revert hurejesha ubao katika hali yake ya kuanza kugeuka na hurudisha kadi
      zako zilizochezwa kwenye mkono wako. Vitendo vya uharibifu vinaweza kukuomba
      uthibitishe.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540512
    m_Localized: Mwenyeji anaweza kuchagua sekunde 30, 60, 90, au 120 kwa kila zamu,
      au kuzima kipima muda katika michezo ya nje ya mtandao. Michezo ya mtandaoni
      hupangwa kila wakati. Wakati unapoisha, ubao halali usio na michezo ya mkono
      huwekwa na unachora; ubao batili usio na michezo ya mkono hurejeshwa na unachora.
      Ukicheza kadi za mkono na ubao ni halali, zamu yako huisha bila sare. Ikiwa
      ni batili, mienendo yako hutenduliwa hadi iwe halali; unachora tu ikiwa hakuna
      kadi ya mkono iliyobaki kwenye ubao.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540513
    m_Localized: Tupa rundo la droo na vikwazo
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540514
    m_Localized: 'Wakati rundo la droo likiwa tupu, Droo inakuwa Pasi: hakuna kadi
      inayotolewa na ubao unarudishwa nyuma. Ikiwa kila mchezaji anayeshiriki atapita
      mfululizo bila kucheza kadi, mchezaji mwenye kadi chache zaidi atashinda ikiwa
      ndiye pekee mwenye idadi hiyo. Ikiwa wachezaji watalingana kwa kadi chache
      zaidi, mchezo utakuwa Msuguano bila mshindi.'
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540515
    m_Localized: Mikopo
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540516
    m_Localized: Ubunifu na uundaji wa michezo
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540517
    m_Localized: Imetengenezwa kwa
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540518
    m_Localized: Unity 6, Bomba la Utoaji wa Universal, Mfumo wa Kuingiza, Audiokinetic
      Wwise, Huduma za Michezo ya Unity, na Steamworks.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540519
    m_Localized: Asante kwa kucheza!
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540521
    m_Localized: Tendua
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540522
    m_Localized: Rudia
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540523
    m_Localized: Rudisha
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540524
    m_Localized: Ubao wa kurekebisha
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540525
    m_Localized: 'Panga: cheo'
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540527
    m_Localized: Weka Kamera upya
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540528
    m_Localized: Ubao nadhifu
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540530
    m_Localized: "Kuweka alama\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540531
    m_Localized: Chora
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540532
    m_Localized: Pasi
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540534
    m_Localized: 'Kidokezo: imezimwa'
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540535
    m_Localized: Songa mbele haraka
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540536
    m_Localized: Endelea
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540537
    m_Localized: Halas!
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540539
    m_Localized: "{0} \xB7 Ameanguka"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549035540540
    m_Localized: "{0} anafikiria\u2026"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549035540541
    m_Localized: Zamu yako
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540542
    m_Localized: Zamu ya {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549035540543
    m_Localized: Zamu Yako
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540544
    m_Localized: Zamu ya {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549035540545
    m_Localized: Kiti {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549035540546
    m_Localized: 'Chora rundo: {0}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549035540547
    m_Localized: 'Muda: {0}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549035540548
    m_Localized: Sio zamu yako.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540549
    m_Localized: Uhamisho huo haupatikani kwa sasa.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540550
    m_Localized: Nenda chini kabla ya kutumia kadi kutoka ubaoni.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540551
    m_Localized: Kadi zilizo ubaoni haziwezi kurudishwa mkononi mwako.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540552
    m_Localized: Lazima ucheze hatua halali kabla ya kumaliza zamu yako.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540553
    m_Localized: Seti hiyo haifikii mahitaji ya kupunguzwa.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540554
    m_Localized: Seti haiwezi kuwa na kadi moja mara mbili.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540555
    m_Localized: Seti hiyo ina kadi nyingi mno.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540556
    m_Localized: Kadi hiyo haiwezi kuongezwa kwenye seti hii.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540557
    m_Localized: Chagua mahali halali pa kadi hiyo.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540558
    m_Localized: Hatua hiyo inajumuisha kadi zaidi ya mara moja.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540559
    m_Localized: Chagua angalau kadi moja ya kuhamisha.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540560
    m_Localized: Kadi au seti hiyo haipatikani tena.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540561
    m_Localized: Mchezo huu tayari umekwisha.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540562
    m_Localized: Jaribu kadi zilizoangaziwa.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540563
    m_Localized: Hatua hiyo hairuhusiwi na sheria za mchezo.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540564
    m_Localized: Usiulize tena
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540566
    m_Localized: Rudisha kadi zako zote mkononi mwako?
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540567
    m_Localized: Baadhi ya kadi batili zitarudi mkononi mwako. Umerekebisha ubao?
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540568
    m_Localized: Umeruka mafunzo? Unaweza kuyarudia wakati wowote kutoka Jinsi ya
      kucheza.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540569
    m_Localized: Umerudi kwenye menyu kuu? Mchezo huu utahifadhiwa ili uweze kuuendeleza
      baadaye.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540570
    m_Localized: Utaanza upya mchezo huu? Raundi ya sasa itapotea.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540571
    m_Localized: Imesitishwa
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540573
    m_Localized: Anzisha upya mchezo
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540574
    m_Localized: Mipangilio
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540575
    m_Localized: Ruka mafunzo
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540576
    m_Localized: Msaada
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540577
    m_Localized: Menyu kuu
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540578
    m_Localized: 'Nambari ya chumba: {0}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282629
  - m_Id: 6549035540579
    m_Localized: Njia za mkato za PC
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540580
    m_Localized: 'Ctrl/Cmd+Z Tendua

      Ctrl/Cmd+Shift+Z au Ctrl+Y Rudia

      Mwisho
      wa Nafasi Mgeuko

      D Chora / pitisha

      Rudisha R

      Ubao wa Kurekebisha
      F

      Kidokezo cha H

      F1 Karatasi hii

      Esc au P Pumzika'
    m_Metadata:
      m_Items: []
