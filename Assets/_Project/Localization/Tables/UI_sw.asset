  - m_Id: 6549014568960
    m_Localized: Mchezo wa Kwanza
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568961
    m_Localized: Maliza mchezo wako wa kwanza.
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568962
    m_Localized: Ushindi wa Kwanza
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568963
    m_Localized: Shinda mchezo wako wa kwanza.
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568964
    m_Localized: MEJNUN ya kwanza
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763264
    m_Localized: Shinda kwa kuondoa vitu vyote mkononi mwako.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763265
    m_Localized: Ushindi Kumi
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763266
    m_Localized: Shinda michezo 10.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763267
    m_Localized: Shinda Boti Ngumu
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763268
    m_Localized: Piga roboti ngumu.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763270
    m_Localized: Cheza mchezo wenye viti sita.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763271
    m_Localized: Kawaida
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763272
    m_Localized: Cheza michezo 50.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763273
    m_Localized: Mkongwe
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763274
    m_Localized: Cheza michezo 250.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763275
    m_Localized: Imetiwa viungo
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763276
    m_Localized: Shinda michezo 50.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763277
    m_Localized: Mwalimu wa MEJNUN
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763278
    m_Localized: Shinda michezo 200.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763279
    m_Localized: Kiwango cha 10
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763280
    m_Localized: Fikia kiwango cha 10.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763281
    m_Localized: Kiwango cha 25
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763282
    m_Localized: Fikia kiwango cha 25.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763283
    m_Localized: Kiwango cha 50
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763285
    m_Localized: Mkusanyaji
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763287
    m_Localized: "MEJNUN \xD710"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763288
    m_Localized: Shinda michezo 10 kwa kuondoa vitu vyote mkononi mwako.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763289
    m_Localized: Safisha Safi
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763290
    m_Localized: Shuka chini na utoe vitu mkononi mwako kwa zamu ile ile, huku vidokezo
      na Ubao wa Kurekebisha ukiwa umezimwa.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763291
    m_Localized: Umeme
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763292
    m_Localized: Shinda ndani ya zamu zako tano za kwanza.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763293
    m_Localized: Ghafla ya Mwisho
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763294
    m_Localized: Shinda kwa kuondoa vitu vyote mkononi mwako huku rundo la kuteka
      likiwa tupu.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763296
    m_Localized: Shinda baada ya kushikilia kadi 20 au zaidi.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763298
    m_Localized: Shinda hesabu ya mwisho wa rundo kwa kadi moja haswa.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763300
    m_Localized: Tengeneza kadi kamili 13 moja kwa moja kutoka kwa Ace hadi mfalme.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763301
    m_Localized: Ace ya Juu
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763302
    m_Localized: Kamilisha malkia-mfalme-ace moja kwa moja.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763303
    m_Localized: Mlango Mkubwa
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763304
    m_Localized: Nenda chini na angalau seti tatu kwa wakati mmoja.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763305
    m_Localized: Mbunifu majengo
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763306
    m_Localized: Weka angalau kadi nane za mkono kwa zamu moja.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763307
    m_Localized: Daktari wa upasuaji
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763308
    m_Localized: Gawanya mkato ulionyooka na umalizie zamu kwa ubao halali.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763309
    m_Localized: Muda Uliokopwa
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763310
    m_Localized: Chukua kadi kutoka kwa seti ya kadi nne za aina moja na uitumie.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763311
    m_Localized: Kuona Mara Mbili
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763312
    m_Localized: Maliza zamu yako kwa nakala zote mbili za kadi kwenye seti tofauti.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763313
    m_Localized: Mgonjwa
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763314
    m_Localized: Shinda bila kutumia Ubao wa Kutendua, Kurudisha Nyuma, au Kurekebisha.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763315
    m_Localized: Hakuna Magurudumu ya Mafunzo
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763317
    m_Localized: Halas!
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763318
    m_Localized: Pata muda wako wa kupumzika.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763319
    m_Localized: Baridi Chini ya Shinikizo
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763320
    m_Localized: Maliza zamu halali zikiwa zimesalia chini ya sekunde tatu.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763322
    m_Localized: Shinda mchezo uliochezwa kwenye kipima muda cha sekunde 30.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957568
    m_Localized: Mwuaji Mkubwa
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957569
    m_Localized: Shinda dhidi ya roboti tano ngumu katika jedwali kamili.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957570
    m_Localized: Ujanja wa Kofia
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957571
    m_Localized: Shinda michezo mitatu mfululizo ya roboti.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957572
    m_Localized: Haizuiliwi
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957573
    m_Localized: Shinda michezo mitano mfululizo.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957574
    m_Localized: Kwenda Mtandaoni
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957575
    m_Localized: Maliza mchezo wa mtandaoni.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957576
    m_Localized: Mrithi wa Umati
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957577
    m_Localized: Shinda mchezo wa mtandaoni ukiwa na angalau wachezaji wanne wa kibinadamu.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957578
    m_Localized: Mwenyeji wa Sherehe
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957579
    m_Localized: Mwenyeji wa michezo 10 mtandaoni.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957580
    m_Localized: Ipitishe
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957581
    m_Localized: Maliza mchezo wa kupitisha na kucheza na angalau wanadamu wanne.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957582
    m_Localized: Hata Steven
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957583
    m_Localized: Maliza mchezo katika hali ya kutofungana.
    m_Metadata:
      m_Items: []
