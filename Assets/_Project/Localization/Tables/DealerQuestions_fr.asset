MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DealerQuestions_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 87a4643bee3d747fb9ab730fc39509cd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6547924049920
    m_Localized: "Qui serait le plus susceptible d'oublier pourquoi il est entr\xE9
      dans une pi\xE8ce ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244224
    m_Localized: Qui raconte les pires blagues ?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244225
    m_Localized: Qui dansera en premier lors d'un mariage ?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244226
    m_Localized: "Qui poss\xE8de la galerie photo la plus chaotique sur son t\xE9l\xE9phone
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244227
    m_Localized: "Qui survivrait le plus longtemps sur une \xEEle d\xE9serte ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244228
    m_Localized: Qui est le plus susceptible de lancer une tendance par inadvertance
      ?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244229
    m_Localized: Qui a l'anniversaire le plus proche d'aujourd'hui ?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244230
    m_Localized: "Qui a pris sa douche le plus r\xE9cemment ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276106395648
    m_Localized: Qui est le plus susceptible d'organiser un spectacle de drag queens
      ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561472
    m_Localized: "Qui a les cheveux les plus boucl\xE9s (et donc les plus jolis)
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561473
    m_Localized: "Qui est le plus difficile \xE0 table ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561474
    m_Localized: "Qui est le plus susceptible de gifler quelqu'un qui a donn\xE9
      une gifle ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561475
    m_Localized: Qui est capable de soulever des poids, mec ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561476
    m_Localized: Qui a le meilleur sens du rythme ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561477
    m_Localized: "Qui peut compter le plus de d\xE9cimales de pi ? Mmm, tarte..."
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561478
    m_Localized: "Si vous \xE9tiez coinc\xE9 sur une \xEEle d\xE9serte avec seulement
      un \xE9cureuil et deux cure-dents... Qui attraperait l'\xE9cureuil, ou quelque
      chose comme \xE7a ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561479
    m_Localized: "Qui est le plus exp\xE9riment\xE9 en mati\xE8re de comptage de
      haricots ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561480
    m_Localized: Qui est le plus bavard ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561481
    m_Localized: Qui a les rots les plus odorants ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561482
    m_Localized: Qui est le meilleur pour deviner le poids des gens ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561483
    m_Localized: "Qui peut construire le meilleur tr\xE9buchet ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561484
    m_Localized: Qui est le meilleur cuisinier ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561485
    m_Localized: "Qui br\xFBle le plus de nourriture en cuisinant ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561486
    m_Localized: "Qui a le plus grand tour de t\xEAte ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561487
    m_Localized: "Qui est le plus susceptible d'oublier son t\xE9l\xE9phone dans
      le r\xE9frig\xE9rateur ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561488
    m_Localized: "Qui est le plus susceptible de laisser la t\xE9l\xE9commande au
      cong\xE9lateur ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561489
    m_Localized: Qui joue du plus d'instruments ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561490
    m_Localized: Qui est le plus mauvais musicien ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561491
    m_Localized: "Qui mettrait le plus de temps \xE0 construire un meuble ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561492
    m_Localized: "Qui est le plus obs\xE9d\xE9 par les chats ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561493
    m_Localized: "Qui est le plus obs\xE9d\xE9 par les chiens ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561494
    m_Localized: Qui sent le plus le sureau ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561495
    m_Localized: "Qui a le bleu comme couleur pr\xE9f\xE9r\xE9e ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561496
    m_Localized: Qui a le plus de chances de combattre un ours (et de gagner) ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561497
    m_Localized: "Qui perd le plus \xE0 Las Vegas ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561498
    m_Localized: Qui sait ce qu'est une douche tout-en-un ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561499
    m_Localized: Qui est le plus souvent en ligne ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561500
    m_Localized: "Vite, je pense \xE0 un nombre entre 81 et 976 ! Qui a devin\xE9
      222 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561501
    m_Localized: "Qui est le plus susceptible de piquer une crise de rage en jouant
      aux jeux vid\xE9o ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561502
    m_Localized: "Qui est le plus comp\xE9titif ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561503
    m_Localized: Qui a le plus envie de commencer ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561504
    m_Localized: Qui a le moins envie de passer en premier ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561505
    m_Localized: "Combattez ! Qui a gagn\xE9 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561506
    m_Localized: Qui n'a pas du tout envie d'y aller ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561507
    m_Localized: Qui n'aime pas la couleur violette ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561508
    m_Localized: Qui a le plus de cheveux gris ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561509
    m_Localized: Qui a le moins de poils ? Je parle des poils du corps.
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561510
    m_Localized: Qui a fait la vaisselle en dernier ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561511
    m_Localized: "Qui poss\xE8de la plus grande collection de jeux ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561512
    m_Localized: "Qui est le mieux plac\xE9 pour expliquer la th\xE9orie quantique
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561513
    m_Localized: Qui a la meilleure vision ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561514
    m_Localized: Qui parle le plus de langues ?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561515
    m_Localized: "Qui poss\xE8de le plus de chats ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561516
    m_Localized: "Qui peut r\xE9gler un carburateur ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561517
    m_Localized: "Qui a visit\xE9 le plus de pays ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561518
    m_Localized: Qui peut courir le plus loin ? Testez-le avant le match !
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561519
    m_Localized: "Qui d\xE9tournerait le tramway vers cinq personnes ?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561520
    m_Localized: Inventez une question, mais ne dites pas que je vous ai dit de...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
