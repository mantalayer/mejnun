  m_TableData:
  - m_Id: 6547924049920
    m_Localized: "Qui serait le plus susceptible d'oublier pourquoi il est entr\xE9
      dans une pi\xE8ce ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244224
    m_Localized: Qui raconte les pires blagues ?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244225
    m_Localized: Qui dansera en premier lors d'un mariage ?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244226
    m_Localized: "Qui poss\xE8de la galerie photo la plus chaotique sur son t\xE9l\xE9phone
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244227
    m_Localized: "Qui survivrait le plus longtemps sur une \xEEle d\xE9serte ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244228
    m_Localized: Qui est le plus susceptible de lancer une tendance par inadvertance
      ?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244229
    m_Localized: Qui a son anniversaire le plus proche d'aujourd'hui ?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244230
    m_Localized: "Qui a pris sa douche le plus r\xE9cemment ?"
    m_Metadata:
      m_Items: []
