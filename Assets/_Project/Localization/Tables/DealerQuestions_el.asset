    m_Localized: "\u03A0\u03BF\u03B9\u03BF\u03C2 \u03BA\u03B1\u03AF\u03B5\u03B9 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03BF
