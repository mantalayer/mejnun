  m_SharedData: {fileID: 11400000, guid: d63316e15cef2427c94a329ac604c22b, type: 2}
  m_Metadata:
    m_Items:
    - rid: 4825848250703282619
  m_TableData:
  - m_Id: 1656690302980
    m_Localized: "T\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014528
    m_Localized: "Tr\xF2 ch\u01A1i Mejnun s\u1EED d\u1EE5ng hai b\u1ED9 b\xE0i \u0111\u1EA7y
      \u0111\u1EE7: 104 l\xE1. M\u1ED7i ng\u01B0\u1EDDi ch\u01A1i \u0111\u01B0\u1EE3c
      chia 11 l\xE1. Ai l\xE0 ng\u01B0\u1EDDi \u0111\u1EA7u ti\xEAn h\u1EBFt b\xE0i
      tr\xEAn tay s\u1EBD th\u1EAFng."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208839
    m_Localized: "Ti\u1EBFp t\u1EE5c n\xE0o\u2014ho\xE0n th\xE0nh vi\u1EC7c \u0111\u1EB7t
      c\u1EA3 ba l\xE1 b\xE0i t\u1EEB tay b\u1EA1n xu\u1ED1ng theo chi\u1EC1u \xFAp."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208841
    m_Localized: "Gi\u1EDD th\xEC to\xE0n b\u1ED9 b\xE0n c\u1EDD thu\u1ED9c quy\u1EC1n
      s\u1EED d\u1EE5ng c\u1EE7a b\u1EA1n: th\xEAm v\xE0o b\u1EA5t k\u1EF3 b\u1ED9
      n\xE0o, s\u1EAFp x\u1EBFp l\u1EA1i, chia nh\u1ECF. V\xE0 b\u1EA1n c\xF3 th\u1EC3
      ti\u1EBFp t\u1EE5c ch\u01A1i ngay trong l\u01B0\u1EE3t n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208847
    m_Localized: "\u0110\u1EB7t 5\u2663 5\u2666 5\u2660 l\xEAn b\xE0n tr\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208851
    m_Localized: "K\u1EBFt th\xFAc l\u01B0\u1EE3t c\u1EE7a b\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208852
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 k\u1EBFt th\xFAc l\u01B0\u1EE3t ch\u01A1i
      khi t\u1EA5t c\u1EA3 c\xE1c b\u1ED9 b\xE0i tr\xEAn b\xE0n \u0111\u1EC1u h\u1EE3p
      l\u1EC7 v\xE0 b\u1EA1n \u0111\xE3 ch\u01A1i \xEDt nh\u1EA5t m\u1ED9t l\xE1
      b\xE0i t\u1EEB tay m\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208853
    m_Localized: Xem {0}.
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548985208859
    m_Localized: "10\u2665 J\u2665 c\xF3 vi\u1EC1n \u0111\u1ECF: \u0111\xE2y kh\xF4ng
      ph\u1EA3i l\xE0 m\u1ED9t b\u1ED9 h\u1EE3p l\u1EC7. \u0110i\u1EC1u \u0111\xF3
      kh\xF4ng sao n\u1EBFu b\u1EA1n \u0111ang \u1EDF gi\u1EEFa l\u01B0\u1EE3t ch\u01A1i,
      nh\u01B0ng b\u1EA1n kh\xF4ng th\u1EC3 k\u1EBFt th\xFAc l\u01B0\u1EE3t ch\u01A1i
      cho \u0111\u1EBFn khi m\u1ECDi b\u1ED9 \u0111\u1EC1u h\u1EE3p l\u1EC7."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208876
    m_Localized: "Khi m\u1ED9t ng\u01B0\u1EDDi ch\u01A1i ch\u1EC9 c\xF2n l\u1EA1i
      l\xE1 b\xE0i cu\u1ED1i c\xF9ng, gh\u1EBF c\u1EE7a h\u1ECD s\u1EBD rung l\xEAn
      v\xE0 hi\u1EC7n d\u1EA5u ch\u1EA5m than (!) \u2014 m\u1ECDi ng\u01B0\u1EDDi
      \u0111\u1EC1u bi\u1EBFt h\u1ECD s\u1EAFp th\u1EAFng."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208892
    m_Localized: "B\u1ED9 \u0111\u1ED3 h\u1ED7n h\u1EE3p"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403147
    m_Localized: "Tr\u1EADn \u0111\u1EA5u ti\u1EBFp theo"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403151
    m_Localized: "Ng\u01B0\u1EDDi ch\u01A1i {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403157
    m_Localized: "B\u1EBF t\u1EAFc"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403165
    m_Localized: "Tr\u1EADn \u0111\u1EA5u ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403177
    m_Localized: "H\xE3y \u0111\u1EC3 tr\xED tu\u1EC7 nh\xE2n t\u1EA1o (AI) ti\u1EBFp
      qu\u1EA3n."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403178
    m_Localized: "L\u01B0u v\xE0 t\u1EA1m d\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403188
    m_Localized: "\xCA-li-gia"
    m_Metadata:
      m_Items: []
