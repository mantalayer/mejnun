  - m_Id: 6549027151874
    m_Localized: "M\u1ED9t tr\xF2 ch\u01A1i b\xE0i d\u1EF1a tr\xEAn c\xE1c b\u1ED9
      b\xE0i, chi\u1EBFn l\u01B0\u1EE3c v\xE0 m\u1ED9t ch\xFAt h\u1ED7n lo\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151875
    m_Localized: "Ch\u01A1i \u0111\u01A1n \u0111\u1EA5u v\u1EDBi AI"
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151876
    m_Localized: "Ch\u01A1i, chuy\u1EC1n b\xF3ng v\xE0 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151878
    m_Localized: "B\u1EA3n t\xF3m t\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151879
    m_Localized: "Ch\u01A1i tr\u1EF1c tuy\u1EBFn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151880
    m_Localized: "Ph\xF2ng tr\u01B0ng b\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151881
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151882
    m_Localized: "T\u1EEB b\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151883
    m_Localized: "C\u1EA5p \u0111\u1ED9 {0} \xB7 {1} / {2} XP"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549027151884
    m_Localized: v{0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346177
    m_Localized: "Ch\u01A1i ph\u1EA7n h\u01B0\u1EDBng d\u1EABn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346178
    m_Localized: "T\xF4i bi\u1EBFt lu\u1EADt l\u1EC7"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346179
    m_Localized: "Ch\u01A1i tr\u1EF1c tuy\u1EBFn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346181
    m_Localized: "Bi\u1EC7t danh"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346182
    m_Localized: "Ng\u01B0\u1EDDi ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346185
    m_Localized: "{0:s\u1ED1 nhi\u1EC1u:{} gi\xE2y|{} gi\xE2y}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346186
    m_Localized: "M\u1EF9 ph\u1EA9m \u0111\u1EC3 b\xE0n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346187
    m_Localized: "Ch\u1ECDn hai b\u1ED9 b\xE0i v\xE0 m\u1ED9t t\u1EA5m v\u1EA3i tr\u1EA3i
      b\xE0n. L\u1EF1a ch\u1ECDn c\u1EE7a ng\u01B0\u1EDDi ch\u01A1i s\u1EBD \u0111\u01B0\u1EE3c
      s\u1EED d\u1EE5ng cho tr\u1EADn \u0111\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346188
    m_Localized: "T\u1EA1o phi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346189
    m_Localized: "M\xE3 phi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346190
    m_Localized: "Tham gia b\u1EB1ng m\xE3"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346191
    m_Localized: "Tr\u1EADn \u0111\u1EA5u nhanh"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346192
    m_Localized: "\u0110ang k\u1EBFt n\u1ED1i\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346193
    m_Localized: "Tr\u01B0\u1EDBc ti\xEAn, h\xE3y tham gia ho\u1EB7c t\u1EA1o m\u1ED9t
      phi\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346194
    m_Localized: "Ban t\u1ED5 ch\u1EE9c \u0111\xE3 h\u1EE7y tr\u1EADn \u0111\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346195
    m_Localized: "B\u1EA1n \u0111\xE3 r\u1EDDi kh\u1ECFi s\u1EA3nh."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346196
    m_Localized: "M\xE3 phi\xEAn kh\xF4ng kh\u1EA3 d\u1EE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346197
    m_Localized: "\u0110ang ch\u1EDD ng\u01B0\u1EDDi ch\u01A1i ({0}/{1})\u2026"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346198
    m_Localized: "B\u1EAFt \u0111\u1EA7u ngay b\xE2y gi\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346199
    m_Localized: "R\u1EDDi kh\u1ECFi s\u1EA3nh"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346200
    m_Localized: "Ch\u01B0a c\xF3 ng\u01B0\u1EDDi ch\u01A1i n\xE0o k\u1EBFt n\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346201
    m_Localized: "\u2022 {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346203
    m_Localized: "Thi\u1EBFt l\u1EADp tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346204
    m_Localized: "C\xE1ch th\u1EE9c"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346205
    m_Localized: "Ch\u01A1i \u0111\u01A1n \u0111\u1EA5u v\u1EDBi AI"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346206
    m_Localized: "Chuy\u1EC1n b\xF3ng v\xE0 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346210
    m_Localized: "{0:s\u1ED1 nhi\u1EC1u:{} gi\xE2y|{} gi\xE2y}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346213
    m_Localized: "Nh\xE2n lo\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346214
    m_Localized: "Bot d\u1EC5 d\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346215
    m_Localized: "Bot c\u1EE1 trung b\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346216
    m_Localized: "Robot c\u1EE9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346217
    m_Localized: "C\xE2n b\u1EB1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346218
    m_Localized: "Ki\u1EC1m ch\u1EBF"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346219
    m_Localized: "Ch\u1EB7n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346221
    m_Localized: "M\u1EF9 ph\u1EA9m \u0111\u1EC3 b\xE0n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346222
    m_Localized: "Ch\u1ECDn hai b\u1ED9 b\xE0i v\xE0 m\u1ED9t t\u1EA5m v\u1EA3i tr\u1EA3i
      b\xE0n. Nh\u1EA5p v\xE0o h\xECnh xem tr\u01B0\u1EDBc \u0111\u1EC3 xem c\xE1c
      b\u1ED9 b\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346224
    m_Localized: "S\xE0n {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346225
    m_Localized: "B\u1ED9 b\xE0i ng\u1EABu nhi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346226
    m_Localized: "M\u1EB7t b\xE0n b\u1EB1ng n\u1EC9"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346227
    m_Localized: "C\u1EA3m gi\xE1c ng\u1EABu nhi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346228
    m_Localized: "Ch\u1ECDn b\u1ED9 b\xE0i {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346229
    m_Localized: "Ch\u1ECDn v\u1EA3i tr\u1EA3i b\xE0n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346230
    m_Localized: "Ch\u01B0a \u0111\u01B0\u1EE3c m\u1EDF kh\xF3a."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346231
    m_Localized: "Ch\u01B0a \u0111\u01B0\u1EE3c m\u1EDF kh\xF3a \u2014 {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346232
    m_Localized: "Ph\xF2ng tr\u01B0ng b\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346234
    m_Localized: "H\xECnh n\u1EC1n b\u1EA3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346235
    m_Localized: "{0} / {1} b\u1ED9 b\xE0i \u0111\u01B0\u1EE3c s\u1EDF h\u1EEFu"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346236
    m_Localized: "{0} / {1} h\xECnh n\u1EC1n b\u1EA3ng \u0111\u01B0\u1EE3c s\u1EDF
      h\u1EEFu"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346237
    m_Localized: "\U0001F512 {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346238
    m_Localized: "M\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346239
    m_Localized: "Ch\u1ECDn m\u1ED9t lo\u1EA1i m\u1EF9 ph\u1EA9m"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346240
    m_Localized: "Xem c\xE1c b\u1ED9 b\xE0i v\xE0 h\xECnh n\u1EC1n b\xE0n c\u1EDD."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346242
    m_Localized: "Thu\u1ED9c s\u1EDF h\u1EEFu"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346243
    m_Localized: '{0} / {1}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346244
    m_Localized: "\u1EA2nh m\u1EDBi trong Gallery"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346245
    m_Localized: "B\u1EA3n xem tr\u01B0\u1EDBc kh\xF4ng kh\u1EA3 d\u1EE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346246
    m_Localized: "\u0110ang t\u1EA3i b\u1EA3n xem tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346247
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346248
    m_Localized: "L\u1ED1i ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346249
    m_Localized: "B\xE0n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346250
    m_Localized: "G\u1EE3i \xFD"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346251
    m_Localized: "Kh\u1EA3 n\u0103ng ti\u1EBFp c\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346252
    m_Localized: "\xC2m thanh"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346253
    m_Localized: "T\u1ED5ng quan"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346254
    m_Localized: "Quy t\u1EAFc"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346255
    m_Localized: "L\u1EDDi c\u1EA3m \u01A1n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346256
    m_Localized: "L\u1ED1i ch\u01A1i & x\xE1c nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346257
    m_Localized: "X\xE1c nh\u1EADn kh\xF4i ph\u1EE5c b\u1EA3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346258
    m_Localized: "H\xE3y h\u1ECFi tr\u01B0\u1EDBc khi tr\u1EA3 h\u1EBFt b\xE0i v\u1EC1
      tay."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346259
    m_Localized: "X\xE1c nh\u1EADn vi\u1EC7c r\xFAt b\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346260
    m_Localized: "H\xE3y h\u1ECFi tr\u01B0\u1EDBc khi r\xFAt th\u0103m ho\u1EB7c
      chuy\u1EC1n b\xF3ng (n\u1EBFu c\xF3)."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346261
    m_Localized: "X\xE1c nh\u1EADn vi\u1EC7c s\u1EEDa ch\u1EEFa bo m\u1EA1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346262
    m_Localized: "H\xE3y h\u1ECFi tr\u01B0\u1EDBc khi tr\u1EA3 l\u1EA1i nh\u1EEFng
      l\xE1 b\xE0i kh\xF4ng h\u1EE3p l\u1EC7 v\xE0o tay b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346263
    m_Localized: "X\xE1c nh\u1EADn vi\u1EC7c r\u1EDDi \u0111i ho\u1EB7c kh\u1EDFi
      \u0111\u1ED9ng l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346266
    m_Localized: "\u0110i\u1EC1u ch\u1EC9nh t\u1ED1c \u0111\u1ED9 di chuy\u1EC3n
      c\u1EE7a ng\u01B0\u1EDDi ch\u01A1i m\xE1y t\xEDnh."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346267
    m_Localized: "B\u0103ng h\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346268
    m_Localized: "R\u1EA5t ch\u1EADm"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346269
    m_Localized: "Ch\u1EADm"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346270
    m_Localized: "B\xECnh th\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346271
    m_Localized: Nhanh
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346273
    m_Localized: "Ai c\u0169ng c\xF3 th\u1EC3 \u0111i tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346274
    m_Localized: "Cho ph\xE9p m\u1ED7i ng\u01B0\u1EDDi ch\u01A1i b\u1ECB lo\u1EA1i
      ngay trong l\u01B0\u1EE3t ch\u01A1i \u0111\u1EA7u ti\xEAn c\u1EE7a m\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346275
    m_Localized: "Hi\u1EC3n th\u1ECB n\xFAt tua nhanh"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346276
    m_Localized: "Hi\u1EC3n th\u1ECB n\xFAt \u0111i\u1EC1u khi\u1EC3n \u0111\u1EC3
      t\u0103ng t\u1ED1c qu\xE1 tr\xECnh x\u1EED l\xFD c\u1EE7a CPU."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346278
    m_Localized: "L\xE0m n\u1ED5i b\u1EADt th\u1EBB khi di chu\u1ED9t"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346279
    m_Localized: "V\u1EBD \u0111\u01B0\u1EDDng vi\u1EC1n v\xE0 h\u01A1i n\xE2ng th\u1EBB
      l\xEAn d\u01B0\u1EDBi con tr\u1ECF chu\u1ED9t."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346280
    m_Localized: "L\u01B0\u1EE3ng cung"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346281
    m_Localized: "\u0110i\u1EC1u ch\u1EC9nh \u0111\u1ED9 cong c\u1EE7a b\xE0n tay."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346282
    m_Localized: "Tr\u1EA3i b\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346284
    m_Localized: "K\xEDch th\u01B0\u1EDBc th\u1EBB"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346285
    m_Localized: "Thay \u0111\u1ED5i k\xEDch th\u01B0\u1EDBc c\xE1c l\xE1 b\xE0i
      tr\xEAn tay b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346286
    m_Localized: "K\xEDch th\u01B0\u1EDBc th\u1EBB c\u1EE7a \u0111\u1ED1i th\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346287
    m_Localized: "Thay \u0111\u1ED5i k\xEDch th\u01B0\u1EDBc c\xE1c l\xE1 b\xE0i
      hi\u1EC3n th\u1ECB trong tay c\u1EE7a nh\u1EEFng ng\u01B0\u1EDDi ch\u01A1i
      kh\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346288
    m_Localized: "\u0110\u1ED9 nh\u1EA1y thu ph\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346289
    m_Localized: "\u0110i\u1EC1u ch\u1EC9nh t\u1ED1c \u0111\u1ED9 ph\xF3ng to thu
      nh\u1ECF c\u1EE7a b\u1EA3ng khi cu\u1ED9n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346290
    m_Localized: "Gi\u01A1 tay l\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346291
    m_Localized: "\u0110i\u1EC1u ch\u1EC9nh \u0111\u1ED9 cao c\u1EE7a th\u1EBB khi
      \u0111\u01B0\u1EE3c ch\u1ECDn ho\u1EB7c di chu\u1ED9t qua."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346292
    m_Localized: "V\u1EBD c\xE1c khung xung quanh c\xE1c t\u1EADp h\u1EE3p"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346295
    m_Localized: "H\xE3y s\u1EAFp x\u1EBFp c\xE1c b\u1ED9 \u0111\u1ED3 \u0103n theo
      d\u1EA1ng l\u01B0\u1EDBi g\u1ECDn g\xE0ng thay v\xEC b\xE0y tr\xED ng\u1EABu
      nhi\xEAn tr\xEAn b\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346296
    m_Localized: "Tr\u1EA3i b\xE0i tr\xEAn b\xE0n c\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346297
    m_Localized: "Thay \u0111\u1ED5i kho\u1EA3ng c\xE1ch gi\u1EEFa c\xE1c qu\xE2n
      b\xE0i trong b\u1ED9 b\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346298
    m_Localized: "S\u1EF1 l\u1ED9n x\u1ED9n c\u1EE7a th\u1EBB"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346299
    m_Localized: "T\u1EA1o th\xEAm m\u1ED9t ch\xFAt bi\u1EBFn t\u1EA5u t\u1EF1 nhi\xEAn
      cho c\xE1ch s\u1EAFp x\u1EBFp th\u1EBB b\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346300
    m_Localized: "G\u1EE3i \xFD"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346301
    m_Localized: "G\u1EE3i \xFD c\xE1c th\u1EBB b\xE0i h\u1EEFu \xEDch tr\xEAn b\xE0n
      c\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346302
    m_Localized: "N\xEAu b\u1EADt nh\u1EEFng l\xE1 b\xE0i tr\xEAn b\xE0n c\u1EDD
      c\xF3 th\u1EC3 gi\xFAp \xEDch cho m\u1ED9t n\u01B0\u1EDBc \u0111i h\u1EE3p
      ph\xE1p."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346303
    m_Localized: "Th\u1EBB g\u1EE3i \xFD rung l\u1EAFc"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346304
    m_Localized: "S\u1EED d\u1EE5ng m\u1ED9t \u0111o\u1EA1n ho\u1EA1t h\xECnh ng\u1EAFn
      \u0111\u1EC3 thu h\xFAt s\u1EF1 ch\xFA \xFD \u0111\u1EBFn c\xE1c l\xE1 b\xE0i
      \u0111\u01B0\u1EE3c g\u1EE3i \xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346305
    m_Localized: "Kh\u1EA3 n\u0103ng ti\u1EBFp c\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346308
    m_Localized: "Ph\u1EA3n h\u1ED3i x\xFAc gi\xE1c"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346309
    m_Localized: "Cho ph\xE9p ph\u1EA3n h\u1ED3i rung tr\xEAn c\xE1c thi\u1EBFt b\u1ECB
      \u0111\u01B0\u1EE3c h\u1ED7 tr\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346310
    m_Localized: "K\xEDch th\u01B0\u1EDBc giao di\u1EC7n ng\u01B0\u1EDDi d\xF9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346311
    m_Localized: "Giao di\u1EC7n hi\u1EC3n th\u1ECB v\u0103n b\u1EA3n v\xE0 c\xE1c
      n\xFAt \u0111i\u1EC1u khi\u1EC3n c\u1EE7a Scales tr\xEAn thi\u1EBFt b\u1ECB
      di \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346312
    m_Localized: "\xC2m thanh"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346313
    m_Localized: "\xC2m l\u01B0\u1EE3ng ch\xEDnh"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346314
    m_Localized: "Thi\u1EBFt l\u1EADp \xE2m l\u01B0\u1EE3ng t\u1ED5ng th\u1EC3 c\u1EE7a
      tr\xF2 ch\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346316
    m_Localized: "\u0110i\u1EC1u ch\u1EC9nh \xE2m l\u01B0\u1EE3ng nh\u1EA1c n\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540480
    m_Localized: "\xC2m l\u01B0\u1EE3ng hi\u1EC7u \u1EE9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540481
    m_Localized: "Thi\u1EBFt l\u1EADp \xE2m l\u01B0\u1EE3ng hi\u1EC7u \u1EE9ng cho
      card v\xE0 giao di\u1EC7n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540483
    m_Localized: "\u0110i\u1EC1u ch\u1EC9nh \xE2m l\u01B0\u1EE3ng gi\u1ECDng n\xF3i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540484
    m_Localized: "Ng\xF4n ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540485
    m_Localized: "Ng\xF4n ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540486
    m_Localized: "Ch\u1ECDn ng\xF4n ng\u1EEF giao di\u1EC7n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540487
    m_Localized: "Tr\u1EF1c tuy\u1EBFn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540488
    m_Localized: "Ch\u01A1i nhanh c\xE1c tr\u1EADn \u0111\u1EA5u v\u1EDBi bot"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540489
    m_Localized: "Thi\u1EBFt l\u1EADp th\u1EDDi gian ch\u1EDD gi\u1EEFa c\xE1c tr\u1EADn
      \u0111\u1EA5u nhanh tr\u01B0\u1EDBc khi th\xEAm ng\u01B0\u1EDDi ch\u01A1i m\xE1y."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540491
    m_Localized: "{0:s\u1ED1 nhi\u1EC1u:{} gi\xE2y|{} gi\xE2y}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540492
    m_Localized: "T\xE0i kho\u1EA3n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540493
    m_Localized: "C\xE1c t\xEDnh n\u0103ng t\xE0i kho\u1EA3n s\u1EBD \u0111\u01B0\u1EE3c
      b\u1ED5 sung sau."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540494
    m_Localized: "C\xE1c t\xEDnh n\u0103ng t\xE0i kho\u1EA3n hi\u1EC7n ch\u01B0a
      kh\u1EA3 d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540495
    m_Localized: '{0}%'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540496
    m_Localized: "{0}\xD7"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540497
    m_Localized: "C\xE1c th\xE0nh ph\u1EA7n v\xE0 ng\u01B0\u1EDDi ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540498
    m_Localized: "Mejnun s\u1EED d\u1EE5ng hai b\u1ED9 b\xE0i ti\xEAu chu\u1EA9n
      52 l\xE1 \u0111\xE3 \u0111\u01B0\u1EE3c x\xE1o tr\u1ED9n: t\u1ED5ng c\u1ED9ng
      104 l\xE1 b\xE0i, kh\xF4ng c\xF3 l\xE1 Joker. C\xE1c l\xE1 b\xE0i gi\u1ED1ng
      nhau t\u1EEB hai b\u1ED9 b\xE0i \u0111\u01B0\u1EE3c t\xEDnh l\xE0 \u0111\xF4i.
      Ch\u01A1i v\u1EDBi 2\u20136 ng\u01B0\u1EDDi, theo chi\u1EC1u kim \u0111\u1ED3ng
      h\u1ED3 (sang tr\xE1i)."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540499
    m_Localized: "Ai \u0111i tr\u01B0\u1EDBc v\xE0 c\xE1ch gi\u1EA3i quy\u1EBFt v\u1EA5n
      \u0111\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540500
    m_Localized: "M\xE1y t\xEDnh s\u1EBD quy\u1EBFt \u0111\u1ECBnh ng\u01B0\u1EDDi
      ch\u01A1i. Ng\u01B0\u1EDDi th\u1EAFng cu\u1ED9c \u1EDF v\xE1n tr\u01B0\u1EDBc
      s\u1EBD ch\u01A1i tr\u01B0\u1EDBc n\u1EBFu h\u1ECD v\u1EABn c\xF2n tham gia.
      N\u1EBFu kh\xF4ng, ng\u01B0\u1EDDi ch\u01A1i s\u1EBD ch\u1ECDn ng\u01B0\u1EDDi
      ch\u01A1i tr\u01B0\u1EDBc b\u1EB1ng c\xE1ch tr\u1EA3 l\u1EDDi c\xE2u h\u1ECFi:
      ch\u1ECDn ch\u1ED7 ng\u1ED3i c\u1EE5c b\u1ED9 ho\u1EB7c \u0111\u1EA5u v\u1EDBi
      AI, ho\u1EB7c b\u1ECF phi\u1EBFu tr\u1EF1c tuy\u1EBFn. Th\u1EDDi gian b\u1ECF
      phi\u1EBFu tr\u1EF1c tuy\u1EBFn k\xE9o d\xE0i 20 gi\xE2y; tr\u01B0\u1EDDng
      h\u1EE3p h\xF2a s\u1EBD \u0111\u01B0\u1EE3c ph\xE2n \u0111\u1ECBnh ng\u1EABu
      nhi\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540501
    m_Localized: "Ng\u01B0\u1EDDi chia b\xE0i s\u1EBD chia 11 l\xE1 b\xE0i cho m\u1ED7i
      ng\u01B0\u1EDDi ch\u01A1i, l\u1EA7n l\u01B0\u1EE3t t\u1EEBng l\xE1 m\u1ED9t,
      theo chi\u1EC1u kim \u0111\u1ED3ng h\u1ED3 b\u1EAFt \u0111\u1EA7u t\u1EEB ng\u01B0\u1EDDi
      ch\u01A1i \u0111\u1EA7u ti\xEAn. C\xE1c l\xE1 b\xE0i c\xF2n l\u1EA1i \u0111\u01B0\u1EE3c
      \xFAp xu\u1ED1ng th\xE0nh ch\u1ED3ng b\xE0i r\xFAt, v\xE0 ng\u01B0\u1EDDi ch\u01A1i
      \u0111\u01B0\u1EE3c ch\u1ECDn \u0111\u1EA7u ti\xEAn s\u1EBD ch\u01A1i l\u01B0\u1EE3t
      \u0111\u1EA7u ti\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540502
    m_Localized: "M\u1EE5c ti\xEAu & t\u1EADp h\u1EE3p h\u1EE3p l\u1EC7"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540503
    m_Localized: "H\xE3y l\xE0 ng\u01B0\u1EDDi \u0111\u1EA7u ti\xEAn h\u1EBFt b\xE0i
      trong tay \u0111\u1EC3 gi\xE0nh chi\u1EBFn th\u1EAFng. M\u1ED7i v\xE1n ch\u01A1i
      ch\u1EC9 c\xF3 m\u1ED9t v\xF2ng; ng\u01B0\u1EDDi th\u1EAFng cu\u1ED9c s\u1EBD
      \u0111i tr\u01B0\u1EDBc trong v\xE1n ti\u1EBFp theo."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540504
    m_Localized: "C\xE1c b\u1ED9 b\xE0i c\xF9ng lo\u1EA1i g\u1ED3m 3-4 l\xE1 b\xE0i
      c\xF9ng h\u1EA1ng, m\u1ED7i l\xE1 kh\xE1c ch\u1EA5t. S\u1EA3nh g\u1ED3m 3-13
      l\xE1 b\xE0i li\xEAn ti\u1EBFp c\xF9ng ch\u1EA5t, kh\xF4ng c\xF3 h\u1EA1ng
      n\xE0o l\u1EB7p l\u1EA1i. \xC1t c\xF3 th\u1EC3 th\u1EA5p (A-2-3) ho\u1EB7c
      cao (Q-K-A), nh\u01B0ng kh\xF4ng bao gi\u1EDD c\u1EA3 hai; K-A-2 kh\xF4ng \u0111\u01B0\u1EE3c
      ph\xE9p. M\u1ED7i b\u1ED9 b\xE0i tr\xEAn b\xE0n ph\u1EA3i h\u1EE3p l\u1EC7;
      c\xE1c b\u1ED9 m\u1ED9t v\xE0 hai l\xE1 b\xE0i kh\xF4ng h\u1EE3p l\u1EC7."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540505
    m_Localized: "\u0110i xu\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540506
    m_Localized: "Tr\u01B0\u1EDBc khi b\u1ECB lo\u1EA1i, b\u1EA1n c\xF3 th\u1EC3
      t\u1EA1o b\u1ED9 b\xE0i m\u1EDBi ch\u1EC9 b\u1EB1ng c\xE1c l\xE1 b\xE0i tr\xEAn
      tay; b\u1EA1n kh\xF4ng th\u1EC3 s\u1EED d\u1EE5ng ho\u1EB7c thay \u0111\u1ED5i
      c\xE1c b\u1ED9 b\xE0i hi\u1EC7n c\xF3 tr\xEAn b\xE0n. B\u1EA1n c\xF3 th\u1EC3
      ch\u01A1i m\u1ED9t ho\u1EB7c nhi\u1EC1u b\u1ED9 b\xE0i, kh\xF4ng c\xF3 \u0111i\u1EC3m
      t\u1ED1i thi\u1EC3u. Khi b\u1EA1n x\xE1c nh\u1EADn \u0111\u01B0\u1EE3c \xEDt
      nh\u1EA5t m\u1ED9t b\u1ED9 b\xE0i h\u1EE3p l\u1EC7 ch\u1EC9 s\u1EED d\u1EE5ng
      b\xE0i tr\xEAn tay, b\u1EA1n b\u1ECB lo\u1EA1i v\xE0 c\xF3 th\u1EC3 s\u1EED
      d\u1EE5ng to\xE0n b\u1ED9 b\xE0n c\u1EDD trong ph\u1EA7n c\xF2n l\u1EA1i c\u1EE7a
      l\u01B0\u1EE3t ch\u01A1i. C\xE1c l\xE1 b\xE0i \u0111\u01B0\u1EE3c s\u1EED d\u1EE5ng
      \u0111\u1EC3 lo\u1EA1i b\u1ECF s\u1EBD v\u1EABn \u1EDF tr\xEAn b\xE0n c\u1EDD
      trong l\u01B0\u1EE3t \u0111\xF3. Ho\xE0n t\xE1c ho\u1EB7c Kh\xF4i ph\u1EE5c
      c\xF3 th\u1EC3 h\u1EE7y b\u1ECF vi\u1EC7c b\u1ECB lo\u1EA1i b\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540507
    m_Localized: "Khi b\u1ECB h\u1EA1 g\u1EE5c, b\u1EA1n c\xF3 th\u1EC3 s\u1EAFp
      x\u1EBFp l\u1EA1i b\xE0n c\u1EDD, bao g\u1ED3m c\u1EA3 vi\u1EC7c t\u1EA1m th\u1EDDi
      v\xF4 hi\u1EC7u h\xF3a n\xF3. \u0110\u1EC3 k\u1EBFt th\xFAc l\u01B0\u1EE3t
      ch\u01A1i, b\xE0n c\u1EDD ph\u1EA3i h\u1EE3p l\u1EC7 v\xE0 b\u1EA1n ph\u1EA3i
      ch\u01A1i \xEDt nh\u1EA5t m\u1ED9t l\xE1 b\xE0i t\u1EEB tay m\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540508
    m_Localized: "H\xE0nh \u0111\u1ED9ng xoay"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540509
    m_Localized: "R\xFAt b\xE0i (ho\u1EB7c B\u1ECF l\u01B0\u1EE3t khi ch\u1ED3ng
      b\xE0i h\u1EBFt) lu\xF4n c\xF3 s\u1EB5n. Thao t\xE1c n\xE0y kh\xF4i ph\u1EE5c
      b\xE0n c\u1EDD v\u1EC1 tr\u1EA1ng th\xE1i b\u1EAFt \u0111\u1EA7u l\u01B0\u1EE3t
      ch\u01A1i c\u1EE7a b\u1EA1n, tr\u1EA3 l\u1EA1i c\xE1c l\xE1 b\xE0i \u0111\xE3
      ch\u01A1i v\xE0o tay, r\xFAt \u200B\u200Bth\xEAm m\u1ED9t l\xE1 b\xE0i n\u1EBFu
      c\xF3 th\u1EC3, v\xE0 k\u1EBFt th\xFAc l\u01B0\u1EE3t ch\u01A1i. K\u1EBFt th\xFAc
      l\u01B0\u1EE3t ch\u01A1i c\xF3 s\u1EB5n khi b\xE0n c\u1EDD h\u1EE3p l\u1EC7
      v\xE0 b\u1EA1n \u0111\xE3 ch\u01A1i m\u1ED9t l\xE1 b\xE0i tr\xEAn tay ho\u1EB7c
      \u0111\xE3 b\u1ECB h\u1EA1 g\u1EE5c."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540510
    m_Localized: "Thao t\xE1c Ho\xE0n t\xE1c (Undo) cho ph\xE9p b\u1EA1n quay l\u1EA1i
      c\xE1c n\u01B0\u1EDBc \u0111i \u0111\xE3 th\u1EF1c hi\u1EC7n; Thao t\xE1c L\xE0m
      l\u1EA1i (Redo) \xE1p d\u1EE5ng l\u1EA1i m\u1ED9t n\u01B0\u1EDBc \u0111i \u0111\xE3
      ho\xE0n t\xE1c trong c\xF9ng m\u1ED9t l\u01B0\u1EE3t. C\xE1c n\u01B0\u1EDBc
      \u0111i m\u1EDBi v\xE0 h\xE0nh \u0111\u1ED9ng k\u1EBFt th\xFAc l\u01B0\u1EE3t
      s\u1EBD x\xF3a b\u1ECF thao t\xE1c L\xE0m l\u1EA1i. Thao t\xE1c S\u1EEDa B\xE0n
      c\u1EDD (Fix Board) c\u1ED1 g\u1EAFng gi\u1EEF l\u1EA1i c\xE1c n\u01B0\u1EDBc
      \u0111i h\u1EE3p l\u1EC7 t\u1EEB tay b\u1EA1n trong khi s\u1EEDa ch\u1EEFa
      b\xE0n c\u1EDD; c\xE1c l\xE1 b\xE0i kh\xF4ng th\u1EC3 s\u1EED d\u1EE5ng s\u1EBD
      \u0111\u01B0\u1EE3c tr\u1EA3 l\u1EA1i tay b\u1EA1n. Thao t\xE1c Kh\xF4i ph\u1EE5c
      (Revert) kh\xF4i ph\u1EE5c b\xE0n c\u1EDD v\u1EC1 tr\u1EA1ng th\xE1i ban \u0111\u1EA7u
      c\u1EE7a l\u01B0\u1EE3t ch\u01A1i v\xE0 tr\u1EA3 l\u1EA1i c\xE1c l\xE1 b\xE0i
      b\u1EA1n \u0111\xE3 ch\u01A1i v\xE0o tay b\u1EA1n. C\xE1c h\xE0nh \u0111\u1ED9ng
      ph\xE1 h\u1EE7y c\xF3 th\u1EC3 y\xEAu c\u1EA7u b\u1EA1n x\xE1c nh\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540511
    m_Localized: "L\u01B0\u1EE3t t\xEDnh gi\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540512
    m_Localized: "Ng\u01B0\u1EDDi ch\u1EE7 tr\xEC c\xF3 th\u1EC3 ch\u1ECDn 30, 60,
      90 ho\u1EB7c 120 gi\xE2y cho m\u1ED7i l\u01B0\u1EE3t, ho\u1EB7c t\u1EAFt b\u1ED9
      \u0111\u1EBFm th\u1EDDi gian trong c\xE1c tr\xF2 ch\u01A1i ngo\u1EA1i tuy\u1EBFn.
      C\xE1c tr\xF2 ch\u01A1i tr\u1EF1c tuy\u1EBFn lu\xF4n c\xF3 th\u1EDDi gian gi\u1EDBi
      h\u1EA1n. Khi h\u1EBFt th\u1EDDi gian, m\u1ED9t b\xE0n ch\u01A1i h\u1EE3p l\u1EC7
      kh\xF4ng c\xF3 b\xE0i tr\xEAn tay s\u1EBD \u0111\u01B0\u1EE3c gi\u1EEF l\u1EA1i
      v\xE0 b\u1EA1n r\xFAt b\xE0i; m\u1ED9t b\xE0n ch\u01A1i kh\xF4ng h\u1EE3p l\u1EC7
      kh\xF4ng c\xF3 b\xE0i tr\xEAn tay s\u1EBD \u0111\u01B0\u1EE3c kh\xF4i ph\u1EE5c
      v\xE0 b\u1EA1n r\xFAt b\xE0i. N\u1EBFu b\u1EA1n \u0111\xE3 ch\u01A1i b\xE0i
      tr\xEAn tay v\xE0 b\xE0n ch\u01A1i h\u1EE3p l\u1EC7, l\u01B0\u1EE3t c\u1EE7a
      b\u1EA1n k\u1EBFt th\xFAc m\xE0 kh\xF4ng r\xFAt b\xE0i. N\u1EBFu b\xE0n ch\u01A1i
      kh\xF4ng h\u1EE3p l\u1EC7, c\xE1c n\u01B0\u1EDBc \u0111i c\u1EE7a b\u1EA1n
      s\u1EBD b\u1ECB h\u1EE7y b\u1ECF cho \u0111\u1EBFn khi b\xE0n ch\u01A1i h\u1EE3p
      l\u1EC7; b\u1EA1n ch\u1EC9 r\xFAt b\xE0i n\u1EBFu kh\xF4ng c\xF2n b\xE0i tr\xEAn
      tay n\xE0o tr\xEAn b\xE0n ch\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540513
    m_Localized: "H\u1EBFt b\xE0i v\xE0 th\u1EBF b\u1EBF t\u1EAFc"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540514
    m_Localized: "Khi ch\u1ED3ng b\xE0i r\xFAt h\u1EBFt, h\xE0nh \u0111\u1ED9ng R\xFAt
      b\xE0i tr\u1EDF th\xE0nh B\u1ECF qua: kh\xF4ng c\xF3 l\xE1 b\xE0i n\xE0o \u0111\u01B0\u1EE3c
      r\xFAt v\xE0 b\xE0n ch\u01A1i \u0111\u01B0\u1EE3c tr\u1EA3 v\u1EC1 tr\u1EA1ng
      th\xE1i ban \u0111\u1EA7u. N\u1EBFu t\u1EA5t c\u1EA3 ng\u01B0\u1EDDi ch\u01A1i
      \u0111ang ho\u1EA1t \u0111\u1ED9ng \u0111\u1EC1u b\u1ECF qua li\xEAn ti\u1EBFp
      m\xE0 kh\xF4ng ch\u01A1i b\xE0i n\xE0o, ng\u01B0\u1EDDi ch\u01A1i c\xF3 \xEDt
      b\xE0i nh\u1EA5t s\u1EBD th\u1EAFng n\u1EBFu h\u1ECD l\xE0 ng\u01B0\u1EDDi
      duy nh\u1EA5t c\xF3 s\u1ED1 b\xE0i nh\u01B0 v\u1EADy. N\u1EBFu ng\u01B0\u1EDDi
      ch\u01A1i c\xF3 s\u1ED1 b\xE0i b\u1EB1ng nhau, tr\xF2 ch\u01A1i k\u1EBFt th\xFAc
      h\xF2a, kh\xF4ng c\xF3 ng\u01B0\u1EDDi th\u1EAFng."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540515
    m_Localized: "L\u1EDDi c\u1EA3m \u01A1n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540516
    m_Localized: "Thi\u1EBFt k\u1EBF v\xE0 ph\xE1t tri\u1EC3n tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540517
    m_Localized: "\u0110\u01B0\u1EE3c l\xE0m b\u1EB1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540518
    m_Localized: "Unity 6, Universal Render Pipeline, Input System, Audiokinetic
      Wwise, Unity Gaming Services v\xE0 Steamworks."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540519
    m_Localized: "C\u1EA3m \u01A1n b\u1EA1n \u0111\xE3 tham gia!"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540520
    m_Localized: "K\u1EBFt th\xFAc l\u01B0\u1EE3t"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540521
    m_Localized: "Ho\xE0n t\xE1c"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540522
    m_Localized: "L\xE0m l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540524
    m_Localized: "S\u1EEDa ch\u1EEFa b\u1EA3ng m\u1EA1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540525
    m_Localized: "S\u1EAFp x\u1EBFp: h\u1EA1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540526
    m_Localized: "S\u1EAFp x\u1EBFp: b\u1ED9 \u0111\u1ED3"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540529
    m_Localized: "\u0110\xE1nh d\u1EA5u"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540530
    m_Localized: "\u0110\xE1nh d\u1EA5u\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540531
    m_Localized: "V\u1EBD tranh"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540533
    m_Localized: "G\u1EE3i \xFD: tr\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540534
    m_Localized: "G\u1EE3i \xFD: t\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540535
    m_Localized: "Tua nhanh \u0111\u1EBFn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540536
    m_Localized: "Ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540538
    m_Localized: "\u0110\xE3 xu\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540539
    m_Localized: "{0} \xB7 \u0110\xE3 gi\u1EA3m"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540540
    m_Localized: "{0} \u0111ang suy ngh\u0129\u2026"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540541
    m_Localized: "\u0110\u1EBFn l\u01B0\u1EE3t b\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540542
    m_Localized: "l\u01B0\u1EE3t c\u1EE7a {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540544
    m_Localized: "L\u01B0\u1EE3t c\u1EE7a {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540546
    m_Localized: "Ng\u0103n r\xFAt b\xE0i: {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540547
    m_Localized: "Th\u1EDDi gian: {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540548
    m_Localized: "Ch\u01B0a \u0111\u1EBFn l\u01B0\u1EE3t b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540549
    m_Localized: "\u0110\u1ED9ng t\xE1c \u0111\xF3 hi\u1EC7n kh\xF4ng kh\u1EA3 d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540550
    m_Localized: "H\xE3y \u0111i xu\u1ED1ng tr\u01B0\u1EDBc khi s\u1EED d\u1EE5ng
      c\xE1c qu\xE2n b\xE0i t\u1EEB b\xE0n ch\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540553
    m_Localized: "B\u1ED9 \u0111\xF3 kh\xF4ng \u0111\xE1p \u1EE9ng \u0111\u1EE7 \u0111i\u1EC1u
      ki\u1EC7n \u0111\u1EC3 \u0111\u01B0\u1EE3c ph\xE9p h\u1EA1 xu\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540555
    m_Localized: "B\u1ED9 \u0111\xF3 c\xF3 qu\xE1 nhi\u1EC1u th\u1EBB."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540556
    m_Localized: "Th\u1EBB \u0111\xF3 kh\xF4ng th\u1EC3 \u0111\u01B0\u1EE3c th\xEAm
      v\xE0o b\u1ED9 n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540557
    m_Localized: "H\xE3y ch\u1ECDn m\u1ED9t \u0111\u1ECBa \u0111i\u1EC3m h\u1EE3p
      l\u1EC7 \u0111\u1EC3 \u0111\u1EB7t th\u1EBB \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540558
    m_Localized: "N\u01B0\u1EDBc \u0111i \u0111\xF3 bao g\u1ED3m vi\u1EC7c s\u1EED
      d\u1EE5ng m\u1ED9t l\xE1 b\xE0i nhi\u1EC1u h\u01A1n m\u1ED9t l\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540560
    m_Localized: "Th\u1EBB ho\u1EB7c b\u1ED9 th\u1EBB \u0111\xF3 hi\u1EC7n kh\xF4ng
      c\xF2n n\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540561
    m_Localized: "Tr\xF2 ch\u01A1i n\xE0y \u0111\xE3 k\u1EBFt th\xFAc r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540563
    m_Localized: "H\xE0nh \u0111\u1ED9ng \u0111\xF3 kh\xF4ng \u0111\u01B0\u1EE3c
      ph\xE9p theo lu\u1EADt ch\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540564
    m_Localized: "\u0110\u1EEBng h\u1ECFi l\u1EA1i n\u1EEFa"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540565
    m_Localized: "X\xE1c nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540566
    m_Localized: "Tr\u1EA3 l\u1EA1i t\u1EA5t c\u1EA3 b\xE0i v\u1EC1 tay b\u1EA1n?"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540567
    m_Localized: "M\u1ED9t s\u1ED1 l\xE1 b\xE0i kh\xF4ng h\u1EE3p l\u1EC7 s\u1EBD
      \u0111\u01B0\u1EE3c tr\u1EA3 v\u1EC1 tay b\u1EA1n. S\u1EEDa l\u1EA1i b\xE0n
      c\u1EDD?"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540568
    m_Localized: "B\u1EA1n \u0111\xE3 b\u1ECF qua ph\u1EA7n h\u01B0\u1EDBng d\u1EABn?
      B\u1EA1n c\xF3 th\u1EC3 ch\u01A1i l\u1EA1i b\u1EA5t c\u1EE9 l\xFAc n\xE0o t\u1EEB
      m\u1EE5c \"C\xE1ch ch\u01A1i\"."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540569
    m_Localized: "Quay l\u1EA1i menu ch\xEDnh? Tr\xF2 ch\u01A1i n\xE0y s\u1EBD \u0111\u01B0\u1EE3c
      l\u01B0u l\u1EA1i \u0111\u1EC3 b\u1EA1n c\xF3 th\u1EC3 ti\u1EBFp t\u1EE5c ch\u01A1i
      sau."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540570
    m_Localized: "Kh\u1EDFi \u0111\u1ED9ng l\u1EA1i tr\xF2 ch\u01A1i n\xE0y? V\xF2ng
      hi\u1EC7n t\u1EA1i s\u1EBD b\u1ECB m\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540571
    m_Localized: "T\u1EA1m d\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540572
    m_Localized: "B\u1EA3n t\xF3m t\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540573
    m_Localized: "Kh\u1EDFi \u0111\u1ED9ng l\u1EA1i tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540574
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540576
    m_Localized: "? Gi\xFAp \u0111\u1EE1"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540577
    m_Localized: "Menu ch\xEDnh"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540578
    m_Localized: "M\xE3 ph\xF2ng: {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540579
    m_Localized: "Ph\xEDm t\u1EAFt PC"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540581
    m_Localized: "H\xE3y th\u1EED c\xE1c th\u1EBB \u0111\u01B0\u1EE3c \u0111\xE1nh
      d\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540583
    m_Localized: "K\u1EBF ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540584
    m_Localized: "Hi\u1EC3u r\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540585
    m_Localized: "K\u1EBF ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540586
    m_Localized: Xong
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540587
    m_Localized: '{0} / {1}'
    m_Metadata:
      m_Items:
