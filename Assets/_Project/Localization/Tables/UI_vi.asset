  - m_Id: 6549035540588
    m_Localized: "\u2713 {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540589
    m_Localized: "\u2717 {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540590
    m_Localized: "Ai \u0111i tr\u01B0\u1EDBc?"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540591
    m_Localized: "Ng\u01B0\u1EDDi ch\u01A1i \u0111\u1EA7u ti\xEAn ng\u1EABu nhi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540592
    m_Localized: "Ch\u1EA1m \u0111\u1EC3 hi\u1EC3n th\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540593
    m_Localized: MEJNUN!
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540594
    m_Localized: "Th\xE0nh t\u1EF1u"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734784
    m_Localized: "\u1EA2nh m\u1EDBi trong Gallery"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734785
    m_Localized: "Ch\u01B0a \u0111\u01B0\u1EE3c m\u1EDF kh\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734786
    m_Localized: "Th\u1EF1c \u0111\u01A1n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734788
    m_Localized: "Ch\u01A1i th\u1EADt \u0111i!"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734789
    m_Localized: "B\u1EAFt \u0111\u1EA7u v\xF2ng m\u1EDBi?"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734790
    m_Localized: "\u0110\u1EEBng h\u1ECFi l\u1EA1i n\u1EEFa"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734792
    m_Localized: "S\u1ED1 th\u1EBB c\xF2n l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734793
    m_Localized: '{0}: {1}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549039734794
    m_Localized: "B\u1EA1n \u0111\xE3 ho\xE0n th\xE0nh ph\u1EA7n h\u01B0\u1EDBng
      d\u1EABn. Gi\u1EDD b\u1EA1n \u0111\xE3 s\u1EB5n s\xE0ng cho m\u1ED9t tr\u1EADn
      \u0111\u1EA5u th\u1EF1c s\u1EF1!"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734796
    m_Localized: "L\xEAn c\u1EA5p! C\u1EA5p \u0111\u1ED9 {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549039734797
    m_Localized: "C\u1EA5p \u0111\u1ED9 {0} \xB7 {1} / {2} XP"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549039734798
    m_Localized: "M\u1EDBi: {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549039734799
    m_Localized: "Ch\u01B0a \u0111\u01B0\u1EE3c m\u1EDF kh\xF3a: {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549039734800
    m_Localized: "B\u1ED9 b\xE0i m\u1EDBi \u0111\xE3 \u0111\u01B0\u1EE3c m\u1EDF
      kh\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734801
    m_Localized: "Nh\u1EA5n \u0111\u1EC3 ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734802
    m_Localized: "b\u1EDFi {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 32528051200000
    m_Localized: "Th\u1EBB b\u1ED1n m\xE0u"
    m_Metadata:
      m_Items: []
  - m_Id: 32528638402560
    m_Localized: "Hi\u1EC3n th\u1ECB ch\u1EA5t r\xF4 m\xE0u xanh d\u01B0\u01A1ng
      v\xE0 ch\u1EA5t chu\u1ED3n m\xE0u xanh l\xE1 c\xE2y tr\xEAn c\xE1c giao di\u1EC7n
      b\xE0i t\u01B0\u01A1ng th\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 32528638402561
    m_Localized: "B\u1ED1 c\u1EE5c d\xE0nh cho ng\u01B0\u1EDDi thu\u1EADn tay tr\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 32528638402562
    m_Localized: "\u0110i\u1EC1u ch\u1EC9nh v\u1ECB tr\xED c\xE1c n\xFAt \u0111i\u1EC1u
      khi\u1EC3n HUD sao cho ph\xF9 h\u1EE3p v\u1EDBi ng\u01B0\u1EDDi ch\u01A1i thu\u1EADn
      tay tr\xE1i."
    m_Metadata:
      m_Items: []
  - m_Id: 32528638402563
    m_Localized: "Ch\u1EBF \u0111\u1ED9 ti\u1EBFt ki\u1EC7m pin"
    m_Metadata:
      m_Items: []
  - m_Id: 32528638402564
    m_Localized: "Gi\u1EDBi h\u1EA1n t\u1ED1c \u0111\u1ED9 hi\u1EC3n th\u1ECB tr\xEAn
      thi\u1EBFt b\u1ECB di \u0111\u1ED9ng \u1EDF m\u1EE9c 30 khung h\xECnh/gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 999999999999999
    m_Localized: '{0}

      {1}'
    m_Metadata:
      m_Items:
