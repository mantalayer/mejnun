  - m_Id: 6549006180422
    m_Localized: Thao
    m_Metadata:
      m_Items: []
  - m_Id: 6549006180432
    m_Localized: "C\xF4ng ch\xFAa"
    m_Metadata:
      m_Items: []
  - m_Id: 6549006180434
    m_Localized: Kristine
    m_Metadata:
      m_Items: []
  - m_Id: 6549006180438
    m_Localized: Siti
    m_Metadata:
      m_Items: []
  - m_Id: 6549006180443
    m_Localized: "V\u0169 Lan"
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568961
    m_Localized: "Ho\xE0n th\xE0nh tr\xF2 ch\u01A1i \u0111\u1EA7u ti\xEAn c\u1EE7a
      b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763270
    m_Localized: "Ch\u01A1i m\u1ED9t tr\xF2 ch\u01A1i v\u1EDBi s\xE1u ch\u1ED7 ng\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763282
    m_Localized: "\u0110\u1EA1t c\u1EA5p \u0111\u1ED9 25."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763290
    m_Localized: "H\xE3y \u0111i xu\u1ED1ng v\xE0 r\xFAt h\u1EBFt b\xE0i trong tay
      \u1EDF c\xF9ng m\u1ED9t l\u01B0\u1EE3t, t\u1EAFt g\u1EE3i \xFD v\xE0 ch\u1EE9c
      n\u0103ng S\u1EEDa B\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763292
    m_Localized: "Th\u1EAFng trong v\xF2ng n\u0103m l\u01B0\u1EE3t ch\u01A1i \u0111\u1EA7u
      ti\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763296
    m_Localized: "Th\u1EAFng khi s\u1EDF h\u1EEFu t\u1EEB 20 l\xE1 b\xE0i tr\u1EDF
      l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763300
    m_Localized: "T\u1EA1o m\u1ED9t s\u1EA3nh 13 l\xE1 b\xE0i ho\xE0n ch\u1EC9nh
      t\u1EEB \xC1t \u0111\u1EBFn K."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763306
    m_Localized: "\u0110\u1EB7t \xEDt nh\u1EA5t t\xE1m l\xE1 b\xE0i v\xE0o tay trong
      m\u1ED9t l\u01B0\u1EE3t."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763312
    m_Localized: "K\u1EBFt th\xFAc l\u01B0\u1EE3t ch\u01A1i c\u1EE7a b\u1EA1n v\u1EDBi
      c\u1EA3 hai l\xE1 b\xE0i n\u1EB1m tr\xEAn hai b\u1ED9 b\xE0i ri\xEAng bi\u1EC7t."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763315
    m_Localized: "Kh\xF4ng c\u1EA7n b\xE1nh xe ph\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763317
    m_Localized: Halas!
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763318
    m_Localized: "\u0110\u1EBFn l\u01B0\u1EE3t b\u1EA1n r\u1ED3i \u0111\u1EA5y."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763320
    m_Localized: "K\u1EBFt th\xFAc l\u01B0\u1EE3t ch\u01A1i h\u1EE3p l\u1EC7 khi
      c\xF2n ch\u01B0a \u0111\u1EBFn ba gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957579
    m_Localized: "T\u1ED5 ch\u1EE9c 10 tr\xF2 ch\u01A1i tr\u1EF1c tuy\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957582
    m_Localized: "Ngay c\u1EA3 Steven"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957595
    m_Localized: "Ng\xE0 voi c\u1ED5 \u0111i\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957601
    m_Localized: "Chu\u1ED9t M\u1EAFt Xanh C\u1ED5 \u0110i\u1EC3n T\u01B0\u01A1ng
      Ph\u1EA3n 4 m\xE0u 2"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957609
    m_Localized: "Chu\u1ED9t m\u1EAFt xanh c\u1ED5 \u0111i\u1EC3n \xE1nh s\xE1ng
      4 m\xE0u 2"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957623
    m_Localized: "M\xE0u xanh l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151877
    m_Localized: "C\xE1ch ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151885
    m_Localized: "B\u1EA1n m\u1EDBi \u0111\u1EBFn v\u1EDBi Mejnun?"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346176
    m_Localized: "M\u1ED9t tr\xF2 ch\u01A1i h\u01B0\u1EDBng d\u1EABn ng\u1EAFn s\u1EBD
      d\u1EA1y b\u1EA1n m\u1ECDi lu\u1EADt ch\u01A1i th\xF4ng qua vi\u1EC7c ch\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346180
    m_Localized: "\u0110\u0103ng nh\u1EADp \u1EA9n danh v\xE0 tham gia b\u1EB1ng
      m\xE3 phi\xEAn, ho\u1EB7c t\xECm ng\u01B0\u1EDDi ch\u01A1i ph\xF9 h\u1EE3p
      nhanh ch\xF3ng."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346183
    m_Localized: "B\u1EADt b\u1ED9 h\u1EB9n gi\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346184
    m_Localized: "T\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346202
    m_Localized: "Ng\u01B0\u1EDDi ch\u01A1i {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346207
    m_Localized: "Gh\u1EBF"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346208
    m_Localized: "B\u1EADt b\u1ED9 h\u1EB9n gi\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346209
    m_Localized: "T\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346211
    m_Localized: "Gh\u1EBF {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346212
    m_Localized: "Ng\u01B0\u1EDDi ch\u01A1i {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549031346220
    m_Localized: "\xCDt nh\u1EA5t m\u1ED9t ch\u1ED7 ng\u1ED3i ph\u1EA3i d\xE0nh cho
      ng\u01B0\u1EDDi ch\u01A1i l\xE0 con ng\u01B0\u1EDDi."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346223
    m_Localized: "B\u1EAFt \u0111\u1EA7u tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346233
    m_Localized: "S\xE0n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346241
    m_Localized: "S\u1EA3n ph\u1EA9m n\xE0y hi\u1EC7n kh\xF4ng c\xF2n trong danh
      m\u1EE5c."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346264
    m_Localized: "H\xE3y h\u1ECFi tr\u01B0\u1EDBc khi r\u1EDDi kh\u1ECFi ho\u1EB7c
      b\u1EAFt \u0111\u1EA7u l\u1EA1i tr\xF2 ch\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346265
    m_Localized: "T\u1ED1c \u0111\u1ED9 di chuy\u1EC3n CPU"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346272
    m_Localized: "R\u1EA5t nhanh"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346277
    m_Localized: "B\xE0n v\xE0 tay"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346283
    m_Localized: "Thay \u0111\u1ED5i kho\u1EA3ng c\xE1ch gi\u1EEFa c\xE1c l\xE1 b\xE0i
      trong tay b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346293
    m_Localized: "Ph\xE1c th\u1EA3o t\u1EEBng b\u1ED9 tr\xEAn b\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346294
    m_Localized: "S\u1EAFp x\u1EBFp c\xE1c b\u1ED9 d\u1EEF li\u1EC7u theo l\u01B0\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346306
    m_Localized: "Gi\u1EA3m chuy\u1EC3n \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346307
    m_Localized: "Gi\u1EA3m thi\u1EC3u c\xE1c chuy\u1EC3n \u0111\u1ED9ng v\xE0 ho\u1EA1t
      \u1EA3nh kh\xF4ng c\u1EA7n thi\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346315
    m_Localized: "\xC2m l\u01B0\u1EE3ng nh\u1EA1c"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540482
    m_Localized: "\xC2m l\u01B0\u1EE3ng gi\u1ECDng n\xF3i"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540490
    m_Localized: "T\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540523
    m_Localized: "Ho\xE0n t\xE1c"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540527
    m_Localized: "\u0110\u1EB7t l\u1EA1i camera"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540528
    m_Localized: "B\u1EA3ng g\u1ECDn g\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540532
    m_Localized: "V\u01B0\u1EE3t qua"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540537
    m_Localized: Halas!
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540543
    m_Localized: "\u0110\u1EBFn l\u01B0\u1EE3t b\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540545
    m_Localized: "Gh\u1EBF {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6549035540551
    m_Localized: "C\xE1c qu\xE2n b\xE0i tr\xEAn b\xE0n kh\xF4ng th\u1EC3 \u0111\u01B0\u1EE3c
      tr\u1EA3 l\u1EA1i v\xE0o tay b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540552
    m_Localized: "B\u1EA1n ph\u1EA3i th\u1EF1c hi\u1EC7n m\u1ED9t n\u01B0\u1EDBc
      \u0111i h\u1EE3p l\u1EC7 tr\u01B0\u1EDBc khi k\u1EBFt th\xFAc l\u01B0\u1EE3t
      ch\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540554
    m_Localized: "M\u1ED9t b\u1ED9 b\xE0i kh\xF4ng th\u1EC3 ch\u1EE9a hai l\xE1 b\xE0i
      gi\u1ED1ng nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540559
    m_Localized: "Ch\u1ECDn \xEDt nh\u1EA5t m\u1ED9t qu\xE2n b\xE0i \u0111\u1EC3
      di chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540562
    m_Localized: "H\xE3y th\u1EED c\xE1c th\u1EBB \u0111\u01B0\u1EE3c \u0111\xE1nh
      d\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540575
    m_Localized: "B\u1ECF qua h\u01B0\u1EDBng d\u1EABn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540580
    m_Localized: "Ctrl/Cmd+Z Ho\xE0n t\xE1c\nCtrl/Cmd+Shift+Z ho\u1EB7c Ctrl+Y L\xE0m
      l\u1EA1i\nSpace K\u1EBFt th\xFAc l\u01B0\u1EE3t\nD V\u1EBD / b\u1ECF qua\nR
      Ho\xE0n t\xE1c\nF S\u1EEDa b\u1EA3ng\nH G\u1EE3i \xFD\nF1 Trang n\xE0y\nEsc
      ho\u1EB7c P T\u1EA1m d\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540582
    m_Localized: "B\u1ECF qua h\u01B0\u1EDBng d\u1EABn"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734787
    m_Localized: "Tr\u1EADn t\xE1i \u0111\u1EA5u"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734791
    m_Localized: "Tr\u1EADn t\xE1i \u0111\u1EA5u"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734795
    m_Localized: +{0} XP
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 1341120512
    m_Localized: Mejnun
    m_Metadata:
      m_Items: []
  - m_Id: 695204831232
    m_Localized: "T\u1EF1 \u0111\u1ED9ng (ng\xF4n ng\u1EEF thi\u1EBFt b\u1ECB)"
    m_Metadata:
      m_Items: []
  - m_Id: 1656669331456
    m_Localized: "\u0110\u01AF\u1EE2C R\u1ED2I"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302976
    m_Localized: "H\u1EE7y b\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302977
    m_Localized: "M\u1EB7t sau"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302978
    m_Localized: "\u0110\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302979
    m_Localized: "TR\xCAN"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302981
    m_Localized: "\u0110\xFAng"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302982
    m_Localized: "KH\xD4NG"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302983
    m_Localized: "Ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302984
    m_Localized: Xong
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302985
    m_Localized: "\u0110\xE3 kh\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 1656690302986
    m_Localized: "\u0110ang t\u1EA3i\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6548909711360
    m_Localized: "Ch\xE0o m\u1EEBng \u0111\u1EBFn v\u1EDBi Mejnun!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014529
    m_Localized: "B\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014530
    m_Localized: "B\xE0i \u0111\u01B0\u1EE3c chia th\xE0nh t\u1EEBng b\u1ED9. M\u1ED9t
      b\u1ED9 gi\u1ED1ng nhau g\u1ED3m 3 ho\u1EB7c 4 l\xE1 b\xE0i c\xF9ng h\u1EA1ng,
      kh\xE1c ch\u1EA5t. M\u1ED9t s\u1EA3nh g\u1ED3m 3 l\xE1 b\xE0i tr\u1EDF l\xEAn
      c\xF9ng ch\u1EA5t, theo th\u1EE9 t\u1EF1."
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014531
    m_Localized: "l\u01B0\u1EE3t c\u1EE7a {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548985208832
    m_Localized: "{0} \u0111i tr\u01B0\u1EDBc. H\xE3y xem c\xF4 \u1EA5y l\xE0m g\xEC."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548985208833
    m_Localized: "{0} b\u1ECB l\u1ED7i"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548985208834
    m_Localized: "{0} \u0111\u1EB7t xu\u1ED1ng m\u1ED9t b\u1ED9 b\xE0i ch\u1EC9 g\u1ED3m
      c\xE1c qu\xE2n b\xE0i tr\xEAn tay. \u0110\xF3 g\u1ECDi l\xE0 \"\u0111i xu\u1ED1ng\",
      v\xE0 m\u1ED9t b\u1ED9 b\xE0i l\xE0 \u0111\u1EE7."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548985208835
    m_Localized: "B\u1EA1n ch\u01B0a g\u1EE5c ng\xE3 \u0111\xE2u"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208836
    m_Localized: "B\u1EA1n kh\xF4ng th\u1EC3 s\u1EED d\u1EE5ng b\xE0n ch\u01A1i cho
      \u0111\u1EBFn khi b\u1EA1n thua. Tr\u01B0\u1EDBc ti\xEAn, h\xE3y \u0111\u1EB7t
      xu\u1ED1ng m\u1ED9t b\u1ED9 b\xE0i t\u1EEB tay c\u1EE7a b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208837
    m_Localized: "\u0110i xu\u1ED1ng tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208838
    m_Localized: "Cho \u0111\u1EBFn khi b\u1EA1n thua, b\u1EA1n ch\u1EC9 c\xF3 th\u1EC3
      ch\u01A1i c\xE1c b\u1ED9 b\xE0i t\u1EEB tay m\xECnh. \u0110\u1EB7t 7\u2665
      8\u2665 9\u2665 l\xEAn b\xE0n tr\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208840
    m_Localized: "B\u1EA1n \u0111\xE3 g\u1EE5c ng\xE3!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208842
    m_Localized: "Th\xEAm v\xE0o b\u1ED9 s\u01B0u t\u1EADp"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208843
    m_Localized: "B\xE2y gi\u1EDD h\xE3y \u0111\u1EB7t A\u2660 c\u1EE7a b\u1EA1n
      l\xEAn J\u2660 Q\u2660 K\u2660 c\u1EE7a {0}."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548985208844
    m_Localized: "\xC1t ch\u1EE7 b\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208845
    m_Localized: "\xC1t c\xF3 th\u1EC3 l\xE0 qu\xE2n b\xE0i th\u1EA5p (A-2-3) ho\u1EB7c
      qu\xE2n b\xE0i cao (Q-K-A), nh\u01B0ng s\u1EA3nh kh\xF4ng bao gi\u1EDD c\xF3
      th\u1EC3 l\u1EADt ng\u01B0\u1EE3c (K-A-2)."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208846
    m_Localized: "C\xF9ng lo\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208848
    m_Localized: "Ti\u1EBFp t\u1EE5c n\xE0o\u2014ho\xE0n th\xE0nh vi\u1EC7c \u0111\u1EB7t
      c\u1EA3 ba l\xE1 b\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208849
    m_Localized: "\u0110\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208850
    m_Localized: "V\u1EDBi hai b\u1ED9 b\xE0i, m\u1ED7i l\xE1 b\xE0i \u0111\u1EC1u
      c\xF3 m\u1ED9t l\xE1 gi\u1ED1ng h\u1EC7t: c\xF9ng ch\u1EA5t v\xE0 c\xF9ng h\u1EA1ng,
      nh\u01B0ng thu\u1ED9c b\u1ED9 b\xE0i kh\xE1c (m\u1EB7t sau l\xE1 b\xE0i kh\xE1c).
      L\xE1 gi\u1ED1ng h\u1EC7t kh\xF4ng bao gi\u1EDD \u0111\u01B0\u1EE3c x\u1EBFp
      v\xE0o c\xF9ng m\u1ED9t b\u1ED9."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208854
    m_Localized: "B\u1EA5t k\u1EF3 b\u1ED9 n\xE0o c\u0169ng \u0111\u1EC1u \u0111\u01B0\u1EE3c
      ch\u1EA5p nh\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208855
    m_Localized: "{0} \u0111\xE3 th\xEAm 10\u2665 J\u2665 v\xE0o b\u1ED9 b\xE0i c\u01A1
      c\u1EE7a b\u1EA1n v\xE0 5\u2665 v\xE0o b\u1ED9 b\xE0i n\u0103m c\u1EE7a b\u1EA1n.
      Khi b\u1EA1n \u0111\xE3 xu\u1ED1ng b\xE0i, b\u1EA1n c\xF3 th\u1EC3 th\xEAm
      v\xE0o b\u1EA5t k\u1EF3 b\u1ED9 b\xE0i n\xE0o tr\xEAn b\xE0n."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548985208856
    m_Localized: "Chia m\u1ED9t \u0111o\u1EA1n th\u1EB3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208857
    m_Localized: "Nh\u1EA5n gi\u1EEF qu\xE2n 10\u2665 v\xE0 k\xE9o n\xF3 v\xE0o \xF4
      tr\u1ED1ng. Qu\xE2n 10\u2665 J\u2665 s\u1EBD \u0111i theo."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208858
    m_Localized: "Ch\u01B0a c\xF3 b\u1ED9 n\xE0o"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208860
    m_Localized: "H\xE3y s\u1EED d\u1EE5ng g\u1EA5p \u0111\xF4i s\u1ED1 c\u1EE7a
      b\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208861
    m_Localized: "\u0110\u1EB7t qu\xE2n 9\u2665 c\u1EE7a b\u1EA1n l\xEAn 10\u2665
      J\u2665. N\xF3 l\xE0 qu\xE2n \u0111\xF4i c\u1EE7a 9\u2665 trong b\u1ED9 b\xE0i
      kia, n\xEAn \u0111\u01B0\u1EE3c ph\xE9p \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208862
    m_Localized: "Ho\xE0n t\xE1c"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208863
    m_Localized: "L\u1EE1 m\u1EAFc l\u1ED7i? H\xE3y ho\xE0n t\xE1c m\u1ED9t b\u01B0\u1EDBc.
      Th\u1EED xem."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208864
    m_Localized: "L\xE0m l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208865
    m_Localized: "Redo kh\xF4i ph\u1EE5c l\u1EA1i n\u01B0\u1EDBc \u0111i. Revert
      \u0111\u1EB7t l\u1EA1i to\xE0n b\u1ED9 l\u01B0\u1EE3t ch\u01A1i, v\xE0 Fix
      board c\u1ED1 g\u1EAFng s\u1EEDa ch\u1EEFa b\xE0n ch\u01A1i cho b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208866
    m_Localized: "M\u1ECDi b\u1ED9 b\xE0i \u0111\u1EC1u h\u1EE3p l\u1EC7 tr\u1EDF
      l\u1EA1i. K\u1EBFt th\xFAc l\u01B0\u1EE3t c\u1EE7a b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208867
    m_Localized: "{0} \u0111\xE3 v\u1EBD"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548985208868
    m_Localized: "{0} kh\xF4ng th\u1EC3 ch\u01A1i n\xEAn c\xF4 \u1EA5y r\xFAt b\xE0i.
      R\xFAt b\xE0i l\u1EA5y m\u1ED9t l\xE1 b\xE0i t\u1EEB ch\u1ED3ng b\xE0i v\xE0
      k\u1EBFt th\xFAc l\u01B0\u1EE3t c\u1EE7a b\u1EA1n."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548985208869
    m_Localized: "B\u1EAFt \u0111\u1EA7u m\u1ED9t nh\xF3m"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208870
    m_Localized: "\u0110\u1EB7t 3\u2665 4\u2665 l\xEAn b\xE0n tr\u1ED1ng. Ch\u1EC9
      c\xF3 hai l\xE1 b\xE0i n\xEAn hi\u1EC7n t\u1EA1i n\xF3 hi\u1EC3n th\u1ECB m\xE0u
      \u0111\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208871
    m_Localized: "Ti\u1EBFp t\u1EE5c n\xE0o\u2014ho\xE0n th\xE0nh vi\u1EC7c \u0111\u1EB7t
      c\u1EA3 hai l\xE1 b\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208872
    m_Localized: "M\u01B0\u1EE3n t\u1EEB m\u1ED9t b\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208873
    m_Localized: "B\u1ED9 t\u1EE9 v\u1EABn c\xF3 t\xE1c d\u1EE5ng v\u1EDBi ba qu\xE2n
      b\xE0i. K\xE9o qu\xE2n 5\u2665 ra kh\u1ECFi nh\xF3m n\u0103m qu\xE2n b\xE0i
      \u0111\u1EC3 t\u1EA1o th\xE0nh 3\u2665 4\u2665."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208874
    m_Localized: "T\u1EA5t c\u1EA3 c\xE1c b\u1ED9 b\xE0i \u0111\u1EC1u h\u1EE3p l\u1EC7.
      K\u1EBFt th\xFAc l\u01B0\u1EE3t ch\u01A1i c\u1EE7a b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208875
    m_Localized: "Ch\u1EC9 c\xF2n m\u1ED9t t\u1EA5m th\u1EBB!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208877
    m_Localized: "B\u1ED9 m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208878
    m_Localized: "Ng\u01B0\u1EDDi ch\u01A1i \u0111ang \u1EDF th\u1EBF b\u1EA5t l\u1EE3i
      c\u0169ng c\xF3 th\u1EC3 b\u1EAFt \u0111\u1EA7u m\u1ED9t b\u1ED9 b\xE0i ho\xE0n
      to\xE0n m\u1EDBi t\u1EEB b\xE0i tr\xEAn tay."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208879
    m_Localized: "M\u1EAFc k\u1EB9t"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208880
    m_Localized: "Bi\u1EC3u t\u01B0\u1EE3ng A\u2665 c\u1EE7a b\u1EA1n kh\xF4ng v\u1EEBa
      v\u1EDBi b\u1EA5t k\u1EF3 v\u1ECB tr\xED n\xE0o tr\xEAn b\xE0n c\u1EA3."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208881
    m_Localized: "V\u1EBD tranh"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208882
    m_Localized: "Ch\u1EA1m v\xE0o n\xFAt R\xFAt b\xE0i \u0111\u1EC3 l\u1EA5y m\u1ED9t
      l\xE1 b\xE0i v\xE0 k\u1EBFt th\xFAc l\u01B0\u1EE3t ch\u01A1i c\u1EE7a b\u1EA1n.
      Vi\u1EC7c r\xFAt b\xE0i c\u0169ng s\u1EBD tr\u1EA3 l\u1EA1i b\u1EA5t k\u1EF3
      l\xE1 b\xE0i n\xE0o b\u1EA1n \u0111\xE3 \u0111\u1EB7t trong l\u01B0\u1EE3t
      n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208883
    m_Localized: "{0} c\u0169ng b\u1ECB k\u1EB9t."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548985208884
    m_Localized: "B\u1EA1n \u0111\xE3 r\xFAt \u0111\u01B0\u1EE3c l\xE1 b\xE0i s\u1ED1
      2 \u2665"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208885
    m_Localized: "\u0110\u1EB7t qu\xE2n 2\u2665 l\xEAn 3\u2665 4\u2665 5\u2665."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208886
    m_Localized: "\xC1t th\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208887
    m_Localized: "Gi\u1EDD th\xEC qu\xE2n \xC1t (A\u2665) n\u1EB1m \u1EDF v\u1ECB
      tr\xED th\u1EA5p: \xC1t-2-3-4-5\u2665. Ch\u01A1i qu\xE2n b\xE0i cu\u1ED1i c\xF9ng
      c\u1EE7a b\u1EA1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208888
    m_Localized: MEJNUN!
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208889
    m_Localized: "B\u1EA1n \u0111\xE3 d\u1ED1c h\u1EBFt s\u1EE9c m\xECnh v\xE0 gi\xE0nh
      chi\u1EBFn th\u1EAFng. C\xF2n m\u1ED9t v\xE0i \u0111i\u1EC1u n\u1EEFa c\u1EA7n
      bi\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208890
    m_Localized: "C\xF9ng lo\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208891
    m_Localized: "Th\u1EB3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208893
    m_Localized: "Th\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208894
    m_Localized: Cao
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403136
    m_Localized: "Kh\xF4ng b\u1ECDc"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403137
    m_Localized: "M\u1ED9t \u0111\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403138
    m_Localized: "C\xF9ng m\u1ED9t b\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403139
    m_Localized: "Ng\u0103n k\xE9o tr\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403140
    m_Localized: "Khi h\u1EBFt b\xE0i trong ch\u1ED3ng b\xE0i r\xFAt, quy\u1EC1n
      R\xFAt b\xE0i s\u1EBD tr\u1EDF th\xE0nh Quy\u1EC1n B\u1ECF qua. N\u1EBFu t\u1EA5t
      c\u1EA3 ng\u01B0\u1EDDi ch\u01A1i \u0111\u1EC1u b\u1ECF qua li\xEAn ti\u1EBFp,
      ng\u01B0\u1EDDi ch\u01A1i c\xF3 \xEDt b\xE0i nh\u1EA5t s\u1EBD th\u1EAFng.
      Tr\u01B0\u1EDDng h\u1EE3p h\xF2a l\xE0 B\u1EBF t\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403141
    m_Localized: "L\u01B0\u1EE3t t\xEDnh gi\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403142
    m_Localized: "Trong c\xE1c tr\xF2 ch\u01A1i t\xEDnh gi\u1EDD, \u0111\u1ED3ng
      h\u1ED3 s\u1EBD \u0111\u1EBFm ng\u01B0\u1EE3c t\u1EEBng l\u01B0\u1EE3t. Khi
      h\u1EBFt gi\u1EDD \u2014 Halas! \u2014 l\u01B0\u1EE3t ch\u01A1i h\u1EE3p l\u1EC7
      k\u1EBFt th\xFAc, n\u1EBFu kh\xF4ng, b\xE0i c\u1EE7a b\u1EA1n s\u1EBD \u0111\u01B0\u1EE3c
      tr\u1EA3 l\u1EA1i v\xE0 b\u1EA1n r\xFAt b\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403143
    m_Localized: "S\u1EEDa bo m\u1EA1ch v\xE0 kh\xF4i ph\u1EE5c l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403144
    m_Localized: "Ch\u1EE9c n\u0103ng Fix board c\u1ED1 g\u1EAFng l\xE0m cho m\u1ECDi
      b\u1ED9 b\xE0i \u0111\u1EC1u h\u1EE3p l\u1EC7 trong khi v\u1EABn gi\u1EEF nguy\xEAn
      c\xE1c n\u01B0\u1EDBc \u0111i c\u1EE7a b\u1EA1n. Ch\u1EE9c n\u0103ng Revert
      \u0111\u01B0a to\xE0n b\u1ED9 b\xE0n c\u1EDD tr\u1EDF l\u1EA1i tr\u1EA1ng th\xE1i
      ban \u0111\u1EA7u khi b\u1EAFt \u0111\u1EA7u l\u01B0\u1EE3t ch\u01A1i c\u1EE7a
      b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403145
    m_Localized: "G\u1EE3i \xFD v\xE0 b\u1EA3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403146
    m_Localized: "G\u1EE3i \xFD ch\u1EC9 ra c\xE1c qu\xE2n b\xE0i b\u1EA1n c\xF3
      th\u1EC3 ch\u01A1i. Ch\u1EE5m ng\xF3n tay \u0111\u1EC3 ph\xF3ng to, k\xE9o
      \u0111\u1EC3 di chuy\u1EC3n v\xE0 s\u1EED d\u1EE5ng ch\u1EBF \u0111\u1ED9 \"V\u1EEBa
      kh\xEDt\" \u0111\u1EC3 xem to\xE0n b\u1ED9 b\xE0n ch\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403148
    m_Localized: "Ng\u01B0\u1EDDi th\u1EAFng cu\u1ED9c s\u1EBD \u0111i tr\u01B0\u1EDBc
      trong v\xE1n ti\u1EBFp theo."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403149
    m_Localized: Layla
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403150
    m_Localized: "B\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403152
    m_Localized: Bot {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403153
    m_Localized: "{0} (Bot \u0111\u01A1n gi\u1EA3n)"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403154
    m_Localized: "{0} (Bot c\u1EE1 trung b\xECnh)"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403155
    m_Localized: "{0} (Bot c\u1EE9ng)"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403156
    m_Localized: "Chuy\u1EC3n t\u1EDBi {0} \u2014 ch\u1EA1m \u0111\u1EC3 hi\u1EC3n
      th\u1ECB"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403158
    m_Localized: "{0} th\u1EAFng!"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403159
    m_Localized: "Tr\xF2 ch\u01A1i k\u1EBFt th\xFAc"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403160
    m_Localized: "{0} \u0111\xE3 b\u1ECF tay xu\u1ED1ng."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403161
    m_Localized: "{0} c\xF3 \xEDt b\xE0i nh\u1EA5t khi b\u1ED9 b\xE0i r\xFAt h\u1EBFt."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403162
    m_Localized: "\u0110i\u1EC3m s\u1ED1 c\u1EE7a c\u1EB7p b\xE0i \xEDt nh\u1EA5t
      b\u1EB1ng nhau. Ch\u1ECDn ng\u01B0\u1EDDi \u0111i tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403163
    m_Localized: "Ai n\xEAn \u0111i tr\u01B0\u1EDBc?"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403164
    m_Localized: "Tr\u1EADn \u0111\u1EA5u t\u1EA1m d\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403166
    m_Localized: "M\xE1y ch\u1EE7 \u0111\xE3 ng\u1EAFt k\u1EBFt n\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403167
    m_Localized: "{0} \u0111\xE3 tham gia"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403168
    m_Localized: "{0} \u0111\xE3 ng\u1EAFt k\u1EBFt n\u1ED1i"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403169
    m_Localized: "T\u1EA5t c\u1EA3 ng\u01B0\u1EDDi ch\u01A1i \u0111\xE3 tham gia"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403170
    m_Localized: "{0} hi\u1EC7n l\xE0 m\xE1y ch\u1EE7"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403171
    m_Localized: "Hi\u1EC7n t\u1EA1i, ng\u01B0\u1EDDi ch\u01A1i \u0111ang l\xE0 ng\u01B0\u1EDDi
      ch\u1EE7 tr\xEC."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403172
    m_Localized: "\u0110ang ch\u1EDD ng\u01B0\u1EDDi ch\u01A1i ({0}/{1})\u2026"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403173
    m_Localized: "\u0110ang ch\u1EDD ng\u01B0\u1EDDi ch\u01A1i ({0}/{1})\u2026\nM\xE3
      ph\xF2ng: {2}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 6548989403174
    m_Localized: "M\u1ED9t ng\u01B0\u1EDDi ch\u01A1i \u0111\xE3 ng\u1EAFt k\u1EBFt
      n\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403175
    m_Localized: "H\xE3y \u0111\u1EE3i h\u1ECD, \u0111\u1EC3 bot c\u1EE7a Medium
      ti\u1EBFp qu\u1EA3n, ho\u1EB7c l\u01B0u l\u1EA1i v\xE0 t\u1EA1m d\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403176
    m_Localized: "Ch\u1EDD / T\u1EF1 \u0111\u1ED9ng b\u1ECF qua"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403179
    m_Localized: "Tr\u1EADn \u0111\u1EA5u \u0111\xE3 \u0111\u01B0\u1EE3c l\u01B0u
      v\xE0 t\u1EA1m d\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403180
    m_Localized: "Ng\u01B0\u1EDDi ch\u1EE7 tr\xEC c\xF3 th\u1EC3 ti\u1EBFp t\u1EE5c
      phi\xEAn h\u1ECDp khi m\u1ECDi ng\u01B0\u1EDDi \u0111\xE3 s\u1EB5n s\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403181
    m_Localized: "Ti\u1EBFp t\u1EE5c ph\xF9 h\u1EE3p"
    m_Metadata:
      m_Items: []
