  - m_Id: 74273040359424
    m_Localized: "Tuy\u1EC7t v\u1EDDi!"
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074624
    m_Localized: "Tuy\u1EC7t v\u1EDDi!"
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074625
    m_Localized: "Tuy\u1EC7t v\u1EDDi!"
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074626
    m_Localized: "Tuy\u1EC7t v\u1EDDi!"
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074627
    m_Localized: "B\u1EA1n bi\u1EBFt c\xE1ch l\xE0m cho t\xF4i c\u1EA3m th\u1EA5y
      m\xECnh xinh \u0111\u1EB9p."
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074628
    m_Localized: "\u0110\xF3 ch\xEDnh l\xE0 \u0111i\u1EC1u t\xF4i \u0111ang n\xF3i
      \u0111\u1EBFn!"
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074629
    m_Localized: "T\xF4i c\u1EA7n nhi\u1EC1u h\u01A1n th\u1EBF trong cu\u1ED9c s\u1ED1ng
      c\u1EE7a m\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074630
    m_Localized: "T\xF4i th\xEDch n\xF3. T\xF4i y\xEAu n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074631
    m_Localized: "Tuy\u1EC7t v\u1EDDi!"
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074632
    m_Localized: "X\xFAc x\xEDch!"
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074633
    m_Localized: "\xD4i tr\u1EDDi \u01A1i, chuy\u1EC7n g\xEC \u0111ang x\u1EA3y ra
      v\u1EADy!"
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074634
    m_Localized: "V\xE0 \u0111\xFAng v\u1EADy!"
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074635
    m_Localized: Cha!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074636
    m_Localized: "Ng\u1ECDt ng\xE0o qu\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074637
    m_Localized: "Ng\u1ECDt!"
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074638
    m_Localized: Yallah!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074639
    m_Localized: "Tuy\u1EC7t v\u1EDDi!"
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074640
    m_Localized: "Tuy\u1EC7t v\u1EDDi!"
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010752
    m_Localized: "X\u1EA5u!"
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010753
    m_Localized: "Kh\xF4ng c\xF3 \u1EDF \u0111\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010754
    m_Localized: "B\u1EA1n \u0111ang ngh\u0129 g\xEC v\u1EADy?"
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010755
    m_Localized: "Sao b\u1EA1n c\xF3 th\u1EC3 l\xE0m th\u1EBF?"
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010756
    m_Localized: "V\xE0o t\xF9 ngay l\u1EADp t\u1EE9c..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010757
    m_Localized: "\u0110i\u1EC1u \u0111\xF3 l\xE0 b\u1EA5t h\u1EE3p ph\xE1p..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010758
    m_Localized: "T\xF4i kh\xF4ng hi\u1EC3u b\u1EA1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010759
    m_Localized: "B\u1EA1n suy ngh\u0129 nh\u01B0 m\u1ED9t con chu\u1ED9t hamster..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010760
    m_Localized: "Ai \u0111\xF3 \u0111ang b\u1ECB ch\u1EE9ng \"ng\xE0y th\u1EE9 Hai
      u\u1EC3 o\u1EA3i\"..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010761
    m_Localized: "\xD4i..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010762
    m_Localized: "\xD4i tr\u1EDDi \u01A1i..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010763
    m_Localized: "\xD4i tr\u1EDDi \u01A1i..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010764
    m_Localized: "\u1ED2, h\u01A1i \u0111au m\u1ED9t ch\xFAt..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010765
    m_Localized: "N\u1ED7i t\u1EE7i nh\u1EE5c..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010766
    m_Localized: "L\u1ED6I! PH\xC1T HI\u1EC6N TR\xCD TU\u1EC6 K\xC9M!"
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010767
    m_Localized: "Con m\xE8o c\u1EE7a t\xF4i c\xF2n ch\u01A1i gi\u1ECFi h\u01A1n
      th\u1EBF."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010768
    m_Localized: "H\u1EEB..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010769
    m_Localized: "T\xF4i kh\xF4ng ng\u1EDD \u0111i\u1EC1u \u0111\xF3..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010770
    m_Localized: "\u1EEAm..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010771
    m_Localized: "\u0110\xE1ng l\u1EBD m\u1ECDi chuy\u1EC7n c\xF3 th\u1EC3 t\u1ED1t
      h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010772
    m_Localized: "Gi\u1EA5u b\xE0i c\u1EE7a \u0111\u1ED1i th\u1EE7 gi\u1EEFa c\xE1c
      l\u01B0\u1EE3t ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010773
    m_Localized: "Di chuy\u1EC3n tay \u0111\u1ED1i th\u1EE7 ra kh\u1ECFi m\xE0n h\xECnh
      m\u1ED9t ph\u1EA7n cho \u0111\u1EBFn l\u01B0\u1EE3t ti\u1EBFp theo c\u1EE7a
      h\u1ECD."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010774
    m_Localized: "Chi\u1EC1u r\u1ED9ng khu v\u1EF1c m\xE9p ch\u1EA3o"
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010775
    m_Localized: "\u0110i\u1EC1u khi\u1EC3n kho\u1EA3ng c\xE1ch t\u1EEB c\xE1c c\u1EA1nh
      tr\xE1i, ph\u1EA3i v\xE0 tr\xEAn c\xF9ng m\xE0 thao t\xE1c k\xE9o b\u1EAFt
      \u0111\u1EA7u di chuy\u1EC3n b\u1EA3ng; \u0111\u1EB7t th\xE0nh 0 \u0111\u1EC3
      t\u1EAFt."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010776
    m_Localized: "Ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 312397158932480
    m_Localized: "C\u1EA3m gi\xE1c m\u1EDBi \u0111\xE3 \u0111\u01B0\u1EE3c m\u1EDF
      kh\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 312397712580608
    m_Localized: "Nh\u1EA5n \u0111\u1EC3 ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 346014409023488
    m_Localized: "Tr\u1EADn \u0111\u1EA5u n\xE0y kh\xF4ng c\xF2n ch\u1ED7 ng\u1ED3i
      mi\u1EC5n ph\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 346014845231104
    m_Localized: "Ch\xFAng t\xF4i kh\xF4ng t\xECm th\u1EA5y k\u1EBFt qu\u1EA3 ph\xF9
      h\u1EE3p v\u1EDBi m\xE3 \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 346014845231105
    m_Localized: "Hi\u1EC7n t\u1EA1i kh\xF4ng c\xF3 k\u1EBFt qu\u1EA3 ph\xF9 h\u1EE3p
      n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 346014845231106
    m_Localized: "Kh\xF4ng th\u1EC3 tham gia tr\u1EADn \u0111\u1EA5u. Vui l\xF2ng
      th\u1EED l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 349485589848064
    m_Localized: "\u0110ang ch\u1EDD ng\u01B0\u1EDDi ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141120
    m_Localized: "M\xE3 ph\xF2ng: {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 349485963141121
    m_Localized: "R\u1EDDi kh\u1ECFi tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141122
    m_Localized: "L\u01B0u v\xE0 t\u1EA1m d\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141123
    m_Localized: "M\xE1y ch\u1EE7 b\u1ECB ng\u1EAFt k\u1EBFt n\u1ED1i, \u0111ang
      t\xECm m\xE1y ch\u1EE7 m\u1EDBi\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141124
    m_Localized: "Kh\xF4ng th\u1EC3 kh\xF4i ph\u1EE5c tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141125
    m_Localized: "{0} \u0111ang k\u1EBFt n\u1ED1i l\u1EA1i\u2026 {1} gi\xE2y"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 349485963141126
    m_Localized: "Vui l\xF2ng ch\u1EDD, AI \u0111ang ho\xE0n th\xE0nh l\u01B0\u1EE3t
      n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141127
    m_Localized: "Ch\u1EE7 nh\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141128
    m_Localized: "\u0110ang ch\u1EDD ng\u01B0\u1EDDi ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141129
    m_Localized: "\u0110\xE3 k\u1EBFt n\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141130
    m_Localized: "K\u1EBFt n\u1ED1i l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141131
    m_Localized: "\u0110\xE3 ng\u1EAFt k\u1EBFt n\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141132
    m_Localized: "AI \u0111ang ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141133
    m_Localized: "\u0110ang ch\u1EDD \u0111\u1EE3i AI"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141134
    m_Localized: "H\xE3y ti\u1EBFp t\u1EE5c ch\u1EDD \u0111\u1EE3i"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141135
    m_Localized: "H\xE3y \u0111\u1EC3 AI ch\u01A1i v\u1EDBi gi\xE1 {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 377671954456576
    m_Localized: "K\u1EBFt n\u1ED1i l\u1EA1i v\u1EDBi ph\xF2ng {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 377671971233792
    m_Localized: "\u0110ang k\u1EBFt n\u1ED1i l\u1EA1i v\u1EDBi ph\xF2ng {0}\u2026"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
  - m_Id: 377671971233793
    m_Localized: "Tr\u1EADn \u0111\u1EA5u \u0111\xE3 k\u1EBFt th\xFAc."
    m_Metadata:
      m_Items: []
  - m_Id: 410560075128832
    m_Localized: "\u0110ang k\u1EBFt n\u1ED1i l\u1EA1i v\u1EDBi tr\u1EADn \u0111\u1EA5u\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 410560075128833
    m_Localized: "\u0110ang ch\u1EDD ng\u01B0\u1EDDi ch\u01A1i ch\u1EA5p nh\u1EADn
      tr\u1EADn t\xE1i \u0111\u1EA5u\u2026 ({0}/{1} s\u1EB5n s\xE0ng)"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282619
