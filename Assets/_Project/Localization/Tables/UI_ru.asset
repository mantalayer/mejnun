      \u0434\u043B\u044F \u0440\u043E\u0437\u044B\u0433\u0440\u044B\u0448\u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0440\u043E\u0437\u044B\u0433\u0440\u044B\u0448 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043F\u0430\u0441. \u0415\u0441\u043B\u0438 \u0432\u0441\u0435 \u0438\u0433\u0440\u043E\u043A\u0438
      \u043F\u0430\u0441\u0443\u044E\u0442 \u043F\u043E\u0434\u0440\u044F\u0434,
      \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442 \u0438\u0433\u0440\u043E\u043A
      \u0441 \u043D\u0430\u0438\u043C\u0435\u043D\u044C\u0448\u0438\u043C \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C
      \u043A\u0430\u0440\u0442. \u041D\u0438\u0447\u044C\u044F \u2013 \u044D\u0442\u043E
      \u0442\u0443\u043F\u0438\u043A\u043E\u0432\u0430\u044F \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403143
    m_Localized: "\u0418\u0441\u043F\u0440\u0430\u0432\u044C\u0442\u0435 \u043F\u043B\u0430\u0442\u0443
      \u0438 \u043E\u0442\u043A\u0430\u0442\u0438\u0442\u0435 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403144
    m_Localized: "\u0424\u0443\u043D\u043A\u0446\u0438\u044F Fix board \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043A\u0430\u0436\u0434\u044B\u0439
      \u043D\u0430\u0431\u043E\u0440 \u0445\u043E\u0434\u043E\u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C,
      \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F \u043F\u0440\u0438 \u044D\u0442\u043E\u043C
      \u0432\u0430\u0448\u0438 \u0445\u043E\u0434\u044B. \u0424\u0443\u043D\u043A\u0446\u0438\u044F
      Revert \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0432\u0441\u044E
      \u0438\u0433\u0440\u043E\u0432\u0443\u044E \u0434\u043E\u0441\u043A\u0443 \u0432
      \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u043E \u0432\u0430\u0448\u0435\u0433\u043E
      \u0445\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403145
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438 \u0438 \u0442\u0430\u0431\u043B\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403146
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442
      \u043A\u0430\u0440\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0440\u0430\u0437\u044B\u0433\u0440\u0430\u0442\u044C.
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0436\u0435\u0441\u0442
      \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      (\u0449\u0438\u043F\u043E\u043A), \u043F\u0435\u0440\u0435\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u043D\u0438\u044F
      (\u043F\u0435\u0440\u0435\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u043D\u0438\u0435)
      \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F
      \u0438 \u043F\u043E\u0434\u0433\u043E\u043D\u043A\u0438 \u043F\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0443,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0432\u0441\u044E
      \u0442\u0430\u0431\u043B\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403147
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0438\u0433\u0440\u0430"
