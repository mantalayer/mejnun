  - m_Id: 6549014568960
    m_Localized: "\u041F\u0435\u0440\u0432\u0430\u044F \u0438\u0433\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568961
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0441\u0432\u043E\u044E
      \u043F\u0435\u0440\u0432\u0443\u044E \u0438\u0433\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568962
    m_Localized: "\u041F\u0435\u0440\u0432\u0430\u044F \u043F\u043E\u0431\u0435\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568963
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0439\u0442\u0435 \u0441\u0432\u043E\u044E
      \u043F\u0435\u0440\u0432\u0443\u044E \u0438\u0433\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568964
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u041C\u0435\u0434\u0436\u043D\u0443\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763265
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u043F\u043E\u0431\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763268
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435 \u0441\u043B\u043E\u0436\u043D\u043E\u0433\u043E
      \u0431\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763269
    m_Localized: "\u041F\u043E\u043B\u043D\u0430\u044F \u0442\u0430\u0431\u043B\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763270
    m_Localized: "\u0421\u044B\u0433\u0440\u0430\u0439\u0442\u0435 \u0432 \u0438\u0433\u0440\u0443
      \u043D\u0430 \u0448\u0435\u0441\u0442\u044C \u043C\u0435\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763271
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763272
    m_Localized: "\u0421\u044B\u0433\u0440\u0430\u0439\u0442\u0435 50 \u0438\u0433\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763273
    m_Localized: "\u0412\u0435\u0442\u0435\u0440\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763274
    m_Localized: "\u0421\u044B\u0433\u0440\u0430\u0439\u0442\u0435 250 \u0438\u0433\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763275
    m_Localized: "\u041E\u043F\u044B\u0442\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763276
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0439\u0442\u0435 50 \u0438\u0433\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763277
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u041C\u0435\u0434\u0436\u043D\u0443\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763278
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0439\u0442\u0435 200 \u0438\u0433\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763279
    m_Localized: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C 10"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763280
    m_Localized: "\u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0438\u0442\u0435 10-\u0433\u043E
      \u0443\u0440\u043E\u0432\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763281
    m_Localized: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C 25"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763282
    m_Localized: "\u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0438\u0442\u0435 25-\u0433\u043E
      \u0443\u0440\u043E\u0432\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763283
    m_Localized: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C 50"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763285
    m_Localized: "\u041A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763287
    m_Localized: "\u041C\u0415\u0416\u041D\u0423\u041D \xD710"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763288
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0439\u0442\u0435 10 \u0438\u0433\u0440,
      \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0438\u0432 \u0441\u0432\u043E\u044E
      \u0440\u0443\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763289
    m_Localized: "\u0427\u0438\u0441\u0442\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763290
    m_Localized: "\u0421\u043F\u0443\u0441\u0442\u0438\u0442\u0435\u0441\u044C \u0432\u043D\u0438\u0437
      \u0438 \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0438\u0442\u0435 \u0441\u0432\u043E\u044E
      \u0440\u0443\u043A\u0443 \u0432 \u0442\u043E\u0442 \u0436\u0435 \u0445\u043E\u0434,
      \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0432 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438
      \u0438 \u0444\u0443\u043D\u043A\u0446\u0438\u044E \xAB\u0418\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0434\u043E\u0441\u043A\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763291
    m_Localized: "\u041C\u043E\u043B\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763292
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0439\u0442\u0435 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u043F\u0435\u0440\u0432\u044B\u0445 \u043F\u044F\u0442\u0438 \u0445\u043E\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763293
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0432\u0437\u0434\u043E\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763294
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0439\u0442\u0435, \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0438\u0432
      \u0441\u0432\u043E\u044E \u0440\u0443\u043A\u0443, \u043A\u043E\u0433\u0434\u0430
      \u043A\u043E\u043B\u043E\u0434\u0430 \u0434\u043B\u044F \u0440\u043E\u0437\u044B\u0433\u0440\u044B\u0448\u0430
      \u043F\u0443\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763296
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0430 \u043F\u0440\u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u0438
      20 \u0438\u043B\u0438 \u0431\u043E\u043B\u0435\u0435 \u043A\u0430\u0440\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763297
    m_Localized: "\u0414\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u043A\u043E\u043D\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763298
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0439\u0442\u0435 \u043F\u043E
      \u0438\u0442\u043E\u0433\u043E\u0432\u043E\u043C\u0443 \u0441\u0447\u0435\u0442\u0443
      \u0440\u043E\u0432\u043D\u043E \u043D\u0430 \u043E\u0434\u043D\u0443 \u043A\u0430\u0440\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763299
    m_Localized: "\u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763300
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u043E\u043B\u043D\u0443\u044E
      \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044E \u0438\u0437 13
      \u043A\u0430\u0440\u0442, \u043E\u0442 \u0442\u0443\u0437\u0430 \u0434\u043E
      \u043A\u043E\u0440\u043E\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763302
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0442\u0440\u0438\u0442
      \u0438\u0437 \u0434\u0430\u043C\u044B, \u043A\u043E\u0440\u043E\u043B\u044F
      \u0438 \u0442\u0443\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763303
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0432\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763304
    m_Localized: "\u0412\u044B\u043F\u043E\u043B\u043D\u044F\u0439\u0442\u0435 \u043A\u0430\u043A
      \u043C\u0438\u043D\u0438\u043C\u0443\u043C \u0442\u0440\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u0430
      \u0437\u0430 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763305
    m_Localized: "\u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763306
    m_Localized: "\u0420\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u043D\u0430
      \u0440\u0443\u043A\u0430\u0445 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435
      \u0432\u043E\u0441\u044C\u043C\u0438 \u043A\u0430\u0440\u0442 \u0437\u0430
      \u043E\u0434\u0438\u043D \u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763307
    m_Localized: "\u0425\u0438\u0440\u0443\u0440\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763308
    m_Localized: "\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u0435 \u043F\u0440\u044F\u043C\u0443\u044E
      \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u043F\u043E\u0432\u043E\u0440\u043E\u0442
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439 \u0434\u043E\u0441\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763309
    m_Localized: "\u0417\u0430\u0438\u043C\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763310
    m_Localized: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043A\u0430\u0440\u0442\u0443
      \u0438\u0437 \u043D\u0430\u0431\u043E\u0440\u0430 \u0438\u0437 \u0447\u0435\u0442\u044B\u0440\u0435\u0445
      \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0445 \u043A\u0430\u0440\u0442
      \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763311
    m_Localized: "\u0414\u0432\u043E\u0439\u043D\u043E\u0435 \u0437\u0440\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763312
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0441\u0432\u043E\u0439
      \u0445\u043E\u0434, \u0438\u043C\u0435\u044F \u043E\u0431\u0435 \u043A\u043E\u043F\u0438\u0438
      \u043A\u0430\u0440\u0442\u044B \u0432 \u0440\u0430\u0437\u043D\u044B\u0445
      \u043D\u0430\u0431\u043E\u0440\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763313
    m_Localized: "\u041F\u0430\u0446\u0438\u0435\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763314
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0439\u0442\u0435, \u043D\u0435
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u0444\u0443\u043D\u043A\u0446\u0438\u0438
      \xAB\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C\xBB, \xAB\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C\xBB
      \u0438\u043B\u0438 \xAB\u0418\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0434\u043E\u0441\u043A\u0443\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763315
    m_Localized: "\u0411\u0435\u0437 \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043A\u043E\u043B\u0435\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763316
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0439\u0442\u0435, \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0432
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763317
    m_Localized: "\u0423\u0432\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763318
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u0432\u0430\u0448\u0430 \u043E\u0447\u0435\u0440\u0435\u0434\u044C
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763319
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u044F\u0439\u0442\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435
      \u043F\u043E\u0434 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763320
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442, \u043A\u043E\u0433\u0434\u0430
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
      \u043C\u0435\u043D\u0435\u0435 \u0442\u0440\u0435\u0445 \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763322
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0439\u0442\u0435 \u0438\u0433\u0440\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
