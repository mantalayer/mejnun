  - m_Id: 6548981014528
    m_Localized: "\u041C\u0435\u0434\u0436\u043D\u0443\u043D \u0438\u0433\u0440\u0430\u0435\u0442\u0441\u044F
      \u0434\u0432\u0443\u043C\u044F \u043F\u043E\u043B\u043D\u044B\u043C\u0438 \u043A\u043E\u043B\u043E\u0434\u0430\u043C\u0438:
      104 \u043A\u0430\u0440\u0442\u044B. \u041A\u0430\u0436\u0434\u043E\u043C\u0443
      \u0438\u0433\u0440\u043E\u043A\u0443 \u0440\u0430\u0437\u0434\u0430\u044E\u0442
      \u043F\u043E 11 \u043A\u0430\u0440\u0442. \u041F\u043E\u0431\u0435\u0434\u0443
      \u043E\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0442\u043E\u0442,
      \u043A\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u043C \u0432\u044B\u043B\u043E\u0436\u0438\u0442
      \u0432\u0441\u0435 \u043A\u0430\u0440\u0442\u044B \u0438\u0437 \u0441\u0432\u043E\u0435\u0439
      \u0440\u0443\u043A\u0438 \u043D\u0430 \u0441\u0442\u043E\u043B."
    m_Metadata:
      m_Items: []
