    m_Metadata:
      m_Items: []
  - m_Id: 6549031346275
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043A\u043D\u043E\u043F\u043A\u0443
      \u043F\u0435\u0440\u0435\u043C\u043E\u0442\u043A\u0438 \u0432\u043F\u0435\u0440\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346290
    m_Localized: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435 \u0440\u0443\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346291
    m_Localized: "\u0420\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u0442 \u0432\u044B\u0441\u043E\u0442\u0443
      \u043F\u043E\u0434\u044A\u0435\u043C\u0430 \u043A\u0430\u0440\u0442\u043E\u0447\u0435\u043A
      \u043F\u0440\u0438 \u0438\u0445 \u0432\u044B\u0431\u043E\u0440\u0435 \u0438\u043B\u0438
      \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u043A\u0443\u0440\u0441\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346297
    m_Localized: "\u0418\u0437\u043C\u0435\u043D\u044F\u0435\u0442 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u043C\u0435\u0436\u0434\u0443 \u043A\u0430\u0440\u0442\u0430\u043C\u0438 \u0432
      \u0438\u0433\u0440\u043E\u0432\u044B\u0445 \u043D\u0430\u0431\u043E\u0440\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346310
    m_Localized: "\u0440\u0430\u0437\u043C\u0435\u0440 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E
      \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540488
    m_Localized: "\u0417\u0430\u043F\u043E\u043B\u043D\u044F\u0439\u0442\u0435 \u0431\u044B\u0441\u0442\u0440\u044B\u0435
      \u043C\u0430\u0442\u0447\u0438 \u0431\u043E\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540491
    m_Localized: '{0:plural:{} second|{} seconds}'
