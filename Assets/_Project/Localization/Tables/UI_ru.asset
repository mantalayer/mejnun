  - m_Id: 6549035540549
    m_Localized: "\u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u044D\u0442\u0430 \u043E\u043F\u0446\u0438\u044F \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540550
    m_Localized: "\u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043A\u0430\u0440\u0442\u044B \u0441 \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E
      \u043F\u043E\u043B\u044F, \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435
      \u0448\u0430\u0433 \u0432\u043D\u0438\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540551
    m_Localized: "\u041A\u0430\u0440\u0442\u044B \u043D\u0430 \u0438\u0433\u0440\u043E\u0432\u043E\u043C
      \u043F\u043E\u043B\u0435 \u043D\u0435\u043B\u044C\u0437\u044F \u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u0432 \u0440\u0443\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540552
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435\u043C
      \u0445\u043E\u0434\u0430 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u044B\u0439
      \u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540553
    m_Localized: "\u042D\u0442\u043E\u0442 \u043D\u0430\u0431\u043E\u0440 \u043D\u0435
      \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
      \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F\u043C \u0434\u043B\u044F
      \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F \u0443\u0440\u043E\u0432\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540554
    m_Localized: "\u0412 \u043D\u0430\u0431\u043E\u0440\u0435 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u043E\u0434\u043D\u043E\u0439 \u0438 \u0442\u043E\u0439
      \u0436\u0435 \u043A\u0430\u0440\u0442\u044B \u0434\u0432\u0430\u0436\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540555
    m_Localized: "\u0412 \u044D\u0442\u043E\u043C \u043D\u0430\u0431\u043E\u0440\u0435
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u043A\u0430\u0440\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540556
    m_Localized: "\u042D\u0442\u0443 \u043A\u0430\u0440\u0442\u0443 \u043D\u0435\u043B\u044C\u0437\u044F
      \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0432 \u0434\u0430\u043D\u043D\u044B\u0439
      \u043D\u0430\u0431\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540557
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0435
