  - m_Id: 6549035540496
    m_Localized: "{0}\xD7"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282628
  - m_Id: 6549035540501
    m_Localized: "\u0414\u0438\u043B\u0435\u0440 \u0440\u0430\u0437\u0434\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u0438\u0433\u0440\u043E\u043A\u0443
      \u043F\u043E 11 \u043A\u0430\u0440\u0442, \u043F\u043E \u043E\u0434\u043D\u043E\u0439
      \u0437\u0430 \u0440\u0430\u0437, \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439
      \u0441\u0442\u0440\u0435\u043B\u043A\u0435, \u043D\u0430\u0447\u0438\u043D\u0430\u044F
      \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0438\u0433\u0440\u043E\u043A\u0430.
      \u041E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u043A\u0430\u0440\u0442\u044B
      \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442 \u043A\u043E\u043B\u043E\u0434\u0443
      \u0434\u043B\u044F \u0440\u043E\u0437\u044B\u0433\u0440\u044B\u0448\u0430 \u0440\u0443\u0431\u0430\u0448\u043A\u043E\u0439
      \u0432\u0432\u0435\u0440\u0445, \u0438 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0445\u043E\u0434 \u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439
      \u0438\u0433\u0440\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540503
    m_Localized: "\u0427\u0442\u043E\u0431\u044B \u0432\u044B\u0438\u0433\u0440\u0430\u0442\u044C,
      \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0432\u044B\u043C \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0438\u0442\u044C
      \u0440\u0443\u043A\u0443. \u0418\u0433\u0440\u0430 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
      \u0438\u0437 \u043E\u0434\u043D\u043E\u0433\u043E \u0440\u0430\u0443\u043D\u0434\u0430;
      \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C \u0445\u043E\u0434\u0438\u0442
      \u043F\u0435\u0440\u0432\u044B\u043C \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0438\u0433\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540504
    m_Localized: "\u041D\u0430\u0431\u043E\u0440\u044B \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0445
      \u043A\u0430\u0440\u0442 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442 3\u20134
      \u043A\u0430\u0440\u0442\u044B \u043E\u0434\u043D\u043E\u0433\u043E \u0440\u0430\u043D\u0433\u0430,
      \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u043A\u0430\u0436\u0434\u0430\u044F
      \u043C\u0430\u0441\u0442\u044C \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u0430.
      \u0421\u0442\u0440\u0438\u0442\u044B \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442
      3\u201313 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043A\u0430\u0440\u0442 \u043E\u0434\u043D\u043E\u0439 \u043C\u0430\u0441\u0442\u0438,
      \u0431\u0435\u0437 \u043F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u044F
      \u0440\u0430\u043D\u0433\u0430. \u0422\u0443\u0437 \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u043C\u043B\u0430\u0434\u0448\u0438\u043C (A-2-3)
      \u0438\u043B\u0438 \u0441\u0442\u0430\u0440\u0448\u0438\u043C (Q-K-A), \u043D\u043E
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043E\u0431\u043E\u0438\u043C\u0438
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E; K-A-2
      \u043D\u0435 \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u043D\u0430\u0431\u043E\u0440 \u043D\u0430
      \u0441\u0442\u043E\u043B\u0435 \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C;
      \u043D\u0430\u0431\u043E\u0440\u044B \u0438\u0437 \u043E\u0434\u043D\u043E\u0439
      \u0438\u043B\u0438 \u0434\u0432\u0443\u0445 \u043A\u0430\u0440\u0442 \u043D\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540510
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430 \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442
      \u0445\u043E\u0434\u044B, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044F\u0441\u044C
      \u043D\u0430\u0437\u0430\u0434; \u041F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u0435
      \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442
      \u043E\u0442\u043C\u0435\u043D\u0435\u043D\u043D\u044B\u0439 \u0445\u043E\u0434
      \u0432 \u0442\u043E\u043C \u0436\u0435 \u0445\u043E\u0434\u0443. \u041D\u043E\u0432\u044B\u0435
      \u0445\u043E\u0434\u044B \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F,
      \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u044E\u0449\u0438\u0435 \u0445\u043E\u0434,
      \u043E\u0442\u043C\u0435\u043D\u044F\u044E\u0442 \u041F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u0435.
      \u0418\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0434\u043E\u0441\u043A\u0438
      \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u044B\u0435 \u0445\u043E\u0434\u044B
      \u0438\u0437 \u0432\u0430\u0448\u0435\u0439 \u0440\u0443\u043A\u0438, \u043F\u043E\u043A\u0430
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0434\u043E\u0441\u043A\u0443; \u043A\u0430\u0440\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043E\u043D\u0430 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C,
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u0432
      \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443. \u041E\u0442\u043C\u0435\u043D\u0430
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0434\u043E\u0441\u043A\u0443 \u0434\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F
      \u043D\u0430\u0447\u0430\u043B\u0430 \u0445\u043E\u0434\u0430 \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0441\u044B\u0433\u0440\u0430\u043D\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u044B
      \u0432 \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443. \u0414\u0435\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u044B\u0435
