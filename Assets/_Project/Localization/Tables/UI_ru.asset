  - m_Id: 6548985208855
    m_Localized: "{0} \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0438 10\u2665 J\u2665
      \u043A \u0432\u0430\u0448\u0438\u043C \u0447\u0435\u0440\u0432\u0430\u043C
      \u0438 5\u2665 \u043A \u0432\u0430\u0448\u0438\u043C \u043F\u044F\u0442\u0435\u0440\u043A\u0430\u043C.
      \u041A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B \u043E\u043A\u0430\u0436\u0435\u0442\u0435\u0441\u044C
      \u0432 \u043D\u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0435\u043C \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0438,
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
      \u043A \u043B\u044E\u0431\u043E\u043C\u0443 \u043D\u0430\u0431\u043E\u0440\u0443
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282628
  - m_Id: 6548985208856
    m_Localized: "\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u043F\u0440\u044F\u043C\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208857
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      10\u2665 \u0438 \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
      \u0435\u0451 \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u0439 \u0441\u0442\u043E\u043B.
      \u0412\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0435\u0439 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u0438 10\u2665 J\u2665."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208858
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208859
    m_Localized: "10\u2665 J\u2665 \u0438\u043C\u0435\u0435\u0442 \u043A\u0440\u0430\u0441\u043D\u0443\u044E
      \u043E\u0431\u0432\u043E\u0434\u043A\u0443: \u044D\u0442\u043E \u043D\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043D\u0430\u0431\u043E\u0440. \u042D\u0442\u043E \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E
      \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u0445\u043E\u0434\u0430,
      \u043D\u043E \u0432\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0441\u0432\u043E\u0439
      \u0445\u043E\u0434, \u043F\u043E\u043A\u0430 \u0432\u0441\u0435 \u043D\u0430\u0431\u043E\u0440\u044B
      \u043D\u0435 \u0431\u0443\u0434\u0443\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208861
    m_Localized: "\u041F\u043E\u043B\u043E\u0436\u0438\u0442\u0435 \u0441\u0432\u043E\u044E
      9\u2665 \u043D\u0430 10\u2665 J\u2665. \u042D\u0442\u043E \u0443\u0434\u0432\u043E\u0435\u043D\u043D\u0430\u044F
      9\u2665 \u0438\u0437 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043D\u0430\u0431\u043E\u0440\u0430,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0437\u0434\u0435\u0441\u044C \u044D\u0442\u043E
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208862
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208863
    m_Localized: "\u0414\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438 \u043E\u0448\u0438\u0431\u043A\u0443?
      \u041E\u0442\u043C\u0435\u043D\u0438\u0442\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u043D\u0430 \u043E\u0434\u0438\u043D \u0448\u0430\u0433 \u043D\u0430\u0437\u0430\u0434.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208864
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0435\u043B\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208865
    m_Localized: "\u0424\u0443\u043D\u043A\u0446\u0438\u044F \xAB\u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C\xBB
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0445\u043E\u0434
      \u043D\u0430 \u043F\u0440\u0435\u0436\u043D\u0438\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C.
      \u0424\u0443\u043D\u043A\u0446\u0438\u044F \xAB\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C\xBB
      \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u0432\u0435\u0441\u044C
      \u0445\u043E\u0434, \u0430 \u0444\u0443\u043D\u043A\u0446\u0438\u044F \xAB\u0418\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0434\u043E\u0441\u043A\u0443\xBB \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0438\u0433\u0440\u043E\u0432\u043E\u0435
      \u043F\u043E\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208866
    m_Localized: "\u0412\u0441\u0435 \u043D\u0430\u0431\u043E\u0440\u044B \u0441\u043D\u043E\u0432\u0430
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B.
      \u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208867
