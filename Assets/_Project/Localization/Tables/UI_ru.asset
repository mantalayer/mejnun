  - m_Id: 6548985208834
    m_Localized: "{0} \u041E\u043D\u0430 \u0441\u0434\u0435\u043B\u0430\u043B\u0430
      \u043D\u0430\u0431\u043E\u0440, \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u0437 \u0435\u0435 \u0440\u0443\u043A.
      \u042D\u0442\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \xAB\u0412\u043D\u0438\u0437\xBB, \u0438 \u043E\u0434\u043D\u043E\u0433\u043E
      \u043D\u0430\u0431\u043E\u0440\u0430 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282628
  - m_Id: 6548985208835
    m_Localized: "\u0412\u044B \u0435\u0449\u0451 \u043D\u0435 \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208836
    m_Localized: "\u0412\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0441\u0442\u043E\u043B,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0441\u0434\u0435\u043B\u0430\u0435\u0442\u0435
      \u0445\u043E\u0434. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435
      \u0445\u043E\u0434 \u0438\u0437 \u0441\u0432\u043E\u0435\u0439 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208837
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u0435\u0441\u044C
      \u0432\u043D\u0438\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208838
    m_Localized: "\u041F\u043E\u043A\u0430 \u0443 \u0432\u0430\u0441 \u043D\u0435\u0442
      \u043A\u0430\u0440\u0442 \u0432 \u0440\u0443\u043A\u0435, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u0435\u0442\u044B \u0438\u0437 \u0441\u0432\u043E\u0435\u0439 \u0440\u0443\u043A\u0438.
      \u041F\u043E\u043B\u043E\u0436\u0438\u0442\u0435 7\u2665 8\u2665 9\u2665 \u043D\u0430
      \u043F\u0443\u0441\u0442\u043E\u0439 \u0441\u0442\u043E\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208839
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435
      \u2014 \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u0435 \u0432\u0441\u0435
      \u0442\u0440\u0438 \u043A\u0430\u0440\u0442\u044B \u0438\u0437 \u0441\u0432\u043E\u0435\u0439
      \u0440\u0443\u043A\u0438, \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u0439\u0442\u0438
      \u0432 \u043D\u0438\u0436\u043D\u0438\u0439 \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208841
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u0441\u044F \u0442\u0430\u0431\u043B\u0438\u0446\u0430
      \u0432 \u0432\u0430\u0448\u0435\u043C \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0438:
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u043A \u043B\u044E\u0431\u043E\u043C\u0443
      \u043D\u0430\u0431\u043E\u0440\u0443, \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u043B\u044F\u0439\u0442\u0435,
      \u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0439\u0442\u0435. \u0418 \u0432\u044B
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C
      \u0438\u0433\u0440\u0443 \u0432 \u044D\u0442\u043E\u0442 \u0436\u0435 \u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208842
    m_Localized: "\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0432 \u043D\u0430\u0431\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208844
    m_Localized: "\u0422\u0443\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208847
    m_Localized: "\u041F\u043E\u043B\u043E\u0436\u0438\u0442\u0435 5\u2663 5\u2666
      5\u2660 \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u0439 \u0441\u0442\u043E\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208848
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435
      \u2014 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435
      \u0432\u0441\u0435\u0445 \u0442\u0440\u0435\u0445 \u043A\u0430\u0440\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208849
    m_Localized: "\u041F\u0430\u0440\u043D\u044B\u0435 \u0438\u0433\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208850
    m_Localized: "\u0412 \u0434\u0432\u0443\u0445 \u043A\u043E\u043B\u043E\u0434\u0430\u0445
      \u0443 \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u0430\u0440\u0442\u044B
      \u0435\u0441\u0442\u044C \u0434\u0443\u0431\u043B\u0438\u043A\u0430\u0442:
      \u0442\u043E\u0439 \u0436\u0435 \u043C\u0430\u0441\u0442\u0438 \u0438 \u0440\u0430\u043D\u0433\u0430,
      \u043D\u043E \u0438\u0437 \u0434\u0440\u0443\u0433\u043E\u0439 \u043A\u043E\u043B\u043E\u0434\u044B
      (\u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u043D\u0430
      \u043E\u0431\u043E\u0440\u043E\u0442\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0438\u043D\u0430\u0447\u0435). \u0414\u0443\u0431\u043B\u0438\u043A\u0430\u0442
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0432 \u043E\u0434\u043D\u043E\u043C \u0438 \u0442\u043E\u043C
      \u0436\u0435 \u043D\u0430\u0431\u043E\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208851
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0441\u0432\u043E\u0439
      \u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208852
    m_Localized: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0441\u0432\u043E\u0439 \u0445\u043E\u0434, \u043A\u043E\u0433\u0434\u0430
      \u0432\u0441\u0435 \u043A\u0430\u0440\u0442\u044B \u043D\u0430 \u0441\u0442\u043E\u043B\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B
      \u0438 \u0432\u044B \u0441\u044B\u0433\u0440\u0430\u043B\u0438 \u0445\u043E\u0442\u044F
      \u0431\u044B \u043E\u0434\u043D\u0443 \u043A\u0430\u0440\u0442\u0443 \u0438\u0437
      \u0441\u0432\u043E\u0435\u0439 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208853
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435 {0}."
