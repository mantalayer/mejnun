  m_TableData:
  - m_Id: 1656690302984
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u043D\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014530
    m_Localized: "\u041A\u0430\u0440\u0442\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430 \u0441\u0442\u043E\u043B \u043D\u0430\u0431\u043E\u0440\u0430\u043C\u0438.
      \u041E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u0430\u044F \u043A\u043E\u043B\u043E\u0434\u0430
      \u2014 \u044D\u0442\u043E 3 \u0438\u043B\u0438 4 \u043A\u0430\u0440\u0442\u044B
      \u043E\u0434\u043D\u043E\u0439 \u043C\u0430\u0441\u0442\u0438, \u0432\u0441\u0435
      \u0440\u0430\u0437\u043D\u044B\u0445 \u043C\u0430\u0441\u0442\u0435\u0439.
      \u0421\u0442\u0440\u0438\u0442 \u2014 \u044D\u0442\u043E 3 \u0438\u043B\u0438
      \u0431\u043E\u043B\u0435\u0435 \u043A\u0430\u0440\u0442 \u043E\u0434\u043D\u043E\u0439
      \u043C\u0430\u0441\u0442\u0438, \u0432\u044B\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0445
      \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208840
    m_Localized: "\u0422\u044B \u043F\u043E\u0432\u0435\u0440\u0436\u0435\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208843
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435
      \u0441\u0432\u043E\u0439 A\u2660 \u043D\u0430 J\u2660 Q\u2660 K\u2660 {0}."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282628
  - m_Id: 6548985208845
    m_Localized: "\u0422\u0443\u0437 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u043C\u043B\u0430\u0434\u0448\u0438\u043C (A-2-3) \u0438\u043B\u0438 \u0441\u0442\u0430\u0440\u0448\u0438\u043C
      (Q-K-A), \u043D\u043E \u0441\u0442\u0440\u0438\u0442 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0437\u0430\u043A\u0440\u0443\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u043E\u043A\u0440\u0443\u0433 (K-A-2)."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208846
    m_Localized: "\u0410\u043D\u0430\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0439
      \u0432\u0438\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208860
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0441\u0432\u043E\u0439 \u0434\u0432\u043E\u0439\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208878
    m_Localized: "\u0418\u0433\u0440\u043E\u043A\u0438, \u0443 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0432\u043D\u0438\u0437\u0443 \u043A\u0430\u0440\u0442\u044B, \u0442\u0430\u043A\u0436\u0435
      \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C
      \u043D\u043E\u0432\u044B\u0435 \u043D\u0430\u0431\u043E\u0440\u044B \u0438\u0437
      \u0441\u0432\u043E\u0435\u0439 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208879
    m_Localized: "\u0417\u0430\u0441\u0442\u0440\u044F\u0432\u0448\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208885
    m_Localized: "\u041F\u043E\u043B\u043E\u0436\u0438\u0442\u0435 2\u2665 \u043D\u0430
      3\u2665 4\u2665 5\u2665."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208890
    m_Localized: "\u0410\u043D\u0430\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0439
      \u0432\u0438\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403138
    m_Localized: "\u0422\u043E\u0442 \u0436\u0435 \u043D\u0430\u0431\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403141
    m_Localized: "\u041F\u043E\u0432\u043E\u0440\u043E\u0442\u044B \u043D\u0430 \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403142
    m_Localized: "\u0412 \u0438\u0433\u0440\u0430\u0445 \u043D\u0430 \u0432\u0440\u0435\u043C\u044F
      \u0442\u0430\u0439\u043C\u0435\u0440 \u043E\u0442\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u0432\u0440\u0435\u043C\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0445\u043E\u0434\u0430.
      \u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u043E \u0438\u0441\u0442\u0435\u043A\u0430\u0435\u0442
      \u2014 \u0443\u0432\u044B! \u2014 \u0445\u043E\u0434 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u043C, \u0432
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435
      \u0432\u0430\u0448\u0438 \u043A\u0430\u0440\u0442\u044B \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430 \u043C\u0435\u0441\u0442\u043E, \u0438 \u0432\u044B \u0431\u0435\u0440\u0435\u0442\u0435
      \u043D\u043E\u0432\u0443\u044E."
    m_Metadata:
      m_Items: []
