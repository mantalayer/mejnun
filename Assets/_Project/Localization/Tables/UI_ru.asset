  - m_Id: 6548985208868
    m_Localized: "{0} \u043D\u0435 \u043C\u043E\u0433\u043B\u0430 \u0438\u0433\u0440\u0430\u0442\u044C,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D\u0430 \u0432\u0437\u044F\u043B\u0430
      \u043A\u0430\u0440\u0442\u0443. \u0412\u0437\u044F\u0442\u0438\u0435 \u043A\u0430\u0440\u0442\u044B
      \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u043E\u0434\u043D\u0443 \u043A\u0430\u0440\u0442\u0443
      \u0438\u0437 \u0441\u0442\u043E\u043F\u043A\u0438 \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442
      \u0432\u0430\u0448 \u0445\u043E\u0434."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282628
  - m_Id: 6548985208869
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u0439\u0442\u0435 \u0433\u0440\u0443\u043F\u043F\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208870
    m_Localized: "\u041F\u043E\u043B\u043E\u0436\u0438\u0442\u0435 3\u2665 4\u2665
      \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u0439 \u0441\u0442\u043E\u043B.
      \u0422\u0430\u043C \u0432\u0441\u0435\u0433\u043E \u0434\u0432\u0435 \u043A\u0430\u0440\u0442\u044B,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u043E\u043A\u0430 \u0447\u0442\u043E
      \u043E\u043D\u0438 \u043A\u0440\u0430\u0441\u043D\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208871
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435
      \u2014 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435
      \u043E\u0431\u0435\u0438\u0445 \u043A\u0430\u0440\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208872
    m_Localized: "\u0417\u0430\u0438\u043C\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0438\u0437 \u043D\u0430\u0431\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208873
    m_Localized: "\u0427\u0435\u0442\u0432\u0435\u0440\u043A\u0430 \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0438 \u0441 \u0442\u0440\u0435\u043C\u044F.
      \u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 5\u2665 \u0438\u0437
      \u043F\u044F\u0442\u0435\u0440\u043E\u043A \u043D\u0430 3\u2665 4\u2665."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208874
    m_Localized: "\u0412\u0441\u0435 \u043D\u0430\u0431\u043E\u0440\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B.
      \u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208875
    m_Localized: "\u041E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043E\u0434\u043D\u0430
      \u043A\u0430\u0440\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208876
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0443 \u0438\u0433\u0440\u043E\u043A\u0430
      \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
      \u043A\u0430\u0440\u0442\u0430, \u0435\u0433\u043E \u043A\u0440\u0435\u0441\u043B\u043E
      \u0442\u0440\u044F\u0441\u0435\u0442\u0441\u044F, \u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0432\u043E\u0441\u043A\u043B\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0437\u043D\u0430\u043A \u2014 \u0432\u0441\u0435 \u0432\u0438\u0434\u044F\u0442,
      \u0447\u0442\u043E \u043E\u043D \u0432\u043E\u0442-\u0432\u043E\u0442 \u0432\u044B\u0438\u0433\u0440\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208877
    m_Localized: "\u041D\u043E\u0432\u044B\u0435 \u043D\u0430\u0431\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208880
    m_Localized: "\u0422\u0432\u043E\u044F \u0431\u0443\u043A\u0432\u0430 \u0410\u2665
      \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u043F\u043E\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208881
    m_Localized: "\u0420\u0438\u0441\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208882
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0412\u0437\u044F\u0442\u044C
      \u043A\u0430\u0440\u0442\u0443\xBB, \u200B\u200B\u0447\u0442\u043E\u0431\u044B
      \u0432\u0437\u044F\u0442\u044C \u043A\u0430\u0440\u0442\u0443 \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0441\u0432\u043E\u0439 \u0445\u043E\u0434. \u041F\u0440\u0438 \u0432\u0437\u044F\u0442\u0438\u0438
      \u043A\u0430\u0440\u0442\u044B \u0442\u0430\u043A\u0436\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F
      \u0432\u0441\u0435 \u043A\u0430\u0440\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0432\u044B \u0432\u044B\u043B\u043E\u0436\u0438\u043B\u0438 \u0432 \u044D\u0442\u043E\u043C
      \u0445\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208883
    m_Localized: "{0} \u0442\u043E\u0436\u0435 \u0437\u0430\u0441\u0442\u0440\u044F\u043B."
