      m_Items: []
  - m_Id: 6549031346221
    m_Localized: "\u0421\u0442\u043E\u043B\u043E\u0432\u0430\u044F \u043A\u043E\u0441\u043C\u0435\u0442\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346222
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0432\u0435
      \u043A\u043E\u043B\u043E\u0434\u044B \u043A\u0430\u0440\u0442 \u0438 \u0441\u0443\u043A\u043D\u043E
      \u0434\u043B\u044F \u0441\u0442\u043E\u043B\u0430. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440, \u0447\u0442\u043E\u0431\u044B
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442."
    m_Metadata:
      m_Items: []
