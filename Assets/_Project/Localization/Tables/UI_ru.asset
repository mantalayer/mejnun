  - m_Id: 6549035540492
    m_Localized: "\u0421\u0447\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540493
    m_Localized: "\u0424\u0443\u043D\u043A\u0446\u0438\u0438 \u0443\u0447\u0435\u0442\u043D\u043E\u0439
      \u0437\u0430\u043F\u0438\u0441\u0438 \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F
      \u043F\u043E\u0437\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540494
    m_Localized: "\u0424\u0443\u043D\u043A\u0446\u0438\u0438 \u0443\u0447\u0435\u0442\u043D\u043E\u0439
      \u0437\u0430\u043F\u0438\u0441\u0438 \u043F\u043E\u043A\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540495
    m_Localized: '{0}%'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282628
  - m_Id: 6549035540497
    m_Localized: "\u041A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B \u0438
      \u0438\u0433\u0440\u043E\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540498
    m_Localized: "\u0412 \u0438\u0433\u0440\u0435 \u041C\u0435\u0434\u0436\u043D\u0443\u043D
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F \u0434\u0432\u0435
      \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u043D\u043D\u044B\u0435 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0435
      \u043A\u043E\u043B\u043E\u0434\u044B \u043F\u043E 52 \u043A\u0430\u0440\u0442\u044B:
      \u0432\u0441\u0435\u0433\u043E 104 \u043A\u0430\u0440\u0442\u044B, \u0431\u0435\u0437
      \u0434\u0436\u043E\u043A\u0435\u0440\u043E\u0432. \u0421\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0435
      \u043A\u0430\u0440\u0442\u044B \u0438\u0437 \u043E\u0431\u0435\u0438\u0445
      \u043A\u043E\u043B\u043E\u0434 \u0441\u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F
      \u0434\u0443\u0431\u043B\u044F\u043C\u0438. \u0418\u0433\u0440\u0430 \u0432\u0435\u0434\u0435\u0442\u0441\u044F
      \u043E\u0442 2 \u0434\u043E 6 \u0438\u0433\u0440\u043E\u043A\u043E\u0432 \u043F\u043E
      \u0447\u0430\u0441\u043E\u0432\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u0435
      (\u0432\u043B\u0435\u0432\u043E)."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540499
    m_Localized: "\u041A\u0442\u043E \u0445\u043E\u0434\u0438\u0442 \u043F\u0435\u0440\u0432\u044B\u043C
      \u0438 \u043A\u0442\u043E \u0440\u0430\u0437\u0434\u0430\u0451\u0442 \u043A\u0430\u0440\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540500
    m_Localized: "\u0420\u0430\u0437\u0434\u0430\u0451\u0442 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440.
      \u041F\u0435\u0440\u0432\u044B\u0439 \u0445\u043E\u0434 \u0445\u043E\u0434\u0438\u0442
      \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0439
      \u0438\u0433\u0440\u044B, \u0435\u0441\u043B\u0438 \u043E\u043D \u0435\u0449\u0451
      \u0438\u0433\u0440\u0430\u0435\u0442. \u0412 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u043E\u043C
      \u0441\u043B\u0443\u0447\u0430\u0435 \u0438\u0433\u0440\u043E\u043A\u0438 \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0445\u043E\u0434\u0447\u0438\u043A\u0430,
      \u0437\u0430\u0434\u0430\u0432\u0430\u044F \u0432\u043E\u043F\u0440\u043E\u0441:
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043C\u0435\u0441\u0442\u043E \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E
      \u0438\u043B\u0438 \u043F\u0440\u043E\u0442\u0438\u0432 \u0418\u0418, \u0438\u043B\u0438
      \u043F\u0440\u043E\u0433\u043E\u043B\u043E\u0441\u043E\u0432\u0430\u0442\u044C
      \u043E\u043D\u043B\u0430\u0439\u043D. \u041E\u043D\u043B\u0430\u0439\u043D-\u0433\u043E\u043B\u043E\u0441\u043E\u0432\u0430\u043D\u0438\u0435
      \u0434\u043B\u0438\u0442\u0441\u044F 20 \u0441\u0435\u043A\u0443\u043D\u0434;
      \u0432 \u0441\u043B\u0443\u0447\u0430\u0435 \u043D\u0438\u0447\u044C\u0435\u0439
      \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540502
    m_Localized: "\u0426\u0435\u043B\u0435\u0432\u044B\u0435 \u0438 \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u044B\u0435
      \u043D\u0430\u0431\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540505
    m_Localized: "\u0421\u043F\u0443\u0441\u043A\u0430\u044F\u0441\u044C \u0432\u043D\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540506
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C \u043A\u0430\u043A
      \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0445\u043E\u0434, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C
      \u043D\u043E\u0432\u044B\u0435 \u043D\u0430\u0431\u043E\u0440\u044B, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u0440\u0442\u044B \u0438\u0437
      \u0432\u0430\u0448\u0435\u0439 \u0440\u0443\u043A\u0438; \u0432\u044B \u043D\u0435
      \u043C\u043E\u0436\u0435\u0442\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0438\u043B\u0438 \u0438\u0437\u043C\u0435\u043D\u044F\u0442\u044C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435
      \u043D\u0430\u0431\u043E\u0440\u044B \u043D\u0430 \u0438\u0433\u0440\u043E\u0432\u043E\u043C
      \u043F\u043E\u043B\u0435. \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0441\u044B\u0433\u0440\u0430\u0442\u044C \u043E\u0434\u0438\u043D \u0438\u043B\u0438
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0431\u043E\u0440\u043E\u0432
      \u0431\u0435\u0437 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043E\u0447\u043A\u043E\u0432.
      \u041A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435
      \u0445\u043E\u0442\u044F \u0431\u044B \u043E\u0434\u0438\u043D \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u044B\u0439
      \u043D\u0430\u0431\u043E\u0440, \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u0437 \u043A\u0430\u0440\u0442
      \u0438\u0437 \u0432\u0430\u0448\u0435\u0439 \u0440\u0443\u043A\u0438, \u0432\u044B
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u0435 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0445\u043E\u0434 \u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0432\u0441\u0435 \u0438\u0433\u0440\u043E\u0432\u043E\u0435 \u043F\u043E\u043B\u0435
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0445\u043E\u0434\u0430. \u041A\u0430\u0440\u0442\u044B,
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u0432
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0445\u043E\u0434,
      \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043D\u0430 \u0438\u0433\u0440\u043E\u0432\u043E\u043C
      \u043F\u043E\u043B\u0435 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u044D\u0442\u043E\u0433\u043E \u0445\u043E\u0434\u0430. \u0424\u0443\u043D\u043A\u0446\u0438\u0438
      \xAB\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C\xBB \u0438\u043B\u0438
      \xAB\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C\xBB \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
      \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C \u043F\u0435\u0440\u0435\u0445\u043E\u0434
      \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540507
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043F\u043E\u043B\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u043E,
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043A\u0430\u0440\u0442\u044B \u043D\u0430 \u0434\u043E\u0441\u043A\u0435,
      \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0435\u0451 \u043D\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439.
      \u0427\u0442\u043E\u0431\u044B \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0441\u0432\u043E\u0439 \u0445\u043E\u0434, \u0434\u043E\u0441\u043A\u0430
      \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439,
      \u0438 \u0432\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0441\u044B\u0433\u0440\u0430\u0442\u044C
      \u0445\u043E\u0442\u044F \u0431\u044B \u043E\u0434\u043D\u0443 \u043A\u0430\u0440\u0442\u0443
      \u0438\u0437 \u0441\u0432\u043E\u0435\u0439 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540508
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0445\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540509
    m_Localized: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u0432\u0437\u044F\u0442\u044C \u043A\u0430\u0440\u0442\u0443 (\u0438\u043B\u0438
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0445\u043E\u0434,
      \u0435\u0441\u043B\u0438 \u0441\u0442\u043E\u043F\u043A\u0430 \u043F\u0443\u0441\u0442\u0430)
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430.
      \u041E\u043D\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0438\u0433\u0440\u043E\u0432\u043E\u0435 \u043F\u043E\u043B\u0435 \u0432
      \u043D\u0430\u0447\u0430\u043B\u043E \u0432\u0430\u0448\u0435\u0433\u043E \u0445\u043E\u0434\u0430,
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0441\u044B\u0433\u0440\u0430\u043D\u043D\u044B\u0435
      \u043A\u0430\u0440\u0442\u044B \u0432 \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443,
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u0437\u044F\u0442\u044C
      \u043E\u0434\u043D\u0443 \u043A\u0430\u0440\u0442\u0443, \u0435\u0441\u043B\u0438
      \u044D\u0442\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0438
      \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u0432\u0430\u0448 \u0445\u043E\u0434.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0445\u043E\u0434 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430, \u043A\u043E\u0433\u0434\u0430
      \u0438\u0433\u0440\u043E\u0432\u043E\u0435 \u043F\u043E\u043B\u0435 \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u043E
      \u0438 \u0432\u044B \u0441\u044B\u0433\u0440\u0430\u043B\u0438 \u043A\u0430\u0440\u0442\u0443
      \u0438\u0437 \u0440\u0443\u043A\u0438 \u0438\u043B\u0438 \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540512
    m_Localized: "\u0412\u0435\u0434\u0443\u0449\u0438\u0439 \u043C\u043E\u0436\u0435\u0442
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C 30, 60, 90 \u0438\u043B\u0438 120
      \u0441\u0435\u043A\u0443\u043D\u0434 \u043D\u0430 \u0445\u043E\u0434, \u0438\u043B\u0438
      \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0442\u0430\u0439\u043C\u0435\u0440
      \u0432 \u043E\u0444\u043B\u0430\u0439\u043D-\u0438\u0433\u0440\u0430\u0445.
      \u0412 \u043E\u043D\u043B\u0430\u0439\u043D-\u0438\u0433\u0440\u0430\u0445
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u0442\u0430\u0439\u043C\u0435\u0440. \u041A\u043E\u0433\u0434\u0430 \u0432\u0440\u0435\u043C\u044F
      \u0438\u0441\u0442\u0435\u043A\u0430\u0435\u0442, \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0434\u043E\u0441\u043A\u0430 \u0431\u0435\u0437 \u043A\u0430\u0440\u0442
      \u0432 \u0440\u0443\u043A\u0435, \u0438 \u0432\u044B \u0431\u0435\u0440\u0435\u0442\u0435
      \u043A\u0430\u0440\u0442\u0443; \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0434\u043E\u0441\u043A\u0430 \u0431\u0435\u0437 \u043A\u0430\u0440\u0442
      \u0432 \u0440\u0443\u043A\u0435, \u0438 \u0432\u044B \u0431\u0435\u0440\u0435\u0442\u0435
      \u043A\u0430\u0440\u0442\u0443. \u0415\u0441\u043B\u0438 \u0432\u044B \u0440\u0430\u0437\u044B\u0433\u0440\u0430\u043B\u0438
      \u043A\u0430\u0440\u0442\u044B \u0432 \u0440\u0443\u043A\u0435 \u0438 \u0434\u043E\u0441\u043A\u0430
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0430,
      \u0432\u0430\u0448 \u0445\u043E\u0434 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0431\u0435\u0437 \u043D\u0438\u0447\u044C\u0438. \u0415\u0441\u043B\u0438
      \u043E\u043D\u0430 \u043D\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0430,
      \u0432\u0430\u0448\u0438 \u0445\u043E\u0434\u044B \u043E\u0442\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F
      \u0434\u043E \u0442\u0435\u0445 \u043F\u043E\u0440, \u043F\u043E\u043A\u0430
      \u043E\u043D\u0430 \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439;
      \u0432\u044B \u0431\u0435\u0440\u0435\u0442\u0435 \u043A\u0430\u0440\u0442\u0443
      \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0442\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435,
      \u0435\u0441\u043B\u0438 \u043D\u0430 \u0434\u043E\u0441\u043A\u0435 \u043D\u0435
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043A\u0430\u0440\u0442 \u0432
      \u0440\u0443\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540513
    m_Localized: "\u041F\u0443\u0441\u0442\u0430\u044F \u043A\u0443\u0447\u0430 \u0434\u043B\u044F
      \u0432\u044B\u0442\u044F\u0433\u0438\u0432\u0430\u043D\u0438\u044F \u0438 \u0442\u0443\u043F\u0438\u043A\u043E\u0432\u0430\u044F
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540514
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043A\u043E\u043B\u043E\u0434\u0430
      \u0434\u043B\u044F \u0440\u043E\u0437\u044B\u0433\u0440\u044B\u0448\u0430 \u043F\u0443\u0441\u0442\u0430,
      \u0440\u043E\u0437\u044B\u0433\u0440\u044B\u0448 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043F\u0430\u0441: \u043D\u0438 \u043E\u0434\u043D\u0430 \u043A\u0430\u0440\u0442\u0430
      \u043D\u0435 \u0432\u044B\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0438 \u0438\u0433\u0440\u043E\u0432\u043E\u0435 \u043F\u043E\u043B\u0435
      \u043F\u0435\u0440\u0435\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u0415\u0441\u043B\u0438 \u0432\u0441\u0435 \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435
      \u0438\u0433\u0440\u043E\u043A\u0438 \u043F\u043E\u0434\u0440\u044F\u0434 \u043F\u0430\u0441\u0443\u044E\u0442,
      \u043D\u0435 \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u044F \u043A\u0430\u0440\u0442\u044B,
      \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442 \u0438\u0433\u0440\u043E\u043A
      \u0441 \u043D\u0430\u0438\u043C\u0435\u043D\u044C\u0448\u0438\u043C \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C
      \u043A\u0430\u0440\u0442, \u0435\u0441\u043B\u0438 \u043E\u043D \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439,
      \u0443 \u043A\u043E\u0433\u043E \u0442\u0430\u043A\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u043A\u0430\u0440\u0442. \u0415\u0441\u043B\u0438 \u0443 \u0438\u0433\u0440\u043E\u043A\u043E\u0432
      \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u043A\u0430\u0440\u0442, \u0438\u0433\u0440\u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0438\u0447\u044C\u0435\u0439 \u0431\u0435\u0437 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044F."
    m_Metadata:
      m_Items: []
