  m_TableData:
  - m_Id: 6547924049920
    m_Localized: "Wer w\xFCrde am ehesten vergessen, warum er einen Raum betreten
      hat?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244224
    m_Localized: "Wer erz\xE4hlt die schlechtesten Witze?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244225
    m_Localized: "Wer w\xFCrde als Erster auf einer Hochzeit tanzen?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244226
    m_Localized: Wer hat die chaotischste Fotogalerie auf seinem Handy?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244227
    m_Localized: "Wer w\xFCrde auf einer einsamen Insel am l\xE4ngsten \xFCberleben?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244228
    m_Localized: "Wer l\xF6st am ehesten versehentlich einen Trend aus?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244229
    m_Localized: "Wessen Geburtstag liegt am n\xE4chsten an heute?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244230
    m_Localized: Wer hat zuletzt geduscht?
    m_Metadata:
      m_Items: []
  references:
    version: 2
