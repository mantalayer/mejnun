MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DealerQuestions_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 87a4643bee3d747fb9ab730fc39509cd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6547924049920
    m_Localized: "Wer w\xFCrde am ehesten vergessen, warum er einen Raum betreten
      hat?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244224
    m_Localized: "Wer erz\xE4hlt die schlechtesten Witze?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244225
    m_Localized: "Wer w\xFCrde als Erster auf einer Hochzeit tanzen?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244226
    m_Localized: Wer hat die chaotischste Fotogalerie auf seinem Handy?
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244227
    m_Localized: "Wer w\xFCrde auf einer einsamen Insel am l\xE4ngsten \xFCberleben?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244228
    m_Localized: "Wer l\xF6st am ehesten versehentlich einen Trend aus?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244229
    m_Localized: "Wessen Geburtstag liegt am n\xE4chsten an heute?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244230
    m_Localized: Wer hat zuletzt geduscht?
    m_Metadata:
      m_Items: []
  - m_Id: 74276106395648
    m_Localized: Wer veranstaltet am ehesten eine Drag-Show?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561472
    m_Localized: "Wessen Haar ist am lockigsten (und daher am sch\xF6nsten)?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561473
    m_Localized: "Wer ist der w\xE4hlerischste Esser?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561474
    m_Localized: "Wer ist am ehesten geneigt, jemanden f\xFCr einen Faustschlag zu
      bestrafen?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561475
    m_Localized: "Wer kann denn \xFCberhaupt heben, Alter?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561476
    m_Localized: Wer kann am besten den Takt halten?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561477
    m_Localized: "Wer kann die meisten Nachkommastellen von Pi z\xE4hlen? Mmm, Kuchen..."
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561478
    m_Localized: "Wenn du mit nur einem Eichh\xF6rnchen und zwei Zahnstochern auf
      einer einsamen Insel gestrandet w\xE4rst... Wer w\xFCrde das Eichh\xF6rnchen
      fangen, oder so?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561479
    m_Localized: "Wer hat die meiste Erfahrung im Bohnenz\xE4hlen?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561480
    m_Localized: Wer tratscht am meisten?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561481
    m_Localized: "Wer hat die stinkendsten R\xFClpser?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561482
    m_Localized: "Wer kann am besten das Gewicht von Menschen sch\xE4tzen?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561483
    m_Localized: Wer kann das beste Trebuchet bauen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561484
    m_Localized: Wer ist der beste Koch?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561485
    m_Localized: "Wer l\xE4sst beim Kochen am meisten Essen anbrennen?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561486
    m_Localized: "Wessen Kopfumfang ist der gr\xF6\xDFte?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561487
    m_Localized: "Wer vergisst am ehesten sein Handy im K\xFChlschrank?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561488
    m_Localized: Wer vergisst am ehesten die Fernbedienung im Gefrierschrank?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561489
    m_Localized: Wer spielt die meisten Instrumente?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561490
    m_Localized: Wer ist am schlechtesten an einem Instrument?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561491
    m_Localized: "Wer br\xE4uchte am l\xE4ngsten, um ein M\xF6belst\xFCck zu bauen?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561492
    m_Localized: Wer ist am meisten von Katzen besessen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561493
    m_Localized: Wer ist am meisten von Hunden besessen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561494
    m_Localized: "Wer riecht am st\xE4rksten nach Holunderbeeren?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561495
    m_Localized: Wessen Lieblingsfarbe ist Blau?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561496
    m_Localized: "Wer hat die gr\xF6\xDFten Chancen, gegen einen B\xE4ren zu k\xE4mpfen
      (und zu gewinnen)?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561497
    m_Localized: Wer verliert in Las Vegas am meisten?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561498
    m_Localized: "Wer wei\xDF, was eine Allesdusche ist?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561499
    m_Localized: "Wer ist am h\xE4ufigsten online?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561500
    m_Localized: Schnell, ich denke an eine Zahl zwischen 81 und 976! Wer hat 222
      getippt?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561501
    m_Localized: Wer neigt am ehesten dazu, beim Spielen auszurasten?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561502
    m_Localized: "Wer ist am wettbewerbsst\xE4rksten?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561503
    m_Localized: "Wer m\xF6chte am liebsten als Erster starten?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561504
    m_Localized: "Wer m\xF6chte am wenigsten als Erster antreten?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561505
    m_Localized: Kampf! Wer hat gewonnen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561506
    m_Localized: "Wer m\xF6chte denn \xFCberhaupt nicht hingehen?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561507
    m_Localized: Wer liebt nicht die Farbe Lila?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561508
    m_Localized: Wer hat die meisten grauen Haare?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561509
    m_Localized: "Wer hat die wenigsten Haare? Ich z\xE4hle die K\xF6rperbehaarung."
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561510
    m_Localized: Wer hat zuletzt abgewaschen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561511
    m_Localized: "Wer besitzt die gr\xF6\xDFte Spielesammlung?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561512
    m_Localized: "Wer kann die Quantentheorie am besten erkl\xE4ren?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561513
    m_Localized: Wer hat die beste Sehkraft?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561514
    m_Localized: Wer spricht die meisten Sprachen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561515
    m_Localized: Wer hat die meisten Katzen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561516
    m_Localized: Wer kann einen Vergaser einstellen?
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561517
    m_Localized: "Wer hat die meisten L\xE4nder bereist?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561518
    m_Localized: Wer kann am weitesten laufen? Probiert es vor dem Spiel aus!
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561519
    m_Localized: "Wer w\xFCrde die Stra\xDFenbahn auf f\xFCnf Personen umleiten?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561520
    m_Localized: Denk dir eine Frage aus, aber sag nicht, dass ich es dir gesagt
      habe...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
