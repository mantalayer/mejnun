  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DealerQuestions_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 87a4643bee3d747fb9ab730fc39509cd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6547924049920
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi d\u1EC5 qu\xEAn l\xFD do m\xECnh b\u01B0\u1EDBc
      v\xE0o ph\xF2ng nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244224
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi k\u1EC3 chuy\u1EC7n c\u01B0\u1EDDi d\u1EDF
      nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244225
    m_Localized: "Ai s\u1EBD l\xE0 ng\u01B0\u1EDDi \u0111\u1EA7u ti\xEAn nh\u1EA3y
      t\u1EA1i \u0111\xE1m c\u01B0\u1EDBi?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244226
    m_Localized: "Ai c\xF3 b\u1ED9 s\u01B0u t\u1EADp \u1EA3nh \u0111i\u1EC7n tho\u1EA1i
      l\u1ED9n x\u1ED9n nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244227
    m_Localized: "Ai s\u1EBD s\u1ED1ng s\xF3t l\xE2u nh\u1EA5t tr\xEAn m\u1ED9t h\xF2n
      \u0111\u1EA3o hoang?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244228
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi c\xF3 kh\u1EA3 n\u0103ng v\xF4 t\xECnh
      kh\u1EDFi x\u01B0\u1EDBng m\u1ED9t xu h\u01B0\u1EDBng cao nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244229
    m_Localized: "Sinh nh\u1EADt c\u1EE7a ai g\u1EA7n v\u1EDBi ng\xE0y h\xF4m nay
      nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244230
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi t\u1EAFm g\u1EA7n \u0111\xE2y nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
