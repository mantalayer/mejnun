%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DealerQuestions_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 87a4643bee3d747fb9ab730fc39509cd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6547924049920
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi d\u1EC5 qu\xEAn l\xFD do m\xECnh b\u01B0\u1EDBc
      v\xE0o ph\xF2ng nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244224
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi k\u1EC3 chuy\u1EC7n c\u01B0\u1EDDi d\u1EDF
      nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244225
    m_Localized: "Ai s\u1EBD l\xE0 ng\u01B0\u1EDDi \u0111\u1EA7u ti\xEAn nh\u1EA3y
      t\u1EA1i \u0111\xE1m c\u01B0\u1EDBi?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244226
    m_Localized: "Ai c\xF3 b\u1ED9 s\u01B0u t\u1EADp \u1EA3nh \u0111i\u1EC7n tho\u1EA1i
      l\u1ED9n x\u1ED9n nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244227
    m_Localized: "Ai s\u1EBD s\u1ED1ng s\xF3t l\xE2u nh\u1EA5t tr\xEAn m\u1ED9t h\xF2n
      \u0111\u1EA3o hoang?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244228
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi c\xF3 kh\u1EA3 n\u0103ng v\xF4 t\xECnh
      kh\u1EDFi x\u01B0\u1EDBng m\u1ED9t xu h\u01B0\u1EDBng cao nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244229
    m_Localized: "Sinh nh\u1EADt c\u1EE7a ai g\u1EA7n v\u1EDBi ng\xE0y h\xF4m nay
      nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244230
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi t\u1EAFm g\u1EA7n \u0111\xE2y nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276106395648
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi c\xF3 kh\u1EA3 n\u0103ng nh\u1EA5t s\u1EBD
      t\u1ED5 ch\u1EE9c m\u1ED9t bu\u1ED5i bi\u1EC3u di\u1EC5n gi\u1EA3 g\xE1i?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561472
    m_Localized: "Ai c\xF3 m\xE1i t\xF3c xo\u0103n nh\u1EA5t (v\xE0 do \u0111\xF3
      \u0111\u1EB9p nh\u1EA5t)?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561473
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi k\xE9n \u0103n nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561474
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi c\xF3 kh\u1EA3 n\u0103ng \u0111\xE1nh
      ng\u01B0\u1EDDi kh\xE1c nh\u1EA5t v\xEC ng\u01B0\u1EDDi \u0111\xF3 \u0111\xE3
      \u0111\xE1nh ng\u01B0\u1EDDi kh\xE1c?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561475
    m_Localized: "Ai m\xE0 bi\u1EBFt n\xE2ng t\u1EA1 \u0111\u01B0\u1EE3c ch\u1EE9,
      anh b\u1EA1n?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561476
    m_Localized: "Ai gi\u1EEF nh\u1ECBp t\u1ED1t nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561477
    m_Localized: "Ai c\xF3 th\u1EC3 \u0111\u1EBFm \u0111\u01B0\u1EE3c nhi\u1EC1u
      ch\u1EEF s\u1ED1 nh\u1EA5t c\u1EE7a s\u1ED1 pi? Mmmm, b\xE1nh pie..."
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561478
    m_Localized: "N\u1EBFu b\u1EA1n b\u1ECB m\u1EAFc k\u1EB9t tr\xEAn m\u1ED9t h\xF2n
      \u0111\u1EA3o hoang v\u1EDBi ch\u1EC9 m\u1ED9t con s\xF3c v\xE0 hai que t\u0103m...
      Ai s\u1EBD b\u1EAFt con s\xF3c, hay \u0111\u1EA1i lo\u1EA1i th\u1EBF?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561479
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi c\xF3 kinh nghi\u1EC7m nh\u1EA5t trong
      vi\u1EC7c \u0111\u1EBFm \u0111\u1EADu?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561480
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi hay bu\xF4n chuy\u1EC7n nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561481
    m_Localized: "Ai c\xF3 ti\u1EBFng \u1EE3 h\u01A1i n\u1EB7ng m\xF9i nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561482
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi gi\u1ECFi nh\u1EA5t trong vi\u1EC7c \u0111o\xE1n
      c\xE2n n\u1EB7ng c\u1EE7a ng\u01B0\u1EDDi kh\xE1c?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561483
    m_Localized: "Ai c\xF3 th\u1EC3 ch\u1EBF t\u1EA1o \u0111\u01B0\u1EE3c m\xE1y
      b\u1EAFn \u0111\xE1 t\u1ED1t nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561484
    m_Localized: "Ai l\xE0 \u0111\u1EA7u b\u1EBFp gi\u1ECFi nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561485
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi hay l\xE0m ch\xE1y th\u1EE9c \u0103n nh\u1EA5t
      khi n\u1EA5u n\u01B0\u1EDBng?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561486
    m_Localized: "Ai c\xF3 chu vi v\xF2ng \u0111\u1EA7u l\u1EDBn nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561487
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi d\u1EC5 qu\xEAn \u0111i\u1EC7n tho\u1EA1i
      trong t\u1EE7 l\u1EA1nh nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561488
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi c\xF3 kh\u1EA3 n\u0103ng \u0111\u1EC3
      qu\xEAn \u0111i\u1EC1u khi\u1EC3n t\u1EEB xa trong t\u1EE7 \u0111\xF4ng cao
      nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561489
    m_Localized: "Ai ch\u01A1i \u0111\u01B0\u1EE3c nhi\u1EC1u nh\u1EA1c c\u1EE5 nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561490
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi ch\u01A1i nh\u1EA1c c\u1EE5 t\u1EC7 nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561491
    m_Localized: "Ai s\u1EBD m\u1EA5t nhi\u1EC1u th\u1EDDi gian nh\u1EA5t \u0111\u1EC3
      l\u1EAFp r\xE1p m\u1ED9t m\xF3n \u0111\u1ED3 n\u1ED9i th\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561492
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi m\xEA m\xE8o nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561493
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi y\xEAu ch\xF3 nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561494
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi ng\u1EEDi th\u1EA5y m\xF9i qu\u1EA3 c\u01A1m
      ch\xE1y r\xF5 nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561495
    m_Localized: "M\xE0u y\xEAu th\xEDch c\u1EE7a ai l\xE0 m\xE0u xanh d\u01B0\u01A1ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561496
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi c\xF3 kh\u1EA3 n\u0103ng nh\u1EA5t \u0111\u1EC3
      chi\u1EBFn \u0111\u1EA5u v\u1EDBi g\u1EA5u (v\xE0 gi\xE0nh chi\u1EBFn th\u1EAFng)?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561497
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi thua l\u1ED7 nhi\u1EC1u nh\u1EA5t \u1EDF
      Las Vegas?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561498
    m_Localized: "Ai bi\u1EBFt v\xF2i sen \u0111a n\u0103ng l\xE0 g\xEC?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561499
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi d\xE0nh nhi\u1EC1u th\u1EDDi gian tr\u1EF1c
      tuy\u1EBFn nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561500
    m_Localized: "Nhanh l\xEAn, t\xF4i \u0111ang ngh\u0129 \u0111\u1EBFn m\u1ED9t
      s\u1ED1 n\u1EB1m gi\u1EEFa 81 v\xE0 976! Ai \u0111o\xE1n l\xE0 222?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561501
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi d\u1EC5 n\u1ED5i n\xF3ng nh\u1EA5t khi
      ch\u01A1i game?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561502
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi c\u1EA1nh tranh nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561503
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi mu\u1ED1n \u0111i tr\u01B0\u1EDBc nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561504
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi \xEDt mu\u1ED1n \u0111i \u0111\u1EA7u
      nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561505
    m_Localized: "\u0110\xE1nh nhau n\xE0o! Ai th\u1EAFng?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561506
    m_Localized: "Ai m\xE0 l\u1EA1i kh\xF4ng mu\u1ED1n \u0111i ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561507
    m_Localized: "Ai m\xE0 kh\xF4ng y\xEAu th\xEDch m\xE0u t\xEDm ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561508
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi c\xF3 nhi\u1EC1u t\xF3c b\u1EA1c nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561509
    m_Localized: "Ai c\xF3 \xEDt l\xF4ng nh\u1EA5t? T\xF4i \u0111ang t\xEDnh c\u1EA3
      l\xF4ng tr\xEAn c\u01A1 th\u1EC3."
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561510
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi r\u1EEDa b\xE1t cu\u1ED1i c\xF9ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561511
    m_Localized: "Ai s\u1EDF h\u1EEFu b\u1ED9 s\u01B0u t\u1EADp game l\u1EDBn nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561512
    m_Localized: "Ai c\xF3 th\u1EC3 gi\u1EA3i th\xEDch l\xFD thuy\u1EBFt l\u01B0\u1EE3ng
      t\u1EED m\u1ED9t c\xE1ch t\u1ED1t nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561513
    m_Localized: "Ai c\xF3 t\u1EA7m nh\xECn t\u1ED1t nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561514
    m_Localized: "Ai n\xF3i \u0111\u01B0\u1EE3c nhi\u1EC1u ngo\u1EA1i ng\u1EEF nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561515
    m_Localized: "Ai nu\xF4i nhi\u1EC1u m\xE8o nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561516
    m_Localized: "Ai c\xF3 th\u1EC3 ch\u1EC9nh s\u1EEDa b\u1ED9 ch\u1EBF h\xF2a kh\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561517
    m_Localized: "Ai l\xE0 ng\u01B0\u1EDDi \u0111\xE3 \u0111\u1EBFn nhi\u1EC1u qu\u1ED1c
      gia nh\u1EA5t?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561518
    m_Localized: "Ai c\xF3 th\u1EC3 ch\u1EA1y xa nh\u1EA5t? H\xE3y th\u1EED tr\u01B0\u1EDBc
      khi tr\u1EADn \u0111\u1EA5u b\u1EAFt \u0111\u1EA7u!"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561519
    m_Localized: "Ai l\u1EA1i \u0111i chuy\u1EC3n h\u01B0\u1EDBng xe \u0111i\u1EC7n
      ch\u1EC9 v\xEC n\u0103m ng\u01B0\u1EDDi?"
    m_Metadata:
      m_Items: []
  - m_Id: 74276131561520
    m_Localized: "H\xE3y \u0111\u1EB7t m\u1ED9t c\xE2u h\u1ECFi, nh\u01B0ng \u0111\u1EEBng
      n\xF3i r\u1EB1ng t\xF4i b\u1EA3o b\u1EA1n l\xE0m th\u1EBF..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
