  - m_Id: 6549014568964
    m_Localized: Primero {app.name:upper}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282625
  - m_Id: 6549018763264
    m_Localized: Gana vaciando tu mano.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763265
    m_Localized: Diez victorias
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763266
    m_Localized: Gana 10 partidos.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763268
    m_Localized: "Derrota a un bot dif\xEDcil."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763269
    m_Localized: Mesa completa
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763270
    m_Localized: Juega una partida con seis asientos.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763271
    m_Localized: Regular
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763272
    m_Localized: Juega 50 partidas.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763273
    m_Localized: Veterano
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763276
    m_Localized: Gana 50 partidos.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763278
    m_Localized: Gana 200 partidos.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763279
    m_Localized: Nivel 10
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763280
    m_Localized: Alcanza el nivel 10.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763281
    m_Localized: Nivel 25
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763283
    m_Localized: Nivel 50
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763284
    m_Localized: Alcanza el nivel 50.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763285
    m_Localized: Coleccionista
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763286
    m_Localized: Desbloquea todas las caras y fieltros de la baraja, ya sean gratuitos
      o conseguibles.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763287
    m_Localized: "{app.name:upper} \xD710"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282625
  - m_Id: 6549018763288
    m_Localized: Gana 10 partidas vaciando tu mano.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763289
    m_Localized: Limpieza total
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763291
    m_Localized: "Iluminaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763292
    m_Localized: Gana en tus primeros cinco turnos.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763293
    m_Localized: "\xDAltimo aliento"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763294
    m_Localized: "Gana vaciando tu mano con el mazo vac\xEDo."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763295
    m_Localized: Regresar
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763296
    m_Localized: "Gana despu\xE9s de tener 20 o m\xE1s cartas."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763297
    m_Localized: "Hasta el \xFAltimo momento"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763298
    m_Localized: Gana el conteo final de la pila por exactamente una carta.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763299
    m_Localized: Carretera Real
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763300
    m_Localized: Forma una escalera completa de 13 cartas desde el as hasta el rey.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763301
    m_Localized: Ace High
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763302
    m_Localized: Completa una escalera de reina-rey-as.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763304
    m_Localized: Baja con al menos tres series a la vez.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763305
    m_Localized: Arquitecto
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763306
    m_Localized: Coloca al menos ocho cartas de tu mano en un solo turno.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763307
    m_Localized: Cirujano
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763308
    m_Localized: "Divide una escalera y termina el turno con una mesa v\xE1lida."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763309
    m_Localized: Tiempo prestado
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763310
    m_Localized: "Toma una carta de un conjunto de cuatro cartas iguales y \xFAsala."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763311
    m_Localized: Ver doble
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763312
    m_Localized: Finaliza tu turno con ambas copias de una carta en conjuntos separados.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763313
    m_Localized: Paciente
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763314
    m_Localized: Gana sin usar Deshacer, Revertir o Reparar el tablero.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763315
    m_Localized: Sin ruedines de apoyo
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763316
    m_Localized: Gana con las pistas desactivadas.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763317
    m_Localized: "\xA1Halas!"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763319
    m_Localized: "Mantener la calma bajo presi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763320
    m_Localized: "Finaliza un turno v\xE1lido cuando queden menos de tres segundos."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763322
    m_Localized: "Gana una partida con un l\xEDmite de tiempo de 30 segundos."
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957568
    m_Localized: Cazador de gigantes
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957569
    m_Localized: "Gana contra cinco bots dif\xEDciles en una mesa completa."
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957570
    m_Localized: Tres tantos
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957571
    m_Localized: Gana tres partidas contra bots seguidas.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957574
    m_Localized: Conectarse a Internet
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957576
    m_Localized: "El que agrada al p\xFAblico"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957577
    m_Localized: Gana una partida online con al menos cuatro jugadores humanos.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957578
    m_Localized: "Anfitri\xF3n de la fiesta"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957579
    m_Localized: Organiza 10 partidas online.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957580
    m_Localized: "P\xE1salo"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957581
    m_Localized: Completa una partida de pases y juego con al menos cuatro personas.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957582
    m_Localized: Steven igual
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957583
    m_Localized: Terminar una partida en empate.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957584
    m_Localized: Asiento caliente
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957585
    m_Localized: "Ser elegido para ir primero seg\xFAn la pregunta 10 veces."
    m_Metadata:
      m_Items: []
