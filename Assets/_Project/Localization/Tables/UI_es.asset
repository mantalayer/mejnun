  - m_Id: 6549035540588
    m_Localized: "\u2713 {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282625
  - m_Id: 6549035540590
    m_Localized: "\xBFQui\xE9n va primero?"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540591
    m_Localized: Jugador elegido al azar
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540592
    m_Localized: Toca para revelar
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540593
    m_Localized: '{app.name:upper}!'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282625
  - m_Id: 6549035540594
    m_Localized: Logros
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734784
    m_Localized: "Novedades en la galer\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734785
    m_Localized: "A\xFAn no est\xE1 desbloqueado"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734789
    m_Localized: "\xBFComenzar una nueva ronda?"
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734790
    m_Localized: No vuelvas a preguntar
    m_Metadata:
      m_Items: []
  - m_Id: 6549039734793
