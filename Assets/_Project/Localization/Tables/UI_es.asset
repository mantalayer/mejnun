  - m_Id: 6549031346186
    m_Localized: "Cosm\xE9ticos de mesa"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346188
    m_Localized: "Crear sesi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346189
    m_Localized: "C\xF3digo de sesi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346190
    m_Localized: "\xDAnete por c\xF3digo"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346191
    m_Localized: "Coincidencia r\xE1pida"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346192
    m_Localized: "Conectando\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346193
    m_Localized: "Primero, \xFAnete o crea una sesi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346194
    m_Localized: "El anfitri\xF3n cancel\xF3 el partido."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346195
    m_Localized: "Saliste del vest\xEDbulo."
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346196
    m_Localized: "C\xF3digo de sesi\xF3n no disponible"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346198
    m_Localized: Empieza ahora
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346200
    m_Localized: "A\xFAn no hay jugadores conectados."
