  - m_Id: 6549035540497
    m_Localized: "\u0642\u0637\u0639\u0627\u062A \u0648 \u067E\u062E\u0634\u200C\u06A9\u0646\u0646\u062F\u0647\u200C\u0647\u0627"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540498
    m_Localized: "{app.name} \u0627\u0632 \u062F\u0648 \u062F\u0633\u062A\u0647 \u06A9\u0627\u0631\u062A
      \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u06F5\u06F2 \u062A\u0627\u06CC\u06CC
      \u0628\u064F\u0631 \u062E\u0648\u0631\u062F\u0647 \u0627\u0633\u062A\u0641\u0627\u062F\u0647
      \u0645\u06CC\u200C\u06A9\u0646\u062F: \u062F\u0631 \u0645\u062C\u0645\u0648\u0639
      \u06F1\u06F0\u06F4 \u06A9\u0627\u0631\u062A\u060C \u0628\u062F\u0648\u0646
      \u062C\u0648\u06A9\u0631. \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC
      \u0645\u0646\u0637\u0628\u0642 \u0627\u0632 \u062F\u0648 \u062F\u0633\u062A\u0647\u060C
      \u062F\u0648 \u0628\u0631\u0627\u0628\u0631 (\u062F\u0627\u0628\u0644) \u0647\u0633\u062A\u0646\u062F.
      \u0628\u0627 \u06F2 \u062A\u0627 \u06F6 \u0628\u0627\u0632\u06CC\u06A9\u0646\u060C
      \u062F\u0631 \u062C\u0647\u062A \u0639\u0642\u0631\u0628\u0647\u200C\u0647\u0627\u06CC
      \u0633\u0627\u0639\u062A (\u0628\u0647 \u0633\u0645\u062A \u0686\u067E) \u0628\u0627\u0632\u06CC
      \u06A9\u0646\u06CC\u062F."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282620
  - m_Id: 6549035540499
    m_Localized: "\u0686\u0647 \u06A9\u0633\u06CC \u0627\u0648\u0644 \u0645\u06CC\u200C\u0631\u0648\u062F
      \u0648 \u062F\u06CC\u0644\u06CC\u0646\u06AF \u0645\u06CC\u200C\u06A9\u0646\u062F\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540500
    m_Localized: "\u06A9\u0627\u0645\u067E\u06CC\u0648\u062A\u0631 \u0642\u0631\u0639\u0647\u200C\u06A9\u0634\u06CC
      \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u06AF\u0631 \u0628\u0631\u0646\u062F\u0647\u200C\u06CC
      \u0628\u0627\u0632\u06CC \u0642\u0628\u0644\u06CC \u0647\u0646\u0648\u0632
      \u062F\u0631 \u062D\u0627\u0644 \u0628\u0627\u0632\u06CC \u0628\u0627\u0634\u062F\u060C
      \u0627\u0648\u0644 \u0628\u0627\u0632\u06CC \u0631\u0627 \u0634\u0631\u0648\u0639
      \u0645\u06CC\u200C\u06A9\u0646\u062F. \u062F\u0631 \u063A\u06CC\u0631 \u0627\u06CC\u0646
      \u0635\u0648\u0631\u062A\u060C \u0628\u0627\u0632\u06CC\u06A9\u0646\u0627\u0646
      \u0628\u0627 \u06CC\u06A9 \u0633\u0648\u0627\u0644\u060C \u0627\u0646\u062A\u062E\u0627\u0628
      \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F \u06A9\u0647 \u0686\u0647 \u06A9\u0633\u06CC
      \u0627\u0648\u0644 \u0628\u0627\u0632\u06CC \u0631\u0627 \u0634\u0631\u0648\u0639
      \u06A9\u0646\u062F: \u0628\u0647 \u0635\u0648\u0631\u062A \u0645\u062D\u0644\u06CC
      \u06CC\u0627 \u062F\u0631 \u0645\u0642\u0627\u0628\u0644 \u0647\u0648\u0634
      \u0645\u0635\u0646\u0648\u0639\u06CC\u060C \u0631\u0648\u06CC \u06CC\u06A9
      \u0635\u0646\u062F\u0644\u06CC \u0636\u0631\u0628\u0647 \u0628\u0632\u0646\u06CC\u062F\u060C
      \u06CC\u0627 \u0628\u0647 \u0635\u0648\u0631\u062A \u0622\u0646\u0644\u0627\u06CC\u0646
      \u0631\u0623\u06CC \u062F\u0647\u06CC\u062F. \u0631\u0623\u06CC\u200C\u06AF\u06CC\u0631\u06CC\u200C\u0647\u0627\u06CC
      \u0622\u0646\u0644\u0627\u06CC\u0646 \u06F2\u06F0 \u062B\u0627\u0646\u06CC\u0647
