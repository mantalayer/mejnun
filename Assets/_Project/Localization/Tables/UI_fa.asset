  - m_Id: 6549035540506
    m_Localized: "\u0642\u0628\u0644 \u0627\u0632 \u0631\u0641\u062A\u0646 \u0628\u0647
      \u0645\u0631\u062D\u0644\u0647\u200C\u06CC \u0628\u0639\u062F\u060C \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F
      \u0641\u0642\u0637 \u0628\u0627 \u0627\u0633\u062A\u0641\u0627\u062F\u0647
      \u0627\u0632 \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC \u062F\u0633\u062A
      \u062E\u0648\u062F\u060C \u0645\u062C\u0645\u0648\u0639\u0647\u200C\u0647\u0627\u06CC
      \u062C\u062F\u06CC\u062F\u06CC \u0628\u0633\u0627\u0632\u06CC\u062F\u061B \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F
      \u0627\u0632 \u0645\u062C\u0645\u0648\u0639\u0647\u200C\u0647\u0627\u06CC \u0645\u0648\u062C\u0648\u062F
      \u0631\u0648\u06CC \u0635\u0641\u062D\u0647 \u0627\u0633\u062A\u0641\u0627\u062F\u0647
      \u06A9\u0646\u06CC\u062F \u06CC\u0627 \u0622\u0646\u0647\u0627 \u0631\u0627
      \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0647\u06CC\u062F. \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F
      \u06CC\u06A9 \u06CC\u0627 \u0686\u0646\u062F \u0645\u062C\u0645\u0648\u0639\u0647
      \u0631\u0627 \u0628\u062F\u0648\u0646 \u062D\u062F\u0627\u0642\u0644 \u0627\u0645\u062A\u06CC\u0627\u0632
      \u0628\u0627\u0632\u06CC \u06A9\u0646\u06CC\u062F. \u0628\u0647 \u0645\u062D\u0636
      \u0627\u06CC\u0646\u06A9\u0647 \u062D\u062F\u0627\u0642\u0644 \u06CC\u06A9
      \u0645\u062C\u0645\u0648\u0639\u0647\u200C\u06CC \u0645\u0639\u062A\u0628\u0631
      \u0641\u0642\u0637 \u062F\u0633\u062A\u06CC \u0631\u0627 \u062A\u0623\u06CC\u06CC\u062F
      \u06A9\u0631\u062F\u06CC\u062F\u060C \u0628\u0627\u0632\u06CC \u0631\u0627
      \u062A\u0645\u0627\u0645 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u062F \u0648
      \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F \u0627\u0632 \u06A9\u0644
      \u0635\u0641\u062D\u0647 \u0628\u0631\u0627\u06CC \u0628\u0642\u06CC\u0647\u200C\u06CC
      \u0646\u0648\u0628\u062A \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646\u06CC\u062F.
      \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u0628\u0631\u0627\u06CC
      \u0631\u0641\u062A\u0646 \u0628\u0647 \u0645\u0631\u062D\u0644\u0647\u200C\u06CC
      \u0628\u0639\u062F \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0634\u062F\u0647\u200C\u0627\u0646\u062F\u060C
      \u0628\u0631\u0627\u06CC \u0622\u0646 \u0646\u0648\u0628\u062A \u0631\u0648\u06CC
      \u0635\u0641\u062D\u0647 \u0645\u06CC\u200C\u0645\u0627\u0646\u0646\u062F.
      \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC
      \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0634\u062F\u0647 \u0628\u0631\u0627\u06CC
      \u0631\u0641\u062A\u0646 \u0628\u0647 \u0645\u0631\u062D\u0644\u0647\u200C\u06CC
      \u0628\u0639\u062F \u0631\u0627 \u0644\u063A\u0648 \u06CC\u0627 \u0628\u0631\u06AF\u0631\u062F\u0627\u0646\u06CC\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540507
    m_Localized: "\u0648\u0642\u062A\u06CC \u0646\u0648\u0628\u062A\u062A\u0627\u0646
      \u062A\u0645\u0627\u0645 \u0634\u062F\u060C \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F
      \u0635\u0641\u062D\u0647 \u0631\u0627 \u062F\u0648\u0628\u0627\u0631\u0647
      \u0628\u0686\u06CC\u0646\u06CC\u062F\u060C \u0627\u0632 \u062C\u0645\u0644\u0647
      \u0627\u06CC\u0646\u06A9\u0647 \u0645\u0648\u0642\u062A\u0627\u064B \u0622\u0646
      \u0631\u0627 \u0646\u0627\u0645\u0639\u062A\u0628\u0631 \u06A9\u0646\u06CC\u062F.
      \u0628\u0631\u0627\u06CC \u067E\u0627\u06CC\u0627\u0646 \u062F\u0627\u062F\u0646
      \u0628\u0647 \u0646\u0648\u0628\u062A\u062A\u0627\u0646\u060C \u0635\u0641\u062D\u0647
      \u0628\u0627\u06CC\u062F \u0645\u0639\u062A\u0628\u0631 \u0628\u0627\u0634\u062F
      \u0648 \u0634\u0645\u0627 \u0628\u0627\u06CC\u062F \u062D\u062F\u0627\u0642\u0644
      \u06CC\u06A9 \u06A9\u0627\u0631\u062A \u0627\u0632 \u062F\u0633\u062A\u062A\u0627\u0646
      \u0628\u0627\u0632\u06CC \u06A9\u0631\u062F\u0647 \u0628\u0627\u0634\u06CC\u062F."
