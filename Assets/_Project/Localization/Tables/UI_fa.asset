  - m_Id: 6549035540509
    m_Localized: "\u06A9\u0634\u06CC\u062F\u0646 \u06A9\u0627\u0631\u062A (\u06CC\u0627
      \u062F\u0627\u062F\u0646 \u06A9\u0627\u0631\u062A \u0648\u0642\u062A\u06CC
      \u06A9\u0647 \u062F\u0633\u062A\u0647 \u06A9\u0627\u0631\u062A\u200C\u0647\u0627
      \u062E\u0627\u0644\u06CC \u0627\u0633\u062A) \u0647\u0645\u06CC\u0634\u0647
      \u062F\u0631 \u062F\u0633\u062A\u0631\u0633 \u0627\u0633\u062A. \u0627\u06CC\u0646
      \u06A9\u0627\u0631 \u0635\u0641\u062D\u0647 \u0631\u0627 \u0628\u0647 \u0627\u0628\u062A\u062F\u0627\u06CC
      \u0646\u0648\u0628\u062A \u0634\u0645\u0627 \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u0627\u0646\u062F\u060C
      \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC \u0628\u0627\u0632\u06CC \u0634\u062F\u0647
      \u0631\u0627 \u0628\u0647 \u062F\u0633\u062A\u062A\u0627\u0646 \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u0627\u0646\u062F\u060C
      \u062F\u0631 \u0635\u0648\u0631\u062A \u0627\u0645\u06A9\u0627\u0646 \u06CC\u06A9
      \u06A9\u0627\u0631\u062A \u0645\u06CC\u200C\u06A9\u0634\u062F \u0648 \u0646\u0648\u0628\u062A
      \u0634\u0645\u0627 \u0631\u0627 \u067E\u0627\u06CC\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F.
      \u067E\u0627\u06CC\u0627\u0646 \u0646\u0648\u0628\u062A \u0632\u0645\u0627\u0646\u06CC
      \u062F\u0631 \u062F\u0633\u062A\u0631\u0633 \u0627\u0633\u062A \u06A9\u0647
      \u0635\u0641\u062D\u0647 \u0645\u0639\u062A\u0628\u0631 \u0628\u0627\u0634\u062F
      \u0648 \u0634\u0645\u0627 \u06CC\u06A9 \u06A9\u0627\u0631\u062A \u0628\u0627\u0632\u06CC
      \u06A9\u0631\u062F\u0647 \u0628\u0627\u0634\u06CC\u062F \u06CC\u0627 \u06A9\u0627\u0631\u062A
      \u062E\u0648\u062F \u0631\u0627 \u0627\u0632 \u062F\u0633\u062A \u062F\u0627\u062F\u0647
      \u0628\u0627\u0634\u06CC\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540510
    m_Localized: "\xAB\u0644\u063A\u0648\xBB (Undo) \u062D\u0631\u06A9\u0627\u062A
      \u0634\u0645\u0627 \u0631\u0627 \u0628\u0647 \u0639\u0642\u0628 \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u0627\u0646\u062F\u061B
      \xAB\u0628\u0627\u0632\u06AF\u0634\u062A\xBB (Redo) \u062D\u0631\u06A9\u062A
      \u0627\u0646\u062C\u0627\u0645 \u0646\u0634\u062F\u0647 \u0631\u0627 \u062F\u0631
      \u0647\u0645\u0627\u0646 \u0646\u0648\u0628\u062A \u062F\u0648\u0628\u0627\u0631\u0647
      \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u062D\u0631\u06A9\u0627\u062A
      \u062C\u062F\u06CC\u062F \u0648 \u0627\u0642\u062F\u0627\u0645\u0627\u062A
      \u067E\u0627\u06CC\u0627\u0646 \u0646\u0648\u0628\u062A\u060C \xAB\u0628\u0627\u0632\u06AF\u0634\u062A\xBB
      (Redo) \u0631\u0627 \u067E\u0627\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u062F.
      \xAB\u062A\u0635\u062D\u06CC\u062D \u0635\u0641\u062D\u0647\xBB (Fix Board)
      \u0633\u0639\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F \u0647\u0646\u06AF\u0627\u0645
      \u062A\u0639\u0645\u06CC\u0631 \u0635\u0641\u062D\u0647\u060C \u0628\u0627\u0632\u06CC\u200C\u0647\u0627\u06CC
      \u0645\u0639\u062A\u0628\u0631 \u0631\u0627 \u0627\u0632 \u062F\u0633\u062A
      \u0634\u0645\u0627 \u0646\u06AF\u0647 \u062F\u0627\u0631\u062F\u061B \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC\u06CC
      \u06A9\u0647 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u0646\u062F \u0627\u0633\u062A\u0641\u0627\u062F\u0647
      \u06A9\u0646\u0646\u062F \u0628\u0647 \u062F\u0633\u062A \u0634\u0645\u0627
      \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u0646\u062F. \xAB\u0628\u0627\u0632\u06AF\u0634\u062A\xBB
      (Revert) \u0635\u0641\u062D\u0647 \u0631\u0627 \u0628\u0647 \u062D\u0627\u0644\u062A
      \u0634\u0631\u0648\u0639 \u0646\u0648\u0628\u062A \u062E\u0648\u062F \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u0627\u0646\u062F
      \u0648 \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC \u0628\u0627\u0632\u06CC
      \u0634\u062F\u0647 \u0634\u0645\u0627 \u0631\u0627 \u0628\u0647 \u062F\u0633\u062A\u062A\u0627\u0646
      \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u0627\u0646\u062F. \u0627\u0642\u062F\u0627\u0645\u0627\u062A
      \u0645\u062E\u0631\u0628 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0627\u0632
      \u0634\u0645\u0627 \u0628\u062E\u0648\u0627\u0647\u0646\u062F \u062A\u0623\u06CC\u06CC\u062F
      \u06A9\u0646\u06CC\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540511
    m_Localized: "\u0646\u0648\u0628\u062A\u200C\u0647\u0627\u06CC \u0632\u0645\u0627\u0646\u200C\u0628\u0646\u062F\u06CC\u200C\u0634\u062F\u0647"
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540512
    m_Localized: "\u0645\u06CC\u0632\u0628\u0627\u0646 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F
      \u062F\u0631 \u0647\u0631 \u0646\u0648\u0628\u062A \u06F3\u06F0\u060C \u06F6\u06F0\u060C
      \u06F9\u06F0 \u06CC\u0627 \u06F1\u06F2\u06F0 \u062B\u0627\u0646\u06CC\u0647
      \u0631\u0627 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646\u062F\u060C
      \u06CC\u0627 \u062F\u0631 \u0628\u0627\u0632\u06CC\u200C\u0647\u0627\u06CC
      \u0622\u0641\u0644\u0627\u06CC\u0646 \u062A\u0627\u06CC\u0645\u0631 \u0631\u0627
      \u062E\u0627\u0645\u0648\u0634 \u06A9\u0646\u062F. \u0628\u0627\u0632\u06CC\u200C\u0647\u0627\u06CC
      \u0622\u0646\u0644\u0627\u06CC\u0646 \u0647\u0645\u06CC\u0634\u0647 \u0632\u0645\u0627\u0646\u200C\u0628\u0646\u062F\u06CC
      \u062F\u0627\u0631\u0646\u062F. \u0648\u0642\u062A\u06CC \u0632\u0645\u0627\u0646
      \u062A\u0645\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u06CC\u06A9
      \u0635\u0641\u062D\u0647 \u0645\u0639\u062A\u0628\u0631 \u0628\u062F\u0648\u0646
      \u0628\u0627\u0632\u06CC \u062F\u0633\u062A\u06CC \u0646\u06AF\u0647 \u062F\u0627\u0634\u062A\u0647
      \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0634\u0645\u0627 \u06A9\u0627\u0631\u062A
      \u0645\u06CC\u200C\u06AF\u06CC\u0631\u06CC\u062F\u061B \u06CC\u06A9 \u0635\u0641\u062D\u0647
      \u0646\u0627\u0645\u0639\u062A\u0628\u0631 \u0628\u062F\u0648\u0646 \u0628\u0627\u0632\u06CC
      \u062F\u0633\u062A\u06CC \u0628\u0627\u0632\u06CC\u0627\u0628\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F
      \u0648 \u0634\u0645\u0627 \u06A9\u0627\u0631\u062A \u0645\u06CC\u200C\u06AF\u06CC\u0631\u06CC\u062F.
      \u0627\u06AF\u0631 \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC \u062F\u0633\u062A\u06CC
      \u0628\u0627\u0632\u06CC \u06A9\u0631\u062F\u0647\u200C\u0627\u06CC\u062F \u0648
      \u0635\u0641\u062D\u0647 \u0645\u0639\u062A\u0628\u0631 \u0627\u0633\u062A\u060C
      \u0646\u0648\u0628\u062A \u0634\u0645\u0627 \u0628\u062F\u0648\u0646 \u0642\u0631\u0639\u0647\u200C\u06A9\u0634\u06CC
      \u0628\u0647 \u067E\u0627\u06CC\u0627\u0646 \u0645\u06CC\u200C\u0631\u0633\u062F.
      \u0627\u06AF\u0631 \u0646\u0627\u0645\u0639\u062A\u0628\u0631 \u0628\u0627\u0634\u062F\u060C
      \u062D\u0631\u06A9\u0627\u062A \u0634\u0645\u0627 \u062A\u0627 \u0632\u0645\u0627\u0646
      \u0645\u0639\u062A\u0628\u0631 \u0634\u062F\u0646 \u062E\u0646\u062B\u06CC
      \u0645\u06CC\u200C\u0634\u0648\u0646\u062F. \u0634\u0645\u0627 \u0641\u0642\u0637
      \u062F\u0631 \u0635\u0648\u0631\u062A\u06CC \u06A9\u0627\u0631\u062A \u0645\u06CC\u200C\u06AF\u06CC\u0631\u06CC\u062F
      \u06A9\u0647 \u0647\u06CC\u0686 \u06A9\u0627\u0631\u062A \u062F\u0633\u062A\u06CC
      \u0631\u0648\u06CC \u0635\u0641\u062D\u0647 \u0628\u0627\u0642\u06CC \u0646\u0645\u0627\u0646\u062F\u0647
      \u0628\u0627\u0634\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540514
    m_Localized: "\u0648\u0642\u062A\u06CC \u062A\u0639\u062F\u0627\u062F \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC
      \u06A9\u0634\u06CC\u062F\u0647 \u0634\u062F\u0647 \u062E\u0627\u0644\u06CC
      \u0634\u062F\u060C \xAB\u06A9\u0634\u06CC\u062F\u0646\xBB \u062A\u0628\u062F\u06CC\u0644
      \u0628\u0647 \xAB\u062F\u0633\u062A \u062F\u0627\u062F\u0646\xBB \u0645\u06CC\u200C\u0634\u0648\u062F:
      \u0647\u06CC\u0686 \u06A9\u0627\u0631\u062A\u06CC \u06A9\u0634\u06CC\u062F\u0647
      \u0646\u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0635\u0641\u062D\u0647
      \u0628\u0647 \u0639\u0642\u0628 \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u062F.
      \u0627\u06AF\u0631 \u0647\u0645\u0647 \u0628\u0627\u0632\u06CC\u06A9\u0646\u0627\u0646
      \u0641\u0639\u0627\u0644 \u067E\u0634\u062A \u0633\u0631 \u0647\u0645 \u0648
      \u0628\u062F\u0648\u0646 \u0628\u0627\u0632\u06CC \u06A9\u0631\u062F\u0646
      \u06A9\u0627\u0631\u062A\u060C \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC\u0634\u0627\u0646
      \u0631\u0627 \u0631\u062F \u0648 \u0628\u062F\u0644 \u06A9\u0646\u0646\u062F\u060C
      \u0628\u0627\u0632\u06CC\u06A9\u0646\u06CC \u06A9\u0647 \u06A9\u0645\u062A\u0631\u06CC\u0646
      \u062A\u0639\u062F\u0627\u062F \u06A9\u0627\u0631\u062A \u0631\u0627 \u062F\u0627\u0631\u062F\u060C
      \u062F\u0631 \u0635\u0648\u0631\u062A\u06CC \u06A9\u0647 \u062A\u0646\u0647\u0627
      \u0628\u0627\u0632\u06CC\u06A9\u0646\u06CC \u0628\u0627\u0634\u062F \u06A9\u0647
      \u0622\u0646 \u062A\u0639\u062F\u0627\u062F \u06A9\u0627\u0631\u062A \u0631\u0627
      \u062F\u0627\u0631\u062F\u060C \u0628\u0631\u0646\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.
      \u0627\u06AF\u0631 \u0628\u0627\u0632\u06CC\u06A9\u0646\u0627\u0646 \u062F\u0631
      \u06A9\u0645\u062A\u0631\u06CC\u0646 \u062A\u0639\u062F\u0627\u062F \u06A9\u0627\u0631\u062A
      \u0645\u0633\u0627\u0648\u06CC \u0634\u0648\u0646\u062F\u060C \u0628\u0627\u0632\u06CC
      \u0628\u0647 \u0628\u0646\u200C\u0628\u0633\u062A \u0645\u06CC\u200C\u0631\u0633\u062F
      \u0648 \u0628\u0631\u0646\u062F\u0647\u200C\u0627\u06CC \u0646\u062F\u0627\u0631\u062F."
