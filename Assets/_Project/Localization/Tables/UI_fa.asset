  m_TableData:
  - m_Id: 6548985208834
    m_Localized: "{0} \u06CC\u06A9 \u0633\u062A \u06A9\u0647 \u0641\u0642\u0637 \u0627\u0632
      \u062F\u0633\u062A \u062E\u0648\u062F\u0634 \u0633\u0627\u062E\u062A\u0647
      \u0634\u062F\u0647 \u0631\u0627 \u0632\u0645\u06CC\u0646 \u0628\u06AF\u0630\u0627\u0631\u062F.
      \u0628\u0647 \u0627\u06CC\u0646 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u0646\u062F
      \u067E\u0627\u06CC\u06CC\u0646 \u0631\u0641\u062A\u0646\u060C \u0648 \u06CC\u06A9
      \u0633\u062A \u06A9\u0627\u0641\u06CC \u0627\u0633\u062A."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282620
  - m_Id: 6548985208850
    m_Localized: "\u0628\u0627 \u062F\u0648 \u062F\u0633\u062A\u0647 \u06A9\u0627\u0631\u062A\u060C
      \u0647\u0631 \u06A9\u0627\u0631\u062A \u06CC\u06A9 \u062F\u0648\u0628\u0644
      \u062F\u0627\u0631\u062F: \u0627\u0632 \u0647\u0645\u0627\u0646 \u062E\u0627\u0644
      \u0648 \u0631\u062A\u0628\u0647\u060C \u0627\u0632 \u062F\u0633\u062A\u0647
      \u062F\u06CC\u06AF\u0631 (\u067E\u0634\u062A \u06A9\u0627\u0631\u062A \u0622\u0646
      \u0645\u062A\u0641\u0627\u0648\u062A \u0628\u0647 \u0646\u0638\u0631 \u0645\u06CC\u200C\u0631\u0633\u062F).
      \u06CC\u06A9 \u062F\u0648\u0628\u0644 \u0647\u0631\u06AF\u0632 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F
      \u062F\u0631 \u06CC\u06A9 \u0645\u062C\u0645\u0648\u0639\u0647 \u0642\u0631\u0627\u0631
      \u06AF\u06CC\u0631\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208863
    m_Localized: "\u0627\u0634\u062A\u0628\u0627\u0647 \u06A9\u0631\u062F\u06CC\u061F
      \u06CC\u06A9 \u062D\u0631\u06A9\u062A \u0628\u0647 \u0639\u0642\u0628 \u0628\u0631\u06AF\u0631\u062F.
      \u0627\u0645\u062A\u062D\u0627\u0646\u0634 \u06A9\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208867
    m_Localized: "{0} \u06A9\u0634\u06CC\u062F\u0647 \u0634\u062F"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282620
  - m_Id: 6548985208868
    m_Localized: "{0} \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u0633\u062A
      \u0628\u0627\u0632\u06CC \u06A9\u0646\u062F\u060C \u0628\u0646\u0627\u0628\u0631\u0627\u06CC\u0646
      \u0627\u0648 \u0642\u0631\u0639\u0647\u200C\u06A9\u0634\u06CC \u06A9\u0631\u062F.
      \u0642\u0631\u0639\u0647\u200C\u06A9\u0634\u06CC \u06CC\u06A9 \u06A9\u0627\u0631\u062A
      \u0627\u0632 \u062F\u0633\u062A\u0647 \u06A9\u0627\u0631\u062A\u200C\u0647\u0627
      \u0631\u0627 \u0628\u0631\u0645\u06CC\u200C\u062F\u0627\u0631\u062F \u0648
      \u0646\u0648\u0628\u062A \u0634\u0645\u0627 \u0631\u0627 \u0628\u0647 \u067E\u0627\u06CC\u0627\u0646
      \u0645\u06CC\u200C\u0631\u0633\u0627\u0646\u062F."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282620
  - m_Id: 6548985208880
    m_Localized: "\u062F\u0633\u062A A\u2665 \u0634\u0645\u0627 \u062F\u0631 \u0647\u06CC\u0686
      \u06A9\u062C\u0627\u06CC \u0645\u06CC\u0632 \u062C\u0627 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208887
    m_Localized: "\u062D\u0627\u0644\u0627 \u2665A \u062F\u0631 \u067E\u0627\u06CC\u06CC\u0646\u200C\u062A\u0631\u06CC\u0646
      \u0633\u0637\u062D \u0642\u0631\u0627\u0631 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F:
      \u2665A-2-3-4-5. \u0622\u062E\u0631\u06CC\u0646 \u06A9\u0627\u0631\u062A\u062A
      \u0631\u0627 \u0628\u0627\u0632\u06CC \u06A9\u0646!"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208888
    m_Localized: '{app.name:upper}!'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282620
  - m_Id: 6548989403143
    m_Localized: "\u0628\u0631\u062F \u0631\u0627 \u062A\u0639\u0645\u06CC\u0631
