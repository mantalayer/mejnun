  - m_Id: 6549035540504
    m_Localized: "\u0633\u062A\u200C\u0647\u0627\u06CC \u0647\u0645\u200C\u0646\u0648\u0639
      \u0634\u0627\u0645\u0644 \u06F3 \u062A\u0627 \u06F4 \u06A9\u0627\u0631\u062A
      \u0628\u0627 \u0631\u062A\u0628\u0647 \u06CC\u06A9\u0633\u0627\u0646 \u0647\u0633\u062A\u0646\u062F
      \u06A9\u0647 \u0647\u0631 \u062E\u0627\u0644 \u0645\u062A\u0641\u0627\u0648\u062A
      \u0627\u0633\u062A. \u0627\u0633\u062A\u0631\u06CC\u062A\u200C\u0647\u0627
      \u0634\u0627\u0645\u0644 \u06F3 \u062A\u0627 \u06F1\u06F3 \u06A9\u0627\u0631\u062A
      \u0645\u062A\u0648\u0627\u0644\u06CC \u0628\u0627 \u0631\u062A\u0628\u0647
      \u06CC\u06A9\u0633\u0627\u0646 \u0647\u0633\u062A\u0646\u062F \u06A9\u0647
      \u0631\u062A\u0628\u0647 \u062A\u06A9\u0631\u0627\u0631\u06CC \u0646\u062F\u0627\u0631\u0646\u062F.
      \u06CC\u06A9 \u0622\u0633 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F
      \u067E\u0627\u06CC\u06CC\u0646 (A-2-3) \u06CC\u0627 \u0628\u0627\u0644\u0627
      (Q-K-A) \u0628\u0627\u0634\u062F\u060C \u0627\u0645\u0627 \u0647\u0631\u06AF\u0632
      \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0647\u0631 \u062F\u0648
      \u0628\u0627\u0634\u062F. K-A-2 \u0645\u062C\u0627\u0632 \u0646\u06CC\u0633\u062A.
      \u0647\u0631 \u0633\u062A \u0631\u0648\u06CC \u0645\u06CC\u0632 \u0628\u0627\u06CC\u062F
      \u0645\u0639\u062A\u0628\u0631 \u0628\u0627\u0634\u062F. \u0633\u062A\u200C\u0647\u0627\u06CC
      \u06CC\u06A9 \u0648 \u062F\u0648 \u06A9\u0627\u0631\u062A\u06CC \u0645\u0639\u062A\u0628\u0631
      \u0646\u06CC\u0633\u062A\u0646\u062F."
