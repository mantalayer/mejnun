      \u0646\u062F\u0627\u0631\u062F\u060C \u0627\u0645\u0627 \u062A\u0627 \u0632\u0645\u0627\u0646\u06CC
      \u06A9\u0647 \u0647\u0645\u0647 \u0645\u062C\u0645\u0648\u0639\u0647\u200C\u0647\u0627
      \u0645\u0639\u062A\u0628\u0631 \u0646\u0628\u0627\u0634\u0646\u062F\u060C \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F
