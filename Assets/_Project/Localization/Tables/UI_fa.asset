  - m_Id: 6548989403139
    m_Localized: "\u0634\u0645\u0639 \u062E\u0627\u0644\u06CC"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403140
    m_Localized: "\u0648\u0642\u062A\u06CC \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC
      \u0642\u0631\u0639\u0647\u200C\u06A9\u0634\u06CC \u062A\u0645\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F\u060C
      \u0642\u0631\u0639\u0647\u200C\u06A9\u0634\u06CC \u062A\u0628\u062F\u06CC\u0644
      \u0628\u0647 \u067E\u0627\u0633 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0627\u06AF\u0631
      \u0647\u0645\u0647 \u067E\u0634\u062A \u0633\u0631 \u0647\u0645 \u067E\u0627\u0633
      \u0628\u062F\u0647\u0646\u062F\u060C \u0628\u0627\u0632\u06CC\u06A9\u0646\u06CC
      \u06A9\u0647 \u06A9\u0645\u062A\u0631\u06CC\u0646 \u06A9\u0627\u0631\u062A
      \u0631\u0627 \u062F\u0627\u0631\u062F \u0628\u0631\u0646\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.
      \u062A\u0633\u0627\u0648\u06CC \u0628\u0647 \u0645\u0639\u0646\u0627\u06CC
      \u0628\u0646\u200C\u0628\u0633\u062A \u0627\u0633\u062A."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403141
    m_Localized: "\u0646\u0648\u0628\u062A\u200C\u0647\u0627\u06CC \u0632\u0645\u0627\u0646\u200C\u0628\u0646\u062F\u06CC\u200C\u0634\u062F\u0647"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403142
    m_Localized: "\u062F\u0631 \u0628\u0627\u0632\u06CC\u200C\u0647\u0627\u06CC \u0632\u0645\u0627\u0646\u200C\u062F\u0627\u0631\u060C
      \u06CC\u06A9 \u0633\u0627\u0639\u062A \u0647\u0631 \u0646\u0648\u0628\u062A
      \u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062A \u0645\u0639\u06A9\u0648\u0633
      \u0645\u06CC\u200C\u0634\u0645\u0627\u0631\u062F. \u0648\u0642\u062A\u06CC
      \u062A\u0645\u0627\u0645 \u0634\u0648\u062F - \u062E\u062F\u0627\u062D\u0627\u0641\u0638!
      - \u06CC\u06A9 \u0646\u0648\u0628\u062A \u0645\u0639\u062A\u0628\u0631 \u0628\u0647
      \u067E\u0627\u06CC\u0627\u0646 \u0645\u06CC\u200C\u0631\u0633\u062F\u060C \u062F\u0631
      \u063A\u06CC\u0631 \u0627\u06CC\u0646 \u0635\u0648\u0631\u062A \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC
      \u0634\u0645\u0627 \u0628\u0647 \u0639\u0642\u0628 \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u0646\u062F
      \u0648 \u0634\u0645\u0627 \u06A9\u0627\u0631\u062A\u200C\u0647\u0627 \u0631\u0627
      \u0645\u06CC\u200C\u06A9\u0634\u06CC\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403144
    m_Localized: "\u0635\u0641\u062D\u0647 \u062B\u0627\u0628\u062A \u0633\u0639\u06CC
      \u0645\u06CC\u200C\u06A9\u0646\u062F \u0647\u0631 \u0633\u062A \u0631\u0627
      \u0645\u0639\u062A\u0628\u0631 \u06A9\u0646\u062F \u0648 \u062F\u0631 \u0639\u06CC\u0646
      \u062D\u0627\u0644 \u062D\u0631\u06A9\u0627\u062A \u0634\u0645\u0627 \u0631\u0627
      \u062D\u0641\u0638 \u06A9\u0646\u062F. \u0628\u0627\u0632\u06AF\u0634\u062A\u060C
      \u06A9\u0644 \u0645\u06CC\u0632 \u0631\u0627 \u0628\u0647 \u062D\u0627\u0644\u062A
      \u0627\u0648\u0644\u06CC\u0647 \u062F\u0631 \u0627\u0628\u062A\u062F\u0627\u06CC
      \u0646\u0648\u0628\u062A \u0634\u0645\u0627 \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u0627\u0646\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403145
    m_Localized: "\u0646\u06A9\u0627\u062A \u0648 \u062C\u062F\u0648\u0644"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403146
    m_Localized: "\u0646\u06A9\u0627\u062A\u060C \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC\u06CC
      \u0631\u0627 \u06A9\u0647 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F
      \u0628\u0627\u0632\u06CC \u06A9\u0646\u06CC\u062F\u060C \u0645\u0634\u062E\u0635
      \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0628\u0631\u0627\u06CC \u0628\u0632\u0631\u06AF\u0646\u0645\u0627\u06CC\u06CC\u060C
      \u0627\u0646\u06AF\u0634\u062A \u062E\u0648\u062F \u0631\u0627 \u0628\u0647
      \u0647\u0645 \u0646\u0632\u062F\u06CC\u06A9 \u06A9\u0646\u06CC\u062F\u060C
      \u0628\u0631\u0627\u06CC \u062D\u0631\u06A9\u062A \u0628\u06A9\u0634\u06CC\u062F
      \u0648 \u0627\u0632 Fit \u0628\u0631\u0627\u06CC \u062F\u06CC\u062F\u0646 \u06A9\u0644
      \u062C\u062F\u0648\u0644 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646\u06CC\u062F."
    m_Metadata:
