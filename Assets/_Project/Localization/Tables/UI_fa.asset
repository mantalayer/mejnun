  - m_Id: 6549035540503
    m_Localized: "\u0627\u0648\u0644\u06CC\u0646 \u0646\u0641\u0631\u06CC \u0628\u0627\u0634
      \u06A9\u0647 \u062F\u0633\u062A\u062A \u0631\u0627 \u062E\u0627\u0644\u06CC
      \u0645\u06CC\u200C\u06A9\u0646\u062F \u062A\u0627 \u0628\u0631\u0646\u062F\u0647
      \u0634\u0648\u06CC. \u0647\u0631 \u0628\u0627\u0632\u06CC \u06CC\u06A9 \u0631\u0627\u0646\u062F
      \u0627\u0633\u062A\u061B \u0628\u0631\u0646\u062F\u0647 \u062F\u0631 \u0628\u0627\u0632\u06CC
      \u0628\u0639\u062F\u06CC \u0632\u0648\u062F\u062A\u0631 \u0628\u0627\u0632\u06CC
      \u0631\u0627 \u0634\u0631\u0648\u0639 \u0645\u06CC\u200C\u06A9\u0646\u062F."
