  - m_Id: 6548981014528
    m_Localized: "{app.name} \u0628\u0627 \u062F\u0648 \u062F\u0633\u062A\u0647 \u06A9\u0627\u0631\u062A
      \u06A9\u0627\u0645\u0644 \u0628\u0627\u0632\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F:
      \u06F1\u06F0\u06F4 \u06A9\u0627\u0631\u062A. \u0628\u0647 \u0647\u0631 \u0646\u0641\u0631
      \u06F1\u06F1 \u06A9\u0627\u0631\u062A \u062F\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.
      \u0627\u0648\u0644\u06CC\u0646 \u0646\u0641\u0631\u06CC \u0628\u0627\u0634\u06CC\u062F
      \u06A9\u0647 \u062F\u0633\u062A \u062E\u0648\u062F \u0631\u0627 \u0631\u0648\u06CC
      \u0645\u06CC\u0632 \u062E\u0627\u0644\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F
      \u062A\u0627 \u0628\u0631\u0646\u062F\u0647 \u0634\u0648\u06CC\u062F."
