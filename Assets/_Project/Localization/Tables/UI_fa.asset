  - m_Id: 6548989403162
    m_Localized: "\u06A9\u0645\u062A\u0631\u06CC\u0646 \u0627\u0645\u062A\u06CC\u0627\u0632
      \u06A9\u0627\u0631\u062A \u0645\u0633\u0627\u0648\u06CC \u0634\u062F. \u0627\u0646\u062A\u062E\u0627\u0628
