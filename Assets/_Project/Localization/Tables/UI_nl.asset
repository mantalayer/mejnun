      m_Items: []
  - m_Id: 6549031346276
    m_Localized: Toon een besturing voor het versnellen van CPU-bochten.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346277
    m_Localized: Tafel & hand
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346278
    m_Localized: Markeer de kaart waarop de muiscursor zich bevindt.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346281
    m_Localized: Hiermee pas je aan hoe sterk je hand buigt.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346282
    m_Localized: Kaartspreiding
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346283
    m_Localized: Hiermee wordt de afstand tussen de kaarten in je hand aangepast.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346284
    m_Localized: Kaartformaat
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346285
    m_Localized: Wijzigt de grootte van je handkaarten.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346286
    m_Localized: Kaartformaat van de tegenstander
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346287
    m_Localized: Wijzigt de grootte van de kaarten die andere spelers in hun hand
      hebben.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346288
    m_Localized: Zoomgevoeligheid
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346289
    m_Localized: Hiermee regel je hoe snel de tabel in- en uitzoomt tijdens het scrollen.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346290
    m_Localized: Steek je hand op
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346291
    m_Localized: Hiermee kunt u aanpassen hoe ver kaarten omhoog komen wanneer ze
      worden geselecteerd of wanneer u er met de muis overheen beweegt.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346292
    m_Localized: Omcirkel de sets met vakjes.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346293
    m_Localized: Omschrijft elke set op de tabel.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346294
    m_Localized: Lijn sets uit op het raster.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346295
    m_Localized: Plaats de sets netjes in een raster in plaats van organisch over
      de tafel verspreid.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346296
    m_Localized: Kaartspreiding
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346297
    m_Localized: Wijzigt de afstand tussen de kaarten in bordspellen.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346299
    m_Localized: Voegt een kleine, natuurlijke variatie toe aan de plaatsing van
      de kaarten.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346300
