  - m_Id: 6549031346303
    m_Localized: Jiggle hintte op kaarten
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346306
    m_Localized: Verminder beweging
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346307
    m_Localized: Vermindert onnodige bewegingen en animaties.
    m_Metadata:
      m_Items: []
