    m_Metadata:
      m_Items: []
  - m_Id: 6549031346301
    m_Localized: 'Tip: handige bordkaarten'
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346302
    m_Localized: Een overzicht van belangrijke kaarten die van pas kunnen komen bij
