      m_Items: []
  - m_Id: 6549031346265
    m_Localized: CPU-bewegingssnelheid
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346266
    m_Localized: Bepaalt hoe snel de computergestuurde spelers hun zetten doen.
