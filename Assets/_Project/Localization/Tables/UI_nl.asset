  - m_Id: 6549018763264
    m_Localized: Win door al je kaarten weg te spelen.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763267
    m_Localized: Versla een moeilijke tegenstander
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763274
    m_Localized: Speel 250 wedstrijden.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763290
    m_Localized: Ga naar beneden en leeg je hand in dezelfde beurt, met hints en
      Fix Board uitgeschakeld.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763301
    m_Localized: Ace High
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763303
    m_Localized: Grote ingang
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763318
    m_Localized: Zorg dat je aan de beurt bent.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957572
    m_Localized: Onstuitbaar
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957573
    m_Localized: Win vijf wedstrijden op rij.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957575
    m_Localized: Voltooi een online game.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957582
    m_Localized: Zelfs Steven
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957588
    m_Localized: Nu beschikbaar
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957592
    m_Localized: Aankoop vereist
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957594
    m_Localized: Klassiek
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957601
    m_Localized: Blueeyedrat Classic Contrast 4-kleuren 2
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957603
    m_Localized: Blueeyedrat Classic Dark 2color 0
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957611
    m_Localized: Blueeyedrat Classic Sepia 2-kleuren 0
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957613
    m_Localized: Kaart PNG's
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151873
    m_Localized: Teal
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151874
    m_Localized: Een kaartspel met sets, strategie en een vleugje chaos.
    m_Metadata:
      m_Items: []
  - m_Id: 6549027151879
    m_Localized: Speel online
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346177
    m_Localized: Speel de tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346179
    m_Localized: Speel online
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346181
    m_Localized: Bijnaam
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346199
    m_Localized: Verlaat de lobby
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346205
    m_Localized: Solo tegen AI
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346227
    m_Localized: Willekeurig gevoel
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346231
    m_Localized: "Nog niet ontgrendeld \u2014 {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282621
  - m_Id: 6549031346237
    m_Localized: "\U0001F512 {0}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282621
  - m_Id: 6549031346241
    m_Localized: Dit artikel is niet meer in de catalogus opgenomen.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346249
    m_Localized: Tafel
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346251
    m_Localized: Toegankelijkheid
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346253
    m_Localized: Algemeen
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346254
    m_Localized: Regels
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346260
    m_Localized: Vraag het gerust voordat je een kaart trekt of doorgeeft, indien
      mogelijk.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346263
    m_Localized: Bevestig dat je weggaat of opnieuw begint.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346267
    m_Localized: Gletsjer
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346279
    m_Localized: Omlijnt de kaart en tilt deze iets omhoog onder de muisaanwijzer.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346280
    m_Localized: Booghoeveelheid
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346298
    m_Localized: Kaartrommeligheid
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346304
    m_Localized: Gebruikt een korte animatie om de aandacht te vestigen op de kaarten
      die een hint geven.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346305
    m_Localized: Toegankelijkheid
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346309
    m_Localized: Schakelt trilfeedback in op ondersteunde apparaten.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540488
    m_Localized: Vul snelle matches in met bots.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540508
    m_Localized: Draai acties
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540552
    m_Localized: "Je moet een geldige zet doen voordat je je beurt be\xEBindigt."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540559
    m_Localized: "Kies minstens \xE9\xE9n kaart om te verplaatsen."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540561
    m_Localized: Dit spel is al afgelopen.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540563
    m_Localized: "Die zet is niet toegestaan \u200B\u200Bvolgens de spelregels."
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540576
    m_Localized: '? Hulp'
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540581
    m_Localized: Probeer de gemarkeerde kaarten.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540583
    m_Localized: Volgende
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540584
    m_Localized: Begrepen.
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540585
    m_Localized: Volgende
    m_Metadata:
      m_Items: []
  - m_Id: 6549035540586
