    m_Localized: "{app.name:upper} \xD710"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282621
  - m_Id: 6549018763288
    m_Localized: Win 10 spellen door al je kaarten weg te spelen.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763289
    m_Localized: Schoonmaken
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763291
    m_Localized: Bliksem
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763292
    m_Localized: Win binnen je eerste vijf beurten.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763293
    m_Localized: Laatste ademtocht
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763294
    m_Localized: Win door je hand leeg te spelen terwijl de trekstapel leeg is.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763295
    m_Localized: Comeback
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763296
    m_Localized: Winst na het bezitten van 20 of meer kaarten.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763297
    m_Localized: Het wordt spannend tot het laatste moment.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763298
    m_Localized: "Win de telling aan het einde van de stapel met precies \xE9\xE9n
      kaart verschil."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763299
    m_Localized: Koninklijke Weg
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763300
    m_Localized: Maak een volledige straight van 13 kaarten, van aas tot koning.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763302
    m_Localized: Maak een straight van vrouw, koning en aas.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763304
    m_Localized: Ga voor minstens drie sets achter elkaar.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763305
    m_Localized: Architect
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763306
    m_Localized: "Leg in \xE9\xE9n beurt minstens acht handkaarten neer."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763307
    m_Localized: Chirurg
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763308
    m_Localized: Splits een straight en eindig de turn met een geldige board.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763309
    m_Localized: Geleende tijd
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763310
    m_Localized: "Neem een \u200B\u200Bkaart uit een set van vier kaarten van dezelfde
      soort en gebruik deze."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763311
    m_Localized: Dubbelzien
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763312
    m_Localized: "Be\xEBindig je beurt met beide exemplaren van een kaart op aparte
      stapels."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763313
    m_Localized: Geduldig
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763314
    m_Localized: Win zonder Ongedaan maken, Terugdraaien of Bord repareren te gebruiken.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763315
    m_Localized: Geen zijwieltjes
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763316
    m_Localized: Win met de hints uitgeschakeld.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763317
    m_Localized: Halas!
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763319
    m_Localized: Koel onder druk
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763320
    m_Localized: "Be\xEBindig een geldige beurt wanneer er minder dan drie seconden
      over zijn."
    m_Metadata:
      m_Items: []
