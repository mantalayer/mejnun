  m_Metadata:
    m_Items:
    - rid: 4825848250703282613
  m_TableData:
  - m_Id: 1656690302979
    m_Localized: SU
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014529
    m_Localized: Set
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208837
    m_Localized: Scendi prima
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208838
    m_Localized: "Finch\xE9 non sei Down puoi giocare solo set dalla tua mano. Metti
      7\u2665 8\u2665 9\u2665 sul tavolo vuoto."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208862
    m_Localized: Disfare
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208864
    m_Localized: Rifare
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208866
    m_Localized: "Ogni set \xE8 di nuovo valido. Termina il tuo turno."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208870
    m_Localized: "Metti 3\u2665 4\u2665 sul tavolo vuoto. Sono solo due carte, quindi
      per ora appare rosso."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208875
    m_Localized: Rimane una sola carta!
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208881
    m_Localized: Disegno
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208882
    m_Localized: Tocca Pesca per prendere una carta e terminare il tuo turno. Pescare
      ti permette anche di recuperare tutte le carte che hai giocato in questo turno.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403146
    m_Localized: I suggerimenti delineano le carte che puoi giocare. Pizzica per
      ingrandire, trascina per spostarti e usa la funzione Adatta per visualizzare
      l'intero tavolo.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403148
    m_Localized: Il vincitore inizia per primo la prossima partita.
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403171
    m_Localized: "Ora un giocatore \xE8 l'host"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403173
    m_Localized: "In attesa dei giocatori ({0}/{1})\u2026\nCodice stanza: {2}"
    m_Metadata:
      m_Items:
      - rid: 4825848250703282613
  - m_Id: 6548989403181
    m_Localized: Riprendi partita
    m_Metadata:
      m_Items: []
