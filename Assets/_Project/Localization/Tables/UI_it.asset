      m_Items: []
  - m_Id: 6549031346307
    m_Localized: Riduce i movimenti e le animazioni non essenziali.
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346308
    m_Localized: Aptica
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346309
    m_Localized: Consente il feedback di vibrazione sui dispositivi supportati.
