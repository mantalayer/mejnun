  - m_Id: 6549018763268
    m_Localized: Sconfiggi un bot difficile.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763269
    m_Localized: Tabella completa
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763270
    m_Localized: Gioca una partita con sei posti.
    m_Metadata:
