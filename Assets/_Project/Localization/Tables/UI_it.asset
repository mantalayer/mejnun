      m_Items: []
  - m_Id: 6549031346278
    m_Localized: Evidenzia la scheda su cui si posiziona il cursore del mouse
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346279
    m_Localized: Delinea e solleva leggermente la scheda sotto il puntatore del mouse.
