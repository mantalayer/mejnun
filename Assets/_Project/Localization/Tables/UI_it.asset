    m_Localized: Collegato
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141130
    m_Localized: Riconnessione
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141131
    m_Localized: Disconnesso
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141132
    m_Localized: IA che gioca
    m_Metadata:
      m_Items: []
