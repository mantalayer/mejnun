    m_Metadata:
      m_Items: []
  - m_Id: 6549018763274
    m_Localized: Gioca 250 partite.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763275
    m_Localized: Condito
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763277
    m_Localized: Master di {app.name:upper}
    m_Metadata:
      m_Items:
