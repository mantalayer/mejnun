  - m_Id: 74273040359424
    m_Localized: Grande!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074624
    m_Localized: Eccezionale!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074625
    m_Localized: Fantastico!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074626
    m_Localized: Bello!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074627
    m_Localized: Sai come farmi sentire bella.
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074628
    m_Localized: Ecco di cosa parlo!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074629
    m_Localized: "Ho bisogno di pi\xF9 cose del genere nella mia vita."
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074630
    m_Localized: Mi piace. Lo adoro.
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074631
    m_Localized: Uuuu!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074632
    m_Localized: Hot dog!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074633
    m_Localized: Beh, che meraviglia!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074634
    m_Localized: E come!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074635
    m_Localized: Cha!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074636
    m_Localized: Dolce come!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074637
    m_Localized: Dolce!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074638
    m_Localized: Yallah!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074639
    m_Localized: Un sacco!
    m_Metadata:
      m_Items: []
  - m_Id: 74273250074640
    m_Localized: Accidenti!
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010752
    m_Localized: Cattivo!
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010753
    m_Localized: "Non l\xEC!"
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010754
    m_Localized: A cosa stavi pensando?
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010755
    m_Localized: Come hai potuto?
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010756
    m_Localized: Dritto in prigione...
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010757
    m_Localized: "Questo \xE8 illegale..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010758
    m_Localized: Non ti capisco...
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010759
    m_Localized: Ragioni come un criceto...
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010760
    m_Localized: "Qualcuno ha la sindrome del luned\xEC..."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010761
    m_Localized: Oof...
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010762
    m_Localized: Che botta...
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010763
    m_Localized: Che botta!
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010764
    m_Localized: Piccolo oof...
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010765
    m_Localized: Vergogna...
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010766
    m_Localized: ERRORE! RILEVATA INTELLIGENZA INFERIORE
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010767
    m_Localized: "Il mio gatto sa giocare meglio di cos\xEC."
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010768
    m_Localized: Eh...
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010769
    m_Localized: Beh, non me l'aspettavo...
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010770
    m_Localized: Ummm...
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010771
    m_Localized: Beh, poteva andare meglio...
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010772
    m_Localized: Nascondere le mani dell'avversario tra un turno e l'altro
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010773
    m_Localized: Sposta parzialmente le mani dell'avversario fuori dallo schermo
      fino al suo prossimo turno.
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010774
    m_Localized: larghezza dell'area di panoramica laterale
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010775
    m_Localized: Controlla la distanza dai bordi sinistro, destro e superiore da
      cui inizia lo scorrimento del cursore sulla scacchiera; impostare su 0 per
      disabilitare.
    m_Metadata:
      m_Items: []
  - m_Id: 74274328010776
    m_Localized: Giocare
    m_Metadata:
      m_Items: []
  - m_Id: 312397712580608
    m_Localized: Tocca per continuare
    m_Metadata:
      m_Items: []
  - m_Id: 312397158932480
    m_Localized: Nuovo feltro sbloccato
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141120
    m_Localized: 'Codice della stanza: {0}'
    m_Metadata:
      m_Items:
      - rid: 4825848250703282613
  - m_Id: 346014409023488
    m_Localized: Per questa partita non ci sono posti liberi.
    m_Metadata:
      m_Items: []
  - m_Id: 346014845231104
    m_Localized: "Non \xE8 stato possibile trovare una corrispondenza con quel codice"
    m_Metadata:
      m_Items: []
  - m_Id: 346014845231105
    m_Localized: Al momento non sono disponibili partite.
    m_Metadata:
      m_Items: []
  - m_Id: 346014845231106
    m_Localized: Impossibile accedere alla partita. Riprova.
    m_Metadata:
      m_Items: []
  - m_Id: 349485589848064
    m_Localized: In attesa dei giocatori
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141121
    m_Localized: Lascia la partita
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141122
    m_Localized: Salva e metti in pausa
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141123
    m_Localized: "Host disconnesso, ricerca di un nuovo host in corso\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 349485963141124
    m_Localized: Impossibile recuperare la partita
    m_Metadata:
      m_Items: []
