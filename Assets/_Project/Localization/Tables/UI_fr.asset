  - m_Id: 6549014568960
    m_Localized: Premier match
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568961
    m_Localized: "Terminez votre premi\xE8re partie."
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568962
    m_Localized: "Premi\xE8re victoire"
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568963
    m_Localized: "Gagnez votre premi\xE8re partie."
    m_Metadata:
      m_Items: []
  - m_Id: 6549014568964
    m_Localized: Premier MEJNUN
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763265
    m_Localized: Dix victoires
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763268
    m_Localized: Battre un bot difficile.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763269
    m_Localized: "Table compl\xE8te"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763270
    m_Localized: "Jouez \xE0 un jeu \xE0 six places."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763271
    m_Localized: "R\xE9gulier"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763272
    m_Localized: Jouez 50 parties.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763273
    m_Localized: "V\xE9t\xE9ran"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763274
    m_Localized: Jouez 250 parties.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763275
    m_Localized: "Chevronn\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763276
    m_Localized: Gagnez 50 matchs.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763277
    m_Localized: "Ma\xEEtre de MEJNUN"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763278
    m_Localized: Gagnez 200 parties.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763279
    m_Localized: Niveau 10
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763280
    m_Localized: Atteignez le niveau 10.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763281
    m_Localized: Niveau 25
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763282
    m_Localized: Atteignez le niveau 25.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763283
    m_Localized: Niveau 50
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763285
    m_Localized: Collectionneur
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763287
    m_Localized: "MEJNUN \xD710"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763288
    m_Localized: Gagnez 10 parties en vidant votre main.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763289
    m_Localized: Nettoyage complet
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763290
    m_Localized: "Descendez et videz votre main au m\xEAme tour, avec les indices
      et le plateau de r\xE9paration d\xE9sactiv\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763291
    m_Localized: Foudre
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763292
    m_Localized: "Gagnez d\xE8s vos cinq premiers tours."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763293
    m_Localized: Dernier souffle
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763294
    m_Localized: Gagnez en vidant votre main lorsque la pioche est vide.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763296
    m_Localized: "Gagnez en poss\xE9dant 20 cartes ou plus."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763297
    m_Localized: Jusqu'au bout
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763298
    m_Localized: "Remportez le d\xE9compte final de la pile d'une seule carte."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763299
    m_Localized: Route Royale
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763300
    m_Localized: "Formez une suite compl\xE8te de 13 cartes, de l'as au roi."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763302
    m_Localized: "Compl\xE9tez une suite dame-roi-as."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763303
    m_Localized: "Grande entr\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763304
    m_Localized: "Descendez avec au moins trois sets \xE0 la fois."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763305
    m_Localized: Architecte
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763306
    m_Localized: Posez au moins huit cartes en main en un seul tour.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763307
    m_Localized: Chirurgien
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763308
    m_Localized: "S\xE9parez une quinte et terminez le tour avec une donne valide."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763309
    m_Localized: "Temps emprunt\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763310
    m_Localized: Prenez une carte d'un ensemble de quatre cartes identiques et utilisez-la.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763311
    m_Localized: Voir double
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763312
    m_Localized: "Terminez votre tour avec les deux exemplaires d'une carte sur des
      ensembles s\xE9par\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763313
    m_Localized: Patient
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763314
    m_Localized: "Gagner sans utiliser les fonctions Annuler, R\xE9tablir ou R\xE9parer
      le plateau."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763315
    m_Localized: Pas de petites roues
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763316
    m_Localized: "Gagnez avec les indices d\xE9sactiv\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763317
    m_Localized: Halas !
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763318
    m_Localized: "Votre tour est \xE9coul\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763319
    m_Localized: Calme sous pression
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763320
    m_Localized: Terminez un tour valide lorsqu'il reste moins de trois secondes.
    m_Metadata:
      m_Items: []
  - m_Id: 6549018763322
    m_Localized: "Remportez une partie jou\xE9e avec un chronom\xE8tre de 30 secondes."
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957568
    m_Localized: "Tueur de g\xE9ants"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957569
    m_Localized: "Remporter la victoire contre cinq bots difficiles \xE0 une table
      compl\xE8te."
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957570
    m_Localized: Tour de chapeau
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957571
    m_Localized: "Gagnez trois parties cons\xE9cutives contre des bots."
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957572
    m_Localized: "Inarr\xEAtable"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957573
    m_Localized: "Gagner cinq matchs d'affil\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957574
    m_Localized: Se connecter
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957575
    m_Localized: Terminez une partie en ligne.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957576
    m_Localized: "Succ\xE8s garanti aupr\xE8s du public"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957577
    m_Localized: Remportez une partie en ligne avec au moins quatre joueurs humains.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957579
    m_Localized: Organiser 10 parties en ligne.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957580
    m_Localized: Transmettez-le
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957581
    m_Localized: Terminez une partie de passe-et-jeu avec au moins quatre humains.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957582
    m_Localized: "M\xEAme Steven"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957583
    m_Localized: Terminer une partie en situation d'impasse.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957584
    m_Localized: "Si\xE8ge \xE9jectable"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957586
    m_Localized: "une r\xE9ussite"
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957587
    m_Localized: Un accomplissement.
    m_Metadata:
      m_Items: []
  - m_Id: 6549022957588
    m_Localized: "Disponible d\xE8s maintenant"
    m_Metadata:
      m_Items: []
