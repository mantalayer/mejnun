      m_Items: []
  - m_Id: 6549031346282
    m_Localized: "\xC9cartement des cartes"
    m_Metadata:
      m_Items: []
  - m_Id: 6549031346283
    m_Localized: Modifie l'espacement entre les cartes dans votre main.
