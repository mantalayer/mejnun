  m_TableData:
  - m_Id: 1656690302984
    m_Localized: Fait
    m_Metadata:
      m_Items: []
  - m_Id: 6548981014530
    m_Localized: "Les cartes sont dispos\xE9es sur la table par groupes. Une m\xEAme
      valeur est compos\xE9e de 3 ou 4 cartes de m\xEAme valeur, mais de couleurs
      diff\xE9rentes. Une suite est compos\xE9e de 3 cartes ou plus de m\xEAme couleur,
      qui se suivent."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208840
    m_Localized: "Tu es \xE0 terre !"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208843
    m_Localized: "Maintenant, placez votre A\u2660 sur le J\u2660 Q\u2660 K\u2660
      de {0}."
    m_Metadata:
      m_Items:
      - rid: 4825848250703282630
  - m_Id: 6548985208845
    m_Localized: "Un as peut \xEAtre faible (A-2-3) ou fort (Q-K-A), mais une suite
      ne se referme jamais (K-A-2)."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208846
    m_Localized: "Du m\xEAme genre"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208860
    m_Localized: Utilisez votre double
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208878
    m_Localized: "Les joueurs qui sont en position Down peuvent \xE9galement commencer
      de nouvelles combinaisons \xE0 partir de leur main."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208879
    m_Localized: "Bloqu\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208885
    m_Localized: "Placez le 2\u2665 sur 3\u2665 4\u2665 5\u2665."
    m_Metadata:
      m_Items: []
  - m_Id: 6548985208890
    m_Localized: "Du m\xEAme genre"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403138
    m_Localized: "M\xEAme ensemble"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403141
    m_Localized: "Tours chronom\xE9tr\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403142
    m_Localized: "Dans les jeux chronom\xE9tr\xE9s, un chronom\xE8tre d\xE9compte
      chaque tour. Quand le temps est \xE9coul\xE9 \u2014 Hale ! \u2014, le tour
      valide se termine ; sinon, vos cartes retournent dans le jeu et vous piochez."
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403152
    m_Localized: Bot {0}
    m_Metadata:
      m_Items:
      - rid: 4825848250703282630
  - m_Id: 6548989403159
    m_Localized: "Jeu termin\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403169
    m_Localized: Tous les joueurs se sont joints
    m_Metadata:
      m_Items: []
  - m_Id: 6548989403172
    m_Localized: "En attente de joueurs ({0}/{1})\u2026"
