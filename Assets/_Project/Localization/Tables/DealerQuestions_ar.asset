  m_TableData:
  - m_Id: 6547924049920
    m_Localized: "\u0645\u0646 \u0647\u0648 \u0627\u0644\u0634\u062E\u0635 \u0627\u0644\u0623\u0643\u062B\u0631
      \u0639\u0631\u0636\u0629 \u0644\u0646\u0633\u064A\u0627\u0646 \u0633\u0628\u0628
      \u062F\u062E\u0648\u0644\u0647 \u0625\u0644\u0649 \u0627\u0644\u063A\u0631\u0641\u0629\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244224
    m_Localized: "\u0645\u0646 \u064A\u0631\u0648\u064A \u0623\u0633\u0648\u0623
      \u0627\u0644\u0646\u0643\u0627\u062A\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244225
    m_Localized: "\u0645\u0646 \u0633\u064A\u0643\u0648\u0646 \u0623\u0648\u0644
      \u0645\u0646 \u064A\u0631\u0642\u0635 \u0641\u064A \u062D\u0641\u0644 \u0627\u0644\u0632\u0641\u0627\u0641\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244226
    m_Localized: "\u0645\u0646 \u064A\u0645\u0644\u0643 \u0623\u0643\u062B\u0631
      \u0645\u0639\u0631\u0636 \u0635\u0648\u0631 \u0641\u0648\u0636\u0648\u064A\u0629
      \u0639\u0644\u0649 \u0647\u0627\u062A\u0641\u0647\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244227
    m_Localized: "\u0645\u0646 \u0633\u064A\u0635\u0645\u062F \u0644\u0623\u0637\u0648\u0644
      \u0641\u062A\u0631\u0629 \u0639\u0644\u0649 \u062C\u0632\u064A\u0631\u0629
      \u0645\u0647\u062C\u0648\u0631\u0629\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244228
    m_Localized: "\u0645\u0646 \u0647\u0648 \u0627\u0644\u0634\u062E\u0635 \u0627\u0644\u0623\u0643\u062B\u0631
      \u0627\u062D\u062A\u0645\u0627\u0644\u0627\u064B \u0644\u0628\u062F\u0621 \u0635\u064A\u062D\u0629
      \u062C\u062F\u064A\u062F\u0629 \u0639\u0646 \u0637\u0631\u064A\u0642 \u0627\u0644\u062E\u0637\u0623\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 6547928244229
    m_Localized: "\u0645\u0646 \u0647\u0648 \u0627\u0644\u0634\u062E\u0635 \u0627\u0644\u0630\u064A
      \u064A\u0635\u0627\u062F\u0641 \u0639\u064A\u062F \u0645\u064A\u0644\u0627\u062F\u0647
      \u0623\u0642\u0631\u0628 \u064A\u0648\u0645 \u0625\u0644\u0649 \u0627\u0644\u064A\u0648\u0645\u061F"
    m_Metadata:
      m_Items: []
