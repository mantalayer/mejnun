        <ui:ScrollView name="settings-page-rules" class="settings-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden" style="display: none">
            <ui:Label class="settings-section-title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="rules.section.components.title" />
                </Bindings>
            </ui:Label>
            <ui:Label class="settings-body-text">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="rules.section.components.body" />
                </Bindings>
            </ui:Label>

            <ui:Label class="settings-section-title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="rules.section.first_player.title" />
                </Bindings>
