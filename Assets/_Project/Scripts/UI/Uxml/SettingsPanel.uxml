        <ui:ScrollView name="settings-page-hints" class="settings-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden" style="display: none">
            <ui:Label class="settings-section-title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.hints.section" />
                </Bindings>
            </ui:Label>
            <ui:Toggle name="hint-board-moves-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.hints.board_moves" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.hints.board_moves.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:Toggle name="hint-jiggle-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.hints.jiggle" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.hints.jiggle.tooltip" />
                </Bindings>
            </ui:Toggle>
        </ui:ScrollView>

        <ui:ScrollView name="settings-page-accessibility" class="settings-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden" style="display: none">
            <ui:Label class="settings-section-title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.accessibility.section" />
                </Bindings>
            </ui:Label>
            <ui:Toggle name="reduced-motion-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.accessibility.reduced_motion" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.accessibility.reduced_motion.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:Toggle name="haptics-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.accessibility.haptics" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.accessibility.haptics.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:Toggle name="four-colour-deck-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.accessibility.four_colour_deck" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.accessibility.four_colour_deck.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:Toggle name="left-handed-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.accessibility.left_handed" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.accessibility.left_handed.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:Toggle name="battery-saver-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.accessibility.battery_saver" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.accessibility.battery_saver.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:VisualElement name="ui-scale-row" class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.accessibility.ui_size" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="ui-scale-slider" low-value="0.8" high-value="3">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.accessibility.ui_size.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="ui-scale-value" class="setting-value" />
            </ui:VisualElement>
        </ui:ScrollView>

        <ui:ScrollView name="settings-page-audio" class="settings-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden" style="display: none">
            <ui:Label class="settings-section-title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.audio.section" />
                </Bindings>
            </ui:Label>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.audio.master_volume" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="volume-master-slider" low-value="0" high-value="1">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.audio.master_volume.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="volume-master-value" class="setting-value" />
