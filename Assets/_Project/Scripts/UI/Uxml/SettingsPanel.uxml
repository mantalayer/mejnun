                    </Bindings>
                </ui:Slider>
                <ui:Label name="volume-sfx-value" class="setting-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.audio.voice_volume" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="volume-voice-slider" low-value="0" high-value="1">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.audio.voice_volume.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="volume-voice-value" class="setting-value" />
            </ui:VisualElement>
        </ui:ScrollView>

        <ui:ScrollView name="settings-page-general" class="settings-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden" style="display: none">
            <ui:Label class="settings-section-title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.general.language_section" />
                </Bindings>
            </ui:Label>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.general.language" />
                    </Bindings>
                </ui:Label>
                <ui:DropdownField name="language-dropdown">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.general.language.tooltip" />
