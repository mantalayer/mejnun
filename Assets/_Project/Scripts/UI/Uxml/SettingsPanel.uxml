<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../Uss/common.uss" />
    <ui:Style src="../Uss/table.uss" />
    <ui:VisualElement name="settings-panel" class="hud-dialog settings-panel" style="display: none">
        <ui:Label class="dialog-title">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.title" />
            </Bindings>
        </ui:Label>
        <ui:VisualElement class="settings-tabs">
            <ui:Button name="settings-tab-gameplay" class="settings-tab">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.tab.gameplay" />
                </Bindings>
            </ui:Button>
            <ui:Button name="settings-tab-table" class="settings-tab">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.tab.table" />
                </Bindings>
            </ui:Button>
            <ui:Button name="settings-tab-hints" class="settings-tab">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.tab.hints" />
                </Bindings>
            </ui:Button>
            <ui:Button name="settings-tab-accessibility" class="settings-tab">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.tab.accessibility" />
                </Bindings>
            </ui:Button>
            <ui:Button name="settings-tab-audio" class="settings-tab">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.tab.audio" />
                </Bindings>
            </ui:Button>
            <ui:Button name="settings-tab-general" class="settings-tab">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.tab.general" />
                </Bindings>
            </ui:Button>
            <ui:Button name="settings-tab-rules" class="settings-tab">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.tab.rules" />
                </Bindings>
            </ui:Button>
            <ui:Button name="settings-tab-credits" class="settings-tab">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.tab.credits" />
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement class="settings-pages">
        <ui:ScrollView name="settings-page-gameplay" class="settings-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden">
            <ui:Label class="settings-section-title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.gameplay.section" />
                </Bindings>
            </ui:Label>
            <ui:Toggle name="confirm-revert-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.gameplay.confirm_revert" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.gameplay.confirm_revert.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:Toggle name="confirm-draw-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.gameplay.confirm_draw" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.gameplay.confirm_draw.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:Toggle name="confirm-fix-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.gameplay.confirm_fix" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.gameplay.confirm_fix.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:Toggle name="confirm-leave-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.gameplay.confirm_leave" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.gameplay.confirm_leave.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.gameplay.cpu_speed" />
                    </Bindings>
                </ui:Label>
                <ui:DropdownField name="cpu-speed-dropdown">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.gameplay.cpu_speed.tooltip" />
                    </Bindings>
                </ui:DropdownField>
            </ui:VisualElement>
            <ui:Toggle name="easy-opening-deal-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.gameplay.easy_opening_deal" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.gameplay.easy_opening_deal.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:Toggle name="show-fast-forward-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.gameplay.show_fast_forward" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.gameplay.show_fast_forward.tooltip" />
                </Bindings>
            </ui:Toggle>
        </ui:ScrollView>

        <ui:ScrollView name="settings-page-table" class="settings-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden" style="display: none">
            <ui:Label class="settings-section-title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.section" />
                </Bindings>
            </ui:Label>
            <ui:Toggle name="hover-highlight-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.table.hover_highlight" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.hover_highlight.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.arc_amount" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="hand-arc-amount-slider" low-value="0" high-value="1.5">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.arc_amount.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="hand-arc-amount-value" class="setting-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.card_spread" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="hand-spread-slider" low-value="0.25" high-value="0.9">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.card_spread.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="hand-spread-value" class="setting-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.card_size" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="hand-card-scale-slider" low-value="0.5" high-value="1.5">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.card_size.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="hand-card-scale-value" class="setting-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.opponent_card_size" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="opponent-card-scale-slider" low-value="0.5" high-value="2">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.opponent_card_size.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="opponent-card-scale-value" class="setting-value" />
            </ui:VisualElement>
            <ui:Toggle name="hide-opponent-hands-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.table.hide_opponent_hands" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.hide_opponent_hands.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.zoom_sensitivity" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="zoom-sensitivity-slider" low-value="0.25" high-value="5">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.zoom_sensitivity.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="zoom-sensitivity-value" class="setting-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.edge_pan_width" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="edge-pan-width-slider" low-value="0" high-value="0.25">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.edge_pan_width.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="edge-pan-width-value" class="setting-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.edge_scroll_width" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="edge-scroll-width-slider" low-value="0" high-value="0.25">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.edge_scroll_width.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="edge-scroll-width-value" class="setting-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.edge_pan_speed" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="edge-pan-speed-slider" low-value="0.25" high-value="3">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.edge_pan_speed.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="edge-pan-speed-value" class="setting-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.pickup_hold" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="long-press-seconds-slider" low-value="0.1" high-value="0.8">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.pickup_hold.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="long-press-seconds-value" class="setting-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.pan_start_speed" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="pan-start-speed-slider" low-value="50" high-value="400">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.pan_start_speed.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="pan-start-speed-value" class="setting-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.raise_hand" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="hand-lift-slider" low-value="0" high-value="1.5">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.raise_hand.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="hand-lift-value" class="setting-value" />
            </ui:VisualElement>
            <ui:Toggle name="overlap-sets-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.table.overlap_sets" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.overlap_sets.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:Toggle name="organic-board-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="settings.table.organic_board" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.organic_board.tooltip" />
                </Bindings>
            </ui:Toggle>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.board_card_spread" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="board-card-spread-slider" low-value="0.5" high-value="1.5">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.board_card_spread.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="board-card-spread-value" class="setting-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label class="setting-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.table.card_messiness" />
                    </Bindings>
                </ui:Label>
                <ui:Slider name="card-messiness-slider" low-value="0" high-value="1">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.table.card_messiness.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="card-messiness-value" class="setting-value" />
