            <ui:Button name="settings-reset-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="settings.general.reset_defaults" />
                    <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.general.reset_defaults.tooltip" />
