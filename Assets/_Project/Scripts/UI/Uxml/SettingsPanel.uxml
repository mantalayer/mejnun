                <ui:Slider name="volume-music-slider" low-value="0" high-value="1">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="UI" entry="settings.audio.music_volume.tooltip" />
                    </Bindings>
                </ui:Slider>
                <ui:Label name="volume-music-value" class="setting-value" />
