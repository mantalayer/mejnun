<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../Uss/table.uss" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="top-bar" class="hud-bar top-bar">
            <ui:VisualElement class="game-status">
                <ui:Label name="turn-label" class="status-label" text="Seat 1's turn" />
                <ui:VisualElement class="draw-pile-status">
                    <ui:Label name="draw-pile-label" class="status-label secondary-label" text="Draw pile: 0" />
                    <ui:VisualElement name="draw-pile-stack" class="draw-pile-stack" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="timer-label" class="status-label timer-label" text="" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="opponents-strip" class="opponents-strip" picking-mode="Ignore">
            <ui:VisualElement name="left-opponents" class="opponent-side opponent-left" picking-mode="Ignore" />
            <ui:VisualElement name="right-opponents" class="opponent-side opponent-right" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="top-opponents" class="opponents-top" picking-mode="Ignore" />
        <ui:VisualElement name="bottom-bar" class="hud-bar bottom-bar">
            <ui:Button name="end-turn-button" class="hud-button primary-button" text="End turn" />
            <ui:Button name="draw-pass-button" class="hud-button" text="Draw" />
            <ui:Button name="undo-button" class="hud-button" text="Undo" />
            <ui:Button name="redo-button" class="hud-button" text="Redo" />
            <ui:Button name="revert-button" class="hud-button" text="Revert" />
            <ui:Button name="fix-board-button" class="hud-button" text="Fix board" />
            <ui:Button name="sort-suit-button" class="hud-button" text="Sort: suit" />
            <ui:Button name="sort-rank-button" class="hud-button" text="Sort: rank" />
            <ui:Button name="fit-board-button" class="hud-button" text="Fit board" />
            <ui:Button name="hint-button" class="hud-button" text="Hint: off" />
            <ui:Button name="mark-set-button" class="hud-button" text="Mark" />
            <ui:Button name="fast-forward-button" class="hud-button" text="Fast forward" style="display: none" />
            <ui:Button name="help-button" class="hud-button" text="?" />
            <ui:Button name="pause-button" class="hud-button" text="Pause" />
            <ui:Button name="menu-button" class="hud-button" text="Exit" />
        </ui:VisualElement>
        <ui:VisualElement name="popup-layer" class="popup-layer" picking-mode="Ignore">
            <ui:Label name="turn-popup" class="turn-popup" picking-mode="Ignore" />
            <ui:Label name="halas-popup" class="halas-popup" text="Halas!" picking-mode="Ignore" />
            <ui:Label name="gone-down-popup" class="gone-down-popup" text="Gone Down" picking-mode="Ignore" />
            <ui:Label name="gone-down-tag" class="gone-down-tag" picking-mode="Ignore" />
            <ui:VisualElement name="marker-layer" class="marker-layer" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="confirm-dialog" class="hud-dialog" style="display: none">
            <ui:Label name="confirm-message" class="dialog-message" text="Are you sure?" />
            <ui:Toggle name="confirm-dont-ask" class="dialog-toggle" label="Don't ask again" />
            <ui:VisualElement class="dialog-actions">
                <ui:Button name="confirm-cancel-button" class="hud-button" text="Cancel" />
                <ui:Button name="confirm-accept-button" class="hud-button primary-button" text="Confirm" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause-panel" class="hud-dialog" style="display: none">
            <ui:Label class="dialog-title" text="Paused" />
            <ui:Button name="resume-button" class="hud-button primary-button" text="Resume" />
            <ui:Button name="restart-button" class="hud-button" text="Restart game" />
            <ui:Button name="settings-button" class="hud-button" text="Settings" />
        </ui:VisualElement>
        <ui:VisualElement name="settings-panel" class="hud-dialog" style="display: none">
            <ui:Label class="dialog-title" text="Settings" />
            <ui:ScrollView class="settings-scroll">
                <ui:Toggle name="hand-arc-toggle" label="Arc hand" />
                <ui:VisualElement class="settings-row">
                    <ui:Label class="setting-label" text="Arc amount" />
                    <ui:Slider name="hand-arc-amount-slider" low-value="0" high-value="1.5" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-row">
                    <ui:Label class="setting-label" text="Card spread" />
                    <ui:Slider name="hand-spread-slider" low-value="0.25" high-value="0.9" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-row">
                    <ui:Label class="setting-label" text="Card size" />
                    <ui:Slider name="hand-card-scale-slider" low-value="0.5" high-value="1.5" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-row">
                    <ui:Label class="setting-label" text="Opponent card size" />
                    <ui:Slider name="opponent-card-scale-slider" low-value="0.5" high-value="2" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-row">
                    <ui:Label class="setting-label" text="Zoom sensitivity" />
                    <ui:Slider name="zoom-sensitivity-slider" low-value="0.25" high-value="5" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-row">
                    <ui:Label class="setting-label" text="CPU move speed" />
                    <ui:DropdownField name="cpu-speed-dropdown" choices="Glacial,Very slow,Slow,Normal,Fast,Very fast" />
                </ui:VisualElement>
                <ui:VisualElement class="settings-row">
                    <ui:Label class="setting-label" text="Raise hand" />
                    <ui:Slider name="hand-lift-slider" low-value="0" high-value="1.5" />
                </ui:VisualElement>
                <ui:Toggle name="hint-board-moves-toggle" label="Hint useful board cards" />
                <ui:Toggle name="hint-jiggle-toggle" label="Jiggle hinted cards" />
                <ui:Toggle name="reduced-motion-toggle" label="Reduce motion" />
                <ui:Toggle name="haptics-toggle" label="Haptics" />
                <ui:Toggle name="show-fast-forward-toggle" label="Show fast-forward button" />
                <ui:Toggle name="overlap-sets-toggle" label="Overlap cards in sets" />
                <ui:Toggle name="organic-board-toggle" label="Place sets organically" />
                <ui:VisualElement class="settings-row">
                    <ui:Label class="setting-label" text="Card messiness" />
                    <ui:Slider name="card-messiness-slider" low-value="0" high-value="1" />
                </ui:VisualElement>
                <ui:Toggle name="easy-opening-deal-toggle" label="Everyone can go down first turn" />
            </ui:ScrollView>
            <ui:Button name="settings-close-button" class="hud-button primary-button" text="Done" />
        </ui:VisualElement>
        <ui:VisualElement name="help-panel" class="hud-dialog help-panel" style="display: none">
            <ui:Label class="dialog-title" text="PC shortcuts" />
            <ui:Label class="shortcut-copy" text="Ctrl/Cmd+Z  Undo&#10;Ctrl/Cmd+Shift+Z or Ctrl+Y  Redo&#10;Space  End turn&#10;D  Draw / pass&#10;R  Revert&#10;F  Fix board&#10;H  Hint&#10;F1  This sheet&#10;Esc or P  Pause" />
            <ui:Button name="help-close-button" class="hud-button primary-button" text="Close" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>