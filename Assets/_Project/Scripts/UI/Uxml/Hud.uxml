<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../Uss/common.uss" />
    <ui:Style src="../Uss/table.uss" />
    <ui:Template name="settings-panel-template" src="SettingsPanel.uxml" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="turn-panel" class="hud-bar turn-panel">
            <ui:Label name="turn-label" class="status-label" />
            <ui:Label name="timer-label" class="status-label timer-label" text="" />
        </ui:VisualElement>
        <ui:Button name="pause-button" class="hud-button hamburger-button" text="">
            <ui:VisualElement class="hamburger-bars" picking-mode="Ignore">
                <ui:VisualElement class="hamburger-bar" />
                <ui:VisualElement class="hamburger-bar" />
                <ui:VisualElement class="hamburger-bar" />
            </ui:VisualElement>
        </ui:Button>
        <ui:VisualElement class="bottom-area">
            <ui:VisualElement name="status-panel" class="hud-bar status-panel">
                <ui:VisualElement class="draw-pile-status">
                    <ui:Label name="draw-pile-label" class="status-label secondary-label draw-pile-label" />
                    <ui:VisualElement name="draw-pile-stack" class="draw-pile-stack" picking-mode="Ignore" />
                    <ui:Button name="draw-pass-button" class="hud-button draw-pile-draw-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="bottom-bar" class="hud-bar bottom-bar">
                <ui:Button name="end-turn-button" class="hud-button primary-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.button.end_turn" />
                    </Bindings>
                </ui:Button>
                <ui:Button name="undo-button" class="hud-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.button.undo" />
                    </Bindings>
                </ui:Button>
                <ui:Button name="redo-button" class="hud-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.button.redo" />
                    </Bindings>
                </ui:Button>
                <ui:Button name="revert-button" class="hud-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.button.revert" />
                    </Bindings>
                </ui:Button>
                <ui:Button name="fix-board-button" class="hud-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.button.fix_board" />
                    </Bindings>
                </ui:Button>
                <ui:Button name="sort-rank-button" class="hud-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.button.sort_rank" />
                    </Bindings>
                </ui:Button>
                <ui:Button name="sort-suit-button" class="hud-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.button.sort_suit" />
                    </Bindings>
                </ui:Button>
                <ui:Button name="fit-board-button" class="hud-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.button.reset_camera" />
                    </Bindings>
                </ui:Button>
                <ui:Button name="compact-board-button" class="hud-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.button.tidy_board" />
                    </Bindings>
                </ui:Button>
                <ui:Button name="mark-set-button" class="hud-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="fast-forward-dock" class="fast-forward-dock hud-bar" picking-mode="Ignore" style="display: none">
            <ui:Button name="fast-forward-button" class="hud-button" style="display: none" />
        </ui:VisualElement>
        <ui:VisualElement name="opponents-strip" class="opponents-strip" picking-mode="Ignore">
            <ui:VisualElement name="left-opponents" class="opponent-side opponent-left" picking-mode="Ignore" />
            <ui:VisualElement name="right-opponents" class="opponent-side opponent-right" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="top-opponents" class="opponents-top" picking-mode="Ignore" />
        <ui:VisualElement name="popup-layer" class="popup-layer" picking-mode="Ignore">
            <ui:Label name="turn-popup" class="turn-popup" picking-mode="Ignore" />
            <ui:Label name="online-notice" class="online-notice" picking-mode="Ignore" />
            <ui:Label name="online-waiting" class="online-waiting" picking-mode="Ignore" />
            <ui:Label name="halas-popup" class="halas-popup" picking-mode="Ignore">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.popup.halas" />
                </Bindings>
            </ui:Label>
            <ui:Label name="gone-down-popup" class="gone-down-popup" picking-mode="Ignore">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.popup.gone_down" />
                </Bindings>
            </ui:Label>
            <ui:Label name="good-move-popup" class="good-move-popup" picking-mode="Ignore" />
            <ui:Label name="gone-down-tag" class="gone-down-tag" picking-mode="Ignore" />
            <ui:Label name="invalid-move-popup" class="invalid-move-popup" picking-mode="Ignore" />
            <ui:VisualElement name="marker-layer" class="marker-layer" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="tutorial-layer" class="tutorial-layer" picking-mode="Ignore" style="display: none">
            <ui:Label name="ghost-hand" class="ghost-hand" text="☝" picking-mode="Ignore" />
            <ui:VisualElement name="coach-popup" class="coach-popup">
                <ui:Label name="coach-title" class="coach-title" text="" />
                <ui:Label name="coach-body" class="coach-body" text="" />
                <ui:Label name="coach-nudge" class="coach-nudge">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="tutorial.ui.coach.nudge" />
                    </Bindings>
                </ui:Label>
                <ui:VisualElement class="coach-actions">
                    <ui:Button name="coach-skip-button" class="hud-button coach-skip-button">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="tutorial.ui.coach.skip" />
                        </Bindings>
                    </ui:Button>
                    <ui:Button name="coach-next-button" class="hud-button primary-button">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="tutorial.ui.coach.next" />
                        </Bindings>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="rule-modal-scrim" class="rule-modal-scrim">
                <ui:VisualElement name="rule-modal" class="hud-dialog rule-modal">
                    <ui:Label name="rule-title" class="dialog-title" text="" />
                    <ui:VisualElement name="rule-diagram" class="rule-diagram" />
                    <ui:Label name="rule-body" class="dialog-message rule-body" text="" />
                    <ui:Label name="rule-page" class="rule-page" text="" />
                    <ui:VisualElement class="dialog-actions">
                        <ui:Button name="rule-back-button" class="hud-button">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="common.back" />
                            </Bindings>
                        </ui:Button>
                        <ui:Button name="rule-ok-button" class="hud-button primary-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="confirm-dialog" class="hud-dialog confirm-dialog" style="display: none">
            <ui:Label name="confirm-message" class="dialog-message" />
            <ui:Toggle name="confirm-dont-ask" class="dialog-toggle">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="UI" entry="hud.confirm.dont_ask" />
                </Bindings>
            </ui:Toggle>
            <ui:VisualElement class="dialog-actions">
                <ui:Button name="confirm-cancel-button" class="hud-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="common.cancel" />
                    </Bindings>
                </ui:Button>
                <ui:Button name="confirm-accept-button" class="hud-button primary-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.confirm.accept" />
                    </Bindings>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause-panel" class="hud-dialog pause-panel" style="display: none">
            <ui:Label class="dialog-title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.pause.title" />
                </Bindings>
            </ui:Label>
            <ui:Label name="room-code-label" class="room-code-label" text="" style="display: none; -unity-text-align: middle-center;" />
            <ui:Button name="resume-button" class="hud-button primary-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.pause.resume" />
                </Bindings>
            </ui:Button>
            <ui:Button name="restart-button" class="hud-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.pause.restart" />
                </Bindings>
            </ui:Button>
            <ui:Button name="settings-button" class="hud-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.pause.settings" />
                </Bindings>
            </ui:Button>
            <ui:Button name="hint-button" class="hud-button" />
            <ui:Button name="skip-tutorial-button" class="hud-button" style="display: none">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.pause.skip_tutorial" />
                </Bindings>
            </ui:Button>
            <ui:Button name="help-button" class="hud-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.pause.help" />
                </Bindings>
            </ui:Button>
            <ui:Button name="menu-button" class="hud-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.pause.main_menu" />
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
        <ui:Instance template="settings-panel-template" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0;" picking-mode="Ignore" />
        <ui:VisualElement name="help-panel" class="hud-dialog help-panel" style="display: none">
            <ui:Label class="dialog-title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.help.title" />
                </Bindings>
            </ui:Label>
            <ui:Label class="shortcut-copy">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="hud.help.shortcuts" />
                </Bindings>
            </ui:Label>
            <ui:Button name="help-close-button" class="hud-button primary-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="common.close" />
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>