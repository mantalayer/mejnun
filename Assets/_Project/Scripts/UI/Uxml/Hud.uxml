<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../Uss/table.uss" />
    <ui:VisualElement name="hud-root" class="hud-root">
        <ui:VisualElement name="top-bar" class="hud-bar top-bar">
            <ui:VisualElement class="game-status">
                <ui:Label name="turn-label" class="status-label" text="Seat 1's turn" />
                <ui:Label name="draw-pile-label" class="status-label secondary-label" text="Draw pile: 0" />
            </ui:VisualElement>
            <ui:VisualElement name="opponents-strip" class="opponents-strip" />
        </ui:VisualElement>
        <ui:VisualElement name="bottom-bar" class="hud-bar bottom-bar">
            <ui:Button name="end-turn-button" class="hud-button primary-button" text="End turn" />
            <ui:Button name="draw-pass-button" class="hud-button" text="Draw" />
            <ui:Button name="undo-button" class="hud-button" text="Undo" />
            <ui:Button name="revert-button" class="hud-button" text="Revert" />
            <ui:Button name="go-down-button" class="hud-button accent-button" text="Go down" />
            <ui:Button name="sort-suit-button" class="hud-button" text="Sort: suit" />
            <ui:Button name="sort-rank-button" class="hud-button" text="Sort: rank" />
            <ui:Button name="fit-board-button" class="hud-button" text="Fit board" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>