.frontend-root {
    width: 100%;
    height: 100%;
    background-color: rgb(9, 25, 20);
    color: rgb(245, 242, 222);
}

.frontend-root .unity-button {
    color: rgb(245, 242, 222);
    background-color: rgb(47, 91, 62);
    border-width: 0;
    border-radius: 6px;
}

.frontend-root .unity-button:hover {
    background-color: rgb(65, 119, 78);
}

.frontend-root .unity-button:disabled {
    color: rgb(191, 201, 188);
    background-color: rgb(54, 68, 57);
}

.frontend-root .primary-flow-button {
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
}

.frontend-root .primary-flow-button:hover {
    background-color: rgb(250, 211, 117);
}

.frontend-safe-area {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.frontend-screen {
    width: 100%;
    max-width: 720px;
    max-height: 100%;
    padding: 28px;
    align-items: stretch;
    justify-content: center;
    background-color: rgba(18, 46, 37, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(105, 149, 115);
    border-right-color: rgb(105, 149, 115);
    border-top-color: rgb(105, 149, 115);
    border-bottom-color: rgb(105, 149, 115);
}

.main-menu-screen {
    width: 100%;
    max-width: 520px;
    align-items: center;
    justify-content: center;
}

.main-menu-screen .frontend-button {
    align-self: stretch;
    width: 100%;
}

.frontend-title {
    color: rgb(245, 220, 145);
    font-size: 46px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.frontend-subtitle,
.frontend-copy {
    color: rgb(218, 227, 205);
    font-size: 16px;
    margin-bottom: 12px;
    white-space: normal;
}

.frontend-page-title {
    color: rgb(245, 220, 145);
    font-size: 30px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.level-progress {
    width: 100%;
    margin-bottom: 18px;
}

.frontend-button {
    min-height: 44px;
    margin-top: 5px;
    margin-bottom: 5px;
    color: rgb(245, 242, 222);
    background-color: rgb(47, 91, 62);
}

.primary-flow-button {
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
}

.frontend-actions {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 12px;
}

.frontend-actions .flow-button,
.frontend-actions .frontend-button {
    flex-grow: 1;
    margin-left: 5px;
    margin-right: 5px;
}

.locked-choice {
    opacity: 0.48;
}

.selected-choice {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(245, 220, 145);
    border-right-color: rgb(245, 220, 145);
    border-top-color: rgb(245, 220, 145);
    border-bottom-color: rgb(245, 220, 145);
}

.gallery-tabs {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.gallery-tab {
    min-height: 40px;
    margin-right: 6px;
}

.selected-tab {
    background-color: rgb(65, 102, 74);
}

.gallery-count {
    flex-grow: 1;
    -unity-text-align: middle-right;
}

.gallery-content {
    flex-direction: row;
    flex-grow: 1;
    min-height: 200px;
}

.gallery-items {
    width: 56%;
    min-height: 200px;
    margin-right: 10px;
}

.gallery-item-tile {
    min-height: 104px;
    margin-bottom: 5px;
    align-items: flex-start;
    color: rgb(248, 250, 238);
    background-color: rgb(49, 91, 62);
}

.gallery-item-tile:hover {
    background-color: rgb(65, 112, 75);
}

.gallery-item-name,
.gallery-item-lock,
.gallery-item-new,
.gallery-progress-label {
    white-space: normal;
}

.gallery-item-lock {
    color: rgb(218, 227, 205);
    font-size: 12px;
}

.gallery-item-new,
.gallery-new-badge {
    color: rgb(245, 220, 145);
    -unity-font-style: bold;
}

.gallery-item-artist {
    color: rgb(191, 201, 188);
    font-size: 11px;
    margin-top: 2px;
}

.gallery-details {
    width: 44%;
    padding: 10px;
    align-items: center;
    background-color: rgba(8, 24, 19, 0.8);
}

.gallery-selected-title {
    color: rgb(245, 220, 145);
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.gallery-preview {
    width: 100%;
    min-height: 112px;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}

.gallery-deck-grid {
    width: 100%;
    height: 100%;
    min-height: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
    align-items: center;
}

.gallery-face {
    flex-shrink: 0;
}

.gallery-tile-preview {
    width: 100%;
    height: 48px;
    margin-bottom: 4px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.hand-fan-preview {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 112px;
}

.fan-card {
    width: 42px;
    height: 62px;
    margin-left: -5px;
    margin-right: -5px;
    -unity-background-scale-mode: scale-to-fit;
}

.random-deck-logo {
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/_Project/Art/Studio/WhatnotGames_StackedBrandMarkVariant_LogoOnly.png?fileID=21300000&guid=f4f49ae01835745ac86e3276e871d395&type=3#WhatnotGames_StackedBrandMarkVariant_LogoOnly");
    -unity-background-scale-mode: scale-to-fit;
}

.felt-swatch {
    width: 100%;
    height: 72px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.45);
    border-right-color: rgba(255, 255, 255, 0.45);
    border-top-color: rgba(255, 255, 255, 0.45);
    border-bottom-color: rgba(255, 255, 255, 0.45);
}

.gallery-progress {
    width: 100%;
}

.setup-screen {
    flex-shrink: 1;
}

.portrait-layout .frontend-screen {
    max-width: 620px;
    padding: 18px;
}

.frontend-screen.setup-screen {
    width: 96%;
    max-width: 1100px;
    max-height: 96%;
    padding: 16px;
}

.setup-content {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.setup-fields {
    width: 67%;
    min-width: 0;
    flex-grow: 1;
    margin-right: 12px;
}

.cosmetic-picker-panel {
    width: 32%;
    min-width: 190px;
    padding: 10px;
    align-items: stretch;
    background-color: rgb(16, 36, 28);
    border-radius: 8px;
}

.cosmetic-picker-copy {
    color: rgb(214, 225, 209);
    white-space: normal;
    margin-bottom: 6px;
}

.cosmetic-preview-button {
    min-height: 112px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 6px;
    color: rgb(248, 250, 238);
    background-color: rgb(48, 91, 62);
}

.cosmetic-preview-button .hand-fan-preview {
    height: 56px;
}

.cosmetic-preview-button .fan-card {
    width: 30px;
    height: 46px;
}

.cosmetic-popup {
    position: absolute;
    width: 470px;
    max-width: 92%;
    max-height: 82%;
    overflow: visible;
}

.cosmetic-popup-panel {
    width: 100%;
    max-height: 460px;
    align-items: stretch;
    padding: 14px;
    background-color: rgb(23, 45, 34);
    border-radius: 10px;
}

.cosmetic-popup-tail {
    position: absolute;
    left: 50%;
    bottom: -8px;
    width: 18px;
    height: 18px;
    background-color: rgb(23, 45, 34);
    rotate: 45deg;
}

.cosmetic-selector-grid {
    height: 300px;
    margin-bottom: 8px;
}

.cosmetic-selector-grid .unity-scroll-view__content-viewport,
.cosmetic-selector-grid-content {
    overflow: hidden;
}

.cosmetic-selector-grid-content {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.cosmetic-choice-tile {
    width: 31.33%;
    min-width: 0;
    min-height: 132px;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    margin: 5px 1%;
    padding: 6px;
    overflow: hidden;
    color: rgb(248, 250, 238);
    background-color: rgb(49, 91, 62);
    border-radius: 6px;
}

.cosmetic-choice-tile:hover {
    background-color: rgb(67, 117, 76);
}

.cosmetic-choice-tile.locked-choice {
    color: rgb(180, 190, 182);
    background-color: rgb(47, 53, 49);
    opacity: 0.58;
}

.cosmetic-locked-notice {
    color: rgb(255, 213, 139);
    background-color: rgb(64, 46, 28);
    border-radius: 5px;
    padding: 8px;
    margin-bottom: 6px;
    white-space: normal;
}

.cosmetic-choice-tile.selected-choice {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(239, 195, 92);
    border-right-color: rgb(239, 195, 92);
    border-top-color: rgb(239, 195, 92);
    border-bottom-color: rgb(239, 195, 92);
}

.picker-choice-preview {
    width: 100%;
    height: 64px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.cosmetic-choice-tile .hand-fan-preview {
    height: 60px;
}

.cosmetic-choice-tile .fan-card {
    width: 30px;
    height: 44px;
    margin-left: -4px;
    margin-right: -4px;
}

.cosmetic-choice-tile .felt-swatch {
    height: 64px;
    flex-shrink: 0;
}

.cosmetic-choice-tile Label {
    max-width: 100%;
    flex-shrink: 1;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.cosmetic-choice-name {
    margin-top: 6px;
    font-size: 13px;
    -unity-font-style: bold;
}

.cosmetic-choice-lock {
    margin-top: 2px;
    font-size: 11px;
    color: rgb(255, 213, 139);
}

.cosmetic-choice-requirement {
    font-size: 10px;
    color: rgb(214, 220, 214);
}

.locked-choice {
    opacity: 1;
}

.portrait-layout .setup-content {
    flex-direction: column;
}

.portrait-layout .setup-fields,
.portrait-layout .cosmetic-picker-panel {
    width: 100%;
    margin-right: 0;
}

.portrait-layout .cosmetic-picker-panel {
    flex-direction: row;
    flex-wrap: wrap;
}

.portrait-layout .cosmetic-picker-panel .settings-section-title,
.portrait-layout .cosmetic-picker-copy {
    width: 100%;
}

.portrait-layout .cosmetic-preview-button {
    flex-grow: 1;
    min-width: 0;
}

.landscape-layout .frontend-screen {
    max-width: 900px;
}

.landscape-layout .main-menu-screen,
.portrait-layout .main-menu-screen {
    max-width: 520px;
}

.landscape-layout .setup-screen {
    max-width: 1100px;
}
