.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.popup-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.turn-popup,
.halas-popup,
.gone-down-popup,
.invalid-move-popup {
    position: absolute;
    left: 50%;
    max-width: 80%;
    translate: -50% 0;
    color: rgb(248, 248, 240);
    background-color: rgba(8, 18, 14, 0.9);
    border-radius: 12px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 12px;
    padding-bottom: 12px;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    scale: 0.9 0.9;
    transition-property: opacity, scale;
    transition-duration: 180ms;
}

.turn-popup {
    top: 36%;
}

.gone-down-popup {
    top: 46%;
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
}

.invalid-move-popup {
    top: 54%;
    color: rgb(248, 248, 240);
    background-color: rgba(96, 42, 34, 0.96);
    font-size: 18px;
}

.halas-popup {
    top: 38%;
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
    font-size: 46px;
}

.gone-down-tag {
    position: absolute;
    min-width: 200px;
    max-width: 80%;
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
    border-radius: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-size: 14px;
    white-space: normal;
    translate: -50% 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    scale: 0.9 0.9;
    transition-property: opacity, scale;
    transition-duration: 180ms;
}

.popup-visible {
    opacity: 1;
    scale: 1 1;
}

.hud-bar {
    flex-direction: row;
    align-items: center;
    background-color: rgba(8, 18, 14, 0.82);
    border-radius: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.turn-panel {
    position: absolute;
    top: 12px;
    left: 12px;
    max-width: 20%;
    flex-direction: column;
    align-items: flex-start;
}

.turn-panel .status-label {
    white-space: normal;
}

.hamburger-button {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 44px;
    min-width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 0;
    font-size: 24px;
}

.bottom-area {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
}

.status-panel {
    width: 288px;
    flex-shrink: 0;
    margin-right: 8px;
}

.opponents-top {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: flex-start;
    padding-left: 22%;
    padding-right: 22%;
}

.marker-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.set-marker {
    position: absolute;
    min-width: 30px;
    height: 30px;
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
    border-radius: 15px;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.card-marker {
    position: absolute;
    min-width: 20px;
    height: 20px;
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
    border-radius: 10px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.draw-pile-status {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    flex-shrink: 0;
    min-height: 0;
}

.draw-pile-label {
    width: 120px;
    flex-shrink: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.draw-pile-stack {
    position: relative;
    width: 48px;
    height: 44px;
    flex-shrink: 0;
    overflow: hidden;
}

.draw-pile-draw-button {
    width: 88px;
    min-width: 88px;
    flex-shrink: 0;
    height: 34px;
    min-height: 34px;
    font-size: 13px;
    margin-top: 2px;
}

.draw-pile-card {
    position: absolute;
    width: 22px;
    height: 32px;
    border-radius: 3px;
    background-color: rgb(45, 70, 57);
    border-width: 1px;
    border-color: rgb(225, 225, 210);
}

.status-label {
    color: rgb(248, 248, 240);
    font-size: 16px;
-unity-font-style: bold;
}

.secondary-label {
    color: rgb(195, 211, 199);
    font-size: 13px;
-unity-font-style: normal;
}

.opponents-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: 16%;
    bottom: 20%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
}

.opponent-side {
    flex-direction: column;
    align-items: center;
}

.opponent-right {
    align-items: flex-end;
}

.opponent-seat {
    flex-direction: column;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 6px;
    min-width: 80px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 6px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(8, 18, 14, 0.35);
    transition-property: background-color, border-color;
    transition-duration: 150ms;
}

.opponents-top > .opponent-seat {
    flex-shrink: 0;
    margin-left: 12px;
    margin-right: 12px;
    padding-left: 16px;
    padding-right: 16px;
}

.opponent-seat.active-seat {
    border-color: rgb(177, 224, 120);
    background-color: rgba(96, 150, 52, 0.55);
}

.opponent-name {
    color: rgb(244, 246, 239);
    font-size: 11px;
    -unity-font-style: bold;
}

.opponent-cards {
    position: relative;
    flex-direction: row;
    flex-shrink: 0;
    height: auto;
    align-items: center;
}

.opponent-cards-vertical {
    flex-direction: column;
}

.opponent-card-back {
    flex-shrink: 0;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(226, 228, 201);
    background-color: rgb(48, 71, 95);
    transition-property: rotate;
    transition-duration: 150ms;
}

.opponent-card-back.skinned {
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.opponent-card-back.shake {
    rotate: 4deg;
}

.opponent-count {
    color: rgb(248, 248, 240);
    font-size: 11px;
    background-color: rgba(8, 18, 14, 0.8);
    border-radius: 8px;
    padding-left: 5px;
    padding-right: 5px;
}

.last-card-badge {
    color: rgb(255, 88, 59);
    font-size: 24px;
    -unity-font-style: bold;
    margin-left: 3px;
}

.last-card-badge.pulse {
    scale: 1.3 1.3;
}

.seat-chip {
    color: rgb(231, 236, 228);
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 5px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-left: 5px;
    margin-right: 5px;
    font-size: 13px;
}

.seat-chip.active-seat {
    color: rgb(18, 30, 20);
    background-color: rgb(177, 224, 120);
-unity-font-style: bold;
}

.bottom-bar {
    justify-content: center;
    flex-wrap: wrap;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.bottom-bar.active-turn {
    border-color: rgb(177, 224, 120);
}

.hud-button {
    min-width: 88px;
    height: 42px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 3px;
    margin-bottom: 3px;
    color: rgb(244, 246, 239);
    background-color: rgb(50, 67, 57);
    border-radius: 5px;
    border-width: 0;
    font-size: 14px;
}

.hud-button:hover {
    background-color: rgb(70, 91, 75);
}

.hud-button:disabled {
    color: rgba(230, 235, 228, 0.45);
    background-color: rgb(48, 54, 49);
}

.primary-button {
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
-unity-font-style: bold;
}

.accent-button {
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
-unity-font-style: bold;
}

.hud-dialog {
    position: absolute;
    left: 20%;
    right: 20%;
    top: 18%;
    bottom: 18%;
    justify-content: center;
    align-items: center;
    background-color: rgba(8, 18, 14, 0.96);
    border-radius: 12px;
    padding: 20px;
}

.dialog-title {
    color: rgb(248, 248, 240);
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.dialog-message,
.shortcut-copy {
    color: rgb(248, 248, 240);
    font-size: 17px;
    white-space: normal;
    margin-bottom: 12px;
}

.dialog-toggle {
    color: rgb(248, 248, 240);
    margin-bottom: 10px;
}

.dialog-actions {
    flex-direction: row;
    justify-content: center;
}

.help-panel {
    left: 25%;
    right: 25%;
    top: 12%;
    bottom: 12%;
}

.pause-panel {
    left: 50%;
    top: 50%;
    right: auto;
    bottom: auto;
    translate: -50% -50%;
    align-items: stretch;
    padding: 16px 20px;
}

.pause-panel .dialog-title {
    -unity-text-align: middle-center;
}

.pause-panel .unity-button {
    min-width: 180px;
    margin-bottom: 6px;
}

.settings-scroll {
    align-self: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
}

.settings-panel {
    align-items: stretch;
    justify-content: flex-start;
}

.settings-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
}

.settings-tab {
    min-width: 90px;
    min-height: 36px;
    flex-grow: 1;
    margin: 3px;
    color: rgb(244, 246, 239);
    background-color: rgb(50, 79, 58);
    border-width: 0;
    border-radius: 5px;
}

.settings-tab.selected-tab {
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
}

.settings-pages {
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}

.settings-page {
    width: 100%;
}

.settings-panel .unity-button {
    color: rgb(244, 246, 239);
    background-color: rgb(50, 79, 58);
    border-width: 0;
    border-radius: 5px;
}

.settings-panel .unity-button:hover {
    background-color: rgb(70, 101, 75);
}

.settings-panel .unity-button:disabled {
    color: rgba(230, 235, 228, 0.65);
    background-color: rgb(48, 54, 49);
}

.settings-panel .settings-tab.selected-tab {
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
}

.settings-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.settings-row .setting-label {
    width: 32%;
    flex-shrink: 0;
}

.settings-row .unity-base-popup-field,
.settings-row .unity-base-dropdown-field {
    flex-grow: 1;
    min-width: 180px;
}

.settings-row .unity-slider {
    flex-grow: 1;
    min-width: 0;
}

.setting-value {
    width: 48px;
    flex-shrink: 0;
    color: rgb(245, 220, 145);
    -unity-text-align: middle-right;
    margin-left: 6px;
}

.settings-tooltip {
    min-height: 34px;
    color: rgb(218, 227, 205);
    font-size: 13px;
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 6px;
}

.settings-section-title {
    color: rgb(248, 248, 240);
    font-size: 19px;
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 6px;
}

.setting-label,
.settings-scroll .unity-toggle {
    color: rgb(248, 248, 240);
}

.portrait-layout .opponents-strip {
    top: 20%;
    bottom: 24%;
}

.phone-layout .bottom-area {
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}

.phone-layout .status-panel {
    margin-right: 0;
    margin-bottom: 6px;
}

.phone-layout .turn-panel {
    max-width: 42%;
}

.phone-layout .opponents-top {
    top: 84px;
    padding-left: 10%;
    padding-right: 10%;
}

.phone-layout .bottom-bar {
    flex-grow: 0;
    align-self: stretch;
    justify-content: flex-start;
    padding-left: 6px;
    padding-right: 6px;
}

.phone-layout .bottom-bar .hud-button {
    width: 18.6%;
    min-width: 0;
    margin-left: 0.7%;
    margin-right: 0.7%;
    padding-left: 2px;
    padding-right: 2px;
    font-size: 12px;
    white-space: normal;
}
