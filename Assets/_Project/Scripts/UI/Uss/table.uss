.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: space-between;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.popup-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.turn-popup,
.halas-popup,
.gone-down-popup {
    position: absolute;
    left: 50%;
    max-width: 80%;
    translate: -50% 0;
    color: rgb(248, 248, 240);
    background-color: rgba(8, 18, 14, 0.9);
    border-radius: 12px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 12px;
    padding-bottom: 12px;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    scale: 0.9 0.9;
    transition-property: opacity, scale;
    transition-duration: 180ms;
}

.turn-popup {
    top: 36%;
}

.gone-down-popup {
    top: 46%;
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
}

.halas-popup {
    top: 38%;
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
    font-size: 46px;
}

.gone-down-tag {
    position: absolute;
    width: 200px;
    height: 32px;
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
    border-radius: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    scale: 0.9 0.9;
    transition-property: opacity, scale;
    transition-duration: 180ms;
}

.popup-visible {
    opacity: 1;
    scale: 1 1;
}

.hud-bar {
    flex-direction: row;
    align-items: center;
    background-color: rgba(8, 18, 14, 0.82);
    border-radius: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.top-bar {
    align-self: flex-start;
    min-height: 54px;
}

.opponents-top {
    position: absolute;
    top: 62px;
    left: 10%;
    right: 10%;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.marker-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.set-marker {
    position: absolute;
    min-width: 30px;
    height: 30px;
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
    border-radius: 15px;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.card-marker {
    position: absolute;
    min-width: 20px;
    height: 20px;
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
    border-radius: 10px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.game-status {
    flex-direction: column;
    min-width: 150px;
}

.draw-pile-status {
    flex-direction: row;
    align-items: center;
    min-height: 46px;
}

.draw-pile-stack {
    position: relative;
    width: 48px;
    height: 44px;
    margin-left: 6px;
    overflow: hidden;
}

.draw-pile-card {
    position: absolute;
    width: 22px;
    height: 32px;
    border-radius: 3px;
    background-color: rgb(45, 70, 57);
    border-width: 1px;
    border-color: rgb(225, 225, 210);
}

.status-label {
    color: rgb(248, 248, 240);
    font-size: 16px;
-unity-font-style: bold;
}

.secondary-label {
    color: rgb(195, 211, 199);
    font-size: 13px;
-unity-font-style: normal;
}

.opponents-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: 16%;
    bottom: 20%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
}

.opponent-side {
    flex-direction: column;
    align-items: center;
}

.opponent-right {
    align-items: flex-end;
}

.opponent-seat {
    flex-direction: column;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 6px;
    min-width: 80px;
}

.opponents-top > .opponent-seat {
    margin-left: 28px;
    margin-right: 28px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 6px;
    border-radius: 6px;
    background-color: rgba(8, 18, 14, 0.35);
}

.opponent-seat.active-seat {
    border-left-width: 3px;
    border-left-color: rgb(177, 224, 120);
    padding-left: 4px;
}

.opponent-name {
    color: rgb(244, 246, 239);
    font-size: 11px;
    -unity-font-style: bold;
}

.opponent-cards {
    position: relative;
    flex-direction: row;
    height: auto;
    min-width: 0;
    align-items: center;
}

.opponent-cards-vertical {
    flex-direction: column;
}

.opponent-card-back {
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(226, 228, 201);
    background-color: rgb(48, 71, 95);
    transition-property: rotate;
    transition-duration: 150ms;
}

.opponent-card-back.skinned {
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.opponent-card-back.shake {
    rotate: 4deg;
}

.opponent-count {
    color: rgb(248, 248, 240);
    font-size: 11px;
    background-color: rgba(8, 18, 14, 0.8);
    border-radius: 8px;
    padding-left: 5px;
    padding-right: 5px;
}

.last-card-badge {
    color: rgb(255, 88, 59);
    font-size: 24px;
    -unity-font-style: bold;
    margin-left: 3px;
}

.last-card-badge.pulse {
    scale: 1.3 1.3;
}

.seat-chip {
    color: rgb(231, 236, 228);
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 5px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-left: 5px;
    margin-right: 5px;
    font-size: 13px;
}

.seat-chip.active-seat {
    color: rgb(18, 30, 20);
    background-color: rgb(177, 224, 120);
-unity-font-style: bold;
}

.bottom-bar {
    justify-content: center;
    flex-wrap: wrap;
}

.hud-button {
    min-width: 88px;
    height: 42px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 3px;
    margin-bottom: 3px;
    color: rgb(244, 246, 239);
    background-color: rgb(50, 67, 57);
    border-radius: 5px;
    border-width: 0;
    font-size: 14px;
}

.hud-button:hover {
    background-color: rgb(70, 91, 75);
}

.hud-button:disabled {
    color: rgba(230, 235, 228, 0.45);
    background-color: rgb(48, 54, 49);
}

.primary-button {
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
-unity-font-style: bold;
}

.accent-button {
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
-unity-font-style: bold;
}

.hud-dialog {
    position: absolute;
    left: 20%;
    right: 20%;
    top: 18%;
    bottom: 18%;
    justify-content: center;
    align-items: center;
    background-color: rgba(8, 18, 14, 0.96);
    border-radius: 12px;
    padding: 20px;
}

.dialog-title {
    color: rgb(248, 248, 240);
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.dialog-message,
.shortcut-copy {
    color: rgb(248, 248, 240);
    font-size: 17px;
    white-space: normal;
    margin-bottom: 12px;
}

.dialog-toggle {
    color: rgb(248, 248, 240);
    margin-bottom: 10px;
}

.dialog-actions {
    flex-direction: row;
    justify-content: center;
}

.help-panel {
    left: 25%;
    right: 25%;
    top: 12%;
    bottom: 12%;
}

.settings-scroll {
    align-self: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
}

.settings-panel {
    align-items: stretch;
    justify-content: flex-start;
}

.settings-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
}

.settings-tab {
    min-width: 90px;
    min-height: 36px;
    flex-grow: 1;
    margin: 3px;
    color: rgb(244, 246, 239);
    background-color: rgb(50, 79, 58);
    border-width: 0;
    border-radius: 5px;
}

.settings-tab.selected-tab {
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
}

.settings-pages {
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}

.settings-page {
    width: 100%;
}

.settings-panel .unity-button {
    color: rgb(244, 246, 239);
    background-color: rgb(50, 79, 58);
    border-width: 0;
    border-radius: 5px;
}

.settings-panel .unity-button:hover {
    background-color: rgb(70, 101, 75);
}

.settings-panel .unity-button:disabled {
    color: rgba(230, 235, 228, 0.65);
    background-color: rgb(48, 54, 49);
}

.settings-panel .settings-tab.selected-tab {
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
}

.settings-row {
    margin-bottom: 8px;
}

.settings-section-title {
    color: rgb(248, 248, 240);
    font-size: 19px;
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 6px;
}

.setting-label,
.settings-scroll .unity-toggle {
    color: rgb(248, 248, 240);
}

.portrait-layout .opponents-strip {
    top: 20%;
    bottom: 24%;
}
