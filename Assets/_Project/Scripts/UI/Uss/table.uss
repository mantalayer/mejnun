.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.popup-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.turn-popup,
.halas-popup,
.gone-down-popup,
.invalid-move-popup {
    position: absolute;
    left: 50%;
    width: 80%;
    max-width: 80%;
    min-width: 0;
    translate: -50% 0;
    color: rgb(248, 248, 240);
    background-color: rgba(8, 18, 14, 0.9);
    border-radius: 12px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 12px;
    padding-bottom: 12px;
    font-size: 30px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    scale: 0.9 0.9;
    transition-property: opacity, scale;
    transition-duration: 180ms;
}

.turn-popup {
    top: 36%;
}

.gone-down-popup {
    top: 46%;
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
}

.good-move-popup {
    position: absolute;
    left: 50%;
    top: 46%;
    width: auto;
    max-width: 60%;
    min-width: 0;
    translate: -50% -100%;
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
    border-radius: 10px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    font-size: 20px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    scale: 0.9 0.9;
    transition-property: opacity, scale;
    transition-duration: 180ms;
}

.good-move-popup--centered {
    left: 50%;
    top: 46%;
    translate: -50% -50%;
}

.invalid-move-popup {
    top: 54%;
    color: rgb(248, 248, 240);
    background-color: rgba(96, 42, 34, 0.96);
    font-size: 18px;
}

.halas-popup {
    top: 38%;
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
    font-size: 46px;
}

.hurry-up-popup {
    position: absolute;
    flex-direction: column;
    left: 50%;
    top: 43%;
    width: auto;
    max-width: 80%;
    translate: -50% -50%;
    color: rgb(255, 246, 238);
    background-color: rgba(130, 24, 24, 0.96);
    border-radius: 14px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px;
    padding-bottom: 16px;
    font-size: 48px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    scale: 0.78 0.78;
    transition-property: opacity, scale;
    transition-duration: 160ms;
}

.reaction-popup-message {
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-center;
}

.reaction-popup-sender {
    margin-top: -4px;
    margin-bottom: 0;
    margin-left: 12px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 23px;
    opacity: 0.75;
    -unity-font-style: normal;
    -unity-text-align: middle-right;
}

.hurry-up-visible {
    opacity: 1;
    scale: 1.08 1.08;
}

.hurry-up-popup.reaction-popup-positive {
    color: rgb(18, 40, 20);
    background-color: rgba(122, 200, 92, 0.96);
}

.phone-layout .hurry-up-popup {
    max-width: 90%;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: 26px;
}

.phone-layout .reaction-popup-sender {
    margin-top: -2px;
    margin-left: 8px;
    font-size: 14px;
}

.phone-layout .hurry-up-visible {
    scale: 1 1;
}

.gone-down-tag {
    position: absolute;
    min-width: 200px;
    max-width: 80%;
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
    border-radius: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-size: 14px;
    white-space: normal;
    translate: -50% 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    scale: 0.9 0.9;
    transition-property: opacity, scale;
    transition-duration: 180ms;
}

.reactions-panel {
    position: absolute;
    width: auto;
    min-width: 200px;
    max-width: 88%;
    flex-direction: column;
    align-items: stretch;
    background-color: rgba(8, 18, 14, 0.96);
    border-radius: 12px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.reactions-title {
    color: rgb(248, 248, 240);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.reactions-panel .reaction-button {
    min-width: 0;
    min-height: 42px;
    height: auto;
    flex-shrink: 0;
    margin-top: 3px;
    margin-bottom: 3px;
    padding-top: 6px;
    padding-bottom: 6px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.reactions-panel .reaction-button.reaction-positive {
    color: rgb(18, 40, 20);
    background-color: rgb(122, 200, 92);
    -unity-font-style: bold;
}

.reactions-panel .reaction-button.reaction-positive:hover {
    background-color: rgb(146, 218, 112);
}

.reactions-panel .reaction-button.reaction-positive:disabled {
    color: rgba(18, 40, 20, 0.5);
    background-color: rgb(74, 104, 66);
}

.rtl .reactions-title,
.rtl .reactions-panel .reaction-button {
    -unity-text-align: middle-center;
}

.popup-visible {
    opacity: 1;
    scale: 1 1;
}

.hud-bar {
    flex-direction: row;
    align-items: center;
    background-color: rgba(8, 18, 14, 0.82);
    border-radius: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.turn-panel {
    position: absolute;
    top: 12px;
    left: 12px;
    max-width: 20%;
    flex-direction: column;
    align-items: flex-start;
}

.rtl .turn-panel {
    left: auto;
    right: 12px;
    align-items: flex-end;
}

.rtl .hamburger-button {
    left: 12px;
    right: auto;
}

.rtl .fast-forward-dock {
    left: 12px;
    right: auto;
}

.rtl .bottom-area,
.rtl .bottom-bar,
.rtl .status-panel,
.rtl .settings-tabs,
.rtl .settings-row,
.rtl .gallery-tabs,
.rtl .gallery-detail-row,
.rtl .dialog-actions,
.rtl .seat-row {
    flex-direction: row-reverse;
}

.rtl .status-panel {
    margin-left: 8px;
    margin-right: 0;
}

.rtl .turn-panel .status-label {
    -unity-text-align: middle-right;
}

.rtl .settings-row .setting-label,
.rtl .dialog-title,
.rtl .gallery-detail-row .setting-label {
    -unity-text-align: middle-right;
}

.left-handed .turn-panel {
    left: auto;
    right: 12px;
    align-items: flex-end;
}

.left-handed .hamburger-button,
.left-handed .fast-forward-dock {
    left: 12px;
    right: auto;
}

.left-handed .bottom-bar,
.left-handed .status-panel {
    flex-direction: row-reverse;
}

.left-handed.rtl .turn-panel {
    left: 12px;
    right: auto;
    align-items: flex-start;
}

.left-handed.rtl .hamburger-button,
.left-handed.rtl .fast-forward-dock {
    left: auto;
    right: 12px;
}

.left-handed.rtl .bottom-bar,
.left-handed.rtl .status-panel {
    flex-direction: row;
}

.phone-layout .bottom-bar {
    flex-direction: row-reverse;
}

.phone-layout.rtl .bottom-bar {
    flex-direction: row;
}

.phone-layout.left-handed .bottom-bar {
    flex-direction: row;
}

.phone-layout.left-handed.rtl .bottom-bar {
    flex-direction: row-reverse;
}


.turn-panel .status-label {
    white-space: normal;
}

.hud-button.hamburger-button {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 44px;
    min-width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 0;
    margin: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-size: 24px;
}

.hamburger-bars {
    flex-direction: column;
    justify-content: space-between;
    width: 26px;
    height: 20px;
    flex-shrink: 0;
    align-self: center;
}

.hamburger-bar {
    width: 26px;
    height: 3px;
    border-radius: 2px;
    background-color: rgb(248, 248, 240);
}

.fast-forward-dock {
    position: absolute;
    right: 12px;
    bottom: 104px;
    justify-content: center;
    align-items: center;
}

/* The dock is sized to the draw pile panel; the button fills it instead of growing it. */
.fast-forward-dock .hud-button {
    height: auto;
    min-height: 0;
    align-self: stretch;
    margin-top: 0;
    margin-bottom: 0;
}

.bottom-area {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
}

.status-panel {
    width: 288px;
    flex-shrink: 0;
    margin-right: 8px;
    align-self: stretch;
    justify-content: center;
}

.opponents-top {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: flex-start;
    padding-left: 22%;
    padding-right: 22%;
}

.marker-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.set-marker {
    position: absolute;
    min-width: 30px;
    height: 30px;
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
    border-radius: 15px;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.card-marker {
    position: absolute;
    min-width: 20px;
    height: 20px;
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
    border-radius: 10px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.draw-pile-status {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    flex-shrink: 0;
    min-height: 0;
}

.draw-pile-label {
    width: 120px;
    flex-shrink: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.draw-pile-stack {
    position: relative;
    width: 48px;
    height: 44px;
    flex-shrink: 0;
    overflow: hidden;
}

.draw-pile-draw-button {
    width: 88px;
    min-width: 88px;
    flex-shrink: 0;
    height: 34px;
    min-height: 34px;
    font-size: 13px;
    margin-top: 2px;
}

.draw-pile-card {
    position: absolute;
    width: 22px;
    height: 32px;
    border-radius: 3px;
    background-color: rgb(45, 70, 57);
    border-width: 1px;
    border-color: rgb(225, 225, 210);
}

.status-label {
    color: rgb(248, 248, 240);
    font-size: 16px;
-unity-font-style: bold;
}

.secondary-label {
    color: rgb(195, 211, 199);
    font-size: 13px;
-unity-font-style: normal;
}

.opponents-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: 16%;
    bottom: 20%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
}

.opponent-side {
    flex-direction: column;
    align-items: center;
}

.opponent-right {
    align-items: flex-end;
}

.opponent-seat {
    position: relative;
    flex-direction: column;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 6px;
    min-width: 72px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 4px;
    padding-bottom: 6px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(8, 18, 14, 0.35);
    transition-property: background-color, border-color;
    transition-duration: 150ms;
}

.opponents-top > .opponent-seat {
    flex-shrink: 0;
    margin-left: 12px;
    margin-right: 12px;
    min-width: 68px;
    padding-left: 8px;
    padding-right: 8px;
}

.opponent-seat.active-seat {
    border-color: rgb(177, 224, 120);
    background-color: rgba(96, 150, 52, 0.55);
}

.opponent-name {
    color: rgb(244, 246, 239);
    font-size: 11px;
    -unity-font-style: bold;
}

.opponent-bot-badge {
    position: absolute;
    right: -9px;
    top: -9px;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
}

.opponent-bot-badge.opponent-bot-badge-left {
    right: auto;
    left: -9px;
}

.opponent-cards {
    position: relative;
    flex-direction: row;
    flex-shrink: 0;
    height: auto;
    align-items: center;
}

.opponent-cards-vertical {
    flex-direction: column;
}

.opponent-cards-phone-stack {
    flex-direction: column;
    align-items: center;
}

.opponent-card-back {
    flex-shrink: 0;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(226, 228, 201);
    background-color: rgb(48, 71, 95);
    transition-property: rotate;
    transition-duration: 150ms;
}

.opponent-card-back.skinned {
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.opponent-card-back.shake {
    rotate: 4deg;
}

.opponent-count {
    color: rgb(248, 248, 240);
    font-size: 11px;
    background-color: rgba(8, 18, 14, 0.8);
    border-radius: 8px;
    padding-left: 5px;
    padding-right: 5px;
}

.last-card-badge {
    color: rgb(255, 88, 59);
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 3px;
}

.last-card-badge.pulse {
    font-size: 19px;
}

.seat-chip {
    color: rgb(231, 236, 228);
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 5px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-left: 5px;
    margin-right: 5px;
    font-size: 13px;
}

.seat-chip.active-seat {
    color: rgb(18, 30, 20);
    background-color: rgb(177, 224, 120);
-unity-font-style: bold;
}

.bottom-bar {
    justify-content: center;
    flex-wrap: wrap;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.desktop-layout .bottom-bar {
    flex-wrap: nowrap;
}

.desktop-layout .bottom-bar .hud-button {
    flex-shrink: 1;
    min-width: 0;
    padding-left: 6px;
    padding-right: 6px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.bottom-bar.active-turn {
    border-color: rgb(177, 224, 120);
}

.hud-button {
    min-width: 88px;
    height: 42px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 3px;
    margin-bottom: 3px;
    color: rgb(244, 246, 239);
    background-color: rgb(50, 67, 57);
    border-radius: 5px;
    border-width: 0;
    font-size: 14px;
}

.hud-button:hover {
    background-color: rgb(70, 91, 75);
}

.hud-button:disabled {
    color: rgba(230, 235, 228, 0.45);
    background-color: rgb(48, 54, 49);
}

.primary-button {
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
-unity-font-style: bold;
}

.accent-button {
    color: rgb(22, 32, 24);
    background-color: rgb(239, 195, 92);
-unity-font-style: bold;
}

.hud-dialog {
    position: absolute;
    left: 20%;
    right: 20%;
    top: 18%;
    bottom: 18%;
    justify-content: center;
    align-items: center;
    background-color: rgba(8, 18, 14, 0.96);
    border-radius: 12px;
    padding: 20px;
}

.dialog-title {
    color: rgb(248, 248, 240);
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.dialog-message,
.shortcut-copy {
    color: rgb(248, 248, 240);
    font-size: 17px;
    white-space: normal;
    margin-bottom: 12px;
}

.dialog-toggle {
    color: rgb(248, 248, 240);
    margin-bottom: 10px;
}

.dialog-actions {
    flex-direction: row;
    justify-content: center;
}

.help-panel {
    left: 25%;
    right: 25%;
    top: 12%;
    bottom: 12%;
}

.pause-panel {
    left: 50%;
    top: 50%;
    right: auto;
    bottom: auto;
    translate: -50% -50%;
    align-items: stretch;
    padding: 16px 20px;
}

/* Confirmation prompts (skip tutorial, leave, draw…): centred and sized to fit their content. */
.confirm-dialog {
    left: 50%;
    top: 50%;
    right: auto;
    bottom: auto;
    width: 440px;
    max-width: 90%;
    translate: -50% -50%;
    padding: 16px 20px;
}

.confirm-dialog .dialog-message {
    -unity-text-align: middle-center;
}

.pause-panel .dialog-title {
    -unity-text-align: middle-center;
}

.room-code-label {
    color: rgb(195, 211, 199);
    font-size: 16px;
    margin-bottom: 12px;
}

.pause-panel .unity-button {
    min-width: 180px;
    margin-bottom: 6px;
}

.settings-scroll {
    align-self: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
}

.settings-panel {
    align-items: stretch;
    justify-content: flex-start;
}

.settings-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
}

.settings-tab {
    min-width: 90px;
    min-height: 36px;
    flex-grow: 1;
    margin: 3px;
    color: rgb(244, 246, 239);
    background-color: rgb(50, 79, 58);
    border-width: 0;
    border-radius: 5px;
}

.settings-tab.selected-tab {
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
}

.settings-pages {
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}

.settings-page {
    width: 100%;
}

.settings-panel .unity-button {
    color: rgb(244, 246, 239);
    background-color: rgb(50, 79, 58);
    border-width: 0;
    border-radius: 5px;
}

.settings-panel .unity-button:hover {
    background-color: rgb(70, 101, 75);
}

.settings-panel .unity-button:disabled {
    color: rgba(230, 235, 228, 0.65);
    background-color: rgb(48, 54, 49);
}

.settings-panel .settings-tab.selected-tab {
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
}

.settings-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.settings-row .setting-label {
    width: 32%;
    flex-shrink: 0;
}

.settings-row .unity-base-popup-field,
.settings-row .unity-base-dropdown-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 120px;
}

.settings-row .unity-base-popup-field__input,
.settings-row .unity-base-dropdown-field__input {
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
}

.settings-row .unity-base-popup-field__text,
.settings-row .unity-base-dropdown-field__text {
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.settings-scroll .unity-scroll-view__content-container {
    width: 100%;
    min-width: 0;
}

.settings-row .unity-slider {
    flex-grow: 1;
    min-width: 0;
}

.settings-compact .settings-row {
    flex-wrap: wrap;
}

.settings-compact .settings-row .setting-label {
    width: 100%;
    flex-shrink: 1;
    white-space: normal;
}

.settings-compact .settings-row .unity-base-popup-field,
.settings-compact .settings-row .unity-base-dropdown-field {
    width: 100%;
    min-width: 0;
}

.settings-compact .settings-scroll .unity-toggle__text {
    min-width: 0;
    flex-shrink: 1;
    white-space: normal;
}

.setting-value {
    width: 48px;
    flex-shrink: 0;
    color: rgb(245, 220, 145);
    -unity-text-align: middle-right;
    margin-left: 6px;
}

.settings-tooltip {
    min-height: 34px;
    color: rgb(218, 227, 205);
    font-size: 13px;
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 6px;
}

.settings-section-title {
    color: rgb(248, 248, 240);
    font-size: 19px;
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 6px;
}

.settings-body-text {
    color: rgb(218, 227, 205);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 8px;
}

.settings-credit-role {
    color: rgb(245, 220, 145);
    font-size: 15px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 4px;
}

.setting-label,
.settings-scroll .unity-toggle {
    color: rgb(248, 248, 240);
}

.portrait-layout .opponents-strip {
    top: 20%;
    bottom: 24%;
}

.phone-layout .bottom-area {
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}

.phone-layout .status-panel {
    margin-right: 0;
    margin-bottom: 6px;
}

.phone-layout .turn-panel {
    max-width: 42%;
}

.phone-layout .turn-popup {
    top: 52%;
    left: 5%;
    right: 5%;
    width: auto;
    max-width: none;
    translate: 0 0;
    font-size: 28px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.phone-layout .halas-popup,
.phone-layout .gone-down-popup,
.phone-layout .invalid-move-popup {
    left: 5%;
    right: 5%;
    width: auto;
    max-width: none;
    translate: 0 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: 22px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.phone-layout .hamburger-button {
    width: 58px;
    min-width: 58px;
    height: 58px;
    min-height: 58px;
    padding: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.phone-layout .hamburger-bars {
    width: 30px;
    height: 24px;
    flex-shrink: 0;
    align-self: center;
}

.phone-layout .hamburger-bar {
    width: 30px;
    height: 4px;
}

.phone-layout .fast-forward-dock .hud-button {
    min-width: 132px;
    font-size: 16px;
}

.phone-layout .opponents-strip {
    position: absolute;
    display: flex;
    left: 0;
    right: 0;
    justify-content: center;
}

.phone-layout .opponent-side {
    position: absolute;
    top: 0;
    bottom: 0;
    height: auto;
    justify-content: space-evenly;
    flex-direction: column;
}

.phone-layout .opponent-left {
    left: 0;
    right: auto;
    align-items: flex-start;
}

.phone-layout .opponent-right {
    left: auto;
    right: 0;
    align-items: flex-end;
}

.phone-layout .opponent-seat {
    margin-top: 8px;
    margin-bottom: 8px;
    min-width: 50px;
    padding-left: 4px;
    padding-right: 4px;
}

.phone-layout .opponents-top > .opponent-seat {
    min-width: 54px;
    padding-left: 5px;
    padding-right: 5px;
}

.phone-layout .opponent-count {
    margin-bottom: 2px;
}

.phone-layout .opponents-top {
    top: 84px;
    padding-left: 10%;
    padding-right: 10%;
}

.settings-panel.mobile-settings {
    left: 1.5%;
    right: 1.5%;
    top: 2%;
    bottom: 2%;
    padding: 12px;
}

.online-notice,
.online-waiting {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 24%;
    padding: 12px 18px;
    border-radius: 10px;
    background-color: rgba(8, 18, 14, 0.94);
    color: rgb(248, 248, 240);
    font-size: 22px;
    -unity-text-align: middle-center;
    white-space: normal;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 180ms;
}

.online-notice.popup-visible,
.online-waiting.waiting-visible {
    opacity: 1;
}

.online-waiting {
    top: 36%;
    display: none;
    border-width: 2px;
    border-color: rgb(239, 195, 92);
}

.phone-layout .bottom-bar {
    flex-grow: 0;
    align-self: stretch;
    justify-content: flex-start;
    padding-left: 6px;
    padding-right: 6px;
}

.phone-layout .bottom-bar .hud-button {
    width: 18.6%;
    min-width: 0;
    min-height: 52px;
    margin-left: 0.7%;
    margin-right: 0.7%;
    padding-left: 2px;
    padding-right: 2px;
    font-size: 15px;
    white-space: normal;
}

/* Tutorial: coach popup, rule modal, ghost hand and HUD button focus. */

.tutorial-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.coach-popup {
    position: absolute;
    left: 50%;
    top: 96px;
    width: 420px;
    max-width: 86%;
    translate: -50% 0;
    background-color: rgba(8, 18, 14, 0.94);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(239, 195, 92);
    padding: 12px 16px;
    opacity: 0;
    scale: 0.94 0.94;
    transition-property: opacity, scale, translate, left, top;
    transition-duration: 180ms;
}

.coach-popup.coach-visible {
    opacity: 1;
    scale: 1 1;
}

.coach-popup.coach-anchored {
    translate: -50% -100%;
}

.coach-title {
    color: rgb(239, 195, 92);
    font-size: 19px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 4px;
}

.coach-body {
    color: rgb(248, 248, 240);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 6px;
}

.coach-nudge {
    display: none;
    color: rgb(255, 196, 170);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.coach-popup.coach-nudging .coach-nudge {
    display: flex;
}

.coach-popup.coach-nudging {
    border-color: rgb(230, 96, 72);
}

.coach-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.coach-skip-button {
    min-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(230, 235, 228, 0.7);
}

.rule-modal-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    background-color: rgba(0, 0, 0, 0);
}

.rule-modal {
    left: 50%;
    top: 50%;
    right: auto;
    bottom: auto;
    width: 560px;
    max-width: 90%;
    translate: -50% -50%;
    border-width: 2px;
    border-color: rgb(239, 195, 92);
}

.rule-body {
    -unity-text-align: middle-center;
}

.rule-page {
    color: rgba(230, 235, 228, 0.6);
    font-size: 13px;
    margin-bottom: 8px;
}

.rule-diagram {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 12px;
}

.diagram-group {
    align-items: center;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 6px;
}

.diagram-cards {
    flex-direction: row;
    border-width: 2px;
    border-radius: 6px;
    padding: 4px;
    border-color: rgb(46, 235, 71);
}

.diagram-group.diagram-invalid .diagram-cards {
    border-color: rgb(242, 41, 33);
}

.diagram-card {
    width: 38px;
    height: 54px;
    margin-left: 2px;
    margin-right: 2px;
    background-color: rgb(250, 248, 240);
    border-radius: 4px;
    color: rgb(24, 24, 24);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.diagram-card.diagram-red {
    color: rgb(196, 30, 30);
}

.diagram-card.diagram-second-deck {
    background-color: rgb(226, 236, 250);
}

.diagram-caption {
    color: rgba(230, 235, 228, 0.8);
    font-size: 13px;
    margin-top: 3px;
}

.ghost-hand {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 44px;
    color: rgb(250, 248, 240);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(8, 18, 14);
    translate: -30% -10%;
    opacity: 0;
}

/* Button taps: flipped so the finger points down, with the fingertip (now near the bottom) on the anchor point. */
.ghost-hand.ghost-hand-down {
    scale: 1 -1;
    translate: -30% -90%;
}

.hud-button.tutorial-focus {
    border-width: 3px;
    border-color: rgb(239, 195, 92);
    background-color: rgb(239, 195, 92);
    color: rgb(22, 32, 24);
    -unity-font-style: bold;
}

.phone-layout .coach-popup {
    width: auto;
    left: 4%;
    right: 4%;
    max-width: none;
    translate: 0 0;
    top: 84px;
}

.phone-layout .coach-popup.coach-anchored {
    translate: 0 -100%;
}

.portrait-layout .rule-modal,
.phone-layout .rule-modal {
    width: 92%;
}

.phone-layout .diagram-card {
    width: 30px;
    height: 44px;
    font-size: 13px;
}

/* Right-to-left text. UI Toolkit never derives text alignment from languageDirection, so every
   left-aligned paragraph or label class is mirrored here. Centred text keeps its centring below. */
.rtl .settings-section-title,
.rtl .settings-body-text,
.rtl .settings-credit-role,
.rtl .settings-tooltip,
.rtl .dialog-message,
.rtl .shortcut-copy,
.rtl .room-code-label,
.rtl .coach-title,
.rtl .coach-body,
.rtl .coach-nudge {
    -unity-text-align: upper-right;
}

.rtl .rule-body,
.rtl .confirm-dialog .dialog-message {
    -unity-text-align: middle-center;
}

.rtl .settings-scroll .unity-toggle {
    flex-direction: row-reverse;
}

.rtl .settings-scroll .unity-toggle > .unity-base-field__label {
    -unity-text-align: middle-right;
}

.rtl .setting-value {
    margin-left: 0;
    margin-right: 6px;
}

.rtl .coach-actions {
    flex-direction: row-reverse;
}

/* Keep the scrollbar on the trailing (left) edge so it never sits against the start of a line. */
.rtl .settings-scroll .unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row-reverse;
}
