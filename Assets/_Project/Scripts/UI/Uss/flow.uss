.flow-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 14, 10, 0.78);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
}

.flow-screen {
    width: 82%;
    max-width: 620px;
    max-height: 92%;
    align-items: stretch;
    background-color: rgb(26, 43, 34);
    border-radius: 12px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 22px;
    padding-bottom: 22px;
}

.flow-title {
    color: rgb(244, 246, 239);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    white-space: normal;
}

.flow-copy {
    color: rgb(205, 217, 205);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 12px;
}

.player-name-fields {
    flex-direction: column;
    max-height: 80%;
    overflow: hidden;
}

.player-name-fields TextField {
    margin-top: 3px;
    margin-bottom: 3px;
}

.seat-row {
    flex-direction: row;
    align-items: center;
}

.seat-name {
    flex-grow: 1;
    flex-shrink: 1;
}

.seat-kind {
    width: 150px;
    margin-left: 6px;
}

.seat-style {
    width: 120px;
    margin-left: 4px;
}

.mejnun-banner {
    color: rgb(239, 195, 92);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.result-counts {
    white-space: pre-wrap;
    margin-top: 8px;
}

.results-scroll {
    max-height: 62%;
    flex-shrink: 1;
}

.result-reward-label,
.result-level-up {
    color: rgb(245, 220, 145);
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.result-chip-list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.result-chip {
    min-height: 30px;
    margin: 3px;
    font-size: 13px;
}

.rematch-confirm {
    align-items: center;
    padding: 10px;
    background-color: rgb(20, 33, 25);
    border-radius: 8px;
}


.flow-error {
    color: rgb(255, 146, 120);
    font-size: 14px;
    white-space: normal;
    margin-top: 6px;
}

.seat-options {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
    margin-bottom: 8px;
}

.flow-button,
.seat-choice {
    min-width: 112px;
    height: 44px;
    margin-left: 5px;
    margin-right: 5px;
    margin-top: 5px;
    margin-bottom: 5px;
    color: rgb(244, 246, 239);
    background-color: rgb(54, 75, 61);
    border-width: 0;
    border-radius: 6px;
    font-size: 15px;
}

.primary-flow-button {
    color: rgb(20, 31, 22);
    background-color: rgb(177, 224, 120);
    -unity-font-style: bold;
}

.handoff-screen {
    align-items: center;
    justify-content: center;
    min-height: 220px;
}

.flow-root .unity-button {
    color: rgb(245, 242, 222);
    background-color: rgb(49, 91, 62);
    border-width: 0;
    border-radius: 6px;
}

.flow-root .unity-button:hover {
    background-color: rgb(69, 119, 77);
}

.flow-root .unity-button:disabled {
    color: rgb(191, 201, 188);
    background-color: rgb(54, 68, 57);
}

.flow-root .primary-flow-button {
    color: rgb(22, 32, 24);
    background-color: rgb(177, 224, 120);
}

.flow-root .primary-flow-button:hover {
    background-color: rgb(194, 235, 143);
}

.deck-unlock-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 12, 9, 0.96);
}

.deck-unlock-caption {
    position: absolute;
    top: 6%;
    width: 100%;
    color: rgb(255, 227, 144);
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.deck-unlock-name {
    position: absolute;
    top: 10%;
    width: 100%;
    color: rgb(255, 235, 178);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.deck-unlock-artist {
    position: absolute;
    top: 16%;
    width: 100%;
    color: rgb(228, 218, 188);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.deck-unlock-stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.deck-unlock-card {
    position: absolute;
    border-radius: 5px;
}

.deck-unlock-glow-outer,
.deck-unlock-glow-inner {
    position: absolute;
    border-radius: 12px;
}

.deck-unlock-glow-outer {
    background-color: rgba(255, 194, 49, 0.22);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(255, 196, 60);
    border-right-color: rgb(255, 196, 60);
    border-top-color: rgb(255, 196, 60);
    border-bottom-color: rgb(255, 196, 60);
}

.deck-unlock-glow-inner {
    background-color: rgba(255, 221, 110, 0.18);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 239, 157);
    border-right-color: rgb(255, 239, 157);
    border-top-color: rgb(255, 239, 157);
    border-bottom-color: rgb(255, 239, 157);
}

.deck-unlock-hint {
    position: absolute;
    bottom: 6%;
    width: 100%;
    color: rgb(225, 225, 207);
    font-size: 16px;
    -unity-text-align: middle-center;
}