.unity-progress-bar {
    color: rgb(248, 250, 255);
    border-radius: 4px;
}

.unity-progress-bar .unity-progress-bar__container {
    background-color: rgba(0, 0, 0, 0);
}

.unity-progress-bar .unity-progress-bar__background {
    background-color: rgb(24, 48, 77);
    border-left-color: rgb(43, 119, 204);
    border-right-color: rgb(43, 119, 204);
    border-top-color: rgb(43, 119, 204);
    border-bottom-color: rgb(43, 119, 204);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.unity-progress-bar .unity-progress-bar__progress {
    background-color: rgb(43, 119, 204);
}

.unity-progress-bar .unity-progress-bar__title {
    color: rgb(248, 250, 255);
}

.unity-base-popup-field__input {
    color: rgb(248, 250, 238);
    background-color: rgb(47, 91, 62);
    border-left-color: rgb(96, 142, 105);
    border-right-color: rgb(96, 142, 105);
    border-top-color: rgb(96, 142, 105);
    border-bottom-color: rgb(96, 142, 105);
}

.unity-base-popup-field__text {
    color: rgb(248, 250, 238);
}

.unity-base-dropdown__container {
    background-color: rgb(24, 48, 36);
}

.unity-base-dropdown__item {
    color: rgb(248, 250, 238);
    background-color: rgb(36, 67, 47);
}

.unity-base-dropdown__item:hover {
    background-color: rgb(65, 112, 75);
}